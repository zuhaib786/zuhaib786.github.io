<ising-laboratory>
  <section class="math-instrument" aria-label="Interactive Ising-model laboratory">
    <div class="math-bar"><div class="math-state"><i></i><span data-state>Metropolis dynamics · thermal spin fluctuations</span></div><div class="math-actions"><div class="math-tabs" aria-label="Temperature preset"><button data-preset="ordered">Ordered</button><button class="active" data-preset="critical">Critical</button><button data-preset="hot">Hot</button></div><button class="math-button active" data-spin="1">Paint +</button><button class="math-button" data-spin="-1">Paint −</button><button class="math-button" data-play>Pause</button><button class="math-button" data-random>Randomize</button></div></div>
    <div class="math-dashboard">
      <div class="math-stage physics-stage"><span class="math-stage-label label">spin lattice · domain walls · magnetization and energy histories</span><canvas data-canvas aria-label="Ising spin lattice and thermodynamic observables"></canvas></div>
      <aside class="math-readout"><p class="label label--accent">Statistical mechanics</p><h2 data-title>Criticality has no preferred scale</h2><p data-description>Near Tₙ, domains appear at many sizes. Local thermal updates produce fluctuations whose collective response becomes macroscopic.</p><div class="math-formula">H = −J Σ⟨ij⟩ sᵢsⱼ − hΣᵢsᵢ</div>
        <div class="math-metrics"><div><strong data-magnetization>0.000</strong><small>Magnetization m</small></div><div><strong data-energy>0.000</strong><small>Energy per spin</small></div><div><strong data-susceptibility>0.000</strong><small>Susceptibility χ</small></div></div>
        <div class="math-controls"><div class="math-control"><label><span>Update algorithm</span><b data-algorithm-value>Metropolis</b></label><select data-algorithm><option value="metropolis">Metropolis</option><option value="wolff">Wolff clusters</option></select></div><div class="math-control"><label><span>Temperature T / J</span><b data-temperature-value>2.269</b></label><input data-temperature type="range" min="0.5" max="5" step="0.01" value="2.269" /></div><div class="math-control"><label><span>External field h / J</span><b data-field-value>0.00</b></label><input data-field type="range" min="-0.5" max="0.5" step="0.01" value="0" /></div><div class="math-control"><label><span>Updates per frame</span><b data-sweeps-value>2</b></label><input data-sweeps type="range" min="1" max="8" step="1" value="2" /></div></div>
        <div class="math-legend"><span><i></i>spin +1</span><span><i></i>spin −1</span><span><i></i>recently flipped cluster</span></div><div class="math-trace"><p class="label">Thermodynamic reading</p><ol><li data-reading-1>Tc = 2 / ln(1 + √2) ≈ 2.269 for the infinite square lattice.</li><li data-reading-2>Below Tc, spin-flip symmetry breaks and |m| becomes macroscopic.</li><li data-reading-3>Paint a domain into the lattice and watch curvature and noise compete.</li></ol></div>
      </aside>
    </div>
  </section>
</ising-laboratory>

<script>
  type Preset="ordered"|"critical"|"hot";type Algorithm="metropolis"|"wolff";
  const TC=2/Math.log(1+Math.SQRT2);
  const ISING_INFO:Record<Preset,[string,string]>={ordered:["Order chooses a sign","Below the critical temperature, a macroscopic domain survives thermal noise and spin-flip symmetry is spontaneously broken."],critical:["Criticality has no preferred scale","Near Tₙ, domains appear at many sizes. Local thermal updates produce fluctuations whose collective response becomes macroscopic."],hot:["Heat erases long-range memory","Above the transition, entropy wins: domains remain short-lived and the time-averaged magnetization approaches zero."]};
  class IsingLaboratory extends HTMLElement{
    canvas!:HTMLCanvasElement;ctx!:CanvasRenderingContext2D;width=0;height=0;cols=96;rows=64;spins=new Int8Array(this.cols*this.rows);temperature=TC;field=0;sweeps=2;algorithm:Algorithm="metropolis";preset:Preset="critical";paintSpin=1;playing=true;frame=0;last=0;rngState=314159265;measureTick=0;mHistory:number[]=[];eHistory:number[]=[];cluster=new Uint8Array(this.cols*this.rows);lastCluster=0;painting=false;resize?:ResizeObserver;theme?:MutationObserver;aborter=new AbortController();
    connectedCallback(){this.canvas=this.querySelector("[data-canvas]") as HTMLCanvasElement;const c=this.canvas.getContext("2d");if(!c)return;this.ctx=c;this.bind();this.resize=new ResizeObserver(()=>this.layout());this.resize.observe(this.canvas);this.theme=new MutationObserver(()=>this.draw());this.theme.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});this.load("critical");this.layout();this.frame=requestAnimationFrame(t=>this.animate(t));}
    disconnectedCallback(){cancelAnimationFrame(this.frame);this.aborter.abort();this.resize?.disconnect();this.theme?.disconnect();}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach(b=>b.addEventListener("click",()=>{this.querySelectorAll("[data-preset]").forEach(x=>x.classList.toggle("active",x===b));this.load(b.dataset.preset as Preset);},{signal}));this.querySelectorAll<HTMLButtonElement>("[data-spin]").forEach(b=>b.addEventListener("click",()=>{this.paintSpin=Number(b.dataset.spin);this.querySelectorAll("[data-spin]").forEach(x=>x.classList.toggle("active",x===b));},{signal}));this.querySelector("[data-play]")?.addEventListener("click",()=>{this.playing=!this.playing;const b=this.querySelector<HTMLButtonElement>("[data-play]");if(b)b.textContent=this.playing?"Pause":"Run";this.text("[data-state]",this.playing?`${this.algorithm==="wolff"?"Wolff cluster":"Metropolis"} dynamics · sampling equilibrium`:"Paused · paint spins into the lattice");},{signal});this.querySelector("[data-random]")?.addEventListener("click",()=>{this.randomize();this.resetHistory();},{signal});this.querySelector<HTMLSelectElement>("[data-algorithm]")?.addEventListener("change",e=>{this.algorithm=(e.currentTarget as HTMLSelectElement).value as Algorithm;this.text("[data-algorithm-value]",this.algorithm==="wolff"?"Wolff":"Metropolis");this.text("[data-state]",this.algorithm==="wolff"?"Wolff clusters · nonlocal critical updates":"Metropolis dynamics · local thermal updates");},{signal});this.range("[data-temperature]",v=>{this.temperature=v;this.text("[data-temperature-value]",v.toFixed(3));this.preset=v<TC*.8?"ordered":v>TC*1.35?"hot":"critical";this.configure();this.resetHistory();});this.range("[data-field]",v=>{this.field=v;this.text("[data-field-value]",v.toFixed(2));if(Math.abs(v)>.001&&this.algorithm==="wolff"){this.algorithm="metropolis";const s=this.querySelector<HTMLSelectElement>("[data-algorithm]");if(s)s.value="metropolis";this.text("[data-algorithm-value]","Metropolis");this.text("[data-state]","External field requires local Metropolis updates");}this.resetHistory();});this.range("[data-sweeps]",v=>{this.sweeps=v;this.text("[data-sweeps-value]",String(v));});this.canvas.addEventListener("pointerdown",e=>{this.painting=true;this.canvas.setPointerCapture(e.pointerId);this.paint(e);},{signal});this.canvas.addEventListener("pointermove",e=>{if(this.painting)this.paint(e);},{signal});const up=(e:PointerEvent)=>{this.painting=false;if(this.canvas.hasPointerCapture(e.pointerId))this.canvas.releasePointerCapture(e.pointerId);};this.canvas.addEventListener("pointerup",up,{signal});this.canvas.addEventListener("pointercancel",up,{signal});}
    range(q:string,fn:(v:number)=>void){this.querySelector<HTMLInputElement>(q)?.addEventListener("input",e=>fn(Number((e.currentTarget as HTMLInputElement).value)),{signal:this.aborter.signal});}
    load(name:Preset){this.preset=name;this.temperature=name==="ordered"?1.45:name==="hot"?4:TC;const input=this.querySelector<HTMLInputElement>("[data-temperature]");if(input)input.value=String(this.temperature);this.text("[data-temperature-value]",this.temperature.toFixed(3));if(name==="ordered")this.spins.fill(1);else this.randomize();this.configure();this.resetHistory();this.draw();}
    configure(){const [title,description]=ISING_INFO[this.preset];this.text("[data-title]",title);this.text("[data-description]",description);this.text("[data-reading-1]",`T/Tc = ${(this.temperature/TC).toFixed(3)} · exact Tc = ${TC.toFixed(6)}.`);}
    random(){let x=this.rngState;x^=x<<13;x^=x>>>17;x^=x<<5;this.rngState=x>>>0;return this.rngState/4294967296;}
    randomize(){for(let i=0;i<this.spins.length;i++)this.spins[i]=this.random()<.5?-1:1;this.cluster.fill(0);this.lastCluster=0;this.draw();}
    index(x:number,y:number){return((y+this.rows)%this.rows)*this.cols+(x+this.cols)%this.cols}
    metropolisSweep(){const n=this.spins.length;this.cluster.fill(0);for(let k=0;k<n;k++){const i=Math.floor(this.random()*n),x=i%this.cols,y=Math.floor(i/this.cols),s=this.spins[i],sum=this.spins[this.index(x-1,y)]+this.spins[this.index(x+1,y)]+this.spins[this.index(x,y-1)]+this.spins[this.index(x,y+1)],dE=2*s*(sum+this.field);if(dE<=0||this.random()<Math.exp(-dE/this.temperature)){this.spins[i]=-s;this.cluster[i]=1;}}}
    wolffStep(){this.cluster.fill(0);const seed=Math.floor(this.random()*this.spins.length),spin=this.spins[seed],p=1-Math.exp(-2/this.temperature),stack=[seed];this.cluster[seed]=1;let size=0;while(stack.length){const i=stack.pop()!,x=i%this.cols,y=Math.floor(i/this.cols);size++;for(const j of [this.index(x-1,y),this.index(x+1,y),this.index(x,y-1),this.index(x,y+1)])if(!this.cluster[j]&&this.spins[j]===spin&&this.random()<p){this.cluster[j]=1;stack.push(j);}}for(let i=0;i<this.spins.length;i++)if(this.cluster[i])this.spins[i]=-this.spins[i];this.lastCluster=size;}
    step(){if(this.algorithm==="wolff"&&Math.abs(this.field)<.001){for(let k=0;k<this.sweeps;k++)this.wolffStep();}else for(let k=0;k<this.sweeps;k++)this.metropolisSweep();this.measureTick++;if(this.measureTick%2===0)this.measure();}
    observables(){let m=0,e=0;for(let y=0;y<this.rows;y++)for(let x=0;x<this.cols;x++){const i=this.index(x,y),s=this.spins[i];m+=s;e-=s*(this.spins[this.index(x+1,y)]+this.spins[this.index(x,y+1)]);e-=this.field*s;}const n=this.spins.length;return{m:m/n,e:e/n}}
    measure(){const o=this.observables();this.mHistory.push(o.m);this.eHistory.push(o.e);if(this.mHistory.length>220){this.mHistory.shift();this.eHistory.shift();}this.updateMetrics(o);}
    updateMetrics(o=this.observables()){const mean=this.mHistory.reduce((s,x)=>s+x,0)/(this.mHistory.length||1),mean2=this.mHistory.reduce((s,x)=>s+x*x,0)/(this.mHistory.length||1),chi=this.spins.length/this.temperature*Math.max(0,mean2-mean*mean);this.text("[data-magnetization]",o.m.toFixed(3));this.text("[data-energy]",o.e.toFixed(3));this.text("[data-susceptibility]",chi.toFixed(2));this.text("[data-reading-2]",this.algorithm==="wolff"?`Last cluster: ${this.lastCluster.toLocaleString()} spins · nonlocal updates suppress critical slowing down.`:`Acceptance is governed locally by min(1, exp(−ΔE/T)); χ uses recent magnetization variance.`);}
    resetHistory(){this.mHistory=[];this.eHistory=[];this.measureTick=0;this.measure();}
    paint(e:PointerEvent){const r=this.canvas.getBoundingClientRect(),top=this.height*.76,x=Math.floor((e.clientX-r.left)/this.width*this.cols),y=Math.floor((e.clientY-r.top)/top*this.rows);if(x<0||x>=this.cols||y<0||y>=this.rows)return;const radius=3;this.cluster.fill(0);for(let dy=-radius;dy<=radius;dy++)for(let dx=-radius;dx<=radius;dx++)if(dx*dx+dy*dy<=radius*radius){const i=this.index(x+dx,y+dy);this.spins[i]=this.paintSpin;this.cluster[i]=1;}this.resetHistory();this.draw();}
    animate(t:number){if(this.playing&&t-this.last>28){this.last=t;this.step();this.draw();}this.frame=requestAnimationFrame(x=>this.animate(x));}
    layout(){const r=this.canvas.getBoundingClientRect();if(!r.width)return;const d=Math.min(devicePixelRatio||1,2);this.width=r.width;this.height=r.height;this.canvas.width=Math.round(r.width*d);this.canvas.height=Math.round(r.height*d);this.ctx.setTransform(d,0,0,d,0,0);this.draw();}
    draw(){if(!this.width)return;const c=this.ctx,top=this.height*.76,off=document.createElement("canvas");off.width=this.cols;off.height=this.rows;const oc=off.getContext("2d")!,im=oc.createImageData(this.cols,this.rows),d=im.data,dark=document.documentElement.dataset.theme==="dark",up=dark?[82,197,218]:[75,63,214],down=dark?[243,99,70]:[200,64,26];for(let i=0;i<this.spins.length;i++){const col=this.spins[i]>0?up:down,k=i*4,boost=this.cluster[i]?1.18:1;d[k]=Math.min(255,col[0]*boost);d[k+1]=Math.min(255,col[1]*boost);d[k+2]=Math.min(255,col[2]*boost);d[k+3]=255;}oc.putImageData(im,0,0);c.imageSmoothingEnabled=false;c.drawImage(off,0,0,this.width,top);c.imageSmoothingEnabled=true;c.strokeStyle=this.css("--glass-border");c.beginPath();c.moveTo(0,top);c.lineTo(this.width,top);c.stroke();this.drawHistory(top+15,this.height-top-30);}
    drawHistory(y:number,h:number){const c=this.ctx,pad=25,w=this.width-pad*2;c.fillStyle=this.css("--paper-sunken");c.fillRect(0,y-15,this.width,h+30);c.strokeStyle=this.css("--rule");c.strokeRect(pad,y,w,h);const line=(values:number[],color:string,min:number,max:number)=>{if(values.length<2)return;c.strokeStyle=color;c.lineWidth=1.4;c.beginPath();values.forEach((v,n)=>{const x=pad+n/Math.max(1,values.length-1)*w,py=y+h-(v-min)/(max-min)*h;n?c.lineTo(x,py):c.moveTo(x,py);});c.stroke();};line(this.mHistory,this.css("--math-a"),-1,1);line(this.eHistory,this.css("--math-b"),-2.5,.5);c.fillStyle=this.css("--ink-faint");c.font="8px IBM Plex Mono";c.fillText("m(t) · e(t)",pad+6,y+12);}
    css(n:string){return getComputedStyle(this).getPropertyValue(n).trim()}text(q:string,v:string){const e=this.querySelector(q);if(e)e.textContent=v}
  }
  if(!customElements.get("ising-laboratory"))customElements.define("ising-laboratory",IsingLaboratory);
</script>

<style>ising-laboratory{display:block}.math-stage canvas{cursor:crosshair;image-rendering:pixelated}.math-button.active{color:var(--paper);background:var(--ink)}</style>

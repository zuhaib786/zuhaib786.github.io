---
type Kind = "storage" | "raft" | "concurrency" | "cache" | "transactions" | "compiler" | "allocator" | "tcp" | "eventloop" | "backprop" | "gpu" | "retry";

interface Props { kind: Kind }

const catalog: Record<Kind, { name: string; description: string; modes: string[]; fault: string; hint: string; metrics: string[] }> = {
  storage: { name: "LSM write path", description: "Follow a write from the client through durability, memory, immutable files, and compaction.", modes: ["WAL + fsync", "Group commit", "No WAL"], fault: "Crash + recover", hint: "Acknowledge only what can survive a crash", metrics: ["Acknowledged", "Durable", "SSTables"] },
  raft: { name: "Raft consensus", description: "Watch elections, replicated logs, quorum acknowledgements, and leader replacement across five nodes.", modes: ["Stable network", "Slow follower", "Split network"], fault: "Drop leader", hint: "A majority can progress; a minority cannot commit", metrics: ["Term", "Committed", "Messages"] },
  concurrency: { name: "Thread interleaving", description: "Schedule three workers instruction by instruction and see when shared state remains safe—or does not.", modes: ["Mutex", "Channel", "Unsynchronised"], fault: "Force deadlock", hint: "Correctness depends on the order between instructions", metrics: ["Counter", "Operations", "Blocked"] },
  cache: { name: "Memory hierarchy", description: "Trace addresses through cache lines and compare locality under different traversal patterns.", modes: ["Row major", "Column major", "Random access"], fault: "Flush caches", hint: "Nearby addresses usually share the same cache line", metrics: ["L1 hit rate", "L2 hit rate", "RAM reads"] },
  transactions: { name: "Transaction schedules", description: "Interleave two transfers and observe visibility, versioning, conflicts, and rollback.", modes: ["Read committed", "Snapshot isolation", "Serializable"], fault: "Inject conflict", hint: "The same operations can produce different outcomes", metrics: ["Commits", "Aborts", "Versions"] },
  compiler: { name: "Compiler pipeline", description: "Transform a tiny expression from source text into tokens, syntax, bytecode, and a running stack machine.", modes: ["Baseline", "Constant fold", "Trace VM"], fault: "Insert syntax error", hint: "Every stage makes a different promise", metrics: ["Tokens", "Instructions", "Stack top"] },
  allocator: { name: "Heap allocator", description: "Allocate and release blocks while watching free lists, splits, coalescing, and fragmentation.", modes: ["First fit", "Best fit", "Buddy system"], fault: "Allocation burst", hint: "Free memory is not always usable memory", metrics: ["Used bytes", "Largest free", "Fragmentation"] },
  tcp: { name: "TCP congestion control", description: "Send a byte stream through a lossy path and watch acknowledgements shape the congestion window.", modes: ["Reno", "CUBIC", "BBR sketch"], fault: "Drop packet", hint: "Loss and delay are signals about the path", metrics: ["Congestion wnd", "Delivered", "Retransmits"] },
  eventloop: { name: "Event loop", description: "Move work between the call stack, timers, I/O callbacks, and the microtask queue one turn at a time.", modes: ["Browser order", "Fair queues", "Cooperative"], fault: "Queue CPU task", hint: "Microtasks drain before the next task begins", metrics: ["Completed", "Queued", "Max wait"] },
  backprop: { name: "Neural backpropagation", description: "Run a tiny network forward, propagate error backward, then update each weighted connection.", modes: ["SGD", "Momentum", "Adam"], fault: "Perturb weights", hint: "Credit flows backward from the loss", metrics: ["Loss", "Accuracy", "Epoch"] },
  gpu: { name: "GPU compute dispatch", description: "Dispatch workgroups over data and compare coalesced access, striding, and branch divergence.", modes: ["Coalesced", "Strided", "Divergent"], fault: "Inject branch", hint: "A warp advances together even when lanes disagree", metrics: ["Cycles", "Memory txns", "Utilisation"] },
  retry: { name: "Retry storm", description: "Overload a service and compare immediate retries, exponential backoff, and a circuit breaker.", modes: ["Immediate retry", "Backoff + jitter", "Circuit breaker"], fault: "Degrade service", hint: "Retries spend capacity while the system is weakest", metrics: ["Queue depth", "Completed", "Load amp."] },
};

const { kind } = Astro.props;
const item = catalog[kind];
---

<systems-laboratory data-kind={kind}>
  <section class="instrument systems-lab" aria-label={`Interactive ${item.name} simulator`}>
    <div class="instrument-tabs">
      {item.modes.map((mode, index) => <button class:list={{ active: index === 0 }} data-mode={index}>{mode}</button>)}
    </div>
    <div class="instrument-status">
      <span><strong data-state>Ready</strong> · <span data-message>Step once or start the simulation</span></span>
      <span class="hint">{item.hint}</span>
    </div>
    <div class="systems-layout">
      <div class="systems-canvas">
        <canvas data-canvas aria-label={`${item.name} state diagram`}></canvas>
        <span class="phase label" data-phase>Initial state</span>
      </div>
      <aside>
        <p class="label label--accent">Live model</p>
        <h2>{item.name}</h2>
        <p>{item.description}</p>
        <div class="instrument-metrics">
          {item.metrics.map((metric, index) => <div><span data-metric={index}>0</span><small>{metric}</small></div>)}
        </div>
        <div class="event-log">
          <p class="label">Event trace</p>
          <ol data-log><li>Model initialised</li></ol>
        </div>
      </aside>
    </div>
    <div class="instrument-toolbar">
      <button class="instrument-action primary" data-run>Run</button>
      <button class="instrument-action" data-step>Step</button>
      <button class="instrument-action danger" data-fault>{item.fault}</button>
      <button class="instrument-action" data-reset>Reset</button>
      <label class="instrument-range"><span>Clock <b data-speed-label>1.0×</b></span><input data-speed type="range" min="1" max="100" value="46" /></label>
    </div>
  </section>
</systems-laboratory>

<script>
  type Kind = "storage" | "raft" | "concurrency" | "cache" | "transactions" | "compiler" | "allocator" | "tcp" | "eventloop" | "backprop" | "gpu" | "retry";
  type Block = { start:number; size:number; free:boolean; id:number };
  type Packet = { seq:number; x:number; lost:boolean; ack:boolean };
  type Task = { name:string; age:number; cost:number; kind:string };
  type Theme = { ink:string; soft:string; faint:string; paper:string; raised:string; rule:string; accent:string; accent2:string; good:string; warn:string; bad:string; grid:string };

  const MODE_DESCRIPTIONS: Record<Kind, string[]> = {
    storage: ["Each acknowledgement waits for a durable log record.", "Several writes share one fsync before acknowledgement.", "Fast acknowledgements can disappear when memory is lost."],
    raft: ["Messages arrive normally and the leader maintains authority.", "One follower receives replication several turns late.", "A partition isolates two nodes from the majority."],
    concurrency: ["A mutex makes the read–modify–write sequence atomic.", "Workers send increments to a single owning thread.", "Reads and writes may interleave and lose updates."],
    cache: ["Sequential elements reuse each fetched cache line.", "A large stride touches a new line on most accesses.", "Unpredictable addresses defeat spatial locality."],
    transactions: ["Statements see values committed before each read.", "Each transaction reads from its starting snapshot.", "Conflicting schedules are rejected before commit."],
    compiler: ["Emit direct stack-machine instructions for the source.", "Evaluate constant subexpressions before bytecode emission.", "Keep the baseline program and expose each VM instruction."],
    allocator: ["Take the first free block large enough for the request.", "Search for the smallest block that satisfies the request.", "Split power-of-two partners and merge buddies on free."],
    tcp: ["Grow additively and halve the window after loss.", "Use a cubic growth curve after the last congestion event.", "Estimate a bandwidth-delay product instead of treating loss alone as congestion."],
    eventloop: ["Drain microtasks, then take the oldest timer or I/O task.", "Alternate queue classes to keep one source from monopolising turns.", "Long work yields in small slices so other tasks can run."],
    backprop: ["Apply the current gradient directly to every weight.", "Accumulate a velocity that smooths successive gradients.", "Scale updates using running first and second moments."],
    gpu: ["Adjacent lanes read adjacent addresses in few transactions.", "Lanes step through memory with a costly stride.", "Opposing branches serialise lanes within each warp."],
    retry: ["Every failed request retries on the following tick.", "Failures wait exponentially longer with deterministic jitter.", "Repeated failures open the circuit and shed requests temporarily."],
  };

  class SystemsLaboratory extends HTMLElement {
    kind:Kind="storage"; mode=0; model:any={}; running=false; frame=0; last=0; elapsed=0; width=0; height=0;
    canvas!:HTMLCanvasElement; ctx!:CanvasRenderingContext2D; resize?:ResizeObserver; themeObserver?:MutationObserver; aborter=new AbortController(); logs:string[]=[]; seed=7831;

    connectedCallback(){
      this.kind=(this.dataset.kind||"storage") as Kind; this.canvas=this.querySelector("[data-canvas]") as HTMLCanvasElement;
      const context=this.canvas.getContext("2d"); if(!context)return; this.ctx=context; this.bind();
      this.resize=new ResizeObserver(()=>this.layout()); this.resize.observe(this.canvas);
      this.themeObserver=new MutationObserver(()=>this.draw()); this.themeObserver.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});
      this.reset(); this.layout(); this.frame=requestAnimationFrame(t=>this.animate(t));
    }
    disconnectedCallback(){cancelAnimationFrame(this.frame);this.resize?.disconnect();this.themeObserver?.disconnect();this.aborter.abort();}
    bind(){const signal=this.aborter.signal;
      this.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(button=>button.addEventListener("click",()=>{this.mode=Number(button.dataset.mode);this.querySelectorAll("[data-mode]").forEach(x=>x.classList.toggle("active",x===button));this.reset();this.message("Mode changed",MODE_DESCRIPTIONS[this.kind][this.mode]);},{signal}));
      this.querySelector("[data-run]")?.addEventListener("click",()=>this.toggle(),{signal});
      this.querySelector("[data-step]")?.addEventListener("click",()=>{this.running=false;this.updateRun();this.step();},{signal});
      this.querySelector("[data-fault]")?.addEventListener("click",()=>this.fault(),{signal});
      this.querySelector("[data-reset]")?.addEventListener("click",()=>this.reset(),{signal});
      this.querySelector<HTMLInputElement>("[data-speed]")?.addEventListener("input",()=>this.text("[data-speed-label]",`${this.speed().toFixed(1)}×`),{signal});
    }
    random(){this.seed=(this.seed*1664525+1013904223)>>>0;return this.seed/4294967296;}
    speed(){const v=Number(this.querySelector<HTMLInputElement>("[data-speed]")?.value||46);return .35+v/42;}
    toggle(){this.running=!this.running;this.updateRun();this.message(this.running?"Running":"Paused",this.running?"The clock is advancing automatically":"Use Step to inspect the next transition");}
    updateRun(){const button=this.querySelector<HTMLButtonElement>("[data-run]");if(button){button.textContent=this.running?"Pause":"Run";button.classList.toggle("active",this.running);}}
    reset(){this.running=false;this.updateRun();this.logs=[];this.seed=7831+this.mode*991;
      switch(this.kind){
        case "storage":this.model={tick:0,phase:0,writes:0,durable:0,mem:0,wal:0,sst:2,compactions:0,crashed:false,pending:0};break;
        case "raft":this.model={tick:0,term:3,leader:0,commit:2,messages:0,partition:new Set<number>(),election:0,nodes:Array.from({length:5},(_,i)=>({role:i===0?"leader":"follower",term:3,log:2,commit:2,delay:0}))};break;
        case "concurrency":this.model={tick:0,counter:0,ops:0,owner:-1,queue:0,deadlock:false,reads:[0,0,0],threads:Array.from({length:3},(_,i)=>({pc:0,state:"ready",done:0,name:`T${i+1}`}))};break;
        case "cache":this.model={tick:0,index:0,l1:[],l2:[],l1hits:0,l2hits:0,misses:0,address:0,line:0,matrix:Array(64).fill(0)};break;
        case "transactions":this.model={tick:0,phase:0,x:50,y:50,a:{read:0,write:0,state:"active"},b:{read:0,write:0,state:"active"},commits:0,aborts:0,versions:[{x:50,y:50,id:0}],conflict:false};break;
        case "compiler":this.model={tick:0,stage:0,source:"let total = (4 + 2) * 3",tokens:[],ast:[],code:[],stack:[],ip:0,error:false,result:null};break;
        case "allocator":this.model={tick:0,next:1,blocks:[{start:0,size:256,free:true,id:0}] as Block[],requests:[36,20,52,16,28,44],at:0,burst:0,failed:0};break;
        case "tcp":this.model={tick:0,next:1,acked:0,cwnd:2,inflight:[] as Packet[],delivered:0,retransmits:0,loseNext:false,ssthresh:8,rtt:0,history:[2]};break;
        case "eventloop":this.model={tick:0,completed:0,maxWait:0,stack:null as Task|null,micro:[{name:"promise A",age:0,cost:1,kind:"micro"}],timers:[{name:"timer 20ms",age:0,cost:1,kind:"timer"}],io:[{name:"fetch callback",age:0,cost:1,kind:"io"}],turn:0};break;
        case "backprop":this.model={tick:0,phase:0,epoch:0,sample:0,loss:1,accuracy:.25,inputs:[[0,0],[0,1],[1,0],[1,1]],targets:[0,1,1,0],w:[.35,-.22,.18,.41,.27,-.31,.44,-.38],velocity:Array(8).fill(0),m:Array(8).fill(0),v:Array(8).fill(0),activations:[0,0,0,0,0],grads:Array(8).fill(0),perturbed:false};break;
        case "gpu":this.model={tick:0,group:0,phase:0,cycles:0,transactions:0,active:32,total:32,branch:false,cells:Array.from({length:48},()=>0)};break;
        case "retry":this.model={tick:0,capacity:6,baseCapacity:6,degraded:0,queue:[],completed:0,attempts:0,arrivals:0,failed:0,circuit:0,history:[0]};break;
      }
      this.log("Model initialised");this.message("Ready",MODE_DESCRIPTIONS[this.kind][this.mode]);this.phase("Initial state");this.update();this.draw();
    }
    step(){switch(this.kind){case"storage":this.stepStorage();break;case"raft":this.stepRaft();break;case"concurrency":this.stepConcurrency();break;case"cache":this.stepCache();break;case"transactions":this.stepTransactions();break;case"compiler":this.stepCompiler();break;case"allocator":this.stepAllocator();break;case"tcp":this.stepTcp();break;case"eventloop":this.stepEventLoop();break;case"backprop":this.stepBackprop();break;case"gpu":this.stepGpu();break;case"retry":this.stepRetry();break;}this.update();this.draw();}
    fault(){switch(this.kind){
      case"storage":{const lost=Math.max(0,this.model.writes-this.model.durable);this.model.writes=this.model.durable;this.model.mem=0;this.model.pending=0;this.model.crashed=true;this.log(`Crash: ${lost} volatile write${lost===1?"":"s"} lost`);break;}
      case"raft":{const m=this.model;if(m.leader>=0){m.partition.add(m.leader);m.nodes[m.leader].role="isolated";this.log(`Leader N${m.leader+1} disconnected`);m.leader=-1;m.election=0;}break;}
      case"concurrency":this.model.deadlock=true;this.model.threads.forEach((t:any)=>t.state="waiting");this.log("Circular wait injected");break;
      case"cache":this.model.l1=[];this.model.l2=[];this.log("L1 and L2 invalidated");break;
      case"transactions":this.model.conflict=true;this.log("Concurrent write conflict injected");break;
      case"compiler":this.model.source="let total = (4 + ) * 3";this.model.error=true;this.model.stage=0;this.log("Removed an operand from source");break;
      case"allocator":this.model.burst=5;this.log("Five allocations queued at once");break;
      case"tcp":{const packet=this.model.inflight[0];if(packet)packet.lost=true;else this.model.loseNext=true;this.log(packet?`Packet ${packet.seq} dropped in flight`:"Next packet marked for loss");break;}
      case"eventloop":this.model.timers.unshift({name:"CPU loop",age:0,cost:8,kind:"timer"});this.log("Long CPU-bound task queued");break;
      case"backprop":this.model.w=this.model.w.map((w:number,i:number)=>w+(i%2?.9:-.8));this.model.perturbed=true;this.log("Weights perturbed away from solution");break;
      case"gpu":this.model.branch=true;this.log("Data-dependent branch enabled");break;
      case"retry":this.model.degraded=10;this.model.capacity=1;this.log("Service capacity fell from 6 to 1");break;
    }this.message("Event injected","Advance the clock to observe the consequence");this.update();this.draw();}

    stepStorage(){const m=this.model;m.tick++;if(m.crashed){m.crashed=false;m.wal=m.durable;m.phase=5;this.phase("Recovery · replay durable WAL");this.log(`Recovered ${m.durable} committed records`);return;}m.phase=(m.phase+1)%5;
      if(m.phase===1){m.writes++;m.pending++;this.phase("01 · client write");this.log(`Write #${m.writes} entered the engine`);if(this.mode===2){m.pending=0;this.log("Acknowledged before durability");}}
      if(m.phase===2){if(this.mode===2)this.phase("02 · WAL bypassed");else{m.wal++;this.phase("02 · append WAL");}}
      if(m.phase===3){this.phase("03 · durability barrier");if(this.mode===0||(this.mode===1&&m.pending>=2)){m.durable=m.writes;m.mem+=m.pending;m.pending=0;this.log(`fsync made ${m.durable} writes durable`);}else if(this.mode===2)m.mem++;}
      if(m.phase===4){this.phase("04 · memtable / flush");if(m.mem>=4){m.sst++;m.mem=0;if(this.mode===2)m.durable=m.writes;this.log(`Flushed immutable table L0-${m.sst}`);}if(m.sst>=5){m.sst=3;m.compactions++;this.log("Compaction merged overlapping SSTables");}}
      if(m.phase===0)this.phase("05 · manifest update");
    }
    stepRaft(){const m=this.model;m.tick++;if(m.leader<0){m.election++;const available=m.nodes.map((_:any,i:number)=>i).filter((i:number)=>!m.partition.has(i));this.phase(available.length>=3?`Election timeout · round ${m.election}`:`No quorum · only ${available.length}/5 connected`);if(m.election>=2&&available.length>=3){const candidate=available[0];m.term++;m.leader=candidate;m.nodes.forEach((n:any,i:number)=>{if(!m.partition.has(i)){n.term=m.term;n.role=i===candidate?"leader":"follower";}});this.log(`N${candidate+1} won term ${m.term} with a quorum`);}else if(m.election===2&&available.length<3)this.log("Election stalled without a majority");return;}
      this.phase(m.tick%3===1?"Append client command":m.tick%3===2?"Replicate log entries":"Commit on quorum");m.messages+=4-m.partition.size;
      if(m.tick%3===1){m.nodes[m.leader].log++;this.log(`Leader appended entry ${m.nodes[m.leader].log}`);}else if(m.tick%3===2){m.nodes.forEach((n:any,i:number)=>{if(i!==m.leader&&!m.partition.has(i)){if(this.mode===1&&i===4){n.delay=(n.delay+1)%3;if(n.delay)return;}n.log=m.nodes[m.leader].log;}});}else{const index=m.nodes[m.leader].log;const votes=m.nodes.filter((n:any,i:number)=>!m.partition.has(i)&&n.log>=index).length;if(votes>=3){m.commit=index;m.nodes.forEach((n:any,i:number)=>{if(!m.partition.has(i))n.commit=index;});this.log(`Entry ${index} committed by ${votes}/5`);}}
      if(this.mode===2&&m.tick===4){m.partition.add(3);m.partition.add(4);this.log("N4–N5 entered minority partition");}
    }
    stepConcurrency(){const m=this.model;m.tick++;if(m.deadlock){this.phase("Deadlock · every worker waits");this.log("No runnable thread");return;}const i=(m.tick-1)%3,t=m.threads[i];
      if(this.mode===1){m.queue++;m.counter++;m.ops++;t.done++;this.phase(`${t.name} sends +1 · owner receives`);this.log(`${t.name} sent message ${m.ops}`);return;}
      if(t.pc===0){if(this.mode===0&&m.owner>=0&&m.owner!==i){t.state="waiting";this.phase(`${t.name} waits for mutex`);return;}if(this.mode===0)m.owner=i;t.state="running";m.reads[i]=m.counter;t.pc=1;this.phase(`${t.name} reads counter = ${m.counter}`);}
      else if(t.pc===1){m.reads[i]++;t.pc=2;this.phase(`${t.name} computes ${m.reads[i]}`);}
      else{const before=m.counter;m.counter=m.reads[i];m.ops++;t.done++;t.pc=0;t.state="ready";if(this.mode===0)m.owner=-1;this.phase(`${t.name} writes counter = ${m.counter}`);this.log(before>=m.counter?`Lost update: ${before} → ${m.counter}`:`${t.name} committed increment ${m.ops}`);}
    }
    stepCache(){const m=this.model;m.tick++;let index;if(this.mode===0)index=m.index%64;else if(this.mode===1)index=(m.index%8)*8+Math.floor(m.index/8)%8;else index=Math.floor(this.random()*64);m.index++;m.address=index*4;m.line=Math.floor(m.address/16);m.matrix[index]++;
      const l1At=m.l1.indexOf(m.line),l2At=m.l2.indexOf(m.line);if(l1At>=0){m.l1hits++;m.l1.splice(l1At,1);m.l1.unshift(m.line);this.phase(`L1 hit · line ${m.line}`);}else if(l2At>=0){m.l2hits++;m.l2.splice(l2At,1);m.l2.unshift(m.line);m.l1.unshift(m.line);m.l1=m.l1.slice(0,4);this.phase(`L2 hit · promote line ${m.line}`);}else{m.misses++;m.l2.unshift(m.line);m.l2=m.l2.slice(0,10);m.l1.unshift(m.line);m.l1=m.l1.slice(0,4);this.phase(`RAM read · fetch line ${m.line}`);this.log(`Loaded bytes ${m.line*16}–${m.line*16+15}`);}}
    stepTransactions(){const m=this.model;m.tick++;m.phase=(m.phase+1)%7;const snap=m.versions[0];
      if(m.phase===1){m.a.read=this.mode===0?m.x:snap.x;this.phase(`T1 reads X = ${m.a.read}`);}
      if(m.phase===2){m.b.read=this.mode===0?m.x:snap.x;this.phase(`T2 reads X = ${m.b.read}`);}
      if(m.phase===3){m.a.write=m.a.read+10;this.phase(`T1 stages X = ${m.a.write}`);}
      if(m.phase===4){m.b.write=m.b.read-5;this.phase(`T2 stages X = ${m.b.write}`);}
      if(m.phase===5){m.x=m.a.write;m.commits++;m.a.state="committed";m.versions.unshift({x:m.x,y:m.y,id:m.versions.length});this.phase("T1 commits");this.log(`T1 published version X=${m.x}`);}
      if(m.phase===6){if(this.mode===2||m.conflict){m.aborts++;m.b.state="aborted";m.conflict=false;this.phase("T2 aborts · write conflict");this.log("T2 rolled back to preserve serial order");}else{m.x=m.b.write;m.commits++;m.b.state="committed";m.versions.unshift({x:m.x,y:m.y,id:m.versions.length});this.phase("T2 commits");this.log(`T2 overwrote X with ${m.x}`);}}
      if(m.phase===0){m.a={read:0,write:0,state:"active"};m.b={read:0,write:0,state:"active"};this.phase("Begin a new concurrent schedule");}
    }
    stepCompiler(){const m=this.model;m.tick++;if(m.error&&m.stage===0){m.stage=1;this.phase("Lexer · tokens accepted");m.tokens=["let","total","=","(","4","+",")","*","3"];return;}if(m.error){m.stage=2;this.phase("Parser error · expected expression");if(m.tick%3===0)this.log("Compilation remains stopped at ')' after '+'");return;}m.stage=(m.stage+1)%5;
      if(m.stage===1){m.tokens=["let","total","=","(","4","+","2",")","*","3"];this.phase("Lexer · source → tokens");this.log(`Emitted ${m.tokens.length} tokens`);}
      if(m.stage===2){m.ast=["let","*","+","4","2","3"];this.phase("Parser · tokens → syntax tree");}
      if(m.stage===3){m.code=this.mode===1?["PUSH 18","STORE total"]:["PUSH 4","PUSH 2","ADD","PUSH 3","MUL","STORE total"];m.ip=0;m.stack=[];this.phase(this.mode===1?"Optimiser · folded constants":"Emitter · AST → bytecode");this.log(`Generated ${m.code.length} instructions`);}
      if(m.stage===4){if(!m.code.length)return;const ins=m.code[m.ip%m.code.length],parts=ins.split(" ");if(parts[0]==="PUSH")m.stack.push(Number(parts[1]));if(parts[0]==="ADD")m.stack.push(m.stack.splice(-2).reduce((a:number,b:number)=>a+b,0));if(parts[0]==="MUL")m.stack.push(m.stack.splice(-2).reduce((a:number,b:number)=>a*b,1));if(parts[0]==="STORE")m.result=m.stack.at(-1);m.ip++;this.phase(`VM · ${ins}`);if(m.ip<m.code.length){m.stage=3;}else this.log(`Program stored total = ${m.result}`);}
      if(m.stage===0){m.error=false;m.source="let total = (4 + 2) * 3";this.phase("Source buffer ready");}
    }

<measure-laboratory>
  <section class="lab" aria-label="Interactive solids-of-revolution laboratory">
    <div class="instrument-bar">
      <div class="run-state">
        <span class="signal" aria-hidden="true"></span>
        <span data-run-state>Sweeping…</span>
      </div>
      <div class="controls" aria-label="Laboratory controls">
        <div class="segments" aria-label="Generating region">
          <button type="button" data-shape="sphere" class="active">Sphere</button>
          <button type="button" data-shape="torus">Torus</button>
          <button type="button" data-shape="cone">Cone</button>
          <button type="button" data-shape="draw">Draw</button>
        </div>
        <button type="button" class="control-button active" data-play>Pause sweep</button>
        <button type="button" class="control-button" data-reset-axis>Reset axis</button>
      </div>
    </div>

    <div class="dashboard">
      <div class="plot-panel">
        <div class="pane">
          <div class="plot-title label">Generating plane · <em data-plane-hint>drag the axis</em></div>
          <canvas data-plane aria-label="2D generating region with draggable axis of rotation"></canvas>
        </div>
        <div class="pane">
          <div class="plot-title label">Solid of revolution · drag to orbit</div>
          <canvas data-solid aria-label="3D solid generated by the sweep"></canvas>
          <div class="sweep-strip">
            <span class="label" data-sweep-label>0°</span>
            <input type="range" min="0" max="360" step="1" value="0" data-sweep aria-label="Sweep angle in degrees" />
          </div>
        </div>
      </div>

      <div class="readout">
        <div class="readout-head">
          <div>
            <p class="label label--accent">Pappus's centroid theorems</p>
            <h2>measure = generator × centroid travel</h2>
          </div>
        </div>

        <div class="stats" aria-label="Generator measurements">
          <article>
            <span class="stat-value" data-area>—</span>
            <span class="stat-label">Region area A</span>
            <small><i class="chip chip-area"></i>centroid rides the inner ring</small>
          </article>
          <article>
            <span class="stat-value" data-length>—</span>
            <span class="stat-label">Boundary length L</span>
            <small><i class="chip chip-curve"></i>its own centroid — a different point</small>
          </article>
          <article>
            <span class="stat-value" data-sweep-deg>0°</span>
            <span class="stat-label">Sweep angle</span>
            <small data-sweep-note>A full turn is 2π</small>
          </article>
        </div>

        <div class="theorems">
          <article class="theorem" data-volume-card>
            <h3 class="label">Volume · area theorem</h3>
            <p class="formula">V = A · 2π<span class="chip-inline chip-area"></span>d̄ = <strong data-v-pappus>—</strong></p>
            <p class="cross-check">
              <span data-check-badge class="badge">✓</span>
              washer slices, computed independently: <strong data-v-washers>—</strong>
            </p>
            <p class="exact" data-v-exact hidden></p>
          </article>
          <article class="theorem" data-surface-card>
            <h3 class="label">Surface · curve theorem</h3>
            <p class="formula">S = L · 2π<span class="chip-inline chip-curve"></span>d̄ = <strong data-s-pappus>—</strong></p>
            <p class="exact" data-s-exact hidden></p>
          </article>
        </div>

        <p class="invalid-note" data-invalid hidden>
          The axis cuts through the region. Pappus's theorems need the axis
          outside the generator — drag it clear and the numbers return.
        </p>

        <section class="method">
          <h3 class="label">Method</h3>
          <p>
            Pappus of Alexandria, fourth century: the volume of a solid of
            revolution is the region's area times the distance its centroid
            travels; the surface is the boundary's length times the travel of
            the boundary's own centroid — two different points, marked with
            two different rings. The washer number is a genuinely independent
            computation (400 horizontal slices, each an annulus), so watching
            the two agree while you drag the axis is the theorem, live. Draw
            your own region and it still holds.
          </p>
        </section>
      </div>
    </div>
  </section>
</measure-laboratory>

<script>
  const TWO_PI = Math.PI * 2;
  const AXIS_EPS = 0.015; // boundary edges this close to the axis revolve to nothing

  type Pt = [number, number];
  type Shape = "sphere" | "torus" | "cone" | "draw";

  function presetRegion(shape: Shape): Pt[] {
    if (shape === "torus") {
      const pts: Pt[] = [];
      for (let i = 0; i < 48; i++) {
        const a = (i / 48) * TWO_PI;
        pts.push([0.85 + 0.35 * Math.cos(a), 0.35 * Math.sin(a)]);
      }
      return pts;
    }
    if (shape === "cone") return [[0, 0.75], [0.85, -0.75], [0, -0.75]];
    // sphere: semicircular region, flat side on the axis
    const pts: Pt[] = [];
    for (let i = 0; i <= 40; i++) {
      const a = -Math.PI / 2 + (i / 40) * Math.PI;
      pts.push([Math.cos(a), Math.sin(a)]);
    }
    return pts;
  }

  function polygonAreaCentroid(pts: Pt[]) {
    let a2 = 0, cx = 0, cy = 0;
    for (let i = 0; i < pts.length; i++) {
      const [x1, y1] = pts[i];
      const [x2, y2] = pts[(i + 1) % pts.length];
      const cross = x1 * y2 - x2 * y1;
      a2 += cross;
      cx += (x1 + x2) * cross;
      cy += (y1 + y2) * cross;
    }
    const area = a2 / 2;
    return { area: Math.abs(area), cx: cx / (6 * area), cy: cy / (6 * area) };
  }

  /** Length and centroid of the boundary, excluding edges lying on the axis
   *  (they revolve to nothing). */
  function curveStats(pts: Pt[], axis: number) {
    let L = 0, mx = 0, my = 0;
    for (let i = 0; i < pts.length; i++) {
      const p = pts[i];
      const q = pts[(i + 1) % pts.length];
      if (Math.abs(p[0] - axis) < AXIS_EPS && Math.abs(q[0] - axis) < AXIS_EPS) continue;
      const len = Math.hypot(q[0] - p[0], q[1] - p[1]);
      L += len;
      mx += ((p[0] + q[0]) / 2) * len;
      my += ((p[1] + q[1]) / 2) * len;
    }
    return L > 0 ? { L, cx: mx / L, cy: my / L } : { L: 0, cx: 0, cy: 0 };
  }

  /** Independent check: volume by 400 washer slices. */
  function washerVolume(pts: Pt[], axis: number, slices = 400) {
    let ymin = Infinity, ymax = -Infinity;
    for (const [, y] of pts) {
      ymin = Math.min(ymin, y);
      ymax = Math.max(ymax, y);
    }
    const dy = (ymax - ymin) / slices;
    let volume = 0;
    for (let s = 0; s < slices; s++) {
      const y = ymin + (s + 0.5) * dy;
      const xs: number[] = [];
      for (let i = 0; i < pts.length; i++) {
        const [x1, y1] = pts[i];
        const [x2, y2] = pts[(i + 1) % pts.length];
        if ((y1 <= y && y2 > y) || (y2 <= y && y1 > y)) {
          xs.push(x1 + ((y - y1) / (y2 - y1)) * (x2 - x1));
        }
      }
      xs.sort((a, b) => a - b);
      for (let k = 0; k + 1 < xs.length; k += 2) {
        const r1 = Math.abs(xs[k] - axis);
        const r2 = Math.abs(xs[k + 1] - axis);
        volume += Math.PI * Math.abs(r2 * r2 - r1 * r1) * dy;
      }
    }
    return volume;
  }

  class MeasureLaboratory extends HTMLElement {
    planeCanvas!: HTMLCanvasElement;
    solidCanvas!: HTMLCanvasElement;
    planeCtx!: CanvasRenderingContext2D;
    solidCtx!: CanvasRenderingContext2D;
    shape: Shape = "sphere";
    region: Pt[] = presetRegion("sphere");
    axis = 0;
    sweep = 0; // current sweep angle, radians
    playing = true;
    holdUntil = 0;
    yaw = -0.6;
    pitch = 0.42;
    idleSpin = true;
    draggingAxis = false;
    drawingRegion = false;
    orbiting = false;
    drawTrail: Pt[] = [];
    dragX = 0;
    dragY = 0;
    frame = 0;
    lastFrame = 0;
    aborter = new AbortController();
    resizeObserver?: ResizeObserver;
    themeObserver?: MutationObserver;
    // plane view window (world units)
    view = { x0: -1.45, x1: 1.65, y0: -1.15, y1: 1.15 };

    connectedCallback() {
      this.planeCanvas = this.querySelector("[data-plane]") as HTMLCanvasElement;
      this.solidCanvas = this.querySelector("[data-solid]") as HTMLCanvasElement;
      const planeCtx = this.planeCanvas.getContext("2d");
      const solidCtx = this.solidCanvas.getContext("2d");
      if (!planeCtx || !solidCtx) return;
      this.planeCtx = planeCtx;
      this.solidCtx = solidCtx;
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        this.playing = false;
        this.idleSpin = false;
        this.sweep = TWO_PI;
      }
      this.bind();
      this.resizeObserver = new ResizeObserver(() => this.layout());
      this.resizeObserver.observe(this.planeCanvas);
      this.themeObserver = new MutationObserver(() => this.renderAll());
      this.themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
      this.layout();
      this.updateReadout();
      this.syncPlayButton();
      this.frame = requestAnimationFrame((t) => this.tick(t));
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.frame);
      this.aborter.abort();
      this.resizeObserver?.disconnect();
      this.themeObserver?.disconnect();
    }

    bind() {
      const signal = this.aborter.signal;
      this.querySelectorAll<HTMLButtonElement>("[data-shape]").forEach((button) => {
        button.addEventListener("click", () => {
          this.shape = button.dataset.shape as Shape;
          this.querySelectorAll("[data-shape]").forEach((item) =>
            item.classList.toggle("active", item === button),
          );
          if (this.shape === "draw") {
            this.text("[data-plane-hint]", "draw a closed loop");
            this.setRunState("Draw a region on the plane", "idle");
          } else {
            this.region = presetRegion(this.shape);
            this.axis = 0;
            this.text("[data-plane-hint]", "drag the axis");
            this.restartSweep();
          }
          this.updateReadout();
          this.renderAll();
        }, { signal });
      });

      const play = this.querySelector<HTMLButtonElement>("[data-play]");
      play?.addEventListener("click", () => {
        this.playing = !this.playing;
        if (this.playing && this.sweep >= TWO_PI) this.sweep = 0;
        this.syncPlayButton();
      }, { signal });

      this.querySelector("[data-reset-axis]")?.addEventListener("click", () => {
        this.axis = 0;
        this.restartSweep();
        this.updateReadout();
        this.renderAll();
      }, { signal });

      const slider = this.querySelector<HTMLInputElement>("[data-sweep]");
      slider?.addEventListener("input", () => {
        this.sweep = (Number(slider.value) / 360) * TWO_PI;
        this.playing = false;
        this.syncPlayButton();
        this.renderSolid();
        this.syncSweepReadout(false);
      }, { signal });

      // Plane canvas: drag the axis, or draw a region in draw mode.
      this.planeCanvas.addEventListener("pointerdown", (event) => {
        const world = this.planeToWorld(event);
        if (Math.abs(this.worldToPlaneX(this.axis) - this.worldToPlaneX(world[0])) < 14 / this.planeScale()) {
          this.draggingAxis = true;
        } else if (this.shape === "draw") {
          this.drawingRegion = true;
          this.drawTrail = [world];
        } else {
          return;
        }
        this.planeCanvas.setPointerCapture(event.pointerId);
      }, { signal });
      this.planeCanvas.addEventListener("pointermove", (event) => {
        const world = this.planeToWorld(event);
        if (this.draggingAxis) {
          this.axis = Math.max(this.view.x0 + 0.1, Math.min(this.view.x1 - 0.1, world[0]));
          this.updateReadout();
          this.renderAll();
        } else if (this.drawingRegion) {
          const last = this.drawTrail[this.drawTrail.length - 1];
          if (Math.hypot(world[0] - last[0], world[1] - last[1]) > 0.035) {
            this.drawTrail.push(world);
            this.renderPlane();
          }
        } else {
          const near = Math.abs(this.worldToPlaneX(this.axis) - this.worldToPlaneX(world[0])) < 14 / this.planeScale();
          this.planeCanvas.style.cursor = near ? "ew-resize" : this.shape === "draw" ? "crosshair" : "default";
        }
      }, { signal });
      const releasePlane = (event: PointerEvent) => {
        if (this.drawingRegion && this.drawTrail.length > 7) {
          this.region = this.drawTrail.slice();
          this.restartSweep();
          this.updateReadout();
          this.renderAll();
        } else if (this.drawingRegion) {
          this.renderPlane(); // too small - discard the trail
        }
        this.draggingAxis = false;
        this.drawingRegion = false;
        this.drawTrail = [];
        if (this.planeCanvas.hasPointerCapture(event.pointerId)) {
          this.planeCanvas.releasePointerCapture(event.pointerId);
        }
      };
      this.planeCanvas.addEventListener("pointerup", releasePlane, { signal });
      this.planeCanvas.addEventListener("pointercancel", releasePlane, { signal });

      // Solid canvas: orbit the camera.
      this.solidCanvas.addEventListener("pointerdown", (event) => {
        this.orbiting = true;
        this.idleSpin = false;
        this.dragX = event.clientX;
        this.dragY = event.clientY;
        this.solidCanvas.setPointerCapture(event.pointerId);
      }, { signal });
      this.solidCanvas.addEventListener("pointermove", (event) => {
        if (!this.orbiting) return;
        this.yaw += (event.clientX - this.dragX) * 0.008;
        this.pitch = Math.max(-1.3, Math.min(1.3, this.pitch + (event.clientY - this.dragY) * 0.006));
        this.dragX = event.clientX;
        this.dragY = event.clientY;
        this.renderSolid();
      }, { signal });
      const releaseSolid = (event: PointerEvent) => {
        this.orbiting = false;
        if (this.solidCanvas.hasPointerCapture(event.pointerId)) {
          this.solidCanvas.releasePointerCapture(event.pointerId);
        }
      };
      this.solidCanvas.addEventListener("pointerup", releaseSolid, { signal });
      this.solidCanvas.addEventListener("pointercancel", releaseSolid, { signal });
    }

    restartSweep() {
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        this.sweep = TWO_PI;
        this.playing = false;
      } else {
        this.sweep = 0;
        this.playing = true;
      }
      this.syncPlayButton();
    }

    tick(time: number) {
      const elapsed = Math.min(time - (this.lastFrame || time), 50);
      this.lastFrame = time;
      if (!document.hidden) {
        let dirty = false;
        if (this.playing && time > this.holdUntil) {
          if (this.sweep < TWO_PI) {
            this.sweep = Math.min(TWO_PI, this.sweep + elapsed * 0.0011);
            if (this.sweep >= TWO_PI) this.holdUntil = time + 2400;
            dirty = true;
          } else {
            this.sweep = 0; // loop after the hold on the finished solid
            dirty = true;
          }
        }
        if (this.idleSpin && !this.orbiting) {
          this.yaw += elapsed * 0.00012;
          dirty = true;
        }
        if (dirty) {
          this.renderSolid();
          this.syncSweepReadout();
        }
      }
      this.frame = requestAnimationFrame((next) => this.tick(next));
    }

    // --- measurements ------------------------------------------------------

    axisValid() {
      let minX = Infinity, maxX = -Infinity;
      for (const [x] of this.region) {
        minX = Math.min(minX, x);
        maxX = Math.max(maxX, x);
      }
      return this.axis <= minX + AXIS_EPS || this.axis >= maxX - AXIS_EPS;
    }

    measure() {
      const { area, cx, cy } = polygonAreaCentroid(this.region);
      const curve = curveStats(this.region, this.axis);
      const dArea = Math.abs(cx - this.axis);
      const dCurve = Math.abs(curve.cx - this.axis);
      return {
        area, cx, cy, dArea,
        L: curve.L, ccx: curve.cx, ccy: curve.cy, dCurve,
        vPappus: area * TWO_PI * dArea,
        vWashers: washerVolume(this.region, this.axis),
        sPappus: curve.L * TWO_PI * dCurve,
      };
    }

    // --- plane (2D) rendering ----------------------------------------------

    /** Uniform world->pixel transform: one scale for both axes (a circle
     *  must render as a circle), letterboxed inside the canvas. */
    planeTransform() {
      const rect = this.planeCanvas.getBoundingClientRect();
      const spanX = this.view.x1 - this.view.x0;
      const spanY = this.view.y1 - this.view.y0;
      const s = Math.min(rect.width / spanX, rect.height / spanY);
      return {
        s,
        ox: (rect.width - spanX * s) / 2,
        oy: (rect.height - spanY * s) / 2,
        rect,
      };
    }

    planeScale() {
      return this.planeTransform().s;
    }

    worldToPlaneX(x: number) {
      const { s, ox } = this.planeTransform();
      return ox + (x - this.view.x0) * s;
    }

    worldToPlaneY(y: number) {
      const { s, oy, rect } = this.planeTransform();
      return rect.height - oy - (y - this.view.y0) * s;
    }

    planeToWorld(event: PointerEvent): Pt {
      const { s, ox, oy, rect } = this.planeTransform();
      const x = this.view.x0 + (event.clientX - rect.left - ox) / s;
      const y = this.view.y0 + (rect.height - oy - (event.clientY - rect.top)) / s;
      return [x, y];
    }

    renderPlane() {
      const ctx = this.planeCtx;
      const rect = this.planeCanvas.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      const w = rect.width, h = rect.height;
      ctx.clearRect(0, 0, w, h);
      const valid = this.axisValid();
      const m = this.measure();

      // Region (or the trail being drawn).
      const outline = this.drawingRegion && this.drawTrail.length > 1 ? this.drawTrail : this.region;
      ctx.beginPath();
      outline.forEach(([x, y], i) => {
        const px = this.worldToPlaneX(x), py = this.worldToPlaneY(y);
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      });
      if (!this.drawingRegion) ctx.closePath();
      ctx.fillStyle = this.css("--mm-region");
      if (!this.drawingRegion) ctx.fill();
      ctx.strokeStyle = this.css("--mm-boundary");
      ctx.lineWidth = 1.8;
      ctx.stroke();

      // The axis of rotation.
      const ax = this.worldToPlaneX(this.axis);
      ctx.strokeStyle = valid ? this.css("--mm-axis") : this.css("--mm-invalid");
      ctx.lineWidth = 2;
      ctx.setLineDash([7, 5]);
      ctx.beginPath();
      ctx.moveTo(ax, 0);
      ctx.lineTo(ax, h);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = valid ? this.css("--mm-axis") : this.css("--mm-invalid");
      ctx.font = "9px 'IBM Plex Mono', monospace";
      ctx.textAlign = "center";
      ctx.fillText("AXIS", ax, 12);

      if (this.drawingRegion) return;

      // Centroid of the region: distance bar + dot.
      const acx = this.worldToPlaneX(m.cx), acy = this.worldToPlaneY(m.cy);
      ctx.strokeStyle = this.css("--mm-centroid-area");
      ctx.lineWidth = 1;
      ctx.setLineDash([2, 4]);
      ctx.beginPath();
      ctx.moveTo(ax, acy);
      ctx.lineTo(acx, acy);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = this.css("--mm-centroid-area");
      ctx.beginPath();
      ctx.arc(acx, acy, 4, 0, TWO_PI);
      ctx.fill();
      ctx.textAlign = "left";
      ctx.fillText(`d̄ = ${m.dArea.toFixed(3)}`, Math.min(ax, acx) + Math.abs(acx - ax) / 2 - 22, acy - 6);

      // Centroid of the boundary curve: a visibly different point.
      const ccx = this.worldToPlaneX(m.ccx), ccy = this.worldToPlaneY(m.ccy);
      ctx.strokeStyle = this.css("--mm-centroid-curve");
      ctx.lineWidth = 1;
      ctx.setLineDash([2, 4]);
      ctx.beginPath();
      ctx.moveTo(ax, ccy);
      ctx.lineTo(ccx, ccy);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.strokeStyle = this.css("--mm-centroid-curve");
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.moveTo(ccx - 5, ccy);
      ctx.lineTo(ccx + 5, ccy);
      ctx.moveTo(ccx, ccy - 5);
      ctx.lineTo(ccx, ccy + 5);
      ctx.stroke();
      ctx.fillStyle = this.css("--mm-centroid-curve");
      ctx.fillText(`d̄ = ${m.dCurve.toFixed(3)}`, Math.min(ax, ccx) + Math.abs(ccx - ax) / 2 - 22, ccy + 14);
    }

    // --- solid (3D) rendering ----------------------------------------------

    project3(x: number, y: number, z: number, w: number, h: number) {
      // World: X right, Y up, Z toward viewer before rotation.
      const cy = Math.cos(this.yaw), sy = Math.sin(this.yaw);
      const cp = Math.cos(this.pitch), sp = Math.sin(this.pitch);
      const x1 = x * cy + z * sy;
      const z1 = -x * sy + z * cy;
      const y2 = y * cp - z1 * sp;
      const z2 = y * sp + z1 * cp;
      const f = 4.2;
      const scale = (Math.min(w, h) * 0.34 * f) / (f + z2);
      return { x: w / 2 + x1 * scale, y: h / 2 - y2 * scale, z: z2 };
    }

    /** Boundary edges that actually revolve (not on the axis), as a list of
     *  polylines in (radius, height) form. */
    revolvingCurves(): { r: number; y: number }[][] {
      const curves: { r: number; y: number }[][] = [];
      let current: { r: number; y: number }[] = [];
      const pts = this.region;
      for (let i = 0; i <= pts.length; i++) {
        const p = pts[i % pts.length];
        const onAxis = Math.abs(p[0] - this.axis) < AXIS_EPS;
        const point = { r: p[0] - this.axis, y: p[1] };
        if (onAxis && current.length) {
          current.push(point); // meridian meets the axis - close the strip there
          curves.push(current);
          current = [];
        } else if (!onAxis) {
          current.push(point);
        }
      }
      if (current.length > 1) curves.push(current);
      return curves.filter((c) => c.length > 1);
    }

    renderSolid() {
      const ctx = this.solidCtx;
      const rect = this.solidCanvas.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      const w = rect.width, h = rect.height;
      ctx.clearRect(0, 0, w, h);
      const m = this.measure();
      const faceRgb = this.hexToRgb(this.css("--mm-face"));
      const sweep = Math.max(this.sweep, 0.03);
      const angleStep = TWO_PI / 44;
      const steps = Math.max(2, Math.ceil(sweep / angleStep));

      // Vertical axis line.
      const axTop = this.project3(0, 1.25, 0, w, h);
      const axBottom = this.project3(0, -1.25, 0, w, h);
      ctx.strokeStyle = this.css("--mm-axis-3d");
      ctx.lineWidth = 1;
      ctx.setLineDash([6, 5]);
      ctx.beginPath();
      ctx.moveTo(axTop.x, axTop.y);
      ctx.lineTo(axBottom.x, axBottom.y);
      ctx.stroke();
      ctx.setLineDash([]);

      // Surface quads, painter-sorted.
      type Quad = { pts: { x: number; y: number }[]; z: number; shade: number };
      const quads: Quad[] = [];
      for (const curve of this.revolvingCurves()) {
        for (let j = 0; j < steps; j++) {
          const a0 = (j / steps) * sweep;
          const a1 = ((j + 1) / steps) * sweep;
          for (let i = 0; i + 1 < curve.length; i++) {
            const p = curve[i], q = curve[i + 1];
            const corners = [
              [p.r * Math.cos(a0), p.y, p.r * Math.sin(a0)],
              [q.r * Math.cos(a0), q.y, q.r * Math.sin(a0)],
              [q.r * Math.cos(a1), q.y, q.r * Math.sin(a1)],
              [p.r * Math.cos(a1), p.y, p.r * Math.sin(a1)],
            ];
            const projected = corners.map(([x, y, z]) => this.project3(x, y, z, w, h));
            // Normal from the first three corners, in world space.
            const ux = corners[1][0] - corners[0][0], uy = corners[1][1] - corners[0][1], uz = corners[1][2] - corners[0][2];
            const vx = corners[3][0] - corners[0][0], vy = corners[3][1] - corners[0][1], vz = corners[3][2] - corners[0][2];
            let nx = uy * vz - uz * vy, ny = uz * vx - ux * vz, nz = ux * vy - uy * vx;
            const nl = Math.hypot(nx, ny, nz) || 1;
            nx /= nl; ny /= nl; nz /= nl;
            const light = Math.abs(nx * 0.45 + ny * 0.55 + nz * 0.7);
            quads.push({
              pts: projected,
              z: (projected[0].z + projected[1].z + projected[2].z + projected[3].z) / 4,
              shade: light,
            });
          }
        }
      }
      quads.sort((a, b) => b.z - a.z);
      ctx.lineJoin = "round";
      for (const quad of quads) {
        ctx.beginPath();
        quad.pts.forEach((p, i) => (i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y)));
        ctx.closePath();
        ctx.fillStyle = `rgba(${faceRgb[0]},${faceRgb[1]},${faceRgb[2]},${(0.1 + quad.shade * 0.34).toFixed(3)})`;
        ctx.fill();
        ctx.strokeStyle = this.css("--mm-wire");
        ctx.lineWidth = 0.5;
        ctx.stroke();
      }

      // Cut faces while the solid is open: the generating region itself,
      // faint at the trailing edge, highlighted at the leading edge.
      if (sweep < TWO_PI - 0.01) {
        this.drawCap(ctx, 0, w, h, 0.1, null);
        this.drawCap(ctx, sweep, w, h, 0.2, this.css("--mm-boundary"));
      } else {
        // Closed solid - no cut, just trace the generator once.
        this.drawCap(ctx, sweep, w, h, 0, this.css("--mm-boundary"));
      }

      // Centroid rings: the travel paths Pappus is talking about.
      this.drawCentroidRing(ctx, m.dArea, m.cy, sweep, this.css("--mm-centroid-area"), w, h, true);
      this.drawCentroidRing(ctx, m.dCurve, m.ccy, sweep, this.css("--mm-centroid-curve"), w, h, false);
    }

    /** The generating region, placed in 3D at a given sweep angle. */
    drawCap(
      ctx: CanvasRenderingContext2D,
      angle: number,
      w: number,
      h: number,
      fillAlpha: number,
      stroke: string | null,
    ) {
      const cosA = Math.cos(angle), sinA = Math.sin(angle);
      ctx.beginPath();
      this.region.forEach(([x, y], i) => {
        const r = x - this.axis;
        const p = this.project3(r * cosA, y, r * sinA, w, h);
        if (i === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      });
      ctx.closePath();
      if (fillAlpha > 0) {
        const rgb = this.hexToRgb(this.css("--mm-face"));
        ctx.fillStyle = `rgba(${rgb[0]},${rgb[1]},${rgb[2]},${fillAlpha})`;
        ctx.fill();
      }
      if (stroke) {
        ctx.strokeStyle = stroke;
        ctx.lineWidth = 1.8;
        ctx.stroke();
      }
    }

    drawCentroidRing(
      ctx: CanvasRenderingContext2D,
      radius: number,
      height: number,
      sweep: number,
      color: string,
      w: number,
      h: number,
      dot: boolean,
    ) {
      ctx.strokeStyle = color;
      ctx.lineWidth = 1.4;
      ctx.setLineDash([3, 4]);
      ctx.beginPath();
      const steps = 72;
      for (let i = 0; i <= steps; i++) {
        const a = (i / steps) * sweep;
        const p = this.project3(radius * Math.cos(a), height, radius * Math.sin(a), w, h);
        if (i === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      }
      ctx.stroke();
      ctx.setLineDash([]);
      const tip = this.project3(radius * Math.cos(sweep), height, radius * Math.sin(sweep), w, h);
      ctx.fillStyle = color;
      ctx.beginPath();
      if (dot) {
        ctx.arc(tip.x, tip.y, 4, 0, TWO_PI);
        ctx.fill();
      } else {
        ctx.strokeStyle = color;
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        ctx.moveTo(tip.x - 4.5, tip.y);
        ctx.lineTo(tip.x + 4.5, tip.y);
        ctx.moveTo(tip.x, tip.y - 4.5);
        ctx.lineTo(tip.x, tip.y + 4.5);
        ctx.stroke();
      }
    }

    // --- readout -----------------------------------------------------------

    updateReadout() {
      const m = this.measure();
      const valid = this.axisValid();
      this.text("[data-area]", m.area.toFixed(3));
      this.text("[data-length]", m.L.toFixed(3));
      const invalidNote = this.querySelector<HTMLElement>("[data-invalid]");
      if (invalidNote) invalidNote.hidden = valid;
      this.classList.toggle("is-invalid", !valid);
      if (!valid) {
        this.text("[data-v-pappus]", "—");
        this.text("[data-v-washers]", "—");
        this.text("[data-s-pappus]", "—");
        const vExact = this.querySelector<HTMLElement>("[data-v-exact]");
        const sExact = this.querySelector<HTMLElement>("[data-s-exact]");
        if (vExact) vExact.hidden = true;
        if (sExact) sExact.hidden = true;
        this.setRunState("Axis inside the region · Pappus on hold", "bad");
        return;
      }
      this.text("[data-v-pappus]", m.vPappus.toFixed(4));
      this.text("[data-v-washers]", m.vWashers.toFixed(4));
      this.text("[data-s-pappus]", m.sPappus.toFixed(4));
      const agree = Math.abs(m.vPappus - m.vWashers) < 0.01 * Math.max(m.vPappus, 1e-9);
      const badge = this.querySelector<HTMLElement>("[data-check-badge]");
      if (badge) badge.classList.toggle("ok", agree);
      this.setRunState(this.playing ? "Sweeping…" : "Paused · scrub the sweep", this.playing ? "good" : "idle");
      this.updateExact();
    }

    /** Closed-form values, shown only while a preset sits at its home axis. */
    updateExact() {
      const vExact = this.querySelector<HTMLElement>("[data-v-exact]");
      const sExact = this.querySelector<HTMLElement>("[data-s-exact]");
      if (!vExact || !sExact) return;
      const home = Math.abs(this.axis) < 0.01;
      let v = "", s = "";
      if (home && this.shape === "sphere") {
        v = `closed form: 4πr³∕3 = ${(4 * Math.PI / 3).toFixed(4)}`;
        s = `closed form: 4πr² = ${(4 * Math.PI).toFixed(4)}`;
      } else if (home && this.shape === "torus") {
        v = `closed form: 2π²Rr² = ${(2 * Math.PI ** 2 * 0.85 * 0.35 ** 2).toFixed(4)}`;
        s = `closed form: 4π²Rr = ${(4 * Math.PI ** 2 * 0.85 * 0.35).toFixed(4)}`;
      } else if (home && this.shape === "cone") {
        v = `closed form: πr²h∕3 = ${(Math.PI * 0.85 ** 2 * 1.5 / 3).toFixed(4)}`;
        s = `closed form: πrℓ + πr² = ${(Math.PI * 0.85 * Math.hypot(0.85, 1.5) + Math.PI * 0.85 ** 2).toFixed(4)}`;
      }
      vExact.hidden = !v;
      sExact.hidden = !s;
      if (v) vExact.textContent = v;
      if (s) sExact.textContent = s;
    }

    syncSweepReadout(updateSlider = true) {
      const deg = Math.round((this.sweep / TWO_PI) * 360);
      this.text("[data-sweep-deg]", `${deg}°`);
      this.text("[data-sweep-label]", `${deg}°`);
      this.text(
        "[data-sweep-note]",
        deg >= 360 ? "Full turn — the theorem's 2π" : "A full turn is 2π",
      );
      const slider = this.querySelector<HTMLInputElement>("[data-sweep]");
      if (slider && updateSlider) slider.value = String(deg);
    }

    // --- plumbing ----------------------------------------------------------

    layout() {
      for (const canvas of [this.planeCanvas, this.solidCanvas]) {
        const rect = canvas.getBoundingClientRect();
        if (!rect.width || !rect.height) continue;
        const dpr = Math.min(devicePixelRatio || 1, 2);
        canvas.width = Math.round(rect.width * dpr);
        canvas.height = Math.round(rect.height * dpr);
        const ctx = canvas === this.planeCanvas ? this.planeCtx : this.solidCtx;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      this.renderAll();
    }

    renderAll() {
      this.renderPlane();
      this.renderSolid();
    }

    css(name: string) {
      return getComputedStyle(this).getPropertyValue(name).trim();
    }

    hexToRgb(hex: string): [number, number, number] {
      let value = hex.replace("#", "").trim();
      if (value.length === 3) value = value[0] + value[0] + value[1] + value[1] + value[2] + value[2];
      const n = parseInt(value, 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    }

    setRunState(message: string, kind: "idle" | "good" | "bad") {
      this.text("[data-run-state]", message);
      this.classList.toggle("is-live", kind === "good");
      this.classList.toggle("is-bad", kind === "bad");
    }

    syncPlayButton() {
      const button = this.querySelector("[data-play]");
      if (!button) return;
      button.textContent = this.playing ? "Pause sweep" : "Play sweep";
      button.classList.toggle("active", this.playing);
      this.updateReadout();
    }

    text(selector: string, value: string) {
      const element = this.querySelector(selector);
      if (element) element.textContent = value;
    }
  }

  if (!customElements.get("measure-laboratory")) {
    customElements.define("measure-laboratory", MeasureLaboratory);
  }
</script>


<union-find-laboratory>
  <section class="instrument union-lab" aria-label="Interactive union-find percolation visualizer">
    <div class="instrument-tabs"><button data-mode="quick">Quick-find</button><button data-mode="weighted">Weighted union</button><button class="active" data-mode="compressed">Path compression</button></div>
    <div class="instrument-status"><span><strong data-state>Ready</strong> · <span data-message>Open sites until the grid percolates</span></span><span class="hint">Click any closed site to open it manually</span></div>
    <div class="union-layout">
      <div class="grid-wrap"><div class="water top label">Source</div><canvas data-grid aria-label="Percolation grid"></canvas><div class="water bottom label">Drain</div></div>
      <aside>
        <p class="label label--accent">Disjoint-set strategy</p><h2 data-name>Weighted + compression</h2><p data-description>Attach the smaller tree, then flatten every parent path encountered by find.</p>
        <div class="instrument-metrics"><div><span data-open>0%</span><small>Sites open</small></div><div><span data-components>0</span><small>Components</small></div><div><span data-depth>0</span><small>Max depth</small></div></div>
        <div class="telemetry"><p><span>Find operations</span><b data-finds>0</b></p><p><span>Successful unions</span><b data-unions>0</b></p><p><span>Percolation threshold</span><b data-threshold>—</b></p></div>
      </aside>
    </div>
    <div class="instrument-toolbar"><button class="instrument-action primary" data-run>▶ Open sites</button><button class="instrument-action" data-step>Open one →</button><button class="instrument-action" data-reset>New experiment</button><label class="instrument-range"><span>Speed <b data-speed-label>15 site/s</b></span><input data-speed type="range" min="1" max="100" value="52" /></label></div>
  </section>
</union-find-laboratory>

<script>
  type Mode="quick"|"weighted"|"compressed";
  const UNION_INFO:Record<Mode,[string,string]>={quick:["Quick-find","Store a component label at every site; union relabels every member of one component."],weighted:["Weighted quick-union","Attach the smaller root below the larger root to limit tree height."],compressed:["Weighted + compression","Attach the smaller tree, then flatten every parent path encountered by find."]};
  class DisjointSet{parent:number[];size:number[];mode:Mode;finds=0;constructor(n:number,mode:Mode){this.parent=Array.from({length:n},(_,i)=>i);this.size=Array(n).fill(1);this.mode=mode;}find(x:number){this.finds++;if(this.mode==="quick")return this.parent[x];let root=x;while(root!==this.parent[root])root=this.parent[root];if(this.mode==="compressed")while(x!==root){const next=this.parent[x];this.parent[x]=root;x=next;}return root;}union(a:number,b:number){let ra=this.find(a),rb=this.find(b);if(ra===rb)return false;if(this.mode==="quick"){for(let i=0;i<this.parent.length;i++)if(this.parent[i]===rb)this.parent[i]=ra;}else{if(this.size[ra]<this.size[rb])[ra,rb]=[rb,ra];this.parent[rb]=ra;this.size[ra]+=this.size[rb];}return true;}depth(x:number){if(this.mode==="quick")return 1;let d=0;while(x!==this.parent[x]){x=this.parent[x];d++;}return d;}}
  class UnionFindLaboratory extends HTMLElement{
    cols=18;rows=12;mode:Mode="compressed";open=new Set<number>();order:number[]=[];cursor=0;unions=0;running=false;percolated=false;threshold=0;ds!:DisjointSet;canvas!:HTMLCanvasElement;ctx!:CanvasRenderingContext2D;width=0;height=0;frame=0;last=0;acc=0;aborter=new AbortController();resize?:ResizeObserver;theme?:MutationObserver;
    connectedCallback(){this.canvas=this.querySelector("[data-grid]") as HTMLCanvasElement;const c=this.canvas.getContext("2d");if(!c)return;this.ctx=c;this.bind();this.resize=new ResizeObserver(()=>this.layout());this.resize.observe(this.canvas);this.theme=new MutationObserver(()=>this.draw());this.theme.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});this.reset();this.layout();this.frame=requestAnimationFrame(t=>this.animate(t));}
    disconnectedCallback(){cancelAnimationFrame(this.frame);this.aborter.abort();this.resize?.disconnect();this.theme?.disconnect();}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(b=>b.addEventListener("click",()=>{this.mode=b.dataset.mode as Mode;this.querySelectorAll("[data-mode]").forEach(x=>x.classList.toggle("active",x===b));this.text("[data-name]",UNION_INFO[this.mode][0]);this.text("[data-description]",UNION_INFO[this.mode][1]);this.reset();},{signal}));this.querySelector("[data-run]")?.addEventListener("click",()=>{if(this.percolated||this.cursor>=this.order.length)this.reset();this.running=!this.running;this.state(this.running?"Opening sites":"Paused",this.running?"Connecting each new site to its open neighbours":"Experiment suspended");this.updateRun();},{signal});this.querySelector("[data-step]")?.addEventListener("click",()=>{this.running=false;this.openNext();this.updateRun();},{signal});this.querySelector("[data-reset]")?.addEventListener("click",()=>this.reset(),{signal});this.querySelector<HTMLInputElement>("[data-speed]")?.addEventListener("input",()=>this.text("[data-speed-label]",`${this.rate()} site/s`),{signal});this.canvas.addEventListener("click",e=>{const r=this.canvas.getBoundingClientRect(),x=Math.floor((e.clientX-r.left)/r.width*this.cols),y=Math.floor((e.clientY-r.top)/r.height*this.rows);this.openSite(y*this.cols+x);},{signal});}
    reset(){this.running=false;this.open.clear();this.cursor=0;this.unions=0;this.percolated=false;this.threshold=0;this.ds=new DisjointSet(this.cols*this.rows,this.mode);this.order=Array.from({length:this.cols*this.rows},(_,i)=>i);for(let i=this.order.length-1;i;i--){const j=Math.floor(Math.random()*(i+1));[this.order[i],this.order[j]]=[this.order[j],this.order[i]];}this.state("Ready","Open sites until the grid percolates");this.update();this.updateRun();this.draw();}
    openNext(){while(this.cursor<this.order.length&&this.open.has(this.order[this.cursor]))this.cursor++;if(this.cursor>=this.order.length)return;this.openSite(this.order[this.cursor++]);}
    openSite(id:number){if(this.open.has(id)||id<0||id>=this.cols*this.rows)return;this.open.add(id);for(const n of this.neighbours(id))if(this.open.has(n)&&this.ds.union(id,n))this.unions++;this.percolated=this.checkPercolation();if(this.percolated&&!this.threshold){this.threshold=this.open.size/(this.cols*this.rows);this.running=false;this.state("Percolates",`A connected component reached the drain at ${(this.threshold*100).toFixed(1)}% open`);this.updateRun();}else this.state("Connecting",`Opened site ${id}; merged adjacent components`);this.update();this.draw();}
    checkPercolation(){const top=new Set<number>();for(let x=0;x<this.cols;x++)if(this.open.has(x))top.add(this.ds.find(x));for(let x=0;x<this.cols;x++){const id=(this.rows-1)*this.cols+x;if(this.open.has(id)&&top.has(this.ds.find(id)))return true;}return false;}
    topRoots(){const roots=new Set<number>();for(let x=0;x<this.cols;x++)if(this.open.has(x))roots.add(this.ds.find(x));return roots;}
    neighbours(id:number){const x=id%this.cols,y=Math.floor(id/this.cols),a:number[]=[];if(x)a.push(id-1);if(x<this.cols-1)a.push(id+1);if(y)a.push(id-this.cols);if(y<this.rows-1)a.push(id+this.cols);return a;}
    update(){const components=this.open.size-this.unions;let depth=0;for(const id of this.open)depth=Math.max(depth,this.ds.depth(id));this.text("[data-open]",`${Math.round(this.open.size/(this.cols*this.rows)*100)}%`);this.text("[data-components]",String(components));this.text("[data-depth]",String(depth));this.text("[data-finds]",this.ds.finds.toLocaleString());this.text("[data-unions]",String(this.unions));this.text("[data-threshold]",this.threshold?`${(this.threshold*100).toFixed(1)}%`:"—");}
    animate(t:number){const d=Math.min(50,t-(this.last||t));this.last=t;if(this.running){this.acc+=d;const delay=1000/this.rate();while(this.acc>=delay&&this.running){this.acc-=delay;this.openNext();}}this.frame=requestAnimationFrame(n=>this.animate(n));}
    rate(){const v=Number(this.querySelector<HTMLInputElement>("[data-speed]")?.value||52);return Math.round(2*Math.pow(2,v/18));}
    layout(){const r=this.canvas.getBoundingClientRect();if(!r.width)return;const d=Math.min(devicePixelRatio||1,2);this.width=r.width;this.height=r.height;this.canvas.width=r.width*d;this.canvas.height=r.height*d;this.ctx.setTransform(d,0,0,d,0,0);this.draw();}
    draw(){if(!this.ctx||!this.width)return;const c=this.ctx,s=getComputedStyle(this),v=(n:string)=>s.getPropertyValue(n).trim(),cw=this.width/this.cols,ch=this.height/this.rows,top=this.topRoots();c.clearRect(0,0,this.width,this.height);for(let id=0;id<this.cols*this.rows;id++){const x=id%this.cols*cw,y=Math.floor(id/this.cols)*ch;c.fillStyle=v("--u-closed");if(this.open.has(id)){const root=this.ds.find(id),flow=top.has(root);if(flow)c.fillStyle=v("--u-flow");else{const hue=(root*47)%360;c.fillStyle=`hsla(${hue},45%,55%,.42)`;}}c.fillRect(x+1,y+1,Math.max(1,cw-2),Math.max(1,ch-2));}if(this.percolated){c.strokeStyle=v("--u-percolate");c.lineWidth=3;c.strokeRect(2,2,this.width-4,this.height-4);}this.update();}
    state(a:string,b:string){this.text("[data-state]",a);this.text("[data-message]",b);}updateRun(){this.text("[data-run]",this.running?"Ⅱ Pause":"▶ Open sites");this.querySelector("[data-run]")?.classList.toggle("active",this.running);}text(q:string,x:string){const e=this.querySelector(q);if(e)e.textContent=x;}
  }
  if(!customElements.get("union-find-laboratory"))customElements.define("union-find-laboratory",UnionFindLaboratory);
</script>

<style>
  union-find-laboratory{--u-closed:color-mix(in srgb,var(--paper-sunken) 75%,transparent);--u-flow:#4b75d6;--u-percolate:#35a978;display:block}:global(html[data-theme="dark"]) union-find-laboratory{--u-closed:rgba(255,255,255,.035);--u-flow:#3b9fd0;--u-percolate:#48d39d}.union-layout{display:grid;grid-template-columns:minmax(29rem,1.3fr) minmax(17rem,.7fr);min-height:34rem}.grid-wrap{display:grid;grid-template-rows:1.5rem 1fr 1.5rem;padding:1rem;border-right:1px solid var(--glass-border);background:linear-gradient(to right,var(--reseau) 1px,transparent 1px),linear-gradient(to bottom,var(--reseau) 1px,transparent 1px);background-size:24px 24px}.water{display:flex;align-items:center;justify-content:center;color:var(--ink-faint);font-size:.5rem}.top{color:var(--interact)}canvas{display:block;width:100%;height:100%;min-height:27rem;cursor:pointer}aside{padding:1.4rem;background:color-mix(in srgb,var(--paper-sunken) 38%,transparent)}aside h2{margin:.55rem 0 .7rem;font-family:var(--font-display);font-size:2rem;font-weight:400;line-height:1}aside>p:not(.label){min-height:4.2rem;color:var(--ink-soft);font-size:.68rem}.instrument-metrics{grid-template-columns:1fr;margin-top:1.2rem}.telemetry{margin-top:1.3rem;padding-top:.8rem;border-top:1px solid var(--rule)}.telemetry p{display:flex;justify-content:space-between;padding:.4rem 0;color:var(--ink-faint);font-size:.6rem}.telemetry b{color:var(--ink);font-weight:500}@media(max-width:53rem){.union-layout{grid-template-columns:1fr}.grid-wrap{border-right:0;border-bottom:1px solid var(--glass-border)}aside .instrument-metrics{grid-template-columns:repeat(3,1fr)}}@media(max-width:40rem){canvas{min-height:22rem}}
</style>

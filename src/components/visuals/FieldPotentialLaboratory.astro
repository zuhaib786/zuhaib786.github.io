<field-potential-laboratory>
  <section class="math-instrument" aria-label="Interactive electric field and potential laboratory">
    <div class="math-bar"><div class="math-state"><i></i><span data-state>Planar electrostatics · E = −∇V</span></div><div class="math-actions"><div class="math-tabs" aria-label="Charge configuration"><button class="active" data-preset="dipole">Dipole</button><button data-preset="quadrupole">Quadrupole</button><button data-preset="capacitor">Capacitor</button><button data-preset="single">Single</button></div><button class="math-button active" data-tool="move">Move</button><button class="math-button" data-tool="positive">+ charge</button><button class="math-button" data-tool="negative">− charge</button><button class="math-button" data-reset>Reset</button></div></div>
    <div class="math-dashboard">
      <div class="math-stage physics-stage"><span class="math-stage-label label">potential colour · equipotentials · field flow · Gaussian flux</span><canvas data-canvas aria-label="Electric potential, field lines, and Gaussian surface"></canvas></div>
      <aside class="math-readout"><p class="label label--accent">Fields and potentials</p><h2 data-title>Opposites organize the plane</h2><p data-description>A dipole has zero net charge but a structured far field. Drag either source and every representation updates together.</p><div class="math-formula">V(x) = −Σ qᵢ log|x−xᵢ| · E = −∇V</div>
        <div class="math-metrics"><div><strong data-flux>0.000</strong><small>Numerical flux Φ</small></div><div><strong data-charge>0</strong><small>Enclosed charge Q</small></div><div><strong data-error>0.00e+0</strong><small>Gauss residual</small></div></div>
        <div class="math-controls"><div class="math-control"><label><span>Gaussian radius</span><b data-radius-value>1.60</b></label><input data-radius type="range" min="0.5" max="3.6" step="0.05" value="1.6" /></div><div class="math-control"><label><span>Vector density</span><b data-density-value>14</b></label><input data-density type="range" min="8" max="24" step="2" value="14" /></div><div class="math-control"><label><span>Contour frequency</span><b data-contour-value>5</b></label><input data-contour type="range" min="2" max="10" step="1" value="5" /></div></div>
        <div class="math-legend"><span><i></i>positive potential / charge</span><span><i></i>negative potential / charge</span><span><i></i>Gaussian curve</span></div><div class="math-trace"><p class="label">Field dictionary</p><ol><li>Equipotentials meet field lines at right angles.</li><li>Field lines follow the steepest decrease of potential.</li><li data-reading-3>Flux equals 2π times enclosed charge in this planar model.</li></ol></div>
      </aside>
    </div>
  </section>
</field-potential-laboratory>

<script>
  type Charge={x:number;y:number;q:number};type Tool="move"|"positive"|"negative";type Preset="dipole"|"quadrupole"|"capacitor"|"single";
  const FIELD_INFO:Record<Preset,[string,string]>={dipole:["Opposites organize the plane","A dipole has zero net charge but a structured far field. Drag either source and every representation updates together."],quadrupole:["Symmetry cancels slowly","Four alternating charges erase the monopole and dipole moments, leaving a field whose far structure decays more quickly."],capacitor:["Between plates, order appears","Two rows of opposite charge approximate parallel plates: nearly uniform field inside, fringing field near the ends."],single:["Flux counts what lies within","Move the Gaussian circle across one source and the measured flux jumps between zero and 2πq without inspecting the source directly."]};
  class FieldPotentialLaboratory extends HTMLElement{
    canvas!:HTMLCanvasElement;ctx!:CanvasRenderingContext2D;width=0;height=0;charges:Charge[]=[];preset:Preset="dipole";tool:Tool="move";gauss={x:0,y:0,r:1.6};density=14;contours=5;span=8;drag=-1;dragGauss=false;resize?:ResizeObserver;theme?:MutationObserver;aborter=new AbortController();
    connectedCallback(){this.canvas=this.querySelector("[data-canvas]") as HTMLCanvasElement;const c=this.canvas.getContext("2d");if(!c)return;this.ctx=c;this.bind();this.resize=new ResizeObserver(()=>this.layout());this.resize.observe(this.canvas);this.theme=new MutationObserver(()=>this.draw());this.theme.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});this.load("dipole");this.layout();}
    disconnectedCallback(){this.aborter.abort();this.resize?.disconnect();this.theme?.disconnect();}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach(b=>b.addEventListener("click",()=>{this.querySelectorAll("[data-preset]").forEach(x=>x.classList.toggle("active",x===b));this.load(b.dataset.preset as Preset);},{signal}));this.querySelectorAll<HTMLButtonElement>("[data-tool]").forEach(b=>b.addEventListener("click",()=>{this.tool=b.dataset.tool as Tool;this.querySelectorAll("[data-tool]").forEach(x=>x.classList.toggle("active",x===b));this.text("[data-state]",this.tool==="move"?"Drag charges or the Gaussian centre":this.tool==="positive"?"Click the plane to place +1":"Click the plane to place −1");},{signal}));this.querySelector("[data-reset]")?.addEventListener("click",()=>this.load(this.preset),{signal});this.range("[data-radius]",v=>{this.gauss.r=v;this.text("[data-radius-value]",v.toFixed(2));this.draw();});this.range("[data-density]",v=>{this.density=v;this.text("[data-density-value]",String(v));this.draw();});this.range("[data-contour]",v=>{this.contours=v;this.text("[data-contour-value]",String(v));this.draw();});this.canvas.addEventListener("pointerdown",e=>this.pointerDown(e),{signal});this.canvas.addEventListener("pointermove",e=>this.pointerMove(e),{signal});const up=(e:PointerEvent)=>{this.drag=-1;this.dragGauss=false;if(this.canvas.hasPointerCapture(e.pointerId))this.canvas.releasePointerCapture(e.pointerId);};this.canvas.addEventListener("pointerup",up,{signal});this.canvas.addEventListener("pointercancel",up,{signal});}
    range(q:string,fn:(v:number)=>void){this.querySelector<HTMLInputElement>(q)?.addEventListener("input",e=>fn(Number((e.currentTarget as HTMLInputElement).value)),{signal:this.aborter.signal});}
    load(name:Preset){this.preset=name;this.gauss={x:0,y:0,r:1.6};if(name==="dipole")this.charges=[{x:-1.25,y:0,q:1},{x:1.25,y:0,q:-1}];else if(name==="quadrupole")this.charges=[{x:-1.25,y:-1.1,q:1},{x:1.25,y:-1.1,q:-1},{x:-1.25,y:1.1,q:-1},{x:1.25,y:1.1,q:1}];else if(name==="capacitor"){this.charges=[];for(let k=-3;k<=3;k++){this.charges.push({x:k*.72,y:-1,q:1},{x:k*.72,y:1,q:-1});}}else this.charges=[{x:.65,y:.15,q:1}];const [title,description]=FIELD_INFO[name];this.text("[data-title]",title);this.text("[data-description]",description);this.draw();}
    field(x:number,y:number){let ex=0,ey=0;for(const p of this.charges){const dx=x-p.x,dy=y-p.y,r2=Math.max(dx*dx+dy*dy,1e-6),inv=p.q/r2;ex+=dx*inv;ey+=dy*inv;}return{x:ex,y:ey}}
    potential(x:number,y:number){let v=0;for(const p of this.charges)v-=p.q*Math.log(Math.sqrt(Math.max((x-p.x)**2+(y-p.y)**2,1e-6)));return v;}
    world(clientX:number,clientY:number){const r=this.canvas.getBoundingClientRect(),scale=Math.min(this.width,this.height)/this.span;return{x:(clientX-r.left-this.width/2)/scale,y:(this.height/2-(clientY-r.top))/scale,scale};}
    screen(x:number,y:number){const scale=Math.min(this.width,this.height)/this.span;return{x:this.width/2+x*scale,y:this.height/2-y*scale,scale}}
    pointerDown(e:PointerEvent){const p=this.world(e.clientX,e.clientY);if(this.tool!=="move"){this.charges.push({x:p.x,y:p.y,q:this.tool==="positive"?1:-1});this.preset="single";this.draw();return;}let best=-1,d=.35;this.charges.forEach((q,i)=>{const n=Math.hypot(q.x-p.x,q.y-p.y);if(n<d){d=n;best=i;}});if(best>=0)this.drag=best;else this.dragGauss=true;this.canvas.setPointerCapture(e.pointerId);this.pointerMove(e);}
    pointerMove(e:PointerEvent){if(this.drag<0&&!this.dragGauss)return;const p=this.world(e.clientX,e.clientY);if(this.drag>=0){this.charges[this.drag].x=p.x;this.charges[this.drag].y=p.y;}else{this.gauss.x=p.x;this.gauss.y=p.y;}this.draw();}
    flux(){const n=360,ds=2*Math.PI*this.gauss.r/n;let sum=0;for(let k=0;k<n;k++){const a=(k+.5)/n*Math.PI*2,x=this.gauss.x+this.gauss.r*Math.cos(a),y=this.gauss.y+this.gauss.r*Math.sin(a),f=this.field(x,y);sum+=(f.x*Math.cos(a)+f.y*Math.sin(a))*ds;}return sum;}
    enclosed(){return this.charges.reduce((s,p)=>s+(Math.hypot(p.x-this.gauss.x,p.y-this.gauss.y)<this.gauss.r?p.q:0),0)}
    layout(){const r=this.canvas.getBoundingClientRect();if(!r.width)return;const d=Math.min(devicePixelRatio||1,2);this.width=r.width;this.height=r.height;this.canvas.width=Math.round(r.width*d);this.canvas.height=Math.round(r.height*d);this.ctx.setTransform(d,0,0,d,0,0);this.draw();}
    draw(){if(!this.width)return;this.drawPotential();this.drawFieldLines();this.drawVectors();this.drawGaussian();this.drawCharges();const flux=this.flux(),q=this.enclosed(),exact=2*Math.PI*q,res=Math.abs(flux-exact);this.text("[data-flux]",flux.toFixed(3));this.text("[data-charge]",q>0?`+${q}`:String(q));this.text("[data-error]",res.toExponential(2));this.text("[data-reading-3]",`Measured Φ=${flux.toFixed(3)}; Gauss predicts 2πQ=${exact.toFixed(3)}.`);}
    drawPotential(){const w=this.width,h=this.height,rw=Math.max(120,Math.floor(w/3)),rh=Math.max(100,Math.floor(h/3)),off=document.createElement("canvas");off.width=rw;off.height=rh;const oc=off.getContext("2d")!,im=oc.createImageData(rw,rh),d=im.data,dark=document.documentElement.dataset.theme==="dark";for(let py=0;py<rh;py++)for(let px=0;px<rw;px++){const p=this.worldAt(px/(rw-1)*w,py/(rh-1)*h),v=this.potential(p.x,p.y),t=Math.tanh(v*.42),band=.84+.16*Math.cos(v*this.contours),base=dark?13:238,pos=dark?[63,92,190]:[82,66,214],neg=dark?[191,66,43]:[200,64,26],mix=Math.min(1,Math.abs(t)),col=t>=0?pos:neg,k=(py*rw+px)*4;d[k]=Math.round((base*(1-mix)+col[0]*mix)*band);d[k+1]=Math.round((base*(1-mix)+col[1]*mix)*band);d[k+2]=Math.round((base*(1-mix)+col[2]*mix)*band);d[k+3]=255;}oc.putImageData(im,0,0);this.ctx.drawImage(off,0,0,w,h);}
    worldAt(px:number,py:number){const s=Math.min(this.width,this.height)/this.span;return{x:(px-this.width/2)/s,y:(this.height/2-py)/s}}
    drawVectors(){const c=this.ctx,cols=this.density,step=this.width/cols,rows=Math.ceil(this.height/step);c.strokeStyle="rgba(255,255,255,.48)";c.fillStyle="rgba(255,255,255,.65)";c.lineWidth=.8;for(let iy=0;iy<=rows;iy++)for(let ix=0;ix<=cols;ix++){const x=(ix+.5)*step,y=(iy+.5)*step,p=this.worldAt(x,y),f=this.field(p.x,p.y),m=Math.hypot(f.x,f.y);if(m<1e-5)continue;const len=Math.min(step*.38,4+Math.log1p(m)*3.5),dx=f.x/m*len,dy=-f.y/m*len;c.beginPath();c.moveTo(x-dx*.45,y-dy*.45);c.lineTo(x+dx*.55,y+dy*.55);c.stroke();const a=Math.atan2(dy,dx);c.beginPath();c.moveTo(x+dx*.55,y+dy*.55);c.lineTo(x+dx*.55-3*Math.cos(a-.45),y+dy*.55-3*Math.sin(a-.45));c.lineTo(x+dx*.55-3*Math.cos(a+.45),y+dy*.55-3*Math.sin(a+.45));c.fill();}}
    drawFieldLines(){const c=this.ctx;c.lineWidth=1;c.globalAlpha=.58;for(const source of this.charges){for(let k=0;k<10;k++){const a=k/10*Math.PI*2,sign=source.q>0?1:-1;let x=source.x+.14*Math.cos(a),y=source.y+.14*Math.sin(a);c.strokeStyle=source.q>0?this.css("--math-a"):this.css("--math-b");c.beginPath();for(let n=0;n<220;n++){const p=this.screen(x,y);n?c.lineTo(p.x,p.y):c.moveTo(p.x,p.y);const f=this.field(x,y),m=Math.hypot(f.x,f.y);if(m<1e-5)break;x+=sign*f.x/m*.035;y+=sign*f.y/m*.035;if(Math.abs(x)>this.span||Math.abs(y)>this.span||this.charges.some(q=>q!==source&&Math.hypot(x-q.x,y-q.y)<.1))break;}c.stroke();}}c.globalAlpha=1;}
    drawGaussian(){const c=this.ctx,p=this.screen(this.gauss.x,this.gauss.y),r=this.gauss.r*p.scale;c.strokeStyle=this.css("--math-good");c.lineWidth=2;c.setLineDash([7,5]);c.beginPath();c.arc(p.x,p.y,r,0,Math.PI*2);c.stroke();c.setLineDash([]);c.fillStyle=this.css("--math-good");c.globalAlpha=.12;c.beginPath();c.arc(p.x,p.y,r,0,Math.PI*2);c.fill();c.globalAlpha=1;c.beginPath();c.arc(p.x,p.y,4,0,Math.PI*2);c.fill();}
    drawCharges(){const c=this.ctx;for(const q of this.charges){const p=this.screen(q.x,q.y),color=q.q>0?this.css("--math-a"):this.css("--math-b");c.fillStyle=color;c.shadowColor=color;c.shadowBlur=13;c.beginPath();c.arc(p.x,p.y,10,0,Math.PI*2);c.fill();c.shadowBlur=0;c.fillStyle="#fff";c.font="600 13px IBM Plex Mono";c.textAlign="center";c.textBaseline="middle";c.fillText(q.q>0?"+":"−",p.x,p.y);c.textAlign="left";c.textBaseline="alphabetic";}}
    css(n:string){return getComputedStyle(this).getPropertyValue(n).trim()}text(q:string,v:string){const e=this.querySelector(q);if(e)e.textContent=v}
  }
  if(!customElements.get("field-potential-laboratory"))customElements.define("field-potential-laboratory",FieldPotentialLaboratory);
</script>

<style>field-potential-laboratory{display:block}.math-stage canvas{cursor:crosshair}.math-button.active{color:var(--paper);background:var(--ink)}</style>

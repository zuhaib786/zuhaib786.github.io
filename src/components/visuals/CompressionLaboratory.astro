<compression-laboratory>
  <section class="instrument compression-lab" aria-label="Interactive lossless compression visualizer">
    <div class="instrument-tabs"><button class="active" data-mode="huffman">Huffman coding</button><button data-mode="rle">Run-length</button><button data-mode="lz77">LZ77 window</button></div>
    <div class="instrument-status"><span><strong data-state>Ready</strong> · <span data-message>Encode the source one token at a time</span></span><span class="hint">Ratios show payload only, excluding format headers</span></div>
    <div class="compression-layout">
      <div class="codec-stage">
        <div class="source-track"><p class="label">Source stream</p><div data-source></div><span class="cursor" data-cursor></span></div>
        <div class="pipeline" aria-hidden="true"><span>plain text</span><i></i><strong data-codec>prefix tree</strong><i></i><span>token stream</span></div>
        <div class="token-track"><p class="label">Encoded payload</p><div data-output><span class="empty">Run the codec to emit tokens</span></div></div>
      </div>
      <aside>
        <p class="label label--accent">Codebook / model</p><h2 data-name>Huffman coding</h2><p data-description>Frequent symbols receive short prefix-free codes built from a binary frequency tree.</p>
        <div class="instrument-metrics"><div><span data-input-bits>0</span><small>Input bits</small></div><div><span data-output-bits>0</span><small>Payload bits</small></div><div><span data-ratio>—</span><small>Size ratio</small></div></div>
        <div class="dictionary"><p class="label">Dictionary</p><div data-dictionary></div></div>
      </aside>
    </div>
    <div class="source-input"><label><span class="label">Text to compress</span><textarea data-input rows="2">BANANA_BANDANA BANANA_BANDANA</textarea></label><button class="instrument-action" data-apply>Apply text</button><button class="instrument-action" data-preset>Next sample</button></div>
    <div class="instrument-toolbar"><button class="instrument-action primary" data-run>▶ Encode stream</button><button class="instrument-action" data-step>Emit one token →</button><button class="instrument-action" data-reset>Reset</button><label class="instrument-range"><span>Speed <b data-speed-label>8 token/s</b></span><input data-speed type="range" min="1" max="100" value="50" /></label></div>
  </section>
</compression-laboratory>

<script>
  type Mode="huffman"|"rle"|"lz77";type Token={label:string;bits:number;start:number;length:number;kind:"literal"|"run"|"reference"|"code"};type HNode={char?:string;freq:number;left?:HNode;right?:HNode};
  const CODEC_INFO:Record<Mode,[string,string,string]>={huffman:["Huffman coding","Frequent symbols receive short prefix-free codes built from a binary frequency tree.","prefix tree"],rle:["Run-length encoding","Replace each maximal run with one symbol and its repetition count.","run detector"],lz77:["LZ77 sliding window","Replace repeated substrings with backward distance-and-length references.","search window"]};
  class CompressionLaboratory extends HTMLElement{
    mode:Mode="huffman";input="BANANA_BANDANA BANANA_BANDANA";tokens:Token[]=[];codes=new Map<string,string>();frequencies=new Map<string,number>();cursor=0;sourceAt=0;bits=0;running=false;frame=0;last=0;acc=0;sample=0;aborter=new AbortController();
    connectedCallback(){this.bind();this.build();this.frame=requestAnimationFrame(t=>this.animate(t));}
    disconnectedCallback(){cancelAnimationFrame(this.frame);this.aborter.abort();}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(b=>b.addEventListener("click",()=>{this.mode=b.dataset.mode as Mode;this.querySelectorAll("[data-mode]").forEach(x=>x.classList.toggle("active",x===b));const info=CODEC_INFO[this.mode];this.text("[data-name]",info[0]);this.text("[data-description]",info[1]);this.text("[data-codec]",info[2]);this.build();},{signal}));this.querySelector("[data-apply]")?.addEventListener("click",()=>{this.input=this.querySelector<HTMLTextAreaElement>("[data-input]")?.value.slice(0,96)||"";this.build();},{signal});this.querySelector("[data-preset]")?.addEventListener("click",()=>{const samples=["MISSISSIPPI RIVER","TOBEORNOTTOBEORTOBEORNOT","AAAAAAAAAABBBBBCCCCDDABCDE","the rain in spain falls mainly in the plain"];this.input=samples[this.sample++%samples.length];const area=this.querySelector<HTMLTextAreaElement>("[data-input]");if(area)area.value=this.input;this.build();},{signal});this.querySelector("[data-run]")?.addEventListener("click",()=>this.toggle(),{signal});this.querySelector("[data-step]")?.addEventListener("click",()=>{this.running=false;this.advance();this.updateRun();},{signal});this.querySelector("[data-reset]")?.addEventListener("click",()=>this.build(),{signal});this.querySelector<HTMLInputElement>("[data-speed]")?.addEventListener("input",()=>this.text("[data-speed-label]",`${this.rate()} token/s`),{signal});}
    build(){this.running=false;this.cursor=0;this.sourceAt=0;this.bits=0;this.codes.clear();this.frequencies.clear();if(this.mode==="huffman")this.tokens=this.huffman();else if(this.mode==="rle")this.tokens=this.rle();else this.tokens=this.lz77();this.renderSource();this.renderDictionary();const output=this.querySelector("[data-output]");if(output){output.replaceChildren();const empty=document.createElement("span");empty.className="empty";empty.textContent="Run the codec to emit tokens";output.append(empty);}this.text("[data-input-bits]",String(this.input.length*8));this.text("[data-output-bits]","0");this.text("[data-ratio]","—");this.state("Ready",`${this.tokens.length} tokens prepared from ${this.input.length} symbols`);this.updateRun();}
    huffman(){for(const char of this.input)this.frequencies.set(char,(this.frequencies.get(char)||0)+1);const queue:HNode[]=[...this.frequencies].map(([char,freq])=>({char,freq}));if(queue.length===1)this.codes.set(queue[0].char!,"0");while(queue.length>1){queue.sort((a,b)=>a.freq-b.freq);const left=queue.shift()!,right=queue.shift()!;queue.push({freq:left.freq+right.freq,left,right});}const walk=(n:HNode,prefix:string)=>{if(n.char!==undefined){this.codes.set(n.char,prefix||"0");return;}if(n.left)walk(n.left,prefix+"0");if(n.right)walk(n.right,prefix+"1");};if(queue[0])walk(queue[0],"");return[...this.input].map((char,i)=>{const code=this.codes.get(char)||"";return{label:code,bits:code.length,start:i,length:1,kind:"code" as const};});}
    rle(){const out:Token[]=[];let i=0;while(i<this.input.length){let j=i+1;while(j<this.input.length&&this.input[j]===this.input[i]&&j-i<255)j++;out.push({label:`${j-i}×${this.visible(this.input[i])}`,bits:16,start:i,length:j-i,kind:"run"});i=j;}return out;}
    lz77(){const out:Token[]=[];let i=0;while(i<this.input.length){let bestLength=0,bestDistance=0;const start=Math.max(0,i-18);for(let j=start;j<i;j++){let length=0;while(length<15&&i+length<this.input.length&&this.input[j+length]===this.input[i+length])length++;if(length>bestLength){bestLength=length;bestDistance=i-j;}}if(bestLength>=3){out.push({label:`⟨${bestDistance},${bestLength}⟩`,bits:13,start:i,length:bestLength,kind:"reference"});i+=bestLength;}else{out.push({label:this.visible(this.input[i]),bits:9,start:i,length:1,kind:"literal"});i++;}}return out;}
    visible(c:string){return c===" "?"␠":c==="\n"?"↵":c;}
    toggle(){if(this.cursor>=this.tokens.length)this.build();this.running=!this.running;this.state(this.running?"Encoding":"Paused",this.running?"Reading the next source span":"Codec suspended");this.updateRun();}
    advance(){const token=this.tokens[this.cursor++];if(!token){this.finish();return;}this.sourceAt=token.start+token.length;this.bits+=token.bits;const output=this.querySelector("[data-output]");output?.querySelector(".empty")?.remove();const chip=document.createElement("b");chip.textContent=token.label;chip.className=token.kind;chip.title=`source ${token.start}…${token.start+token.length-1} · ${token.bits} bits`;output?.append(chip);this.text("[data-output-bits]",String(this.bits));this.text("[data-ratio]",this.input.length?`${Math.round(this.bits/(this.input.length*8)*100)}%`:"—");this.moveCursor(token);this.state("Token emitted",`${token.label} represents ${token.length} source symbol${token.length===1?"":"s"}`);if(this.cursor>=this.tokens.length)this.finish();}
    finish(){this.running=false;this.state("Complete",`${this.tokens.length} tokens · ${this.bits} payload bits`);this.updateRun();}
    renderSource(){const box=this.querySelector("[data-source]");if(!box)return;box.replaceChildren();[...this.input].forEach((char,i)=>{const s=document.createElement("span");s.textContent=this.visible(char);s.dataset.index=String(i);box.append(s);});}
    renderDictionary(){const box=this.querySelector("[data-dictionary]");if(!box)return;box.replaceChildren();if(this.mode==="huffman"){[...this.codes].sort((a,b)=>(this.frequencies.get(b[0])||0)-(this.frequencies.get(a[0])||0)).forEach(([char,code])=>{const row=document.createElement("p");const key=document.createElement("span");key.textContent=`${this.visible(char)} · ${this.frequencies.get(char)}`;const value=document.createElement("b");value.textContent=code;row.append(key,value);box.append(row);});}else{const lines=this.mode==="rle"?[["Token","count × symbol"],["Count","8 bits"],["Symbol","8 bits"]]:[["Window","18 symbols"],["Match","minimum 3"],["Reference","distance, length"]];lines.forEach(([a,b])=>{const row=document.createElement("p");const k=document.createElement("span");k.textContent=a;const v=document.createElement("b");v.textContent=b;row.append(k,v);box.append(row);});}}
    moveCursor(token:Token){this.querySelectorAll<HTMLElement>("[data-source] span").forEach(s=>{const i=Number(s.dataset.index);s.classList.toggle("consumed",i<this.sourceAt);s.classList.toggle("active",i>=token.start&&i<token.start+token.length);});}
    animate(t:number){const d=Math.min(50,t-(this.last||t));this.last=t;if(this.running){this.acc+=d;const delay=1000/this.rate();if(this.acc>=delay){this.acc=0;this.advance();}}this.frame=requestAnimationFrame(n=>this.animate(n));}
    rate(){const v=Number(this.querySelector<HTMLInputElement>("[data-speed]")?.value||50);return Math.max(1,Math.round(2*Math.pow(2,v/25)));}
    state(a:string,b:string){this.text("[data-state]",a);this.text("[data-message]",b);}updateRun(){this.text("[data-run]",this.running?"Ⅱ Pause":"▶ Encode stream");this.querySelector("[data-run]")?.classList.toggle("active",this.running);}text(q:string,x:string){const e=this.querySelector(q);if(e)e.textContent=x;}
  }
  if(!customElements.get("compression-laboratory"))customElements.define("compression-laboratory",CompressionLaboratory);
</script>

<style>
  compression-laboratory{display:block}.compression-layout{display:grid;grid-template-columns:minmax(31rem,1.4fr) minmax(17rem,.6fr);min-height:35rem}.codec-stage{display:flex;flex-direction:column;justify-content:center;gap:2.2rem;padding:1.5rem;border-right:1px solid var(--glass-border);overflow:hidden;background:linear-gradient(to right,var(--reseau) 1px,transparent 1px),linear-gradient(to bottom,var(--reseau) 1px,transparent 1px);background-size:24px 24px}.source-track>div,.token-track>div{display:flex;align-items:center;gap:.25rem;min-height:4.4rem;margin-top:.55rem;padding:.7rem;overflow-x:auto;background:var(--glass);border:1px solid var(--rule);border-radius:8px}.source-track span{display:grid;flex:0 0 auto;width:1.45rem;height:2rem;place-items:center;color:var(--ink-soft);border:1px solid var(--rule);border-radius:4px;font-size:.65rem;transition:background 160ms ease,color 160ms ease}.source-track span.consumed{color:var(--ink-faint);background:var(--accent-soft)}.source-track span.active{color:var(--paper);background:var(--interact);border-color:var(--interact)}.pipeline{display:grid;grid-template-columns:auto 1fr auto 1fr auto;align-items:center;gap:.7rem;color:var(--ink-faint);font-size:.55rem;text-transform:uppercase}.pipeline i{height:1px;background:linear-gradient(90deg,var(--rule),var(--interact));}.pipeline strong{padding:.4rem .6rem;color:var(--interact);border:1px solid var(--interact);border-radius:99px;font-weight:500}.token-track b{display:inline-grid;flex:0 0 auto;min-height:2rem;place-items:center;padding:.3rem .55rem;color:var(--ink-soft);border:1px solid var(--rule);border-radius:5px;font-size:.6rem;font-weight:500}.token-track b.reference{color:var(--paper);background:var(--accent-2);border-color:var(--accent-2)}.token-track b.run{color:var(--paper);background:var(--interact);border-color:var(--interact)}.token-track b.code{font-size:.55rem;letter-spacing:.08em}.empty{color:var(--ink-faint);font-size:.6rem}aside{padding:1.4rem;background:color-mix(in srgb,var(--paper-sunken) 38%,transparent)}aside h2{margin:.55rem 0 .7rem;font-family:var(--font-display);font-size:2rem;font-weight:400;line-height:1}aside>p:not(.label){min-height:4.2rem;color:var(--ink-soft);font-size:.68rem}.instrument-metrics{grid-template-columns:1fr;margin-top:1.1rem}.dictionary{margin-top:1.3rem;padding-top:1rem;border-top:1px solid var(--rule)}.dictionary>div{max-height:12rem;margin-top:.55rem;overflow:auto}.dictionary :global(p){display:flex;justify-content:space-between;gap:1rem;padding:.25rem 0;color:var(--ink-faint);font-size:.55rem}.dictionary :global(b){color:var(--ink);font-weight:500}.source-input{display:grid;grid-template-columns:1fr auto auto;align-items:end;gap:.6rem;padding:.8rem 1rem;border-top:1px solid var(--glass-border);background:color-mix(in srgb,var(--paper-sunken) 26%,transparent)}.source-input label{display:grid;gap:.25rem}.source-input textarea{width:100%;resize:vertical;padding:.5rem .65rem;color:var(--ink);background:var(--glass);border:1px solid var(--rule);border-radius:7px;font-size:.65rem}@media(max-width:55rem){.compression-layout{grid-template-columns:1fr}.codec-stage{border-right:0;border-bottom:1px solid var(--glass-border)}aside .instrument-metrics{grid-template-columns:repeat(3,1fr)}}@media(max-width:42rem){.source-input{grid-template-columns:1fr}.source-input button{width:100%}.pipeline{grid-template-columns:1fr;text-align:center}.pipeline i{width:1px;height:1rem;margin:auto}}
</style>

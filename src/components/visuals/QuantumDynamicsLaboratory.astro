<quantum-dynamics-laboratory>
  <section class="math-instrument" aria-label="Interactive quantum wave-packet laboratory">
    <div class="math-bar"><div class="math-state"><i></i><span data-state>Split-step Fourier evolution · unitary propagation</span></div><div class="math-actions"><div class="math-tabs" aria-label="Quantum potential"><button class="active" data-mode="barrier">Barrier</button><button data-mode="free">Free packet</button><button data-mode="harmonic">Harmonic well</button><button data-mode="double">Double well</button></div><button class="math-button" data-play>Pause</button><button class="math-button" data-reset>Relaunch</button></div></div>
    <div class="math-dashboard">
      <div class="math-stage physics-stage"><span class="math-stage-label label">probability density · complex phase · potential · spacetime history</span><canvas data-canvas aria-label="Quantum wave packet and probability-density history"></canvas></div>
      <aside class="math-readout"><p class="label label--accent">Quantum dynamics</p><h2 data-title>A packet meets a barrier</h2><p data-description>Part of the amplitude reflects and part tunnels through. Phase continues to evolve even where probability density is small.</p><div class="math-formula">i ∂ₜψ = [−½∂²ₓ + V(x)] ψ</div>
        <div class="math-metrics"><div><strong data-norm>1.000000</strong><small>Probability norm</small></div><div><strong data-position>−5.000</strong><small>Expected position ⟨x⟩</small></div><div><strong data-right>0.000</strong><small>Probability right of barrier</small></div></div>
        <div class="math-controls"><div class="math-control"><label><span data-potential-label>Barrier height V₀</span><b data-potential-value>1.60</b></label><input data-potential type="range" min="0" max="3.5" step="0.05" value="1.6" /></div><div class="math-control"><label><span>Mean wave number k₀</span><b data-k-value>2.20</b></label><input data-k type="range" min="0.4" max="4.5" step="0.05" value="2.2" /></div><div class="math-control"><label><span>Packet width σ</span><b data-width-value>0.75</b></label><input data-width type="range" min="0.3" max="1.6" step="0.05" value="0.75" /></div><div class="math-control"><label><span>Time step Δt</span><b data-dt-value>0.010</b></label><input data-dt type="range" min="0.002" max="0.02" step="0.001" value="0.01" /></div></div>
        <div class="math-legend"><span><i></i>probability / phase</span><span><i></i>potential energy</span><span><i></i>probability current</span></div><div class="math-trace"><p class="label">Quantum reading</p><ol><li data-reading-1>The kinetic step is diagonal in momentum space.</li><li data-reading-2>The potential step is diagonal in position space.</li><li data-reading-3>Alternating both exponentials preserves norm to numerical precision.</li></ol></div>
      </aside>
    </div>
  </section>
</quantum-dynamics-laboratory>

<script>
  type Mode="barrier"|"free"|"harmonic"|"double";
  const QUANTUM_INFO:Record<Mode,[string,string,string,string]>={barrier:["A packet meets a barrier","Part of the amplitude reflects and part tunnels through. Phase continues to evolve even where probability density is small.","Barrier height V₀","Probability right of barrier"],free:["Dispersion is phase disagreement","A free packet spreads because its momentum components accumulate phase at different quadratic rates.","Reference potential","Probability right of origin"],harmonic:["A quadratic well organizes recurrence","The packet oscillates inside a harmonic potential while its phase-space centre follows the classical orbit.","Oscillator strength","Probability x > 0"],double:["Amplitude negotiates two wells","Two minima communicate through a classically forbidden central region, producing coherent transfer and beating.","Well strength","Probability x > 0"]};
  class QuantumDynamicsLaboratory extends HTMLElement{
    canvas!:HTMLCanvasElement;ctx!:CanvasRenderingContext2D;width=0;height=0;mode:Mode="barrier";N=512;L=20;re=new Float64Array(this.N);im=new Float64Array(this.N);potential=new Float64Array(this.N);V0=1.6;k0=2.2;sigma=.75;dt=.01;x0=-5;playing=true;frame=0;last=0;clock=0;history:Float32Array[]=[];historyTick=0;resize?:ResizeObserver;theme?:MutationObserver;aborter=new AbortController();
    connectedCallback(){this.canvas=this.querySelector("[data-canvas]") as HTMLCanvasElement;const c=this.canvas.getContext("2d");if(!c)return;this.ctx=c;this.bind();this.resize=new ResizeObserver(()=>this.layout());this.resize.observe(this.canvas);this.theme=new MutationObserver(()=>this.draw());this.theme.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});this.reset();this.layout();this.frame=requestAnimationFrame(t=>this.animate(t));}
    disconnectedCallback(){cancelAnimationFrame(this.frame);this.aborter.abort();this.resize?.disconnect();this.theme?.disconnect();}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(b=>b.addEventListener("click",()=>{this.mode=b.dataset.mode as Mode;this.querySelectorAll("[data-mode]").forEach(x=>x.classList.toggle("active",x===b));this.configure();this.reset();},{signal}));this.querySelector("[data-play]")?.addEventListener("click",()=>{this.playing=!this.playing;const b=this.querySelector<HTMLButtonElement>("[data-play]");if(b)b.textContent=this.playing?"Pause":"Run";this.text("[data-state]",this.playing?"Split-step Fourier evolution · unitary propagation":"Paused · click the plot to relaunch from x₀");},{signal});this.querySelector("[data-reset]")?.addEventListener("click",()=>this.reset(),{signal});this.range("[data-potential]",v=>{this.V0=v;this.text("[data-potential-value]",v.toFixed(2));this.buildPotential();this.history=[];this.draw();});this.range("[data-k]",v=>{this.k0=v;this.text("[data-k-value]",v.toFixed(2));this.reset();});this.range("[data-width]",v=>{this.sigma=v;this.text("[data-width-value]",v.toFixed(2));this.reset();});this.range("[data-dt]",v=>{this.dt=v;this.text("[data-dt-value]",v.toFixed(3));});this.canvas.addEventListener("pointerdown",e=>{const r=this.canvas.getBoundingClientRect(),x=(e.clientX-r.left)/this.width*this.L-this.L/2;this.x0=Math.max(-8.5,Math.min(8.5,x));this.reset();},{signal});}
    range(q:string,fn:(v:number)=>void){this.querySelector<HTMLInputElement>(q)?.addEventListener("input",e=>fn(Number((e.currentTarget as HTMLInputElement).value)),{signal:this.aborter.signal});}
    configure(){const i=QUANTUM_INFO[this.mode];this.text("[data-title]",i[0]);this.text("[data-description]",i[1]);this.text("[data-potential-label]",i[2]);this.text("[data-right]","0.000");const small=this.querySelector("[data-right]")?.nextElementSibling;if(small)small.textContent=i[3];if(this.mode==="free")this.V0=0;else if(this.mode==="harmonic")this.V0=.22;else if(this.mode==="double")this.V0=.08;else this.V0=1.6;const input=this.querySelector<HTMLInputElement>("[data-potential]");if(input){input.value=String(this.V0);input.max=this.mode==="barrier"?"3.5":"0.5";input.step=this.mode==="barrier"?"0.05":"0.01";}this.text("[data-potential-value]",this.V0.toFixed(2));}
    reset(){this.clock=0;this.history=[];this.re.fill(0);this.im.fill(0);this.buildPotential();const dx=this.L/this.N;for(let i=0;i<this.N;i++){const x=(i-this.N/2)*dx,g=Math.exp(-((x-this.x0)**2)/(4*this.sigma*this.sigma));this.re[i]=g*Math.cos(this.k0*x);this.im[i]=g*Math.sin(this.k0*x);}this.normalize();this.captureHistory();this.updateMetrics();this.draw();}
    buildPotential(){const dx=this.L/this.N;for(let i=0;i<this.N;i++){const x=(i-this.N/2)*dx;if(this.mode==="barrier")this.potential[i]=Math.abs(x)<.55?this.V0:0;else if(this.mode==="free")this.potential[i]=0;else if(this.mode==="harmonic")this.potential[i]=this.V0*x*x;else this.potential[i]=this.V0*(x*x-5)*(x*x-5);}}
    normalize(){const dx=this.L/this.N;let n=0;for(let i=0;i<this.N;i++)n+=(this.re[i]**2+this.im[i]**2)*dx;const s=1/Math.sqrt(n||1);for(let i=0;i<this.N;i++){this.re[i]*=s;this.im[i]*=s;}}
    step(){const half=this.dt/2;for(let i=0;i<this.N;i++)this.rotate(i,-this.potential[i]*half);this.fft(this.re,this.im,false);for(let i=0;i<this.N;i++){const n=i<this.N/2?i:i-this.N,k=2*Math.PI*n/this.L;this.rotate(i,-.5*k*k*this.dt);}this.fft(this.re,this.im,true);for(let i=0;i<this.N;i++)this.rotate(i,-this.potential[i]*half);this.clock+=this.dt;this.historyTick++;if(this.historyTick%7===0)this.captureHistory();}
    rotate(i:number,a:number){const c=Math.cos(a),s=Math.sin(a),r=this.re[i],m=this.im[i];this.re[i]=r*c-m*s;this.im[i]=r*s+m*c;}
    fft(re:Float64Array,im:Float64Array,inverse:boolean){const n=re.length;for(let i=1,j=0;i<n;i++){let bit=n>>1;for(;j&bit;bit>>=1)j^=bit;j^=bit;if(i<j){[re[i],re[j]]=[re[j],re[i]];[im[i],im[j]]=[im[j],im[i]];}}for(let len=2;len<=n;len<<=1){const ang=(inverse?2:-2)*Math.PI/len,wlr=Math.cos(ang),wli=Math.sin(ang);for(let i=0;i<n;i+=len){let wr=1,wi=0;for(let j=0;j<len/2;j++){const u=i+j,v=i+j+len/2,tr=re[v]*wr-im[v]*wi,ti=re[v]*wi+im[v]*wr;re[v]=re[u]-tr;im[v]=im[u]-ti;re[u]+=tr;im[u]+=ti;const nw=wr*wlr-wi*wli;wi=wr*wli+wi*wlr;wr=nw;}}}if(inverse)for(let i=0;i<n;i++){re[i]/=n;im[i]/=n;}}
    captureHistory(){const bins=180,row=new Float32Array(bins);for(let j=0;j<bins;j++){const i=Math.floor(j/bins*this.N),d=this.re[i]**2+this.im[i]**2;row[j]=d;}this.history.push(row);if(this.history.length>96)this.history.shift();}
    metrics(){const dx=this.L/this.N;let norm=0,mean=0,right=0,energy=0;for(let i=0;i<this.N;i++){const x=(i-this.N/2)*dx,d=this.re[i]**2+this.im[i]**2;norm+=d*dx;mean+=x*d*dx;if(x>(this.mode==="barrier"?.55:0))right+=d*dx;const j=(i+1)%this.N,dr=(this.re[j]-this.re[i])/dx,di=(this.im[j]-this.im[i])/dx;energy+=(.5*(dr*dr+di*di)+this.potential[i]*d)*dx;}return{norm,mean,right,energy};}
    currentAt(i:number){const dx=this.L/this.N,l=(i-1+this.N)%this.N,r=(i+1)%this.N,dr=(this.re[r]-this.re[l])/(2*dx),di=(this.im[r]-this.im[l])/(2*dx);return this.re[i]*di-this.im[i]*dr;}
    updateMetrics(){const m=this.metrics();this.text("[data-norm]",m.norm.toFixed(6));this.text("[data-position]",m.mean.toFixed(3));this.text("[data-right]",m.right.toFixed(3));this.text("[data-reading-3]",`Norm error ${(Math.abs(m.norm-1)).toExponential(2)} · ⟨H⟩ = ${m.energy.toFixed(3)} · t = ${this.clock.toFixed(2)}.`);}
    animate(t:number){if(this.playing&&t-this.last>16){this.last=t;for(let k=0;k<3;k++)this.step();this.updateMetrics();this.draw();}this.frame=requestAnimationFrame(x=>this.animate(x));}
    layout(){const r=this.canvas.getBoundingClientRect();if(!r.width)return;const d=Math.min(devicePixelRatio||1,2);this.width=r.width;this.height=r.height;this.canvas.width=Math.round(r.width*d);this.canvas.height=Math.round(r.height*d);this.ctx.setTransform(d,0,0,d,0,0);this.draw();}
    draw(){if(!this.width)return;const c=this.ctx;c.fillStyle=this.css("--paper-sunken");c.fillRect(0,0,this.width,this.height);const topH=this.height*.68,pad=25,maxD=Math.max(...Array.from(this.re,(r,i)=>r*r+this.im[i]*this.im[i]),.02),scale=topH*.5/maxD;c.strokeStyle=this.css("--rule");c.beginPath();c.moveTo(0,topH*.78);c.lineTo(this.width,topH*.78);c.stroke();const vmax=Math.max(...this.potential.map(Math.abs),1);c.fillStyle=this.css("--math-b");c.globalAlpha=.18;c.beginPath();c.moveTo(0,topH*.78);for(let i=0;i<this.N;i++){const x=i/(this.N-1)*this.width,y=topH*.78-Math.min(.7,Math.abs(this.potential[i])/vmax*.7)*topH;c.lineTo(x,y);}c.lineTo(this.width,topH*.78);c.closePath();c.fill();c.globalAlpha=1;for(let i=0;i<this.N-1;i++){const x=i/(this.N-1)*this.width,nx=(i+1)/(this.N-1)*this.width,d=this.re[i]**2+this.im[i]**2,nd=this.re[i+1]**2+this.im[i+1]**2,y=topH*.78-d*scale,ny=topH*.78-nd*scale,phase=(Math.atan2(this.im[i],this.re[i])+Math.PI)/(2*Math.PI)*360;c.strokeStyle=`hsl(${phase} 82% 63%)`;c.lineWidth=2;c.beginPath();c.moveTo(x,y);c.lineTo(nx,ny);c.stroke();}c.fillStyle=this.css("--math-good");for(let i=20;i<this.N-20;i+=40){const x=i/(this.N-1)*this.width,j=this.currentAt(i),y=topH*.86;c.globalAlpha=Math.min(.8,.15+Math.abs(j));c.fillRect(x,y,Math.sign(j||1)*Math.min(20,Math.abs(j)*18),2);}c.globalAlpha=1;this.drawHistory(pad,topH+18,this.width-pad*2,this.height-topH-36);}
    drawHistory(x:number,y:number,w:number,h:number){const c=this.ctx,bins=180,rows=this.history.length;if(rows<1)return;const off=document.createElement("canvas");off.width=bins;off.height=Math.max(1,rows);const oc=off.getContext("2d")!,im=oc.createImageData(bins,Math.max(1,rows)),d=im.data,max=Math.max(...this.history.flatMap(row=>Array.from(row)),.02);for(let iy=0;iy<rows;iy++)for(let ix=0;ix<bins;ix++){const a=Math.min(1,Math.sqrt(this.history[iy][ix]/max)),k=(iy*bins+ix)*4;d[k]=30+40*a;d[k+1]=50+170*a;d[k+2]=70+180*a;d[k+3]=255;}oc.putImageData(im,0,0);c.drawImage(off,x,y,w,h);c.strokeStyle=this.css("--rule");c.strokeRect(x,y,w,h);}
    css(n:string){return getComputedStyle(this).getPropertyValue(n).trim()}text(q:string,v:string){const e=this.querySelector(q);if(e)e.textContent=v}
  }
  if(!customElements.get("quantum-dynamics-laboratory"))customElements.define("quantum-dynamics-laboratory",QuantumDynamicsLaboratory);
</script>

<style>quantum-dynamics-laboratory{display:block}.math-stage canvas{cursor:crosshair}</style>

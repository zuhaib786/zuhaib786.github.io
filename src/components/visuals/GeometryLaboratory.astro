<geometry-laboratory>
  <section class="instrument geometry-lab" aria-label="Interactive computational geometry visualizer">
    <div class="instrument-tabs"><button class="active" data-mode="hull">Convex hull</button><button data-mode="sweep">Closest-pair sweep</button><button data-mode="delaunay">Delaunay triangulation</button></div>
    <div class="instrument-status"><span><strong data-state>Ready</strong> · <span data-message>Click to add points or drag an existing point</span></span><span class="hint">Every point set is editable</span></div>
    <div class="geometry-layout">
      <div class="plane"><canvas data-plane aria-label="Editable point plane"></canvas><div class="plane-legend label"><span><i class="active"></i>Active</span><span><i class="candidate"></i>Candidate</span><span><i class="result"></i>Result</span></div></div>
      <aside>
        <p class="label label--accent">Construction</p><h2 data-name>Monotone chain hull</h2><p data-description>Sort points left-to-right and discard every clockwise turn from the upper and lower chains.</p>
        <div class="instrument-metrics"><div><span data-points>0</span><small>Input points</small></div><div><span data-operations>0</span><small>Operations</small></div><div><span data-result>—</span><small data-result-label>Hull vertices</small></div></div>
        <div class="predicate"><p class="label">Geometric predicate</p><code data-predicate>cross(a, b, c) ≤ 0 → pop b</code></div>
      </aside>
    </div>
    <div class="instrument-toolbar"><button class="instrument-action primary" data-run>▶ Construct</button><button class="instrument-action" data-step>Step →</button><button class="instrument-action" data-random>New point set</button><button class="instrument-action" data-clear>Clear</button><label class="instrument-range"><span>Speed <b data-speed-label>10 op/s</b></span><input data-speed type="range" min="1" max="100" value="50" /></label></div>
  </section>
</geometry-laboratory>

<script>
  type Mode="hull"|"sweep"|"delaunay";type Point={id:number;x:number;y:number};type Op={active?:number;hull?:number[];sweep?:number;pair?:number[];best?:number[];distance?:number;triangles?:number[][]};
  const GEO_INFO:Record<Mode,[string,string,string,string]>={hull:["Monotone chain hull","Sort points left-to-right and discard every clockwise turn from the upper and lower chains.","cross(a, b, c) ≤ 0 → pop b","Hull vertices"],sweep:["Closest-pair sweep","Move left-to-right and compare only points inside the current best-distance strip.","xᵢ − xⱼ < best → compare(i, j)","Closest distance"],delaunay:["Delaunay triangulation","Insert points and replace every triangle whose circumcircle contains the newcomer.","inCircle(a, b, c, p) → retriangulate","Triangles"]};
  class GeometryLaboratory extends HTMLElement{
    mode:Mode="hull";points:Point[]=[];extras=new Map<number,Point>();ops:Op[]=[];cursor=0;running=false;current:Op={};finalResult="—";nextId=0;drag=-1;
    canvas!:HTMLCanvasElement;ctx!:CanvasRenderingContext2D;width=0;height=0;frame=0;last=0;acc=0;aborter=new AbortController();resize?:ResizeObserver;theme?:MutationObserver;
    connectedCallback(){this.canvas=this.querySelector("[data-plane]") as HTMLCanvasElement;const c=this.canvas.getContext("2d");if(!c)return;this.ctx=c;this.bind();this.resize=new ResizeObserver(()=>this.layout());this.resize.observe(this.canvas);this.theme=new MutationObserver(()=>this.draw());this.theme.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});this.random();this.layout();this.frame=requestAnimationFrame(t=>this.animate(t));}
    disconnectedCallback(){cancelAnimationFrame(this.frame);this.aborter.abort();this.resize?.disconnect();this.theme?.disconnect();}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(b=>b.addEventListener("click",()=>{this.mode=b.dataset.mode as Mode;this.querySelectorAll("[data-mode]").forEach(x=>x.classList.toggle("active",x===b));const info=GEO_INFO[this.mode];this.text("[data-name]",info[0]);this.text("[data-description]",info[1]);this.text("[data-predicate]",info[2]);this.text("[data-result-label]",info[3]);this.reset();},{signal}));this.querySelector("[data-run]")?.addEventListener("click",()=>this.toggle(),{signal});this.querySelector("[data-step]")?.addEventListener("click",()=>{this.running=false;this.ensure();this.advance();this.updateRun();},{signal});this.querySelector("[data-random]")?.addEventListener("click",()=>this.random(),{signal});this.querySelector("[data-clear]")?.addEventListener("click",()=>{this.points=[];this.nextId=0;this.reset();},{signal});this.querySelector<HTMLInputElement>("[data-speed]")?.addEventListener("input",()=>this.text("[data-speed-label]",`${this.rate()} op/s`),{signal});
      this.canvas.addEventListener("pointerdown",e=>{const found=this.pointAt(e);if(found>=0){this.drag=found;this.canvas.setPointerCapture(e.pointerId);}else{const p=this.coords(e);this.points.push({id:this.nextId++,...p});this.reset();}},{signal});this.canvas.addEventListener("pointermove",e=>{if(this.drag<0)return;const p=this.coords(e),node=this.points.find(x=>x.id===this.drag);if(node){node.x=p.x;node.y=p.y;this.reset();}},{signal});const stop=()=>this.drag=-1;this.canvas.addEventListener("pointerup",stop,{signal});this.canvas.addEventListener("pointercancel",stop,{signal});}
    random(){this.points=[];this.nextId=0;for(let i=0;i<24;i++)this.points.push({id:this.nextId++,x:.07+Math.random()*.86,y:.08+Math.random()*.84});this.reset();}
    reset(){this.running=false;this.ops=[];this.cursor=0;this.current={};this.finalResult="—";this.state("Ready","Click to add points or drag an existing point");this.text("[data-points]",String(this.points.length));this.text("[data-operations]","0");this.text("[data-result]","—");this.updateRun();this.draw();}
    ensure(){if(this.ops.length)return;if(this.mode==="hull")this.buildHull();else if(this.mode==="sweep")this.buildSweep();else this.buildDelaunay();}
    cross(a:Point,b:Point,c:Point){return(b.x-a.x)*(c.y-a.y)-(b.y-a.y)*(c.x-a.x);}
    buildHull(){const sorted=[...this.points].sort((a,b)=>a.x-b.x||a.y-b.y);if(sorted.length<2){this.ops=[{hull:sorted.map(p=>p.id)}];this.finalResult=String(sorted.length);return;}const lower:Point[]=[],upper:Point[]=[];for(const p of sorted){while(lower.length>=2&&this.cross(lower.at(-2)!,lower.at(-1)!,p)<=0){lower.pop();this.ops.push({active:p.id,hull:lower.map(x=>x.id)});}lower.push(p);this.ops.push({active:p.id,hull:lower.map(x=>x.id)});}for(const p of [...sorted].reverse()){while(upper.length>=2&&this.cross(upper.at(-2)!,upper.at(-1)!,p)<=0){upper.pop();this.ops.push({active:p.id,hull:[...lower.slice(0,-1),...upper].map(x=>x.id)});}upper.push(p);this.ops.push({active:p.id,hull:[...lower.slice(0,-1),...upper].map(x=>x.id)});}const hull=[...lower.slice(0,-1),...upper.slice(0,-1)];this.ops.push({hull:hull.map(p=>p.id)});this.finalResult=String(hull.length);}
    buildSweep(){const sorted=[...this.points].sort((a,b)=>a.x-b.x);let best=Infinity,bestPair:number[]=[];for(let i=0;i<sorted.length;i++){const p=sorted[i];for(let j=i-1;j>=0&&p.x-sorted[j].x<best;j--){const q=sorted[j],d=Math.hypot(p.x-q.x,p.y-q.y);if(d<best){best=d;bestPair=[p.id,q.id];}this.ops.push({active:p.id,sweep:p.x,pair:[p.id,q.id],best:[...bestPair],distance:best});}}this.finalResult=Number.isFinite(best)?best.toFixed(3):"—";}
    buildDelaunay(){this.extras.clear();const superPoints:Point[]=[{id:-1,x:-8,y:-5},{id:-2,x:9,y:-5},{id:-3,x:.5,y:9}];superPoints.forEach(p=>this.extras.set(p.id,p));let triangles:Point[][]=[[...superPoints]];for(const p of this.points){const bad=triangles.filter(t=>this.inCircle(t[0],t[1],t[2],p));const counts=new Map<string,{edge:[Point,Point];count:number}>();for(const t of bad)for(const [a,b] of [[t[0],t[1]],[t[1],t[2]],[t[2],t[0]]] as [Point,Point][]){const key=a.id<b.id?`${a.id},${b.id}`:`${b.id},${a.id}`;const found=counts.get(key);if(found)found.count++;else counts.set(key,{edge:[a,b],count:1});}triangles=triangles.filter(t=>!bad.includes(t));for(const {edge,count} of counts.values())if(count===1)triangles.push([edge[0],edge[1],p]);this.ops.push({active:p.id,triangles:triangles.map(t=>t.map(x=>x.id))});}triangles=triangles.filter(t=>t.every(p=>p.id>=0));this.ops.push({triangles:triangles.map(t=>t.map(x=>x.id))});this.finalResult=String(triangles.length);}
    inCircle(a:Point,b:Point,c:Point,p:Point){const ax=a.x-p.x,ay=a.y-p.y,bx=b.x-p.x,by=b.y-p.y,cx=c.x-p.x,cy=c.y-p.y;const det=(ax*ax+ay*ay)*(bx*cy-cx*by)-(bx*bx+by*by)*(ax*cy-cx*ay)+(cx*cx+cy*cy)*(ax*by-bx*ay);return this.cross(a,b,c)>0?det>0:det<0;}
    toggle(){if(this.cursor>=this.ops.length&&this.ops.length)this.reset();this.ensure();this.running=!this.running;this.state(this.running?"Constructing":"Paused",this.running?"Evaluating the next geometric predicate":"Construction suspended");this.updateRun();}
    advance(){const op=this.ops[this.cursor++];if(!op){this.finish();return;}this.current=op;this.text("[data-operations]",String(this.cursor));this.state("Constructing",this.mode==="hull"?"Testing the orientation of the next turn":this.mode==="sweep"?"Comparing a point inside the active strip":"Removing triangles whose circumcircle is violated");this.draw();if(this.cursor>=this.ops.length)this.finish();}
    finish(){this.running=false;this.text("[data-result]",this.finalResult);this.state("Complete",`${GEO_INFO[this.mode][0]} finished`);this.updateRun();this.draw();}
    animate(t:number){const d=Math.min(50,t-(this.last||t));this.last=t;if(this.running){this.acc+=d;const delay=1000/this.rate();while(this.acc>=delay&&this.running){this.acc-=delay;this.advance();}}this.frame=requestAnimationFrame(n=>this.animate(n));}
    rate(){const v=Number(this.querySelector<HTMLInputElement>("[data-speed]")?.value||50);return Math.round(2*Math.pow(2,v/21));}
    layout(){const r=this.canvas.getBoundingClientRect();if(!r.width)return;const d=Math.min(devicePixelRatio||1,2);this.width=r.width;this.height=r.height;this.canvas.width=r.width*d;this.canvas.height=r.height*d;this.ctx.setTransform(d,0,0,d,0,0);this.draw();}
    point(id:number){return this.points.find(p=>p.id===id)||this.extras.get(id)!;}screen(p:Point){return{x:p.x*this.width,y:p.y*this.height};}
    draw(){if(!this.ctx||!this.width)return;const c=this.ctx,s=getComputedStyle(this),v=(n:string)=>s.getPropertyValue(n).trim();c.clearRect(0,0,this.width,this.height);if(this.current.triangles){for(const ids of this.current.triangles){const pts=ids.map(id=>this.screen(this.point(id)));c.beginPath();c.moveTo(pts[0].x,pts[0].y);c.lineTo(pts[1].x,pts[1].y);c.lineTo(pts[2].x,pts[2].y);c.closePath();c.fillStyle=v("--geo-fill");c.fill();c.strokeStyle=ids.some(id=>id<0)?v("--geo-faint"):v("--geo-result");c.lineWidth=1;c.stroke();}}if(this.current.hull?.length){const pts=this.current.hull.map(id=>this.screen(this.point(id)));c.beginPath();c.moveTo(pts[0].x,pts[0].y);pts.slice(1).forEach(p=>c.lineTo(p.x,p.y));if(this.cursor>=this.ops.length)c.closePath();c.strokeStyle=v("--geo-result");c.lineWidth=2;c.stroke();}if(this.current.sweep!==undefined){c.strokeStyle=v("--geo-sweep");c.setLineDash([5,5]);c.beginPath();c.moveTo(this.current.sweep*this.width,0);c.lineTo(this.current.sweep*this.width,this.height);c.stroke();c.setLineDash([]);}const line=(ids:number[]|undefined,color:string,width:number)=>{if(!ids?.length)return;const a=this.screen(this.point(ids[0])),b=this.screen(this.point(ids[1]));c.strokeStyle=color;c.lineWidth=width;c.beginPath();c.moveTo(a.x,a.y);c.lineTo(b.x,b.y);c.stroke();};line(this.current.best,v("--geo-result"),3);line(this.current.pair,v("--geo-candidate"),1);for(const p of this.points){const q=this.screen(p);c.beginPath();c.arc(q.x,q.y,p.id===this.current.active?6:4,0,Math.PI*2);c.fillStyle=p.id===this.current.active?v("--geo-active"):v("--geo-point");c.fill();c.strokeStyle=v("--geo-outline");c.stroke();}}
    coords(e:PointerEvent){const r=this.canvas.getBoundingClientRect();return{x:Math.max(.02,Math.min(.98,(e.clientX-r.left)/r.width)),y:Math.max(.03,Math.min(.97,(e.clientY-r.top)/r.height))};}pointAt(e:PointerEvent){const p=this.coords(e);let id=-1,d=.035;for(const n of this.points){const x=Math.hypot(n.x-p.x,n.y-p.y);if(x<d){d=x;id=n.id;}}return id;}
    state(a:string,b:string){this.text("[data-state]",a);this.text("[data-message]",b);}updateRun(){this.text("[data-run]",this.running?"Ⅱ Pause":"▶ Construct");this.querySelector("[data-run]")?.classList.toggle("active",this.running);}text(q:string,x:string){const e=this.querySelector(q);if(e)e.textContent=x;}
  }
  if(!customElements.get("geometry-laboratory"))customElements.define("geometry-laboratory",GeometryLaboratory);
</script>

<style>
  geometry-laboratory{--geo-point:var(--paper-raised);--geo-outline:var(--ink-soft);--geo-active:#c8401a;--geo-candidate:#d9a52b;--geo-result:#4b3fd6;--geo-sweep:#c8401a;--geo-fill:rgba(75,63,214,.05);--geo-faint:var(--rule);display:block}:global(html[data-theme="dark"]) geometry-laboratory{--geo-point:#c4d1ee;--geo-outline:#445170;--geo-active:#ff6687;--geo-candidate:#f0c95b;--geo-result:#6fd6ff;--geo-sweep:#ff6687;--geo-fill:rgba(111,214,255,.04);--geo-faint:#26304d}.geometry-layout{display:grid;grid-template-columns:minmax(31rem,1.4fr) minmax(17rem,.6fr);min-height:35rem}.plane{display:grid;grid-template-rows:1fr auto;padding:1rem;border-right:1px solid var(--glass-border);background:linear-gradient(to right,var(--reseau) 1px,transparent 1px),linear-gradient(to bottom,var(--reseau) 1px,transparent 1px);background-size:24px 24px}canvas{display:block;width:100%;height:100%;min-height:29rem;touch-action:none;cursor:crosshair}.plane-legend{display:flex;gap:1rem;padding-top:.6rem;color:var(--ink-faint);font-size:.5rem}.plane-legend span{display:flex;align-items:center;gap:.3rem}.plane-legend i{width:8px;height:8px;border-radius:50%}.active{background:var(--geo-active)}.candidate{background:var(--geo-candidate)}.result{background:var(--geo-result)}aside{padding:1.4rem;background:color-mix(in srgb,var(--paper-sunken) 38%,transparent)}aside h2{margin:.55rem 0 .7rem;font-family:var(--font-display);font-size:2rem;font-weight:400;line-height:1}aside>p:not(.label){min-height:4.2rem;color:var(--ink-soft);font-size:.68rem}.instrument-metrics{grid-template-columns:1fr;margin-top:1.1rem}.predicate{margin-top:1.3rem;padding-top:1rem;border-top:1px solid var(--rule)}.predicate code{display:block;margin-top:.65rem;padding:.75rem;color:var(--ink-soft);background:var(--code-wash);border:1px solid var(--rule);font-size:.58rem}@media(max-width:55rem){.geometry-layout{grid-template-columns:1fr}.plane{border-right:0;border-bottom:1px solid var(--glass-border)}aside .instrument-metrics{grid-template-columns:repeat(3,1fr)}}@media(max-width:40rem){canvas{min-height:23rem}}
</style>

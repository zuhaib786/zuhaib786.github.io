<dynamic-programming-laboratory>
  <section class="instrument dp-lab" aria-label="Interactive dynamic programming table visualizer">
    <div class="instrument-tabs"><button class="active" data-mode="edit">Edit distance</button><button data-mode="lcs">Longest subsequence</button><button data-mode="knapsack">0/1 knapsack</button></div>
    <div class="instrument-status"><span><strong data-state>Ready</strong> · <span data-message>Each cell stores the answer to one smaller problem</span></span><span class="hint">Highlighted cells are the current dependencies</span></div>
    <div class="dp-layout">
      <div class="matrix-stage"><canvas data-matrix aria-label="Dynamic programming dependency table"></canvas><div class="matrix-legend label"><span><i class="dependency"></i>Dependency</span><span><i class="current"></i>Writing</span><span><i class="solution"></i>Traceback</span></div></div>
      <aside>
        <p class="label label--accent">Subproblem</p><h2 data-name>Levenshtein distance</h2><p data-description>Choose the cheapest deletion, insertion, or substitution for every pair of prefixes.</p>
        <div class="instrument-metrics"><div><span data-result>—</span><small>Optimal value</small></div><div><span data-filled>0%</span><small>Table filled</small></div><div><span data-decisions>0</span><small>Transitions</small></div></div>
        <div class="recurrence"><p class="label">Recurrence</p><code data-recurrence>min(delete, insert, substitute)</code></div>
      </aside>
    </div>
    <div class="input-strip"><label><span data-label-a>Source</span><input data-a value="kitten" /></label><label><span data-label-b>Target</span><input data-b value="sitting" /></label><label data-cap-wrap hidden><span>Capacity</span><input data-cap type="number" min="1" max="30" value="12" /></label><button class="instrument-action" data-apply>Apply input</button></div>
    <div class="instrument-toolbar"><button class="instrument-action primary" data-run>▶ Fill table</button><button class="instrument-action" data-step>Fill one cell →</button><button class="instrument-action" data-reset>Reset</button><label class="instrument-range"><span>Speed <b data-speed-label>18 cell/s</b></span><input data-speed type="range" min="1" max="100" value="55" /></label></div>
  </section>
</dynamic-programming-laboratory>

<script>
  type Mode="edit"|"lcs"|"knapsack";type Op={r:number;c:number;value:number;deps:[number,number][]};
  const DP_INFO:Record<Mode,[string,string,string]>={edit:["Levenshtein distance","Choose the cheapest deletion, insertion, or substitution for every pair of prefixes.","min(delete, insert, substitute)"],lcs:["Longest common subsequence","Extend a match diagonally; otherwise keep the better answer from removing either final symbol.","match ? diagonal + 1 : max(up, left)"],knapsack:["0/1 knapsack","For each item and capacity, compare skipping it with taking it exactly once.","max(skip, value + remaining capacity)"]};
  class DynamicProgrammingLaboratory extends HTMLElement{
    mode:Mode="edit";a="kitten";b="sitting";capacity=12;weights=[2,3,4,5,7];values=[3,4,5,8,10];matrix:number[][]=[];final:number[][]=[];ops:Op[]=[];cursor=0;running=false;current:Op|null=null;trace=new Set<string>();rows=0;cols=0;
    canvas!:HTMLCanvasElement;ctx!:CanvasRenderingContext2D;width=0;height=0;frame=0;last=0;acc=0;aborter=new AbortController();resize?:ResizeObserver;theme?:MutationObserver;
    connectedCallback(){this.canvas=this.querySelector("[data-matrix]") as HTMLCanvasElement;const c=this.canvas.getContext("2d");if(!c)return;this.ctx=c;this.bind();this.resize=new ResizeObserver(()=>this.layout());this.resize.observe(this.canvas);this.theme=new MutationObserver(()=>this.draw());this.theme.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});this.build();this.layout();this.frame=requestAnimationFrame(t=>this.animate(t));}
    disconnectedCallback(){cancelAnimationFrame(this.frame);this.aborter.abort();this.resize?.disconnect();this.theme?.disconnect();}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(btn=>btn.addEventListener("click",()=>{this.mode=btn.dataset.mode as Mode;this.querySelectorAll("[data-mode]").forEach(x=>x.classList.toggle("active",x===btn));const info=DP_INFO[this.mode];this.text("[data-name]",info[0]);this.text("[data-description]",info[1]);this.text("[data-recurrence]",info[2]);const cap=this.querySelector<HTMLElement>("[data-cap-wrap]");if(cap)cap.hidden=this.mode!=="knapsack";this.text("[data-label-a]",this.mode==="knapsack"?"Weights":"Source");this.text("[data-label-b]",this.mode==="knapsack"?"Values":"Target");const a=this.querySelector<HTMLInputElement>("[data-a]"),b=this.querySelector<HTMLInputElement>("[data-b]");if(a)a.value=this.mode==="knapsack"?"2,3,4,5,7":"kitten";if(b)b.value=this.mode==="knapsack"?"3,4,5,8,10":"sitting";this.apply();},{signal}));this.querySelector("[data-apply]")?.addEventListener("click",()=>this.apply(),{signal});this.querySelector("[data-run]")?.addEventListener("click",()=>this.toggle(),{signal});this.querySelector("[data-step]")?.addEventListener("click",()=>{this.running=false;this.advance();this.updateRun();},{signal});this.querySelector("[data-reset]")?.addEventListener("click",()=>this.build(),{signal});this.querySelector<HTMLInputElement>("[data-speed]")?.addEventListener("input",()=>this.text("[data-speed-label]",`${this.rate()} cell/s`),{signal});}
    apply(){const a=this.querySelector<HTMLInputElement>("[data-a]")?.value||"",b=this.querySelector<HTMLInputElement>("[data-b]")?.value||"";if(this.mode==="knapsack"){this.weights=a.split(",").map(Number).filter(n=>n>0).slice(0,8);this.values=b.split(",").map(Number).filter(Number.isFinite).slice(0,this.weights.length);while(this.values.length<this.weights.length)this.values.push(1);this.capacity=Math.max(1,Math.min(30,Number(this.querySelector<HTMLInputElement>("[data-cap]")?.value||12)));}else{this.a=a.slice(0,12);this.b=b.slice(0,12);}this.build();}
    build(){this.running=false;this.cursor=0;this.current=null;this.trace.clear();this.ops=[];if(this.mode==="knapsack")this.buildKnapsack();else this.buildStrings();this.matrix=Array.from({length:this.rows},()=>Array(this.cols).fill(NaN));if(this.mode==="edit"){for(let r=0;r<this.rows;r++)this.matrix[r][0]=r;for(let c=0;c<this.cols;c++)this.matrix[0][c]=c;}else{for(let r=0;r<this.rows;r++)this.matrix[r][0]=0;for(let c=0;c<this.cols;c++)this.matrix[0][c]=0;}this.state("Ready","Each cell stores the answer to one smaller problem");this.text("[data-result]","—");this.text("[data-filled]","0%");this.text("[data-decisions]","0");this.updateRun();this.draw();}
    buildStrings(){this.rows=this.b.length+1;this.cols=this.a.length+1;const t=Array.from({length:this.rows},()=>Array(this.cols).fill(0));if(this.mode==="edit"){for(let r=0;r<this.rows;r++)t[r][0]=r;for(let c=0;c<this.cols;c++)t[0][c]=c;}for(let r=1;r<this.rows;r++)for(let c=1;c<this.cols;c++){if(this.mode==="edit"){const cost=this.a[c-1]===this.b[r-1]?0:1;t[r][c]=Math.min(t[r-1][c]+1,t[r][c-1]+1,t[r-1][c-1]+cost);this.ops.push({r,c,value:t[r][c],deps:[[r-1,c],[r,c-1],[r-1,c-1]]});}else{t[r][c]=this.a[c-1]===this.b[r-1]?t[r-1][c-1]+1:Math.max(t[r-1][c],t[r][c-1]);this.ops.push({r,c,value:t[r][c],deps:this.a[c-1]===this.b[r-1]?[[r-1,c-1]]:[[r-1,c],[r,c-1]]});}}this.final=t;}
    buildKnapsack(){this.rows=this.weights.length+1;this.cols=this.capacity+1;const t=Array.from({length:this.rows},()=>Array(this.cols).fill(0));for(let r=1;r<this.rows;r++)for(let c=1;c<this.cols;c++){const w=this.weights[r-1],skip=t[r-1][c];if(w<=c){t[r][c]=Math.max(skip,this.values[r-1]+t[r-1][c-w]);this.ops.push({r,c,value:t[r][c],deps:[[r-1,c],[r-1,c-w]]});}else{t[r][c]=skip;this.ops.push({r,c,value:skip,deps:[[r-1,c]]});}}this.final=t;}
    toggle(){if(this.cursor>=this.ops.length)this.build();this.running=!this.running;this.state(this.running?"Filling table":"Paused",this.running?"Solving subproblems in dependency order":"Execution suspended");this.updateRun();}
    advance(){const op=this.ops[this.cursor++];if(!op){this.finish();return;}this.current=op;this.matrix[op.r][op.c]=op.value;this.text("[data-filled]",`${Math.round(this.cursor/this.ops.length*100)}%`);this.text("[data-decisions]",String(this.cursor));this.state("Writing cell",`dp[${op.r}, ${op.c}] = ${op.value}`);this.draw();if(this.cursor>=this.ops.length)this.finish();}
    finish(){this.running=false;this.current=null;const result=this.final[this.rows-1][this.cols-1];this.text("[data-result]",String(result));this.makeTrace();this.state("Complete",`Optimal value: ${result}`);this.updateRun();this.draw();}
    makeTrace(){this.trace.clear();let r=this.rows-1,c=this.cols-1;while(r>0||c>0){this.trace.add(`${r},${c}`);if(this.mode==="edit"){if(r>0&&c>0&&this.final[r][c]===this.final[r-1][c-1]+(this.a[c-1]===this.b[r-1]?0:1)){r--;c--;}else if(r>0&&this.final[r][c]===this.final[r-1][c]+1)r--;else c--;}else if(this.mode==="lcs"){if(r>0&&c>0&&this.a[c-1]===this.b[r-1]){r--;c--;}else if(r>0&&(c===0||this.final[r-1][c]>=this.final[r][c-1]))r--;else c--;}else{if(r>0&&this.final[r][c]!==this.final[r-1][c])c-=this.weights[r-1];r--;}if(r<0||c<0)break;}this.trace.add("0,0");}
    animate(t:number){const d=Math.min(50,t-(this.last||t));this.last=t;if(this.running){this.acc+=d;const delay=1000/this.rate();while(this.acc>=delay&&this.running){this.acc-=delay;this.advance();}}this.frame=requestAnimationFrame(n=>this.animate(n));}
    rate(){const v=Number(this.querySelector<HTMLInputElement>("[data-speed]")?.value||55);return Math.round(2*Math.pow(2,v/17));}
    layout(){const r=this.canvas.getBoundingClientRect();if(!r.width)return;const d=Math.min(devicePixelRatio||1,2);this.width=r.width;this.height=r.height;this.canvas.width=r.width*d;this.canvas.height=r.height*d;this.ctx.setTransform(d,0,0,d,0,0);this.draw();}
    draw(){if(!this.ctx||!this.width||!this.rows)return;const x=this.ctx,s=getComputedStyle(this),v=(n:string)=>s.getPropertyValue(n).trim(),marginX=46,marginY=45,cw=(this.width-marginX-12)/this.cols,ch=(this.height-marginY-12)/this.rows;x.clearRect(0,0,this.width,this.height);const deps=new Set(this.current?.deps.map(d=>d.join(","))||[]);for(let r=0;r<this.rows;r++)for(let c=0;c<this.cols;c++){const key=`${r},${c}`,px=marginX+c*cw,py=marginY+r*ch;let fill=v("--d-cell");if(deps.has(key))fill=v("--d-dep");if(this.trace.has(key))fill=v("--d-trace");if(this.current?.r===r&&this.current.c===c)fill=v("--d-current");x.fillStyle=fill;x.fillRect(px+1,py+1,Math.max(1,cw-2),Math.max(1,ch-2));const value=this.matrix[r]?.[c];if(Number.isFinite(value)){x.fillStyle=this.current?.r===r&&this.current.c===c?v("--d-on"):v("--d-text");x.font=`${Math.max(7,Math.min(12,cw*.32))}px IBM Plex Mono`;x.textAlign="center";x.textBaseline="middle";x.fillText(String(value),px+cw/2,py+ch/2);}}x.fillStyle=v("--d-label");x.font="10px IBM Plex Mono";x.textAlign="center";if(this.mode==="knapsack"){for(let c=0;c<this.cols;c++)x.fillText(String(c),marginX+(c+.5)*cw,marginY-12);for(let r=1;r<this.rows;r++)x.fillText(`w${this.weights[r-1]}`,marginX-22,marginY+(r+.5)*ch);}else{for(let c=1;c<this.cols;c++)x.fillText(this.a[c-1],marginX+(c+.5)*cw,marginY-12);for(let r=1;r<this.rows;r++)x.fillText(this.b[r-1],marginX-20,marginY+(r+.5)*ch);}x.textAlign="start";}
    state(a:string,b:string){this.text("[data-state]",a);this.text("[data-message]",b);}updateRun(){this.text("[data-run]",this.running?"Ⅱ Pause":"▶ Fill table");this.querySelector("[data-run]")?.classList.toggle("active",this.running);}text(q:string,z:string){const e=this.querySelector(q);if(e)e.textContent=z;}
  }
  if(!customElements.get("dynamic-programming-laboratory"))customElements.define("dynamic-programming-laboratory",DynamicProgrammingLaboratory);
</script>

<style>
  dynamic-programming-laboratory{--d-cell:color-mix(in srgb,var(--paper-raised) 55%,transparent);--d-dep:#d9a52b;--d-current:#c8401a;--d-trace:#4b3fd6;--d-text:var(--ink);--d-on:#fff;--d-label:var(--ink-faint);display:block}:global(html[data-theme="dark"]) dynamic-programming-laboratory{--d-cell:rgba(255,255,255,.035);--d-dep:#8b6d2a;--d-current:#ff6687;--d-trace:#337fa4;--d-text:#e8ecf7;--d-on:#07101a}.dp-layout{display:grid;grid-template-columns:minmax(31rem,1.4fr) minmax(17rem,.6fr);min-height:35rem}.matrix-stage{display:grid;grid-template-rows:1fr auto;padding:1rem;border-right:1px solid var(--glass-border);overflow:hidden;background:linear-gradient(to right,var(--reseau) 1px,transparent 1px),linear-gradient(to bottom,var(--reseau) 1px,transparent 1px);background-size:24px 24px}canvas{display:block;width:100%;height:100%;min-height:29rem}.matrix-legend{display:flex;gap:1rem;padding-top:.6rem;color:var(--ink-faint);font-size:.5rem}.matrix-legend span{display:flex;align-items:center;gap:.3rem}.matrix-legend i{width:8px;height:8px;border-radius:2px}.dependency{background:var(--d-dep)}.current{background:var(--d-current)}.solution{background:var(--d-trace)}aside{padding:1.4rem;background:color-mix(in srgb,var(--paper-sunken) 38%,transparent)}aside h2{margin:.55rem 0 .7rem;font-family:var(--font-display);font-size:2rem;font-weight:400;line-height:1}aside>p:not(.label){min-height:4.2rem;color:var(--ink-soft);font-size:.68rem}.instrument-metrics{grid-template-columns:1fr;margin-top:1.1rem}.recurrence{margin-top:1.3rem;padding-top:1rem;border-top:1px solid var(--rule)}.recurrence code{display:block;margin-top:.65rem;padding:.75rem;color:var(--ink-soft);background:var(--code-wash);border:1px solid var(--rule);font-size:.6rem}.input-strip{display:grid;grid-template-columns:1fr 1fr .45fr auto;align-items:end;gap:.6rem;padding:.8rem 1rem;border-top:1px solid var(--glass-border);background:color-mix(in srgb,var(--paper-sunken) 26%,transparent)}.input-strip label{display:grid;gap:.25rem;color:var(--ink-faint);font-size:.5rem;letter-spacing:.06em;text-transform:uppercase}.input-strip input{min-width:0;height:2.4rem;padding:.4rem .55rem;color:var(--ink);background:var(--glass);border:1px solid var(--rule);border-radius:7px}@media(max-width:55rem){.dp-layout{grid-template-columns:1fr}.matrix-stage{border-right:0;border-bottom:1px solid var(--glass-border)}aside .instrument-metrics{grid-template-columns:repeat(3,1fr)}}@media(max-width:43rem){canvas{min-height:23rem}.input-strip{grid-template-columns:1fr}.input-strip button{width:100%}}
</style>

<wave-laboratory>
  <section class="math-instrument" aria-label="Interactive wave equation laboratory">
    <div class="math-bar"><div class="math-state"><i></i><span data-state>Finite differences · evolving initial data</span></div><div class="math-actions"><div class="math-tabs" aria-label="Wave medium"><button class="active" data-mode="string">String</button><button data-mode="membrane">Membrane</button><button data-mode="interference">Interference</button></div><button class="math-button" data-play>Pause</button><button class="math-button" data-excite>Excite</button><button class="math-button" data-clear>Clear</button></div></div>
    <div class="math-dashboard">
      <div class="math-stage physics-stage"><span class="math-stage-label label" data-stage-label>displacement · velocity · normal-mode spectrum</span><canvas data-canvas aria-label="String, membrane, and interference wave fields"></canvas></div>
      <aside class="math-readout"><p class="label label--accent">Wave laboratory</p><h2 data-title>A pluck becomes a spectrum</h2><p data-description>Local curvature accelerates the string. The resulting motion is simultaneously a travelling disturbance and a superposition of normal modes.</p><div class="math-formula" data-formula>∂²u/∂t² = c² ∇²u − γ ∂u/∂t</div>
        <div class="math-metrics"><div><strong data-energy>0.000</strong><small>Total discrete energy</small></div><div><strong data-mode-value>n = 1</strong><small data-mode-label>Dominant mode</small></div><div><strong data-cfl>0.350</strong><small>CFL number</small></div></div>
        <div class="math-controls"><div class="math-control"><label><span>Boundary condition</span><b data-boundary-value>Fixed</b></label><select data-boundary><option value="fixed">Fixed ends</option><option value="free">Free ends</option><option value="periodic">Periodic</option></select></div><div class="math-control"><label><span>Wave speed c</span><b data-speed-value>0.80</b></label><input data-speed type="range" min="0.3" max="1.2" step="0.05" value="0.8" /></div><div class="math-control"><label><span>Damping γ</span><b data-damping-value>0.006</b></label><input data-damping type="range" min="0" max="0.08" step="0.002" value="0.006" /></div><div class="math-control"><label><span>Brush width</span><b data-brush-value>8</b></label><input data-brush type="range" min="2" max="18" step="1" value="8" /></div></div>
        <div class="math-legend"><span><i></i>positive displacement</span><span><i></i>negative displacement</span><span><i></i>kinetic contribution</span></div><div class="math-trace"><p class="label">Numerical reading</p><ol><li data-reading-1>Fixed ends admit sine modes with nodes at both boundaries.</li><li data-reading-2>The spectrum is projected directly from the evolving displacement.</li><li data-reading-3>The CFL number remains below the finite-difference stability limit.</li></ol></div>
      </aside>
    </div>
  </section>
</wave-laboratory>

<script>
  type Mode="string"|"membrane"|"interference";type Boundary="fixed"|"free"|"periodic";
  const WAVE_INFO:Record<Mode,[string,string,string,string]>={string:["A pluck becomes a spectrum","Local curvature accelerates the string. The resulting motion is simultaneously a travelling disturbance and a superposition of normal modes.","∂²u/∂t² = c² ∂²u/∂x² − γ∂u/∂t","displacement · velocity · normal-mode spectrum"],membrane:["A surface chooses its nodes","A two-dimensional membrane supports indexed mode families. Paint displacement into it and watch fronts reflect into nodal geometry.","∂²u/∂t² = c²(∂²ₓu + ∂²ᵧu) − γ∂u/∂t","membrane displacement · nodal geometry"],interference:["Phase writes stationary geometry","Two coherent point sources overlap. Loci of equal path difference reinforce while half-wavelength differences cancel.","u = sin(kr₁−ωt)/√r₁ + sin(kr₂−ωt)/√r₂","coherent sources · path difference · fringes"]};
  class WaveLaboratory extends HTMLElement{
    canvas!:HTMLCanvasElement;ctx!:CanvasRenderingContext2D;width=0;height=0;mode:Mode="string";boundary:Boundary="fixed";speed=.8;damping=.006;brush=8;playing=true;frame=0;last=0;phase=0;N=240;u=new Float64Array(this.N);v=new Float64Array(this.N);cols=72;rows=48;um=new Float32Array(this.cols*this.rows);vm=new Float32Array(this.cols*this.rows);scratch=new Float32Array(this.cols*this.rows);sources=[{x:-1.25,y:0},{x:1.25,y:0}];dragSource=-1;painting=false;resize?:ResizeObserver;theme?:MutationObserver;aborter=new AbortController();
    connectedCallback(){this.canvas=this.querySelector("[data-canvas]") as HTMLCanvasElement;const c=this.canvas.getContext("2d");if(!c)return;this.ctx=c;this.bind();this.resize=new ResizeObserver(()=>this.layout());this.resize.observe(this.canvas);this.theme=new MutationObserver(()=>this.draw());this.theme.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});this.excite();this.layout();this.frame=requestAnimationFrame(t=>this.animate(t));}
    disconnectedCallback(){cancelAnimationFrame(this.frame);this.aborter.abort();this.resize?.disconnect();this.theme?.disconnect();}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(b=>b.addEventListener("click",()=>{this.mode=b.dataset.mode as Mode;this.querySelectorAll("[data-mode]").forEach(x=>x.classList.toggle("active",x===b));this.configure();this.clear();this.excite();},{signal}));this.querySelector("[data-play]")?.addEventListener("click",()=>{this.playing=!this.playing;const b=this.querySelector<HTMLButtonElement>("[data-play]");if(b)b.textContent=this.playing?"Pause":"Run";this.text("[data-state]",this.playing?"Finite differences · evolving initial data":"Paused · paint a new displacement");},{signal});this.querySelector("[data-excite]")?.addEventListener("click",()=>{this.clear();this.excite();},{signal});this.querySelector("[data-clear]")?.addEventListener("click",()=>this.clear(),{signal});this.querySelector<HTMLSelectElement>("[data-boundary]")?.addEventListener("change",e=>{this.boundary=(e.currentTarget as HTMLSelectElement).value as Boundary;this.text("[data-boundary-value]",this.boundary[0].toUpperCase()+this.boundary.slice(1));this.enforceBoundary();this.updateReading();this.draw();},{signal});this.range("[data-speed]",v=>{this.speed=v;this.text("[data-speed-value]",v.toFixed(2));this.updateMetrics();});this.range("[data-damping]",v=>{this.damping=v;this.text("[data-damping-value]",v.toFixed(3));});this.range("[data-brush]",v=>{this.brush=v;this.text("[data-brush-value]",String(v));});this.canvas.addEventListener("pointerdown",e=>{this.painting=true;this.canvas.setPointerCapture(e.pointerId);this.paint(e);},{signal});this.canvas.addEventListener("pointermove",e=>{if(this.painting)this.paint(e);},{signal});const up=(e:PointerEvent)=>{this.painting=false;this.dragSource=-1;if(this.canvas.hasPointerCapture(e.pointerId))this.canvas.releasePointerCapture(e.pointerId);};this.canvas.addEventListener("pointerup",up,{signal});this.canvas.addEventListener("pointercancel",up,{signal});}
    range(q:string,fn:(v:number)=>void){this.querySelector<HTMLInputElement>(q)?.addEventListener("input",e=>fn(Number((e.currentTarget as HTMLInputElement).value)),{signal:this.aborter.signal});}
    configure(){const i=WAVE_INFO[this.mode];this.text("[data-title]",i[0]);this.text("[data-description]",i[1]);this.text("[data-formula]",i[2]);this.text("[data-stage-label]",i[3]);this.updateReading();}
    clear(){this.u.fill(0);this.v.fill(0);this.um.fill(0);this.vm.fill(0);this.phase=0;this.draw();}
    excite(){if(this.mode==="string"){const centre=.37;for(let i=0;i<this.N;i++){const x=i/(this.N-1);this.u[i]=x<centre?x/centre:(1-x)/(1-centre);this.u[i]*=.78;}}else if(this.mode==="membrane"){for(let y=0;y<this.rows;y++)for(let x=0;x<this.cols;x++)this.um[y*this.cols+x]=.72*Math.sin(Math.PI*x/(this.cols-1))*Math.sin(2*Math.PI*y/(this.rows-1));}else this.sources=[{x:-1.25,y:0},{x:1.25,y:0}];this.enforceBoundary();this.updateMetrics();this.draw();}
    enforceBoundary(){if(this.boundary==="fixed"){this.u[0]=this.u[this.N-1]=0;this.v[0]=this.v[this.N-1]=0;}else if(this.boundary==="free"){this.u[0]=this.u[1];this.u[this.N-1]=this.u[this.N-2];}if(this.boundary!=="periodic"){for(let x=0;x<this.cols;x++){this.um[x]=0;this.um[(this.rows-1)*this.cols+x]=0;this.vm[x]=0;this.vm[(this.rows-1)*this.cols+x]=0;}for(let y=0;y<this.rows;y++){this.um[y*this.cols]=0;this.um[y*this.cols+this.cols-1]=0;this.vm[y*this.cols]=0;this.vm[y*this.cols+this.cols-1]=0;}}}
    stepString(){const dt=.36,c2=this.speed*this.speed,start=this.boundary==="periodic"?0:1,end=this.boundary==="periodic"?this.N:this.N-1;for(let i=start;i<end;i++){const l=i===0?this.N-1:i-1,r=i===this.N-1?0:i+1,a=c2*(this.u[l]-2*this.u[i]+this.u[r])-this.damping*this.v[i];this.v[i]+=a*dt;}for(let i=start;i<end;i++)this.u[i]+=this.v[i]*dt;this.enforceBoundary();}
    stepMembrane(){const dt=.28,c2=this.speed*this.speed,periodic=this.boundary==="periodic";for(let y=0;y<this.rows;y++)for(let x=0;x<this.cols;x++){if(!periodic&&(x===0||y===0||x===this.cols-1||y===this.rows-1)){this.scratch[y*this.cols+x]=0;continue;}const xm=x?x-1:this.cols-1,xp=x<this.cols-1?x+1:0,ym=y?y-1:this.rows-1,yp=y<this.rows-1?y+1:0,i=y*this.cols+x,lap=this.um[y*this.cols+xm]+this.um[y*this.cols+xp]+this.um[ym*this.cols+x]+this.um[yp*this.cols+x]-4*this.um[i];this.vm[i]+=(c2*lap-this.damping*this.vm[i])*dt;this.scratch[i]=this.um[i]+this.vm[i]*dt;}const swap=this.um;this.um=this.scratch;this.scratch=swap;this.enforceBoundary();}
    animate(t:number){if(this.playing&&t-this.last>16){this.last=t;if(this.mode==="string")for(let k=0;k<2;k++)this.stepString();else if(this.mode==="membrane")for(let k=0;k<2;k++)this.stepMembrane();else this.phase+=this.speed*.07;this.updateMetrics();this.draw();}this.frame=requestAnimationFrame(x=>this.animate(x));}
    paint(e:PointerEvent){const r=this.canvas.getBoundingClientRect(),px=e.clientX-r.left,py=e.clientY-r.top;if(this.mode==="interference"){const world=this.interferenceWorld(px,py);if(this.dragSource<0){let best=0;if(Math.hypot(world.x-this.sources[1].x,world.y-this.sources[1].y)<Math.hypot(world.x-this.sources[0].x,world.y-this.sources[0].y))best=1;this.dragSource=best;}this.sources[this.dragSource]=world;this.draw();return;}if(this.mode==="string"){const index=Math.round(px/this.width*(this.N-1)),target=(.5-py/(this.height*.72))*2;for(let j=Math.max(0,index-this.brush*2);j<=Math.min(this.N-1,index+this.brush*2);j++){const w=Math.exp(-Math.pow((j-index)/this.brush,2));this.u[j]=this.u[j]*(1-w)+target*w;this.v[j]=0;}}else{const gx=Math.round(px/this.width*(this.cols-1)),gy=Math.round(py/this.height*(this.rows-1)),target=.85;for(let y=Math.max(1,gy-this.brush);y<Math.min(this.rows-1,gy+this.brush);y++)for(let x=Math.max(1,gx-this.brush);x<Math.min(this.cols-1,gx+this.brush);x++){const d2=((x-gx)**2+(y-gy)**2)/(this.brush*this.brush),w=Math.exp(-d2*2);this.um[y*this.cols+x]=this.um[y*this.cols+x]*(1-w)+target*w;this.vm[y*this.cols+x]=0;}}this.enforceBoundary();this.updateMetrics();this.draw();}
    interferenceWorld(px:number,py:number){const sx=6,aspect=this.height/this.width;return{x:(px/this.width-.5)*sx,y:(.5-py/this.height)*sx*aspect}}
    energy(){if(this.mode==="string"){let k=0,p=0;for(let i=0;i<this.N;i++)k+=.5*this.v[i]*this.v[i];for(let i=0;i<this.N-1;i++)p+=.5*this.speed*this.speed*(this.u[i+1]-this.u[i])**2;return(k+p)/this.N;}if(this.mode==="membrane"){let e=0;for(let y=0;y<this.rows;y++)for(let x=0;x<this.cols;x++){const i=y*this.cols+x;e+=.5*this.vm[i]*this.vm[i];if(x<this.cols-1)e+=.25*this.speed*this.speed*(this.um[i+1]-this.um[i])**2;if(y<this.rows-1)e+=.25*this.speed*this.speed*(this.um[i+this.cols]-this.um[i])**2;}return e/(this.cols*this.rows);}return 2;}
    spectrum(){const out:number[]=[];for(let n=1;n<=24;n++){let a=0;for(let i=0;i<this.N;i++)a+=this.u[i]*Math.sin(Math.PI*n*i/(this.N-1));out.push(Math.abs(a)*2/this.N);}return out;}
    updateMetrics(){const cfl=(this.mode==="membrane"?.28:.36)*this.speed*(this.mode==="membrane"?Math.SQRT2:1),spec=this.mode==="string"?this.spectrum():[],dom=spec.length?spec.indexOf(Math.max(...spec))+1:0;this.text("[data-energy]",this.energy().toExponential(2));this.text("[data-mode-value]",this.mode==="string"?`n = ${dom}`:this.mode==="membrane"?"2D lattice":"Δr fringes");this.text("[data-mode-label]",this.mode==="string"?"Dominant mode":this.mode==="membrane"?"Discrete medium":"Interference coordinate");this.text("[data-cfl]",cfl.toFixed(3));}
    updateReading(){if(this.mode==="string")this.text("[data-reading-1]",this.boundary==="fixed"?"Fixed ends admit sine modes with nodes at both boundaries.":this.boundary==="free"?"Free ends impose zero slope and allow an antinode at each boundary.":"Periodic boundaries turn the string into a closed translation-invariant loop.");else if(this.mode==="membrane")this.text("[data-reading-1]","The five-point Laplacian turns local curvature into normal acceleration.");else this.text("[data-reading-1]","Bright and dark fringes are contours of path difference modulo one wavelength.");}
    layout(){const r=this.canvas.getBoundingClientRect();if(!r.width)return;const d=Math.min(devicePixelRatio||1,2);this.width=r.width;this.height=r.height;this.canvas.width=Math.round(r.width*d);this.canvas.height=Math.round(r.height*d);this.ctx.setTransform(d,0,0,d,0,0);this.draw();}
    draw(){if(!this.width)return;const c=this.ctx;c.fillStyle=this.css("--paper-sunken");c.fillRect(0,0,this.width,this.height);if(this.mode==="string")this.drawString();else if(this.mode==="membrane")this.drawMembrane();else this.drawInterference();}
    drawString(){const c=this.ctx,h=this.height*.72,mid=h/2,amp=h*.34;c.strokeStyle=this.css("--rule");c.lineWidth=1;c.beginPath();c.moveTo(0,mid);c.lineTo(this.width,mid);c.stroke();const fill=c.createLinearGradient(0,0,this.width,0);fill.addColorStop(0,this.css("--math-a"));fill.addColorStop(1,this.css("--math-b"));c.strokeStyle=fill;c.lineWidth=2;c.beginPath();for(let i=0;i<this.N;i++){const x=i/(this.N-1)*this.width,y=mid-this.u[i]*amp;i?c.lineTo(x,y):c.moveTo(x,y);}c.stroke();c.globalAlpha=.28;c.fillStyle=this.css("--math-good");for(let i=0;i<this.N;i+=4){const x=i/(this.N-1)*this.width,y=mid-this.u[i]*amp;c.fillRect(x,y,1,-this.v[i]*amp*.28);}c.globalAlpha=1;this.drawSpectrum(h+18,this.height-h-34);}
    drawSpectrum(y:number,h:number){const c=this.ctx,s=this.spectrum(),pad=28,w=this.width-pad*2;c.strokeStyle=this.css("--rule");c.strokeRect(pad,y,w,h);const max=Math.max(...s,1e-6),bar=w/s.length;c.fillStyle=this.css("--math-a");s.forEach((v,i)=>{const bh=v/max*(h-22);c.globalAlpha=.25+.75*v/max;c.fillRect(pad+i*bar+1,y+h-bh-1,Math.max(1,bar-2),bh);});c.globalAlpha=1;c.fillStyle=this.css("--ink-faint");c.font="8px IBM Plex Mono";c.fillText("normal-mode amplitudes · n = 1…24",pad+6,y+12);}
    drawMembrane(){const c=this.ctx,off=document.createElement("canvas");off.width=this.cols;off.height=this.rows;const oc=off.getContext("2d")!,im=oc.createImageData(this.cols,this.rows),d=im.data;for(let i=0;i<this.um.length;i++){const x=Math.tanh(this.um[i]*1.7),a=Math.abs(x),pos=[70,122,244],neg=[246,92,50],base=document.documentElement.dataset.theme==="dark"?10:239,col=x>=0?pos:neg,k=i*4;d[k]=base*(1-a)+col[0]*a;d[k+1]=base*(1-a)+col[1]*a;d[k+2]=base*(1-a)+col[2]*a;d[k+3]=255;}oc.putImageData(im,0,0);c.imageSmoothingEnabled=true;c.drawImage(off,0,0,this.width,this.height);c.strokeStyle="rgba(255,255,255,.12)";c.lineWidth=.6;for(let x=0;x<=this.cols;x+=6){c.beginPath();c.moveTo(x/this.cols*this.width,0);c.lineTo(x/this.cols*this.width,this.height);c.stroke();}for(let y=0;y<=this.rows;y+=6){c.beginPath();c.moveTo(0,y/this.rows*this.height);c.lineTo(this.width,y/this.rows*this.height);c.stroke();}}
    drawInterference(){const c=this.ctx,rw=Math.max(120,Math.floor(this.width/3)),rh=Math.max(100,Math.floor(this.height/3)),off=document.createElement("canvas");off.width=rw;off.height=rh;const oc=off.getContext("2d")!,im=oc.createImageData(rw,rh),d=im.data,dark=document.documentElement.dataset.theme==="dark";for(let py=0;py<rh;py++)for(let px=0;px<rw;px++){const p=this.interferenceWorld(px/(rw-1)*this.width,py/(rh-1)*this.height),r1=Math.max(.08,Math.hypot(p.x-this.sources[0].x,p.y-this.sources[0].y)),r2=Math.max(.08,Math.hypot(p.x-this.sources[1].x,p.y-this.sources[1].y)),u=(Math.sin(8*r1-this.phase)/Math.sqrt(r1)+Math.sin(8*r2-this.phase)/Math.sqrt(r2))*.45,t=Math.tanh(u),a=Math.abs(t),pos=[64,202,244],neg=[255,107,71],base=dark?8:240,col=t>=0?pos:neg,k=(py*rw+px)*4;d[k]=base*(1-a)+col[0]*a;d[k+1]=base*(1-a)+col[1]*a;d[k+2]=base*(1-a)+col[2]*a;d[k+3]=255;}oc.putImageData(im,0,0);c.drawImage(off,0,0,this.width,this.height);for(const s of this.sources){const p=this.sourceScreen(s);c.fillStyle="#fff";c.shadowColor=this.css("--math-a");c.shadowBlur=12;c.beginPath();c.arc(p.x,p.y,6,0,Math.PI*2);c.fill();c.shadowBlur=0;}}
    sourceScreen(p:{x:number;y:number}){const sx=6,aspect=this.height/this.width;return{x:(p.x/sx+.5)*this.width,y:(.5-p.y/(sx*aspect))*this.height}}
    css(n:string){return getComputedStyle(this).getPropertyValue(n).trim()}text(q:string,v:string){const e=this.querySelector(q);if(e)e.textContent=v}
  }
  if(!customElements.get("wave-laboratory"))customElements.define("wave-laboratory",WaveLaboratory);
</script>

<style>wave-laboratory{display:block}.math-stage canvas{cursor:crosshair}</style>

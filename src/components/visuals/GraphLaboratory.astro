<graph-laboratory>
  <section class="instrument graph-lab" aria-label="Interactive graph algorithm visualizer">
    <div class="instrument-tabs">
      <button class="active" data-algorithm="bfs">Breadth first</button><button data-algorithm="dfs">Depth first</button><button data-algorithm="dijkstra">Dijkstra</button><button data-algorithm="topological">Topological</button>
    </div>
    <div class="instrument-status"><span><strong data-state>Ready</strong> · <span data-message>Click a node to choose the start</span></span><span class="hint">Drag nodes to reshape the graph</span></div>
    <div class="graph-layout">
      <div class="canvas-wrap"><canvas data-graph aria-label="Directed weighted graph"></canvas><div class="graph-legend label"><span><i class="queued"></i>Frontier</span><span><i class="current"></i>Current</span><span><i class="done"></i>Visited</span></div></div>
      <aside>
        <p class="label label--accent">Execution</p><h2 data-name>Breadth-first search</h2><p data-description>Visits the graph in layers using a first-in, first-out queue.</p>
        <div class="instrument-metrics"><div><span data-visited>0</span><small>Visited</small></div><div><span data-frontier>0</span><small>Frontier peak</small></div><div><span data-relaxed>0</span><small>Edges examined</small></div></div>
        <div class="order"><p class="label">Visit order</p><div data-order><span>—</span></div></div>
      </aside>
    </div>
    <div class="instrument-toolbar"><button class="instrument-action primary" data-run>▶ Run traversal</button><button class="instrument-action" data-step>Step →</button><button class="instrument-action" data-random>New graph</button><button class="instrument-action" data-reset>Reset</button><label class="instrument-range"><span>Speed <b data-speed-label>12 op/s</b></span><input data-speed type="range" min="1" max="100" value="48" /></label></div>
  </section>
</graph-laboratory>

<script>
  type Kind = "bfs"|"dfs"|"dijkstra"|"topological";
  type Node = { id:number; x:number; y:number; label:string };
  type Edge = { from:number; to:number; weight:number };
  type Op = { kind:"queue"|"visit"|"edge"; node?:number; edge?:number; value?:number };
  const INFO:Record<Kind,[string,string]>={bfs:["Breadth-first search","Visits the graph in layers using a first-in, first-out queue."],dfs:["Depth-first search","Follows one branch as far as possible before backtracking through the stack."],dijkstra:["Dijkstra's algorithm","Relaxes weighted edges in increasing distance order."],topological:["Topological ordering","Repeatedly removes a zero-indegree node to linearize this directed acyclic graph."]};
  class GraphLaboratory extends HTMLElement {
    nodes:Node[]=[]; edges:Edge[]=[]; algorithm:Kind="bfs"; start=0; sequence:Op[]=[]; cursor=0; running=false; visited=new Set<number>(); frontier=new Set<number>(); activeEdge=-1; current=-1; order:number[]=[]; distances=new Map<number,number>(); examined=0; peak=0;
    canvas!:HTMLCanvasElement;ctx!:CanvasRenderingContext2D;width=0;height=0;frame=0;last=0;acc=0;drag=-1;aborter=new AbortController();resize?:ResizeObserver;theme?:MutationObserver;
    connectedCallback(){this.canvas=this.querySelector("[data-graph]") as HTMLCanvasElement;const c=this.canvas.getContext("2d");if(!c)return;this.ctx=c;this.bind();this.resize=new ResizeObserver(()=>this.layout());this.resize.observe(this.canvas);this.theme=new MutationObserver(()=>this.draw());this.theme.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});this.makeGraph(false);this.layout();this.frame=requestAnimationFrame(t=>this.animate(t));}
    disconnectedCallback(){cancelAnimationFrame(this.frame);this.aborter.abort();this.resize?.disconnect();this.theme?.disconnect();}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-algorithm]").forEach(b=>b.addEventListener("click",()=>{this.algorithm=b.dataset.algorithm as Kind;this.querySelectorAll("[data-algorithm]").forEach(x=>x.classList.toggle("active",x===b));this.text("[data-name]",INFO[this.algorithm][0]);this.text("[data-description]",INFO[this.algorithm][1]);this.reset();},{signal}));this.querySelector("[data-run]")?.addEventListener("click",()=>this.toggle(),{signal});this.querySelector("[data-step]")?.addEventListener("click",()=>{this.running=false;this.ensure();this.advance();this.updateRun();},{signal});this.querySelector("[data-random]")?.addEventListener("click",()=>this.makeGraph(true),{signal});this.querySelector("[data-reset]")?.addEventListener("click",()=>this.reset(),{signal});this.querySelector<HTMLInputElement>("[data-speed]")?.addEventListener("input",()=>this.text("[data-speed-label]",`${this.rate()} op/s`),{signal});
      this.canvas.addEventListener("pointerdown",e=>{const n=this.nodeAt(e);if(n<0)return;this.drag=n;this.canvas.setPointerCapture(e.pointerId);this.start=n;this.reset();},{signal});this.canvas.addEventListener("pointermove",e=>{if(this.drag<0)return;const r=this.canvas.getBoundingClientRect();this.nodes[this.drag].x=Math.max(.05,Math.min(.95,(e.clientX-r.left)/r.width));this.nodes[this.drag].y=Math.max(.08,Math.min(.92,(e.clientY-r.top)/r.height));this.draw();},{signal});const stop=()=>this.drag=-1;this.canvas.addEventListener("pointerup",stop,{signal});this.canvas.addEventListener("pointercancel",stop,{signal});}
    makeGraph(random:boolean){const n=10;this.nodes=Array.from({length:n},(_,i)=>({id:i,label:String.fromCharCode(65+i),x:random?.08+i/(n-1)*.84:[.10,.27,.44,.63,.82,.19,.39,.58,.76,.9][i],y:random?.18+Math.random()*.65:[.24,.12,.26,.16,.3,.68,.56,.72,.58,.8][i]}));this.edges=[];for(let i=0;i<n-1;i++){this.edges.push({from:i,to:i+1,weight:1+Math.floor(Math.random()*9)});if(i+3<n&&(i%2===0||random&&Math.random()>.45))this.edges.push({from:i,to:i+3,weight:1+Math.floor(Math.random()*9)});if(i+2<n&&Math.random()>.58)this.edges.push({from:i,to:i+2,weight:1+Math.floor(Math.random()*9)});}this.start=0;this.reset();}
    reset(){this.running=false;this.sequence=[];this.cursor=0;this.visited.clear();this.frontier.clear();this.activeEdge=-1;this.current=-1;this.order=[];this.distances.clear();this.examined=0;this.peak=0;this.text("[data-visited]","0");this.text("[data-frontier]","0");this.text("[data-relaxed]","0");this.orderEl();this.state("Ready",this.algorithm==="topological"?"Ready to compute a dependency order":`Start node ${this.nodes[this.start]?.label||"A"} selected`);this.updateRun();this.draw();}
    ensure(){if(!this.sequence.length)this.sequence=this.build();}
    build(){if(this.algorithm==="topological")return this.topological();if(this.algorithm==="dijkstra")return this.dijkstra();const ops:Op[]=[];const seen=new Set([this.start]);const work=[this.start];ops.push({kind:"queue",node:this.start});while(work.length){const node=this.algorithm==="bfs"?work.shift()!:work.pop()!;ops.push({kind:"visit",node});const outgoing=this.edges.map((e,i)=>({e,i})).filter(x=>x.e.from===node);if(this.algorithm==="dfs")outgoing.reverse();for(const {e,i} of outgoing){ops.push({kind:"edge",edge:i});if(!seen.has(e.to)){seen.add(e.to);work.push(e.to);ops.push({kind:"queue",node:e.to});}}}return ops;}
    dijkstra(){const ops:Op[]=[];const d=new Map<number,number>([[this.start,0]]),done=new Set<number>(),open=[this.start];ops.push({kind:"queue",node:this.start,value:0});while(open.length){open.sort((a,b)=>d.get(a)!-d.get(b)!);const node=open.shift()!;if(done.has(node))continue;done.add(node);ops.push({kind:"visit",node,value:d.get(node)});for(let i=0;i<this.edges.length;i++){const e=this.edges[i];if(e.from!==node)continue;ops.push({kind:"edge",edge:i});const next=d.get(node)!+e.weight;if(next<(d.get(e.to)??Infinity)){d.set(e.to,next);open.push(e.to);ops.push({kind:"queue",node:e.to,value:next});}}}return ops;}
    topological(){const ops:Op[]=[];const indegree=Array(this.nodes.length).fill(0);this.edges.forEach(e=>indegree[e.to]++);const queue:number[]=[];indegree.forEach((d,i)=>{if(!d){queue.push(i);ops.push({kind:"queue",node:i});}});while(queue.length){const node=queue.shift()!;ops.push({kind:"visit",node});for(let i=0;i<this.edges.length;i++){const e=this.edges[i];if(e.from!==node)continue;ops.push({kind:"edge",edge:i});if(--indegree[e.to]===0){queue.push(e.to);ops.push({kind:"queue",node:e.to});}}}return ops;}
    toggle(){if(this.cursor>=this.sequence.length&&this.sequence.length)this.reset();this.ensure();this.running=!this.running;this.state(this.running?"Running":"Paused",this.running?"Advancing the worklist":"Execution suspended");this.updateRun();}
    advance(){const op=this.sequence[this.cursor++];if(!op){this.finish();return;}this.activeEdge=-1;if(op.kind==="queue"&&op.node!==undefined){this.frontier.add(op.node);if(op.value!==undefined)this.distances.set(op.node,op.value);this.peak=Math.max(this.peak,this.frontier.size);}else if(op.kind==="visit"&&op.node!==undefined){this.frontier.delete(op.node);this.visited.add(op.node);this.current=op.node;this.order.push(op.node);if(op.value!==undefined)this.distances.set(op.node,op.value);}else if(op.kind==="edge"&&op.edge!==undefined){this.activeEdge=op.edge;this.examined++;}this.text("[data-visited]",String(this.visited.size));this.text("[data-frontier]",String(this.peak));this.text("[data-relaxed]",String(this.examined));this.orderEl();this.state("Running",op.kind==="edge"?"Examining an outgoing edge":op.kind==="queue"?"Added a node to the worklist":"Removed the next node from the worklist");this.draw();if(this.cursor>=this.sequence.length)this.finish();}
    finish(){this.running=false;this.activeEdge=-1;this.current=-1;this.state("Complete",`${this.order.length} nodes ordered`);this.updateRun();this.draw();}
    orderEl(){const box=this.querySelector("[data-order]");if(!box)return;box.replaceChildren();if(!this.order.length){const s=document.createElement("span");s.textContent="—";box.append(s);return;}this.order.forEach(id=>{const i=document.createElement("i");i.textContent=this.nodes[id].label;box.append(i);});}
    animate(t:number){const d=Math.min(50,t-(this.last||t));this.last=t;if(this.running){this.acc+=d;const delay=1000/this.rate();while(this.acc>=delay&&this.running){this.acc-=delay;this.advance();}}this.frame=requestAnimationFrame(n=>this.animate(n));}
    rate(){const v=Number(this.querySelector<HTMLInputElement>("[data-speed]")?.value||48);return Math.round(2*Math.pow(2,v/20));}
    layout(){const r=this.canvas.getBoundingClientRect();if(!r.width)return;const d=Math.min(devicePixelRatio||1,2);this.width=r.width;this.height=r.height;this.canvas.width=r.width*d;this.canvas.height=r.height*d;this.ctx.setTransform(d,0,0,d,0,0);this.draw();}
    draw(){if(!this.ctx||!this.width)return;const c=this.ctx,s=getComputedStyle(this),v=(n:string)=>s.getPropertyValue(n).trim();c.clearRect(0,0,this.width,this.height);this.edges.forEach((e,i)=>{const a=this.nodes[e.from],b=this.nodes[e.to],x1=a.x*this.width,y1=a.y*this.height,x2=b.x*this.width,y2=b.y*this.height,ang=Math.atan2(y2-y1,x2-x1),r=15;c.strokeStyle=i===this.activeEdge?v("--g-active"):v("--g-edge");c.lineWidth=i===this.activeEdge?2.5:1;c.beginPath();c.moveTo(x1+Math.cos(ang)*r,y1+Math.sin(ang)*r);c.lineTo(x2-Math.cos(ang)*r,y2-Math.sin(ang)*r);c.stroke();c.fillStyle=c.strokeStyle;c.beginPath();c.moveTo(x2-Math.cos(ang)*r,y2-Math.sin(ang)*r);c.lineTo(x2-Math.cos(ang+.45)*(r+7),y2-Math.sin(ang+.45)*(r+7));c.lineTo(x2-Math.cos(ang-.45)*(r+7),y2-Math.sin(ang-.45)*(r+7));c.closePath();c.fill();c.fillStyle=v("--g-label");c.font="10px IBM Plex Mono";c.fillText(String(e.weight),(x1+x2)/2+4,(y1+y2)/2-4);});this.nodes.forEach(n=>{const x=n.x*this.width,y=n.y*this.height;let fill=v("--g-node");if(this.frontier.has(n.id))fill=v("--g-frontier");if(this.visited.has(n.id))fill=v("--g-visited");if(n.id===this.current)fill=v("--g-current");c.beginPath();c.arc(x,y,15,0,Math.PI*2);c.fillStyle=fill;c.fill();c.strokeStyle=n.id===this.start?v("--g-start"):v("--g-outline");c.lineWidth=n.id===this.start?3:1;c.stroke();c.fillStyle=v("--g-text");c.font="600 10px IBM Plex Mono";c.textAlign="center";c.textBaseline="middle";c.fillText(n.label,x,y);const dist=this.distances.get(n.id);if(dist!==undefined){c.fillStyle=v("--g-label");c.font="9px IBM Plex Mono";c.fillText(String(dist),x,y+25);}});c.textAlign="start";}
    nodeAt(e:PointerEvent){const r=this.canvas.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top;let found=-1,dist=24;this.nodes.forEach(n=>{const d=Math.hypot(n.x*this.width-x,n.y*this.height-y);if(d<dist){dist=d;found=n.id;}});return found;}
    state(a:string,b:string){this.text("[data-state]",a);this.text("[data-message]",b);}updateRun(){this.text("[data-run]",this.running?"Ⅱ Pause":"▶ Run traversal");this.querySelector("[data-run]")?.classList.toggle("active",this.running);}text(q:string,x:string){const e=this.querySelector(q);if(e)e.textContent=x;}
  }
  if(!customElements.get("graph-laboratory"))customElements.define("graph-laboratory",GraphLaboratory);
</script>

<style>
  graph-laboratory{--g-node:var(--paper-raised);--g-edge:var(--ink-faint);--g-outline:var(--ink-soft);--g-text:var(--ink);--g-label:var(--ink-faint);--g-frontier:#d9a52b;--g-current:#c8401a;--g-visited:#4b3fd6;--g-active:#c8401a;--g-start:#35a978;display:block}:global(html[data-theme="dark"]) graph-laboratory{--g-node:#12182d;--g-edge:#4b587d;--g-outline:#8795bd;--g-text:#f0f4ff;--g-frontier:#edc353;--g-current:#ff6687;--g-visited:#4776a3;--g-active:#ff6687;--g-start:#48d39d}
  .graph-layout{display:grid;grid-template-columns:minmax(30rem,1.35fr) minmax(17rem,.65fr);min-height:34rem}.canvas-wrap{display:grid;grid-template-rows:1fr auto;padding:1rem;border-right:1px solid var(--glass-border);background:linear-gradient(to right,var(--reseau) 1px,transparent 1px),linear-gradient(to bottom,var(--reseau) 1px,transparent 1px);background-size:24px 24px}canvas{display:block;width:100%;height:100%;min-height:28rem;touch-action:none}.graph-legend{display:flex;gap:1rem;padding-top:.6rem;color:var(--ink-faint);font-size:.5rem}.graph-legend span{display:flex;align-items:center;gap:.3rem}.graph-legend i{width:8px;height:8px;border-radius:50%}.queued{background:var(--g-frontier)}.current{background:var(--g-current)}.done{background:var(--g-visited)}
  aside{padding:1.4rem;background:color-mix(in srgb,var(--paper-sunken) 38%,transparent)}aside h2{margin:.55rem 0 .7rem;font-family:var(--font-display);font-size:2rem;font-weight:400;line-height:1}aside>p:not(.label){min-height:3.5rem;color:var(--ink-soft);font-size:.68rem}.instrument-metrics{grid-template-columns:1fr;margin-top:1.3rem}.order{margin-top:1.3rem;padding-top:1rem;border-top:1px solid var(--rule)}.order>div{display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.6rem}.order :global(i),.order :global(span){display:grid;width:1.6rem;height:1.6rem;place-items:center;color:var(--ink-soft);border:1px solid var(--rule);border-radius:50%;font-size:.55rem;font-style:normal}
  @media(max-width:55rem){.graph-layout{grid-template-columns:1fr}.canvas-wrap{border-right:0;border-bottom:1px solid var(--glass-border)}aside .instrument-metrics{grid-template-columns:repeat(3,1fr)}}@media(max-width:40rem){canvas{min-height:23rem}}
</style>

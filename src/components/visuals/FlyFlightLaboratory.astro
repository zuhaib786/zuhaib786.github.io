        if (index === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke();
    }

    frame(time: number) {
      const dt = this.lastFrame ? Math.min(0.033, (time - this.lastFrame) / 1000) : 0;
      this.lastFrame = time;
      this.update(dt);
      this.drawArena();
      this.drawBrain(dt);
      this.drawTrace();
      this.animationFrame = requestAnimationFrame((next) => this.frame(next));
    }
  }

  if (!customElements.get("fly-flight-laboratory")) customElements.define("fly-flight-laboratory", FlyFlightLaboratory);
</script>


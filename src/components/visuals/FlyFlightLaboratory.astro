      ctx.setLineDash([]);
      ctx.strokeStyle = "#efaa54";
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      this.traceValues.forEach((value, index) => {
        const x = index / Math.max(1, this.traceValues.length - 1) * rect.width;

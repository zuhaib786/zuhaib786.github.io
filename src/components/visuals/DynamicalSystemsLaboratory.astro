<dynamical-systems-laboratory>
  <section class="math-instrument" aria-label="Interactive dynamical systems laboratory">
    <div class="math-bar"><div class="math-state"><i></i><span data-state>Flowing through phase space</span></div><div class="math-actions"><div class="math-tabs" aria-label="Dynamical system"><button class="active" data-mode="pendulum">Pendulum</button><button data-mode="vdp">Van der Pol</button><button data-mode="lotka">Predator–prey</button><button data-mode="logistic">Logistic map</button></div><button class="math-button" data-play>Pause</button><button class="math-button" data-clear>Clear paths</button></div></div>
    <div class="math-dashboard">
      <div class="math-stage"><span class="math-stage-label label" data-stage-label>vector field · click to seed a trajectory</span><canvas data-canvas aria-label="Phase portrait and bifurcation diagram"></canvas></div>
      <aside class="math-readout"><p class="label label--accent">Dynamical systems</p><h2 data-title>Damping chooses the future</h2><p data-description>A pendulum's state is a point in angle–velocity space. Damping turns closed energy contours into spirals that terminate at stable equilibria.</p><div class="math-formula" data-formula>θ̇ = ω,  ω̇ = −sin θ − μω</div>
        <div class="math-metrics"><div><strong data-metric-1>stable focus</strong><small data-metric-1-label>Origin</small></div><div><strong data-metric-2>4</strong><small data-metric-2-label>Trajectories</small></div><div><strong data-metric-3>0.18</strong><small data-metric-3-label>Damping μ</small></div></div>
        <div class="math-controls"><div class="math-control"><label><span data-p1-label>Damping μ</span><b data-p1-value>0.18</b></label><input data-p1 type="range" min="0" max="2" step="0.01" value="0.18" /></div><div class="math-control"><label><span data-p2-label>Gravity scale</span><b data-p2-value>1.00</b></label><input data-p2 type="range" min="0.2" max="3" step="0.05" value="1" /></div><div class="math-control"><label><span>Integration step</span><b data-dt-value>0.025</b></label><input data-dt type="range" min="0.008" max="0.06" step="0.001" value="0.025" /></div></div>
        <div class="math-legend"><span><i></i>trajectory</span><span><i></i>nullcline / unstable</span><span><i></i>moving state</span></div><div class="math-trace"><p class="label">Qualitative reading</p><ol><li data-reading-1>Energy decreases whenever μ &gt; 0.</li><li data-reading-2>Stable equilibria occur at θ = 2kπ.</li><li data-reading-3>Separatrices divide oscillation from rotation.</li></ol></div>
      </aside>
    </div>
  </section>
</dynamical-systems-laboratory>

<script>
  type Mode="pendulum"|"vdp"|"lotka"|"logistic";type Pt=[number,number];
  const INFO:Record<Mode,[string,string,string,string]>={
    pendulum:["Damping chooses the future","A pendulum's state is a point in angle–velocity space. Damping turns closed energy contours into spirals that terminate at stable equilibria.","θ̇ = ω,  ω̇ = −g sin θ − μω","vector field · click to seed a trajectory"],
    vdp:["A cycle attracts nearby states","Negative damping near the origin and positive damping far away cooperate to create a stable limit cycle independent of the initial condition.","ẋ = y,  ẏ = μ(1−x²)y − x","nonlinear oscillator · stable limit cycle"],
    lotka:["Populations chase one another","Prey growth feeds predators; predators suppress prey. Orbits circle the coexistence equilibrium without settling in the idealized model.","ẋ = αx − xy,  ẏ = xy − γy","state space · prey x against predators y"],
    logistic:["Order doubles into chaos","A one-dimensional recurrence passes through fixed points, period doubling, periodic windows, and chaos as its growth parameter changes.","xₙ₊₁ = r xₙ(1−xₙ)","bifurcation diagram · click to choose r"],
  };
  class DynamicalSystemsLaboratory extends HTMLElement{
    canvas!:HTMLCanvasElement;ctx!:CanvasRenderingContext2D;width=0;height=0;mode:Mode="pendulum";p1=.18;p2=1;dt=.025;paths:Pt[][]=[];playing=true;clock=0;last=0;frame=0;resize?:ResizeObserver;theme?:MutationObserver;aborter=new AbortController();
    connectedCallback(){this.canvas=this.querySelector("[data-canvas]") as HTMLCanvasElement;const c=this.canvas.getContext("2d");if(!c)return;this.ctx=c;this.bind();this.resize=new ResizeObserver(()=>this.layout());this.resize.observe(this.canvas);this.theme=new MutationObserver(()=>this.draw());this.theme.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});this.configure();this.seedDefaults();this.layout();this.frame=requestAnimationFrame(t=>this.animate(t));}
    disconnectedCallback(){cancelAnimationFrame(this.frame);this.aborter.abort();this.resize?.disconnect();this.theme?.disconnect();}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(b=>b.addEventListener("click",()=>{this.mode=b.dataset.mode as Mode;this.querySelectorAll("[data-mode]").forEach(x=>x.classList.toggle("active",x===b));this.configure();this.seedDefaults();this.draw();},{signal}));this.querySelector("[data-play]")?.addEventListener("click",()=>{this.playing=!this.playing;const b=this.querySelector<HTMLButtonElement>("[data-play]");if(b)b.textContent=this.playing?"Pause":"Play";this.text("[data-state]",this.playing?"Flowing through phase space":"Paused at the current state");},{signal});this.querySelector("[data-clear]")?.addEventListener("click",()=>{this.paths=[];this.draw();},{signal});
      const range=(q:string,f:(n:number)=>void)=>this.querySelector<HTMLInputElement>(q)?.addEventListener("input",e=>{f(Number((e.currentTarget as HTMLInputElement).value));this.seedDefaults();this.draw();},{signal});range("[data-p1]",v=>{this.p1=v;this.text("[data-p1-value]",v.toFixed(2));});range("[data-p2]",v=>{this.p2=v;this.text("[data-p2-value]",v.toFixed(2));});range("[data-dt]",v=>{this.dt=v;this.text("[data-dt-value]",v.toFixed(3));});this.canvas.addEventListener("pointerdown",e=>this.addSeed(e),{signal});}
    defaults(){if(this.mode==="pendulum")return{p1:.18,p2:1,min1:0,max1:2,step1:.01,min2:.2,max2:3,step2:.05,l1:"Damping μ",l2:"Gravity scale"};if(this.mode==="vdp")return{p1:1.4,p2:1,min1:.05,max1:5,step1:.05,min2:.4,max2:2.5,step2:.05,l1:"Nonlinearity μ",l2:"Restoring scale"};if(this.mode==="lotka")return{p1:1.2,p2:1,min1:.2,max1:3,step1:.05,min2:.2,max2:3,step2:.05,l1:"Prey growth α",l2:"Predator loss γ"};return{p1:3.72,p2:.23,min1:2.5,max1:4,step1:.001,min2:.01,max2:.99,step2:.01,l1:"Growth parameter r",l2:"Initial state x₀"};}
    configure(){const info=INFO[this.mode],d=this.defaults();this.p1=d.p1;this.p2=d.p2;this.text("[data-title]",info[0]);this.text("[data-description]",info[1]);this.text("[data-formula]",info[2]);this.text("[data-stage-label]",info[3]);this.text("[data-p1-label]",d.l1);this.text("[data-p2-label]",d.l2);this.text("[data-p1-value]",d.p1.toFixed(this.mode==="logistic"?3:2));this.text("[data-p2-value]",d.p2.toFixed(2));this.setRange("[data-p1]",d.min1,d.max1,d.step1,d.p1);this.setRange("[data-p2]",d.min2,d.max2,d.step2,d.p2);if(this.mode==="logistic"){this.text("[data-reading-1]","A fixed point loses stability near r = 3.");this.text("[data-reading-2]","Successive period doublings accumulate near r ≈ 3.56995.");this.text("[data-reading-3]","Positive Lyapunov exponent indicates sensitive dependence.");}else if(this.mode==="vdp"){this.text("[data-reading-1]","The origin is unstable when μ > 0.");this.text("[data-reading-2]","Every nonzero initial condition approaches one cycle.");this.text("[data-reading-3]","Larger μ separates slow drift from fast jumps.");}else if(this.mode==="lotka"){this.text("[data-reading-1]","The coexistence equilibrium is (γ, α).");this.text("[data-reading-2]","The ideal model conserves a nonlinear first integral.");this.text("[data-reading-3]","Predator peaks lag behind prey peaks.");}else{this.text("[data-reading-1]","Energy decreases whenever μ > 0.");this.text("[data-reading-2]","Stable equilibria occur at θ = 2kπ.");this.text("[data-reading-3]","Separatrices divide oscillation from rotation.");}}
    seedDefaults(){this.clock=0;if(this.mode==="logistic"){this.paths=[];return;}const seeds=this.mode==="lotka"?[[.4,.7],[1.2,2.8],[3.5,.8],[4.2,3.8]]:[[.25,2.5],[-2.4,.2],[1.8,-1.5],[-.5,.8]];this.paths=seeds.map(s=>this.integrate(s as Pt));this.updateMetrics();}
    bounds(){return this.mode==="lotka"?{x0:0,x1:5,y0:0,y1:5}:{x0:-3.5,x1:3.5,y0:-3.5,y1:3.5};}
    field(x:number,y:number):Pt{if(this.mode==="pendulum")return[y,-this.p2*Math.sin(x)-this.p1*y];if(this.mode==="vdp")return[y,this.p1*(1-x*x)*y-this.p2*x];return[this.p1*x-x*y,x*y-this.p2*y];}
    rk4(p:Pt,h:number):Pt{const k1=this.field(p[0],p[1]),k2=this.field(p[0]+h*k1[0]/2,p[1]+h*k1[1]/2),k3=this.field(p[0]+h*k2[0]/2,p[1]+h*k2[1]/2),k4=this.field(p[0]+h*k3[0],p[1]+h*k3[1]);return[p[0]+h*(k1[0]+2*k2[0]+2*k3[0]+k4[0])/6,p[1]+h*(k1[1]+2*k2[1]+2*k3[1]+k4[1])/6];}
    integrate(seed:Pt){const path=[seed],steps=this.mode==="lotka"?1600:1300;let p=seed;for(let n=0;n<steps;n++){p=this.rk4(p,this.dt);if(!Number.isFinite(p[0])||Math.abs(p[0])>100||Math.abs(p[1])>100)break;path.push(p);}return path;}
    addSeed(e:PointerEvent){if(this.mode==="logistic"){const r=this.canvas.getBoundingClientRect(),x=(e.clientX-r.left)/r.width;this.p1=2.5+x*1.5;this.setValue("[data-p1]",this.p1);this.text("[data-p1-value]",this.p1.toFixed(3));this.draw();return;}const b=this.bounds(),r=this.canvas.getBoundingClientRect(),p:[number,number]=[b.x0+(e.clientX-r.left)/r.width*(b.x1-b.x0),b.y1-(e.clientY-r.top)/r.height*(b.y1-b.y0)];this.paths.push(this.integrate(p));if(this.paths.length>9)this.paths.shift();this.updateMetrics();this.draw();}
    animate(t:number){const elapsed=Math.min(50,t-(this.last||t));this.last=t;if(this.playing){this.clock+=elapsed*.035;this.draw();}this.frame=requestAnimationFrame(n=>this.animate(n));}
    layout(){const r=this.canvas.getBoundingClientRect();if(!r.width)return;const d=Math.min(devicePixelRatio||1,2);this.width=r.width;this.height=r.height;this.canvas.width=Math.round(r.width*d);this.canvas.height=Math.round(r.height*d);this.ctx.setTransform(d,0,0,d,0,0);this.draw();}
    draw(){if(!this.width)return;const c=this.ctx,s=getComputedStyle(this),paper=s.getPropertyValue("--paper-sunken"),rule=s.getPropertyValue("--rule"),ink=s.getPropertyValue("--ink-soft");c.clearRect(0,0,this.width,this.height);c.fillStyle=paper;c.fillRect(0,0,this.width,this.height);if(this.mode==="logistic"){this.drawLogistic();return;}const b=this.bounds(),to=(p:Pt)=>({x:(p[0]-b.x0)/(b.x1-b.x0)*this.width,y:(b.y1-p[1])/(b.y1-b.y0)*this.height});c.strokeStyle=rule;c.lineWidth=1;const origin=to([0,0]);c.beginPath();c.moveTo(0,origin.y);c.lineTo(this.width,origin.y);c.moveTo(origin.x,0);c.lineTo(origin.x,this.height);c.stroke();
      const cols=22,rows=15;for(let iy=0;iy<rows;iy++)for(let ix=0;ix<cols;ix++){const x=b.x0+(ix+.5)/cols*(b.x1-b.x0),y=b.y0+(iy+.5)/rows*(b.y1-b.y0),v=this.field(x,y),mag=Math.hypot(v[0],v[1])||1,p=to([x,y]),len=Math.min(this.width/cols*.34,15),dx=v[0]/mag*len,dy=-v[1]/mag*len;c.strokeStyle=ink;c.globalAlpha=.22+.28*Math.min(1,mag/4);c.beginPath();c.moveTo(p.x-dx*.55,p.y-dy*.55);c.lineTo(p.x+dx*.55,p.y+dy*.55);c.stroke();}c.globalAlpha=1;this.drawNullclines(to,b);
      const colors=["#6fd6ff","#ff8b59","#59c99b","#c98bff","#ffd15c","#ff657a"];this.paths.forEach((path,k)=>{c.strokeStyle=colors[k%colors.length];c.lineWidth=1.4;c.beginPath();path.forEach((p,n)=>{const q=to(p);n?c.lineTo(q.x,q.y):c.moveTo(q.x,q.y);});c.stroke();if(path.length){const q=to(path[Math.floor(this.clock+k*71)%path.length]);c.fillStyle=colors[k%colors.length];c.beginPath();c.arc(q.x,q.y,4,0,Math.PI*2);c.fill();}});this.updateMetrics();}
    drawNullclines(to:(p:Pt)=>{x:number;y:number},b:any){const c=this.ctx;c.strokeStyle=getComputedStyle(this).getPropertyValue("--math-b");c.lineWidth=1.2;c.setLineDash([5,5]);if(this.mode==="pendulum"){for(let k=-1;k<=1;k++){const x=k*Math.PI,p=to([x,0]);c.beginPath();c.moveTo(p.x,0);c.lineTo(p.x,this.height);c.stroke();}}else if(this.mode==="vdp"){const p=to([0,0]);c.beginPath();c.moveTo(0,p.y);c.lineTo(this.width,p.y);c.stroke();c.beginPath();for(let n=0;n<200;n++){const x=b.x0+n/199*(b.x1-b.x0),den=this.p1*(1-x*x),y=Math.abs(den)<.05?NaN:this.p2*x/den,q=to([x,y]);if(Number.isFinite(y)&&y>b.y0&&y<b.y1)n?c.lineTo(q.x,q.y):c.moveTo(q.x,q.y);}c.stroke();}else{for(const x of [0,this.p2]){const p=to([x,0]);c.beginPath();c.moveTo(p.x,0);c.lineTo(p.x,this.height);c.stroke();}for(const y of [0,this.p1]){const p=to([0,y]);c.beginPath();c.moveTo(0,p.y);c.lineTo(this.width,p.y);c.stroke();}}c.setLineDash([]);}
    drawLogistic(){const c=this.ctx,w=this.width,h=this.height,dark=document.documentElement.dataset.theme==="dark",fg=dark?"rgba(111,214,255,.42)":"rgba(75,63,214,.34)";c.fillStyle=fg;for(let px=0;px<w;px++){const r=2.5+px/(w-1)*1.5;let x=.517;for(let n=0;n<450;n++){x=r*x*(1-x);if(n>250)c.fillRect(px,(1-x)*h*.72+20,.75,.75);}}const selectedX=(this.p1-2.5)/1.5*w;c.strokeStyle=getComputedStyle(this).getPropertyValue("--math-b");c.lineWidth=1.4;c.beginPath();c.moveTo(selectedX,0);c.lineTo(selectedX,h*.74);c.stroke();const chartY=h*.78,chartH=h*.19;c.strokeStyle=getComputedStyle(this).getPropertyValue("--rule");c.strokeRect(0,chartY,w,chartH);let x=this.p2,lambda=0;c.strokeStyle=getComputedStyle(this).getPropertyValue("--math-good");c.lineWidth=1.4;c.beginPath();for(let n=0;n<120;n++){x=this.p1*x*(1-x);if(n>20)lambda+=Math.log(Math.abs(this.p1*(1-2*x))+1e-12);const px=n/119*w,py=chartY+chartH*(1-x);n?c.lineTo(px,py):c.moveTo(px,py);}c.stroke();lambda/=99;this.text("[data-metric-1]",this.p1.toFixed(3));this.text("[data-metric-1-label]","Parameter r");this.text("[data-metric-2]",x.toFixed(4));this.text("[data-metric-2-label]","Latest iterate");this.text("[data-metric-3]",lambda.toFixed(3));this.text("[data-metric-3-label]","Lyapunov exponent");}
    updateMetrics(){if(this.mode==="logistic")return;this.text("[data-metric-1]",this.mode==="lotka"?`(${this.p2.toFixed(1)}, ${this.p1.toFixed(1)})`:this.mode==="vdp"?"limit cycle":this.p1>0?"stable focus":"center");this.text("[data-metric-1-label]",this.mode==="lotka"?"Coexistence":this.mode==="vdp"?"Attractor":"Origin");this.text("[data-metric-2]",String(this.paths.length));this.text("[data-metric-2-label]","Trajectories");this.text("[data-metric-3]",this.p1.toFixed(2));this.text("[data-metric-3-label]",this.mode==="pendulum"?"Damping μ":this.mode==="vdp"?"Nonlinearity μ":"Prey growth α");}
    text(q:string,s:string){const e=this.querySelector(q);if(e)e.textContent=s}setRange(q:string,min:number,max:number,step:number,value:number){const e=this.querySelector<HTMLInputElement>(q);if(e){e.min=String(min);e.max=String(max);e.step=String(step);e.value=String(value);}}setValue(q:string,v:number){const e=this.querySelector<HTMLInputElement>(q);if(e)e.value=String(v)}
  }
  if(!customElements.get("dynamical-systems-laboratory"))customElements.define("dynamical-systems-laboratory",DynamicalSystemsLaboratory);
</script>

<style>
  dynamical-systems-laboratory{display:block}.math-stage canvas{cursor:crosshair}
</style>

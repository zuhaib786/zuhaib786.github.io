        if(active||over){standard.emissive.set(child.userData.partColor as string);standard.emissiveIntensity=over?.5:.34;}
        else{standard.emissive.copy(material.userData.baseEmissive??new THREE.Color(0x000000));standard.emissiveIntensity=material.userData.baseEmissiveIntensity??0;}

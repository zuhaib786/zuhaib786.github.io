<solid-biology-explorer>
  <section class="biology-instrument" aria-label="Interactive 3D biology atlas">
    <nav class="specimen-tabs" aria-label="Choose a specimen">
      <button type="button" data-model="cell" aria-pressed="true">Animal cell</button>
      <button type="button" data-model="heart" aria-pressed="false">Human heart</button>
      <button type="button" data-model="brain" aria-pressed="false">Brain</button>
      <button type="button" data-model="eye" aria-pressed="false">Eye</button>
      <button type="button" data-model="anatomy" aria-pressed="false">Human anatomy</button>
    </nav>
    <div class="biology-dashboard">
      <div class="biology-stage">
        <header class="stage-heading"><div><h2 data-model-title>Animal cell</h2><p data-model-subtitle>A cutaway through the microscopic world</p></div><span class="view-badge" data-view-name>Whole specimen</span></header>
        <div class="canvas-wrap">
          <canvas data-canvas tabindex="0" aria-label="Interactive 3D specimen" aria-describedby="biology-controls-help"></canvas>
          <div class="model-tooltip" data-tooltip role="tooltip" hidden><strong data-tooltip-name></strong><span data-tooltip-detail></span></div>
          <div class="stage-status" data-status role="status"><span aria-hidden="true" class="loading-ring"></span><strong data-status-title>Preparing the specimen</strong><span data-status-detail>Loading the 3D atlas…</span></div>
          <noscript><p class="no-script">Enable JavaScript to rotate and explore the 3D models.</p></noscript>
        </div>
        <div class="view-controls">
          <button type="button" data-whole disabled><span aria-hidden="true">↶</span> Show whole model</button>
          <div><button type="button" data-section aria-pressed="true" hidden>Cutaway</button><button type="button" data-spin aria-pressed="false">Auto-rotate</button><button type="button" data-reset>Reset view</button></div>
        </div>
        <p class="interaction-hint" id="biology-controls-help">Drag to rotate. Scroll or pinch to zoom. Click a structure to isolate it.<span>Keyboard: arrows to rotate, + / − to zoom, Esc to show the whole model.</span></p>
      </div>
      <aside class="biology-readout" aria-label="Structure information">
        <div class="readout-copy">
          <p class="part-system" data-part-system>Explore the specimen</p>
          <h2 data-part-name>Animal cell</h2>
          <p class="part-description" data-description>Explore the machinery inside an animal cell. Select an organelle to examine its structure.</p>
          <section class="role-section"><h3>What it does</h3><p data-role>Hover to identify. Click to isolate.</p></section>
          <section class="detail-section"><h3>A closer look</h3><p data-detail>The information panel stays available as you rotate the model.</p></section>
        </div>
        <div class="structure-picker"><div class="list-heading"><h3>Explore structures</h3><span data-part-count>7 structures</span></div><div class="structure-list" data-parts aria-label="Isolate a structure"></div></div>
      </aside>
    </div>
    <footer class="model-note"><p data-model-source>Purpose-built educational cutaway. Colours and relative sizes are illustrative.</p><a href="/biology#model-credits">Model credits & references</a></footer>
    <p class="sr-only" data-announce role="status" aria-live="polite"></p>
  </section>
</solid-biology-explorer>

<script>
  import '../../scripts/biology/explorer';
</script>

<style>
  solid-biology-explorer { display: block; }
  [hidden] { display: none !important; }
  .biology-instrument { border: 1px solid var(--rule); border-radius: 14px; overflow: hidden; background: var(--paper-raised); }
  .specimen-tabs { display: flex; gap: 0.4rem; padding: 0.7rem; border-bottom: 1px solid var(--rule); overflow-x: auto; scrollbar-width: thin; }
  .specimen-tabs button { flex: 1 0 auto; padding: 0.8rem 1rem; border: 1px solid transparent; border-radius: 7px; color: var(--ink-soft); background: transparent; font-size: 0.82rem; cursor: pointer; }
  .specimen-tabs button[aria-pressed='true'] { background: var(--paper-sunken); color: var(--ink); border-color: var(--rule); }
  .specimen-tabs button:hover { color: var(--accent); }
  .biology-dashboard { display: grid; grid-template-columns: minmax(0, 1fr) 21rem; height: 48rem; }
  .biology-stage { display: flex; flex-direction: column; min-width: 0; background: #eef0f2; color: #354050; }
  .stage-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; padding: 1.4rem 1.5rem 0; }
  .stage-heading h2 { font-size: 1rem; font-weight: 600; letter-spacing: -0.02em; }
  .stage-heading p { color: #697486; font-size: 0.71rem; margin-top: 0.25rem; }
  .view-badge { flex-shrink: 0; max-width: 45%; padding: 0.3rem 0.6rem; border: 1px solid #cdd3db; border-radius: 4px; color: #667487; font-size: 0.65rem; text-align: right; }
  .canvas-wrap { position: relative; flex: 1; min-height: 30rem; isolation: isolate; }
  .canvas-wrap::before { content: ''; position: absolute; width: 48%; height: 4%; bottom: 12%; left: 26%; background: #485168; opacity: 0.13; border-radius: 50%; filter: blur(17px); pointer-events: none; }
  canvas { position: absolute; width: 100%; height: 100%; inset: 0; touch-action: none; cursor: grab; }
  canvas:active { cursor: grabbing; }
  .view-controls { display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: center; justify-content: space-between; padding: 0 1.2rem; }
  .view-controls > div { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .view-controls button { min-height: 2.2rem; padding: 0.45rem 0.65rem; font-size: 0.7rem; border: 1px solid #c9d0d9; border-radius: 5px; background: #f6f7f9; color: #3e4a5d; cursor: pointer; }
  .view-controls [data-whole] { background: #33435c; border-color: #33435c; color: #fff; }
  .view-controls [data-whole]:disabled { background: transparent; border-color: #cdd3db; color: #738092; cursor: default; }
  .view-controls button[aria-pressed='true'] { background: #d9e2ef; border-color: #8d9fba; color: #273c60; }
  .view-controls button:hover:not(:disabled) { border-color: #617794; }
  .interaction-hint { padding: 0.85rem 1.2rem 1.2rem; color: #6a7585; font-size: 0.65rem; }
  .interaction-hint span { display: block; font-size: 0.59rem; margin-top: 0.25rem; }
  .biology-readout { --part-color: #9aa9bb; min-width: 0; overflow-y: auto; border-left: 1px solid var(--rule); background: var(--paper-raised); }
  .readout-copy { min-height: 24rem; padding: 1.5rem 1.4rem 1rem; border-top: 3px solid var(--part-color); }
  .part-system { color: var(--ink-soft); font-size: 0.68rem; }
  .readout-copy h2 { margin: 0.6rem 0 1rem; color: var(--ink); font-family: var(--font-display); font-size: 2.5rem; font-weight: 400; line-height: 1.05; }
  .part-description { font-size: 0.81rem; color: var(--ink-soft); line-height: 1.75; }
  .readout-copy section { margin-top: 1.3rem; }
  .readout-copy h3, .list-heading h3 { font-family: var(--font-sans); font-size: 0.72rem; font-weight: 600; color: var(--ink); }
  .readout-copy section p { margin-top: 0.4rem; font-size: 0.75rem; line-height: 1.75; color: var(--ink-soft); }
  .structure-picker { border-top: 1px solid var(--rule); padding: 1.1rem 1.4rem 1.4rem; }
  .list-heading { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; margin-bottom: 0.65rem; }
  .list-heading span { color: var(--ink-soft); font-size: 0.6rem; }
  .structure-list { display: grid; grid-template-columns: 1fr; gap: 0.3rem; }
  .structure-list :global(button) { display: flex; align-items: center; gap: 0.7rem; width: 100%; min-height: 2.35rem; padding: 0.5rem 0.65rem; color: var(--ink-soft); background: transparent; border: 1px solid var(--rule); border-radius: 5px; font-family: var(--font-sans); font-size: 0.74rem; text-align: left; cursor: pointer; }
  .structure-list :global(button:hover), .structure-list :global(button[aria-pressed='true']) { background: var(--paper-sunken); color: var(--ink); border-color: var(--rule-strong); }
  .structure-list :global(button[aria-pressed='true']) { box-shadow: inset 3px 0 var(--part-color); }
  .structure-list :global(i) { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; }
  .model-tooltip { position: absolute; z-index: 2; pointer-events: none; max-width: 225px; padding: 0.65rem 0.85rem; border: 1px solid #ffffff40; border-radius: 6px; color: #f4f6fc; background: #28374aee; box-shadow: 0 5px 20px #25334a18; }
  .model-tooltip strong { display: block; font-size: 0.78rem; font-weight: 500; }
  .model-tooltip span { display: block; margin-top: 0.2rem; font-size: 0.64rem; line-height: 1.4; color: #ccd7e8; }
  .stage-status { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem; padding: 2rem; background: #eef0f2ec; text-align: center; }
  .stage-status strong { font-size: 0.95rem; font-weight: 500; }
  .stage-status > span:not(.loading-ring) { max-width: 35ch; font-size: 0.8rem; color: #637086; }
  .loading-ring { width: 1.6rem; height: 1.6rem; border: 2px solid #c5ccda; border-top-color: #526f99; border-radius: 50%; animation: spin 1s linear infinite; }
  .stage-status[data-error='true'] .loading-ring { display: none; }
  .model-note { display: flex; gap: 1.5rem; justify-content: space-between; padding: 0.9rem 1.3rem; border-top: 1px solid var(--rule); font-size: 0.65rem; color: var(--ink-soft); }
  .model-note p { max-width: 90ch; }
  .model-note a { white-space: nowrap; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }
  .no-script { position: absolute; z-index: 3; inset: 25%; padding: 2rem; background: #eef0f2; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (max-width: 1000px) { .biology-dashboard { grid-template-columns: minmax(0, 1fr) 18rem; } .readout-copy, .structure-picker { padding-inline: 1.1rem; } .stage-heading { flex-direction: column; } .view-badge { max-width: 100%; } }
  @media (max-width: 720px) {
    .biology-dashboard { grid-template-columns: 1fr; height: auto; }
    .biology-readout { border-left: 0; border-top: 1px solid var(--rule); }
    .canvas-wrap { min-height: 23rem; }
    .stage-heading { padding: 1rem 1.1rem 0; flex-direction: row; }
    .stage-heading p { max-width: 24ch; }
    .view-badge { max-width: 40%; }
    .specimen-tabs button { padding: 0.6rem 0.85rem; font-size: 0.75rem; }
    .readout-copy { min-height: 0; }
    .readout-copy h2 { font-size: 2.3rem; }
    .structure-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .structure-list :global(button) { font-size: 0.7rem; }
    .model-note { flex-direction: column; gap: 0.5rem; }
    .interaction-hint span { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .loading-ring { animation: none; } }
</style>

<solid-biology-explorer>
  <section class="biology-instrument" aria-label="Interactive three-dimensional biology explorer">
    <header class="biology-bar">
      <div class="biology-state"><i></i><span><b>BIO / SOLID ATLAS</b><small data-model-state>Animal cell · eukaryotic ultrastructure</small></span></div>
      <div class="biology-tabs" role="tablist" aria-label="Specimen category" data-tabs></div>
      <div class="biology-actions">
        <button class="biology-button" data-isolate aria-pressed="false" title="Fade everything except the selected structure">Isolate</button>
        <button class="biology-button active" data-spin aria-pressed="true">Auto-rotate</button>
        <button class="biology-button" data-reset>Reset view</button>
      </div>
    </header>

    <div class="biology-dashboard">
      <div class="biology-stage">
        <div class="stage-meta" aria-hidden="true"><span data-stage-code>SPECIMEN 01 / EUKARYOTA</span><span data-stage-scale>≈ 20 µm</span></div>
        <canvas data-canvas tabindex="0" aria-label="Rotatable three-dimensional animal cell. Drag to rotate, scroll to zoom."></canvas>
        <div class="stage-status" data-loading hidden><span class="stage-spinner" aria-hidden="true"></span><p>Generating geometry<b data-loading-name></b></p></div>
        <p class="stage-hint"><span>Drag</span> to orbit · <span>scroll</span> to zoom · <span>click</span> any structure</p>

        <div class="stage-foot">
          <div class="transport" data-transport hidden>
            <button class="transport-play" data-play aria-pressed="true" aria-label="Pause"><span data-play-glyph>❚❚</span></button>
            <div class="transport-track">
              <div class="transport-phases" data-phases></div>
              <input type="range" min="0" max="1000" value="0" step="1" data-scrub aria-label="Scrub through the process" />
              <p class="transport-caption"><b data-phase-name>Chemotaxis</b><span data-phase-caption></span></p>
            </div>
          </div>
          <div class="specimen-tray" data-tray aria-label="Choose a specimen"></div>
        </div>
        <div class="sr-only" role="status" aria-live="polite" data-announce></div>
      </div>

      <aside class="biology-readout" aria-label="Selected structure information">
        <div class="readout-heading">
          <div><p class="label label--accent" data-part-system>Cell boundary</p><h2 data-part-name>Plasma membrane</h2></div>
          <span class="part-index" data-part-index>01 / 09</span>
        </div>
        <p class="part-description" data-part-description></p>
        <div class="role-card"><span class="label">Functional role</span><p data-part-role></p></div>
        <dl class="part-facts">
          <div><dt>Organisation</dt><dd data-part-kind></dd></div>
          <div><dt>Model scale</dt><dd data-part-scale></dd></div>
        </dl>
        <div class="structure-list-head"><span class="label">Selectable structures</span><span data-structure-count>09 parts</span></div>
        <div class="structure-list" data-parts aria-label="Select a structure"></div>
        <div class="observation"><span class="label">Field note</span><p data-part-note></p></div>
      </aside>
    </div>
  </section>
</solid-biology-explorer>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";
  import { RoomEnvironment } from "three/examples/jsm/environments/RoomEnvironment.js";
  import { BY_ID, CATEGORIES, SPECIMENS } from "../../lib/bio";
  import type { Built, Category, Part, Specimen } from "../../lib/bio";

  const CAMERA_DIR = new THREE.Vector3(0.5, 0.3, 1).normalize();
  const pad = (n: number) => String(n).padStart(2, "0");

  class SolidBiologyExplorer extends HTMLElement {
    canvas!: HTMLCanvasElement;
    renderer!: THREE.WebGLRenderer;
    scene!: THREE.Scene;
    camera!: THREE.PerspectiveCamera;
    controls!: OrbitControls;
    ground!: THREE.Mesh;

    specimen: Specimen = SPECIMENS[0];
    built?: Built;
    cache = new Map<string, Built>();
    category: Category = "micro";
    selected = "";
    hover = "";
    isolate = false;
    auto = true;
    playing = true;
    progress = 0;
    clock = new THREE.Clock();
    elapsed = 0;
    frame = 0;
    token = 0;

    raycaster = new THREE.Raycaster();
    pointer = new THREE.Vector2();
    pointerDown?: { x: number; y: number };
    resizeObserver?: ResizeObserver;
    aborter = new AbortController();
    homeCamera = new THREE.Vector3(0, 0, 8);
    homeTarget = new THREE.Vector3();

    connectedCallback() {
      this.canvas = this.querySelector("[data-canvas]") as HTMLCanvasElement;
      this.auto = !matchMedia("(prefers-reduced-motion: reduce)").matches;

      this.renderer = new THREE.WebGLRenderer({ canvas: this.canvas, antialias: true, alpha: true, powerPreference: "high-performance" });
      this.renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2));
      this.renderer.outputColorSpace = THREE.SRGBColorSpace;
      this.renderer.toneMapping = THREE.ACESFilmicToneMapping;
      this.renderer.toneMappingExposure = 1.02;
      this.renderer.shadowMap.enabled = true;
      this.renderer.shadowMap.type = THREE.PCFSoftShadowMap;

      this.scene = new THREE.Scene();
      this.camera = new THREE.PerspectiveCamera(34, 1, 0.05, 200);
      this.controls = new OrbitControls(this.camera, this.canvas);
      this.controls.enableDamping = true;
      this.controls.dampingFactor = 0.07;
      this.controls.autoRotateSpeed = 0.65;

      // Image-based lighting, so the physical materials read as wet tissue
      // rather than as black plastic under three point lights.
      const pmrem = new THREE.PMREMGenerator(this.renderer);
      this.scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
      this.addLights();

      this.ground = new THREE.Mesh(new THREE.CircleGeometry(9, 64), new THREE.ShadowMaterial({ color: 0x070a18, opacity: 0.24 }));
      this.ground.rotation.x = -Math.PI / 2;
      this.ground.receiveShadow = true;
      this.scene.add(this.ground);

      this.buildTabs();
      this.buildTray();
      this.bind();
      this.resizeObserver = new ResizeObserver(() => this.layout());
      this.resizeObserver.observe(this.canvas);
      this.layout();
      this.tick();
      this.load(SPECIMENS[0].id);
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.frame);
      this.aborter.abort();
      this.resizeObserver?.disconnect();
      this.controls?.dispose();
      this.cache.forEach(built => { this.disposeObject(built.group); built.dispose?.(); });
      this.cache.clear();
      this.ground?.geometry.dispose();
      (this.ground?.material as THREE.Material)?.dispose();
      this.renderer?.dispose();
    }

    addLights() {
      this.scene.add(new THREE.HemisphereLight(0xeef4ff, 0x26304b, 0.85));
      const key = new THREE.DirectionalLight(0xfff2df, 2.4);
      key.position.set(-5, 8, 8);
      key.castShadow = true;
      key.shadow.mapSize.set(2048, 2048);
      key.shadow.camera.near = 0.5;
      key.shadow.camera.far = 40;
      Object.assign(key.shadow.camera, { left: -8, right: 8, top: 8, bottom: -8 });
      key.shadow.bias = -0.0006;
      this.scene.add(key);
      const rim = new THREE.DirectionalLight(0x6fa8ff, 1.3);
      rim.position.set(6, 2, -6);
      this.scene.add(rim);
      const fill = new THREE.PointLight(0xd293ff, 0.85, 26);
      fill.position.set(-5, -2, 4);
      this.scene.add(fill);
    }

    /* ── chrome ── */

    buildTabs() {
      const host = this.querySelector("[data-tabs]");
      if (!host) return;
      CATEGORIES.forEach(category => {
        const button = document.createElement("button");
        button.type = "button";
        button.role = "tab";
        button.dataset.tab = category.id;
        button.innerHTML = `<b>${category.label}</b><em>${category.blurb}</em>`;
        button.addEventListener("click", () => this.setCategory(category.id), { signal: this.aborter.signal });
        host.append(button);
      });
    }

    buildTray() {
      const tray = this.querySelector("[data-tray]");
      if (!tray) return;
      tray.replaceChildren();
      SPECIMENS.filter(specimen => specimen.category === this.category).forEach((specimen, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.dataset.model = specimen.id;
        const swatch = specimen.parts.slice(0, 4).map(p => `<i style="--dot:${p.color}"></i>`).join("");
        button.innerHTML = `<span class="specimen-art" aria-hidden="true">${swatch}</span><small>${pad(index + 1)}</small><b>${specimen.name}</b><em>${specimen.subtitle}</em>`;
        button.addEventListener("click", () => this.load(specimen.id), { signal: this.aborter.signal });
        tray.append(button);
      });
      this.syncTray();
    }

    setCategory(category: Category) {
      if (this.category === category) return;
      this.category = category;
      this.buildTray();
      const first = SPECIMENS.find(specimen => specimen.category === category);
      if (first) this.load(first.id);
    }

    syncTray() {
      this.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach(button => {
        const active = button.dataset.tab === this.category;
        button.classList.toggle("active", active);
        button.setAttribute("aria-selected", String(active));
      });
      this.querySelectorAll<HTMLButtonElement>("[data-model]").forEach(button => {
        const active = button.dataset.model === this.specimen.id;
        button.classList.toggle("active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    }

    bind() {
      const signal = this.aborter.signal;
      this.querySelector("[data-spin]")?.addEventListener("click", () => { this.auto = !this.auto; this.syncSpin(); }, { signal });
      this.querySelector("[data-reset]")?.addEventListener("click", () => this.resetView(), { signal });
      this.querySelector("[data-isolate]")?.addEventListener("click", () => {
        this.isolate = !this.isolate;
        const button = this.querySelector<HTMLButtonElement>("[data-isolate]");
        button?.classList.toggle("active", this.isolate);
        button?.setAttribute("aria-pressed", String(this.isolate));
        this.updateMaterials();
      }, { signal });
      this.querySelector("[data-play]")?.addEventListener("click", () => this.setPlaying(!this.playing), { signal });
      this.querySelector("[data-scrub]")?.addEventListener("input", event => {
        this.progress = Number((event.target as HTMLInputElement).value) / 1000;
        this.built?.seek?.(this.progress);
        this.syncPhase();
      }, { signal });

      this.controls.addEventListener("start", () => { this.auto = false; this.syncSpin(); });
      this.canvas.addEventListener("pointerdown", event => { this.pointerDown = { x: event.clientX, y: event.clientY }; }, { signal });
      this.canvas.addEventListener("pointermove", event => {
        if (this.pointerDown && Math.hypot(event.clientX - this.pointerDown.x, event.clientY - this.pointerDown.y) > 4) { this.setHover(""); return; }
        this.setHover(this.pick(event));
      }, { signal });
      this.canvas.addEventListener("pointerleave", () => this.setHover(""), { signal });
      this.canvas.addEventListener("pointerup", event => {
        if (this.pointerDown && Math.hypot(event.clientX - this.pointerDown.x, event.clientY - this.pointerDown.y) < 4) {
          const id = this.pick(event);
          if (id) this.select(id, true);
        }
        this.pointerDown = undefined;
      }, { signal });
      this.canvas.addEventListener("keydown", event => {
        if (event.key === "Enter" && this.hover) { event.preventDefault(); this.select(this.hover, true); }
      }, { signal });
    }

    /* ── loading ── */

    async load(id: string) {
      const specimen = BY_ID.get(id);
      if (!specimen) return;
      const token = ++this.token;
      this.specimen = specimen;
      this.category = specimen.category;
      this.progress = 0;
      this.elapsed = 0;
      this.hover = "";
      this.selected = specimen.parts[0].id;

      this.text("[data-model-state]", `${specimen.name} · ${specimen.subtitle}`);
      this.text("[data-stage-code]", specimen.code);
      this.text("[data-stage-scale]", specimen.scale);
      this.canvas.setAttribute("aria-label", `Rotatable ${specimen.aria}. Drag to rotate, scroll to zoom.`);
      this.syncTray();
      this.buildPartButtons();
      this.select(this.selected, false);
      this.buildPhases();

      // Processes animate on their own; specimens rely on the turntable.
      this.auto = specimen.category !== "process" && !matchMedia("(prefers-reduced-motion: reduce)").matches;
      this.syncSpin();
      this.setPlaying(true);

      if (this.built) this.scene.remove(this.built.group);
      this.built = undefined;

      let built = this.cache.get(id);
      if (!built) {
        // Generating a specimen takes long enough to drop a frame, so let the
        // status paint before the main thread disappears into the geometry.
        this.showLoading(true, specimen.name);
        await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
        if (token !== this.token) return;
        built = specimen.build();
        this.prepare(built.group);
        this.cache.set(id, built);
      }
      if (token !== this.token) return;

      this.built = built;
      // Put the model into its first frame *before* framing the camera — a
      // metaball surface has no extent until its field has been evaluated once.
      built.seek?.(0);
      built.update?.(0, 0);
      this.scene.add(built.group);
      this.frameGroup(built.group);
      this.updateMaterials();
      this.showLoading(false);
      this.syncPhase();
    }

    /** Record each material's resting state so highlight and isolate can be undone. */
    prepare(root: THREE.Object3D) {
      root.traverse(child => {
        if (!(child instanceof THREE.Mesh)) return;
        const materials = Array.isArray(child.material) ? child.material : [child.material];
        materials.forEach(material => {
          if (!material) return;
          material.userData.baseOpacity = material.opacity;
          material.userData.baseTransparent = material.transparent;
          material.userData.baseDepthWrite = material.depthWrite;
          if ("emissive" in material) {
            const standard = material as THREE.MeshStandardMaterial;
            material.userData.baseEmissive = standard.emissive.clone();
            material.userData.baseEmissiveIntensity = standard.emissiveIntensity;
          }
        });
      });
    }

    frameGroup(group: THREE.Object3D) {
      const box = new THREE.Box3().setFromObject(group);
      // Marching-cubes surfaces preallocate their vertex buffer, so their
      // computed box is meaningless — take their known field extent instead.
      group.traverse(child => {
        if (!(child instanceof THREE.Mesh) || !child.userData.volume) return;
        const centre = child.getWorldPosition(new THREE.Vector3());
        const scale = child.getWorldScale(new THREE.Vector3());
        const reach = Math.max(scale.x, scale.y, scale.z);   // the field spans ±1 before scaling
        box.expandByPoint(centre.clone().addScalar(reach));
        box.expandByPoint(centre.clone().addScalar(-reach));
      });
      if (box.isEmpty()) box.setFromCenterAndSize(new THREE.Vector3(), new THREE.Vector3(4, 4, 4));

      const sphere = box.getBoundingSphere(new THREE.Sphere());
      this.ground.position.y = box.min.y - 0.05;
      const fov = (this.camera.fov * Math.PI) / 180;
      const distance = (sphere.radius / Math.sin(fov / 2)) * 1.22;
      this.homeCamera.copy(CAMERA_DIR).multiplyScalar(distance).add(sphere.center);
      this.homeTarget.copy(sphere.center);
      this.controls.minDistance = distance * 0.25;
      this.controls.maxDistance = distance * 3;
      this.camera.near = Math.max(0.02, distance * 0.01);
      this.camera.far = distance * 12;
      this.camera.position.copy(this.homeCamera);
      this.controls.target.copy(this.homeTarget);
      this.controls.update();
      this.camera.updateProjectionMatrix();
    }

    disposeObject(object: THREE.Object3D) {
      object.traverse(child => {
        if (!(child instanceof THREE.Mesh)) return;
        child.geometry.dispose();
        const materials = Array.isArray(child.material) ? child.material : [child.material];
        materials.forEach(material => material?.dispose());
      });
    }

    /* ── readout ── */

    buildPartButtons() {
      const list = this.querySelector<HTMLElement>("[data-parts]");
      if (!list) return;
      list.replaceChildren();
      this.specimen.parts.forEach((item, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.dataset.part = item.id;
        button.innerHTML = `<i style="--part:${item.color}"></i><span><b>${pad(index + 1)}</b>${item.name}</span><em>↗</em>`;
        button.addEventListener("click", () => this.select(item.id, true), { signal: this.aborter.signal });
        list.append(button);
      });
      this.text("[data-structure-count]", `${pad(this.specimen.parts.length)} parts`);
    }

    select(id: string, announce: boolean) {
      const index = this.specimen.parts.findIndex(item => item.id === id);
      if (index < 0) return;
      const item: Part = this.specimen.parts[index];
      this.selected = id;
      this.text("[data-part-system]", item.system);
      this.text("[data-part-name]", item.name);
      this.text("[data-part-description]", item.description);
      this.text("[data-part-role]", item.role);
      this.text("[data-part-kind]", item.kind);
      this.text("[data-part-scale]", item.scale);
      this.text("[data-part-note]", item.note);
      this.text("[data-part-index]", `${pad(index + 1)} / ${pad(this.specimen.parts.length)}`);
      (this.querySelector(".biology-readout") as HTMLElement)?.style.setProperty("--selected-part", item.color);
      this.querySelectorAll<HTMLButtonElement>("[data-part]").forEach(button => {
        const active = button.dataset.part === id;
        button.classList.toggle("active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      if (announce) this.text("[data-announce]", `${item.name} selected. ${item.description}`);
      this.updateMaterials();
    }

    setHover(id: string) {
      if (id === this.hover) return;
      this.hover = id;
      this.canvas.style.cursor = id ? "pointer" : "grab";
      this.updateMaterials();
    }

    updateMaterials() {
      this.built?.group.traverse(child => {
        if (!(child instanceof THREE.Mesh)) return;
        const id = child.userData.partId as string | undefined;
        const active = !!id && id === this.selected;
        const over = !!id && id === this.hover;
        const faded = this.isolate && !active;
        const materials = Array.isArray(child.material) ? child.material : [child.material];
        materials.forEach(material => {
          if (!material) return;
          if (faded) {
            material.transparent = true;
            material.opacity = (material.userData.baseOpacity ?? 1) * 0.1;
            material.depthWrite = false;
          } else {
            material.transparent = material.userData.baseTransparent ?? material.transparent;
            material.opacity = material.userData.baseOpacity ?? material.opacity;
            material.depthWrite = material.userData.baseDepthWrite ?? material.depthWrite;
          }
          if (!("emissive" in material)) return;
          const standard = material as THREE.MeshStandardMaterial;
          if ((active || over) && !faded) {
            standard.emissive.set((child.userData.partColor as string) || "#ffffff");
            standard.emissiveIntensity = over ? 0.5 : 0.32;
          } else {
            standard.emissive.copy((material.userData.baseEmissive as THREE.Color) ?? new THREE.Color(0x000000));
            standard.emissiveIntensity = (material.userData.baseEmissiveIntensity as number) ?? 0;
          }
        });
      });
    }

    pick(event: PointerEvent) {
      if (!this.built) return "";
      const rect = this.canvas.getBoundingClientRect();
      this.pointer.set(((event.clientX - rect.left) / rect.width) * 2 - 1, -(((event.clientY - rect.top) / rect.height) * 2 - 1));
      this.raycaster.setFromCamera(this.pointer, this.camera);
      const hits = this.raycaster.intersectObject(this.built.group, true);
      const ids = hits.map(hit => hit.object.userData.partId as string).filter(Boolean);
      // Enclosing surfaces are hit first and are almost never what was meant,
      // so a boundary only wins if there is nothing behind it.
      const boundary = /^(membrane|wall|macrophage|sclera)$/;
      return ids.find(id => !boundary.test(id)) || ids[0] || "";
    }

    /* ── transport ── */

    buildPhases() {
      const transport = this.querySelector<HTMLElement>("[data-transport]");
      const host = this.querySelector<HTMLElement>("[data-phases]");
      const phases = this.specimen.phases;
      if (!transport || !host) return;
      transport.hidden = !phases;
      host.replaceChildren();
      if (!phases) return;
      phases.forEach((phase, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.dataset.phase = String(index);
        button.style.setProperty("--at", String(phase.at));
        button.innerHTML = `<i></i><span>${phase.name}</span>`;
        button.addEventListener("click", () => {
          this.progress = phase.at + 0.001;
          this.built?.seek?.(this.progress);
          this.syncPhase();
        }, { signal: this.aborter.signal });
        host.append(button);
      });
    }

    setPlaying(playing: boolean) {
      this.playing = playing;
      const button = this.querySelector<HTMLButtonElement>("[data-play]");
      button?.setAttribute("aria-pressed", String(playing));
      button?.setAttribute("aria-label", playing ? "Pause" : "Play");
      this.text("[data-play-glyph]", playing ? "❚❚" : "▶");
    }

    syncPhase() {
      const phases = this.specimen.phases;
      if (!phases) return;
      const scrub = this.querySelector<HTMLInputElement>("[data-scrub]");
      if (scrub && document.activeElement !== scrub) scrub.value = String(Math.round(this.progress * 1000));
      let index = 0;
      for (let i = 0; i < phases.length; i++) if (this.progress >= phases[i].at) index = i;
      this.text("[data-phase-name]", phases[index].name);
      this.text("[data-phase-caption]", phases[index].caption);
      this.querySelectorAll<HTMLButtonElement>("[data-phase]").forEach(button => {
        button.classList.toggle("active", Number(button.dataset.phase) === index);
      });
    }

    /* ── loop ── */

    resetView() {
      this.camera.position.copy(this.homeCamera);
      this.controls.target.copy(this.homeTarget);
      this.controls.update();
      this.auto = false;
      this.syncSpin();
    }

    syncSpin() {
      this.controls.autoRotate = this.auto;
      const button = this.querySelector<HTMLButtonElement>("[data-spin]");
      button?.classList.toggle("active", this.auto);
      button?.setAttribute("aria-pressed", String(this.auto));
    }

    showLoading(on: boolean, name = "") {
      const node = this.querySelector<HTMLElement>("[data-loading]");
      if (node) node.hidden = !on;
      this.text("[data-loading-name]", on && name ? ` · ${name}` : "");
    }

    layout() {
      if (!this.renderer) return;
      const rect = this.canvas.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      this.renderer.setSize(rect.width, rect.height, false);
      this.camera.aspect = rect.width / rect.height;
      this.camera.updateProjectionMatrix();
    }

    tick = () => {
      this.frame = requestAnimationFrame(this.tick);
      const delta = Math.min(this.clock.getDelta(), 0.05);
      if (this.built) {
        if (this.specimen.phases) {
          if (this.playing) {
            this.progress = (this.progress + delta / (this.specimen.duration || 20)) % 1;
            this.built.seek?.(this.progress);
            this.syncPhase();
          }
        } else {
          this.elapsed += delta;
          this.built.update?.(this.elapsed, delta);
        }
      }
      this.controls.autoRotate = this.auto;
      this.controls.update();
      this.renderer.render(this.scene, this.camera);
    };

    text(selector: string, value: string) {
      const node = this.querySelector(selector);
      if (node) node.textContent = value;
    }
  }

  if (!customElements.get("solid-biology-explorer")) customElements.define("solid-biology-explorer", SolidBiologyExplorer);
</script>

<style>
  solid-biology-explorer{display:block;--bio-green:#55d6be}

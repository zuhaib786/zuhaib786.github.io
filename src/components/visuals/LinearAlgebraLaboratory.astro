<linear-algebra-laboratory>
  <section class="math-instrument" aria-label="Interactive linear algebra laboratory">
    <div class="math-bar"><div class="math-state"><i></i><span data-state>Drag the vector or edit the matrix</span></div><div class="math-actions"><div class="math-tabs" aria-label="Linear algebra view"><button class="active" data-mode="map">Linear map</button><button data-mode="eigen">Eigenstructure</button><button data-mode="svd">SVD</button><button data-mode="projection">Projection</button></div><button class="math-button" data-preset>Next matrix</button></div></div>
    <div class="math-dashboard">
      <div class="math-stage"><span class="math-stage-label label" data-stage-label>domain grid · image grid · drag v</span><canvas data-canvas aria-label="Linear map acting on a grid and unit circle"></canvas></div>
      <aside class="math-readout"><p class="label label--accent">Linear algebra as geometry</p><h2 data-title>A matrix moves a basis</h2><p data-description>The columns are the images of the coordinate basis. Every grid point follows because linearity determines the rest of the plane.</p><div class="math-formula" data-formula>A = [ 1.20  0.65 ; −0.25  0.90 ]</div>
        <div class="math-metrics"><div><strong data-det>1.243</strong><small data-det-label>Determinant</small></div><div><strong data-trace>2.100</strong><small data-trace-label>Trace</small></div><div><strong data-condition>1.77</strong><small data-condition-label>Condition number</small></div></div>
        <div class="math-controls">
          <div class="matrix-controls"><div class="math-control"><label><span>a₁₁</span><b data-a-value>1.20</b></label><input data-a type="range" min="-2" max="2" step="0.05" value="1.2" /></div><div class="math-control"><label><span>a₁₂</span><b data-b-value>0.65</b></label><input data-b type="range" min="-2" max="2" step="0.05" value="0.65" /></div><div class="math-control"><label><span>a₂₁</span><b data-c-value>−0.25</b></label><input data-c type="range" min="-2" max="2" step="0.05" value="-0.25" /></div><div class="math-control"><label><span>a₂₂</span><b data-d-value>0.90</b></label><input data-d type="range" min="-2" max="2" step="0.05" value="0.9" /></div></div>
          <div class="math-control" data-stage-control hidden><label><span data-stage-control-label>Decomposition stage</span><b data-stage-value>A</b></label><input data-stage type="range" min="0" max="3" step="0.01" value="3" /></div>
        </div>
        <div class="math-legend"><span><i></i>Ae₁ / principal direction</span><span><i></i>Ae₂ / secondary direction</span><span><i></i>selected vector</span></div><div class="math-trace"><p class="label">Invariant reading</p><ol><li data-reading-1>Area scales by det A = 1.243.</li><li data-reading-2>Orientation is preserved because det A &gt; 0.</li><li data-reading-3>The unit circle becomes an ellipse.</li></ol></div>
      </aside>
    </div>
  </section>
</linear-algebra-laboratory>

<script>
  type Mode="map"|"eigen"|"svd"|"projection";type Pt=[number,number];
  const INFO:Record<Mode,[string,string,string,string]>={
    map:["A matrix moves a basis","The columns are the images of the coordinate basis. Every grid point follows because linearity determines the rest of the plane.","A x = x₁ Ae₁ + x₂ Ae₂","domain grid · image grid · drag v"],
    eigen:["Some directions do not turn","An eigenvector stays on its own span. Repeated application changes its magnitude by powers of the corresponding eigenvalue.","A vᵢ = λᵢ vᵢ","eigendirections · repeated application of A"],
    svd:["Every map is rotate, stretch, rotate","The SVD separates a general linear map into an input rotation, orthogonal axis scaling, and an output rotation.","A = U Σ Vᵀ","Vᵀ → Σ → U · scrub the factorisation"],
    projection:["Approximation leaves an orthogonal error","Projection selects the point on a line nearest to v. The residual is perpendicular to every vector in the target subspace.","projᵤ(v) = (v·u / u·u)u","orthogonal projection · drag v"],
  };
  class LinearAlgebraLaboratory extends HTMLElement{
    canvas!:HTMLCanvasElement;ctx!:CanvasRenderingContext2D;width=0;height=0;mode:Mode="map";A=[1.2,.65,-.25,.9];v:Pt=[1.25,1.45];stage=3;dragging=false;preset=0;resize?:ResizeObserver;theme?:MutationObserver;aborter=new AbortController();
    presets=[[1.2,.65,-.25,.9],[1.45,.75,.75,.35],[.2,1.35,-1.1,.25],[1,.8,0,.18],[-1.1,.35,.2,.9]];
    connectedCallback(){this.canvas=this.querySelector("[data-canvas]") as HTMLCanvasElement;const c=this.canvas.getContext("2d");if(!c)return;this.ctx=c;this.bind();this.resize=new ResizeObserver(()=>this.layout());this.resize.observe(this.canvas);this.theme=new MutationObserver(()=>this.draw());this.theme.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});this.configure();this.layout();}
    disconnectedCallback(){this.aborter.abort();this.resize?.disconnect();this.theme?.disconnect();}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(b=>b.addEventListener("click",()=>{this.mode=b.dataset.mode as Mode;this.querySelectorAll("[data-mode]").forEach(x=>x.classList.toggle("active",x===b));if(this.mode==="eigen")this.setMatrix([1.35,.62,.62,.45]);this.configure();this.draw();},{signal}));this.querySelector("[data-preset]")?.addEventListener("click",()=>{this.preset=(this.preset+1)%this.presets.length;this.setMatrix(this.presets[this.preset]);this.draw();},{signal});
      (["a","b","c","d"] as const).forEach((key,i)=>this.querySelector<HTMLInputElement>(`[data-${key}]`)?.addEventListener("input",e=>{this.A[i]=Number((e.currentTarget as HTMLInputElement).value);this.text(`[data-${key}-value]`,this.signed(this.A[i]));this.draw();},{signal}));this.querySelector<HTMLInputElement>("[data-stage]")?.addEventListener("input",e=>{this.stage=Number((e.currentTarget as HTMLInputElement).value);this.text("[data-stage-value]",this.mode==="projection"?`${Math.round(this.stage/3*180)}°`:this.stage<1?"Vᵀ":this.stage<2?"Σ":"U");this.draw();},{signal});
      this.canvas.addEventListener("pointerdown",e=>{this.dragging=true;this.canvas.setPointerCapture(e.pointerId);this.pick(e);},{signal});this.canvas.addEventListener("pointermove",e=>{if(this.dragging)this.pick(e);},{signal});const up=(e:PointerEvent)=>{this.dragging=false;if(this.canvas.hasPointerCapture(e.pointerId))this.canvas.releasePointerCapture(e.pointerId);};this.canvas.addEventListener("pointerup",up,{signal});this.canvas.addEventListener("pointercancel",up,{signal});}
    configure(){const i=INFO[this.mode];this.text("[data-title]",i[0]);this.text("[data-description]",i[1]);this.text("[data-formula]",i[2]);this.text("[data-stage-label]",i[3]);const ctl=this.querySelector<HTMLElement>("[data-stage-control]");if(ctl)ctl.hidden=!(this.mode==="svd"||this.mode==="projection");this.text("[data-stage-control-label]",this.mode==="projection"?"Subspace angle":"Decomposition stage");if(this.mode==="projection"){this.stage=.6;this.text("[data-stage-value]","36°");}else if(this.mode==="svd"){this.stage=3;this.text("[data-stage-value]","U");}}
    setMatrix(values:number[]){this.A=[...values];(["a","b","c","d"] as const).forEach((k,i)=>{const input=this.querySelector<HTMLInputElement>(`[data-${k}]`);if(input)input.value=String(values[i]);this.text(`[data-${k}-value]`,this.signed(values[i]));});}
    pick(e:PointerEvent){const r=this.canvas.getBoundingClientRect(),scale=Math.min(this.width,this.height)/7;this.v=[(e.clientX-r.left-this.width/2)/scale,(this.height/2-(e.clientY-r.top))/scale];this.draw();}
    layout(){const r=this.canvas.getBoundingClientRect();if(!r.width)return;const d=Math.min(devicePixelRatio||1,2);this.width=r.width;this.height=r.height;this.canvas.width=Math.round(r.width*d);this.canvas.height=Math.round(r.height*d);this.ctx.setTransform(d,0,0,d,0,0);this.draw();}
    mul(A:number[],p:Pt):Pt{return[A[0]*p[0]+A[1]*p[1],A[2]*p[0]+A[3]*p[1]];}
    eig(){const [a,b,c,d]=this.A,tr=a+d,det=a*d-b*c,disc=tr*tr-4*det;if(disc<0)return{real:false,l1:tr/2,l2:tr/2,v1:[1,0] as Pt,v2:[0,1] as Pt};const root=Math.sqrt(disc),l1=(tr+root)/2,l2=(tr-root)/2;const vector=(l:number):Pt=>{let v:Pt=Math.abs(b)>Math.abs(c)?[b,l-a]:[l-d,c];const n=Math.hypot(...v)||1;return[v[0]/n,v[1]/n];};return{real:true,l1,l2,v1:vector(l1),v2:vector(l2)};}
    svd(){const [a,b,c,d]=this.A,p=a*a+c*c,q=a*b+c*d,r=b*b+d*d,tr=p+r,disc=Math.sqrt(Math.max(0,(p-r)*(p-r)+4*q*q)),l1=(tr+disc)/2,l2=(tr-disc)/2,s1=Math.sqrt(Math.max(0,l1)),s2=Math.sqrt(Math.max(0,l2));let v1:Pt=Math.abs(q)>.00001?[q,l1-p]:p>=r?[1,0]:[0,1],n=Math.hypot(...v1)||1;v1=[v1[0]/n,v1[1]/n];const v2:Pt=[-v1[1],v1[0]],u1raw=this.mul(this.A,v1),u2raw=this.mul(this.A,v2),u1:Pt=s1?[u1raw[0]/s1,u1raw[1]/s1]:[1,0],u2:Pt=s2?[u2raw[0]/s2,u2raw[1]/s2]:[-u1[1],u1[0]];return{s1,s2,v1,v2,u1,u2};}
    stageMatrix(){if(this.mode!=="svd")return this.A;const s=this.svd(),t=this.stage,angle=Math.atan2(s.v1[1],s.v1[0]);if(t<1){const a=-angle*t;return[Math.cos(a),-Math.sin(a),Math.sin(a),Math.cos(a)];}const VT=[s.v1[0],s.v1[1],s.v2[0],s.v2[1]];if(t<2){const u=t-1,stretch=[1+(s.s1-1)*u,0,0,1+(s.s2-1)*u];return this.mm(stretch,VT);}const pre=this.mm([s.s1,0,0,s.s2],VT),u=t-2;return pre.map((v,i)=>v+(this.A[i]-v)*u);}
    mm(X:number[],Y:number[]){return[X[0]*Y[0]+X[1]*Y[2],X[0]*Y[1]+X[1]*Y[3],X[2]*Y[0]+X[3]*Y[2],X[2]*Y[1]+X[3]*Y[3]];}
    draw(){if(!this.width)return;const c=this.ctx,s=getComputedStyle(this),paper=s.getPropertyValue("--paper-sunken"),rule=s.getPropertyValue("--rule"),soft=s.getPropertyValue("--ink-faint"),A=this.stageMatrix(),scale=Math.min(this.width,this.height)/7,to=(p:Pt)=>({x:this.width/2+p[0]*scale,y:this.height/2-p[1]*scale});c.clearRect(0,0,this.width,this.height);c.fillStyle=paper;c.fillRect(0,0,this.width,this.height);this.drawGrid(c,[1,0,0,1],to,rule,.55);if(this.mode!=="projection")this.drawGrid(c,A,to,this.css("--math-a"),.5);const o=to([0,0]);c.strokeStyle=soft;c.lineWidth=1;c.beginPath();c.moveTo(0,o.y);c.lineTo(this.width,o.y);c.moveTo(o.x,0);c.lineTo(o.x,this.height);c.stroke();if(this.mode==="projection")this.drawProjection(c,to);else{this.drawCircle(c,A,to);this.arrow(c,to([0,0]),to(this.mul(A,[1,0])),this.css("--math-a"),"Ae₁");this.arrow(c,to([0,0]),to(this.mul(A,[0,1])),this.css("--math-b"),"Ae₂");if(this.mode==="eigen")this.drawEigen(c,to);const Av=this.mul(A,this.v);this.arrow(c,to([0,0]),to(Av),this.css("--math-good"),"Av");}this.updateReadout();}
    drawGrid(c:CanvasRenderingContext2D,A:number[],to:(p:Pt)=>{x:number;y:number},color:string,alpha:number){c.strokeStyle=color;c.globalAlpha=alpha;c.lineWidth=.8;for(let k=-4;k<=4;k++){for(let family=0;family<2;family++){c.beginPath();for(let j=0;j<=80;j++){const t=-4+j/10,p:Pt=family?[t,k]:[k,t],q=to(this.mul(A,p));j?c.lineTo(q.x,q.y):c.moveTo(q.x,q.y);}c.stroke();}}c.globalAlpha=1;}
    drawCircle(c:CanvasRenderingContext2D,A:number[],to:(p:Pt)=>{x:number;y:number}){c.strokeStyle=this.css("--ink-soft");c.lineWidth=1.6;c.beginPath();for(let n=0;n<=160;n++){const a=n/160*Math.PI*2,p=this.mul(A,[Math.cos(a),Math.sin(a)]),q=to(p);n?c.lineTo(q.x,q.y):c.moveTo(q.x,q.y);}c.stroke();}
    drawEigen(c:CanvasRenderingContext2D,to:(p:Pt)=>{x:number;y:number}){const e=this.eig();if(!e.real){this.text("[data-state]","Complex eigenvalues · no real invariant lines");return;}for(const [v,color,label] of [[e.v1,this.css("--math-a"),`λ₁=${e.l1.toFixed(2)}`],[e.v2,this.css("--math-b"),`λ₂=${e.l2.toFixed(2)}`]] as [Pt,string,string][]){const a=to([-v[0]*4,-v[1]*4]),b=to([v[0]*4,v[1]*4]);c.strokeStyle=color;c.lineWidth=1.5;c.setLineDash([5,4]);c.beginPath();c.moveTo(a.x,a.y);c.lineTo(b.x,b.y);c.stroke();c.setLineDash([]);c.fillStyle=color;c.font="600 9px IBM Plex Mono";c.fillText(label,b.x-62,b.y-8);}let p=this.v;for(let n=0;n<5;n++){const q=this.mul(this.A,p);this.arrow(c,to(p),to(q),this.css("--math-good"),n===4?"A⁵v":"");p=q;if(Math.hypot(...p)>4){const m=Math.hypot(...p);p=[p[0]/m*3,p[1]/m*3];}}}
    drawProjection(c:CanvasRenderingContext2D,to:(p:Pt)=>{x:number;y:number}){const angle=this.stage/3*Math.PI,u:Pt=[Math.cos(angle),Math.sin(angle)],dot=this.v[0]*u[0]+this.v[1]*u[1],p:Pt=[dot*u[0],dot*u[1]],a=to([-u[0]*4,-u[1]*4]),b=to([u[0]*4,u[1]*4]);c.strokeStyle=this.css("--math-a");c.lineWidth=2;c.beginPath();c.moveTo(a.x,a.y);c.lineTo(b.x,b.y);c.stroke();this.arrow(c,to([0,0]),to(this.v),this.css("--math-good"),"v");this.arrow(c,to([0,0]),to(p),this.css("--math-a"),"proj v");const vp=to(this.v),pp=to(p);c.strokeStyle=this.css("--math-b");c.setLineDash([4,4]);c.beginPath();c.moveTo(vp.x,vp.y);c.lineTo(pp.x,pp.y);c.stroke();c.setLineDash([]);this.text("[data-det]",dot.toFixed(3));this.text("[data-det-label]","Projection coefficient");this.text("[data-trace]",Math.hypot(this.v[0]-p[0],this.v[1]-p[1]).toFixed(3));this.text("[data-trace-label]","Residual norm");this.text("[data-condition]","90°");this.text("[data-condition-label]","Residual angle");}
    arrow(c:CanvasRenderingContext2D,a:{x:number;y:number},b:{x:number;y:number},color:string,label:string){c.strokeStyle=color;c.fillStyle=color;c.lineWidth=2;c.beginPath();c.moveTo(a.x,a.y);c.lineTo(b.x,b.y);c.stroke();const ang=Math.atan2(b.y-a.y,b.x-a.x);c.beginPath();c.moveTo(b.x,b.y);c.lineTo(b.x-9*Math.cos(ang-.42),b.y-9*Math.sin(ang-.42));c.lineTo(b.x-9*Math.cos(ang+.42),b.y-9*Math.sin(ang+.42));c.fill();if(label){c.font="600 9px IBM Plex Mono";c.fillText(label,b.x+6,b.y-7);}}
    updateReadout(){if(this.mode==="projection"){this.text("[data-reading-1]","The scalar coefficient is the coordinate of v along u.");this.text("[data-reading-2]","The residual v − projᵤ(v) is perpendicular to u.");this.text("[data-reading-3]","Projection minimizes Euclidean distance to the line.");return;}const [a,b,c,d]=this.A,det=a*d-b*c,tr=a+d,s=this.svd(),cond=s.s2<1e-8?Infinity:s.s1/s.s2;this.text("[data-det-label]","Determinant");this.text("[data-trace-label]","Trace");this.text("[data-condition-label]","Condition number");this.text("[data-det]",det.toFixed(3));this.text("[data-trace]",tr.toFixed(3));this.text("[data-condition]",Number.isFinite(cond)?cond.toFixed(2):"∞");this.text("[data-formula]",this.mode==="svd"?`A = U diag(${s.s1.toFixed(2)}, ${s.s2.toFixed(2)}) Vᵀ`:this.mode==="eigen"?`A vᵢ = λᵢ vᵢ`:`A = [ ${a.toFixed(2)}  ${b.toFixed(2)} ; ${c.toFixed(2)}  ${d.toFixed(2)} ]`);this.text("[data-reading-1]",`Area scales by det A = ${det.toFixed(3)}.`);this.text("[data-reading-2]",det<0?"Orientation is reversed because det A < 0.":Math.abs(det)<.001?"The plane collapses to lower dimension because det A = 0.":"Orientation is preserved because det A > 0.");this.text("[data-reading-3]",this.mode==="svd"?`Principal stretches are σ₁=${s.s1.toFixed(3)} and σ₂=${s.s2.toFixed(3)}.`:"The unit circle becomes an ellipse whose axes are the singular directions.");}
    css(n:string){return getComputedStyle(this).getPropertyValue(n).trim()}signed(n:number){return`${n<0?"−":""}${Math.abs(n).toFixed(2)}`}text(q:string,s:string){const e=this.querySelector(q);if(e)e.textContent=s}
  }
  if(!customElements.get("linear-algebra-laboratory"))customElements.define("linear-algebra-laboratory",LinearAlgebraLaboratory);
</script>

<style>
  linear-algebra-laboratory{display:block}.math-stage canvas{cursor:crosshair}.matrix-controls{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}.math-readout [hidden]{display:none}
</style>

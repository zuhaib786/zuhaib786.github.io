<orbital-mechanics-laboratory>
  <section class="math-instrument" aria-label="Interactive orbital mechanics laboratory">
    <div class="math-bar"><div class="math-state"><i></i><span data-state>Velocity Verlet · conserving orbital structure</span></div><div class="math-actions"><div class="math-tabs" aria-label="Orbital preset"><button class="active" data-preset="binary">Binary</button><button data-preset="eccentric">Eccentric</button><button data-preset="figure8">Figure eight</button><button data-preset="slingshot">Slingshot</button></div><button class="math-button" data-play>Pause</button><button class="math-button" data-reset>Reset</button></div></div>
    <div class="math-dashboard">
      <div class="math-stage physics-stage"><span class="math-stage-label label" data-stage-label>configuration space · velocity vectors · invariant drift</span><canvas data-canvas aria-label="N-body trajectories and conservation diagnostics"></canvas></div>
      <aside class="math-readout"><p class="label label--accent">Orbital mechanics</p><h2 data-title>Two masses share one focus</h2><p data-description>Mutual gravity keeps both bodies moving around their common centre of mass. Drag a body to perturb the initial condition.</p><div class="math-formula" data-formula>r̈ᵢ = Σⱼ≠ᵢ Gmⱼ(rⱼ−rᵢ)/|rⱼ−rᵢ|³</div>
        <div class="math-metrics"><div><strong data-energy>0.00e+0</strong><small>Relative energy drift</small></div><div><strong data-angular>0.00e+0</strong><small>Angular momentum drift</small></div><div><strong data-orbit>e = 0.000</strong><small data-orbit-label>Osculating eccentricity</small></div></div>
        <div class="math-controls"><div class="math-control"><label><span>Integrator</span><b data-integrator-value>Verlet</b></label><select data-integrator><option value="verlet">Velocity Verlet</option><option value="euler">Explicit Euler</option></select></div><div class="math-control"><label><span>Time step Δt</span><b data-dt-value>0.008</b></label><input data-dt type="range" min="0.002" max="0.03" step="0.001" value="0.008" /></div><div class="math-control"><label><span>Steps per frame</span><b data-speed-value>4</b></label><input data-speed type="range" min="1" max="12" step="1" value="4" /></div><div class="math-control"><label><span>Softening ε</span><b data-soft-value>0.020</b></label><input data-soft type="range" min="0" max="0.12" step="0.005" value="0.02" /></div></div>
        <div class="math-legend"><span><i></i>trajectory / velocity</span><span><i></i>secondary mass</span><span><i></i>centre of mass</span></div><div class="math-trace"><p class="label">Structure check</p><ol><li data-reading-1>Velocity Verlet is symplectic and keeps bounded energy error.</li><li data-reading-2>Euler injects or removes energy monotonically.</li><li data-reading-3>Drag any mass to create a new initial-value problem.</li></ol></div>
      </aside>
    </div>
  </section>
</orbital-mechanics-laboratory>

<script>
  type Body={x:number;y:number;vx:number;vy:number;m:number;color:string;trail:{x:number;y:number}[]};
  type Preset="binary"|"eccentric"|"figure8"|"slingshot";
  const ORBIT_INFO:Record<Preset,[string,string]>={
    binary:["Two masses share one focus","Mutual gravity keeps both bodies moving around their common centre of mass. Drag a body to perturb the initial condition."],
    eccentric:["A conic is an energy statement","A light body alternates between fast periapsis and slow apoapsis while the osculating eccentricity reads the orbit's geometry."],
    figure8:["Three bodies exchange one curve","Equal masses chase one another along a periodic figure-eight solution with zero total angular momentum."],
    slingshot:["Gravity trades energy between travellers","A probe crosses a moving gravitational system and can leave with a different inertial-frame energy after the encounter."],
  };
  class OrbitalMechanicsLaboratory extends HTMLElement{
    canvas!:HTMLCanvasElement;ctx!:CanvasRenderingContext2D;width=0;height=0;bodies:Body[]=[];preset:Preset="binary";integrator="verlet";dt=.008;speed=4;soft=.02;playing=true;frame=0;last=0;tickCount=0;simTime=0;initialEnergy=0;initialAngular=0;history:{e:number;l:number}[]=[];selected=1;dragging=-1;view=4.8;resize?:ResizeObserver;theme?:MutationObserver;aborter=new AbortController();
    connectedCallback(){this.canvas=this.querySelector("[data-canvas]") as HTMLCanvasElement;const c=this.canvas.getContext("2d");if(!c)return;this.ctx=c;this.bind();this.resize=new ResizeObserver(()=>this.layout());this.resize.observe(this.canvas);this.theme=new MutationObserver(()=>this.draw());this.theme.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});this.load("binary");this.layout();this.frame=requestAnimationFrame(t=>this.animate(t));}
    disconnectedCallback(){cancelAnimationFrame(this.frame);this.aborter.abort();this.resize?.disconnect();this.theme?.disconnect();}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach(b=>b.addEventListener("click",()=>{this.querySelectorAll("[data-preset]").forEach(x=>x.classList.toggle("active",x===b));this.load(b.dataset.preset as Preset);},{signal}));this.querySelector("[data-play]")?.addEventListener("click",()=>{this.playing=!this.playing;const b=this.querySelector<HTMLButtonElement>("[data-play]");if(b)b.textContent=this.playing?"Pause":"Run";this.text("[data-state]",this.playing?`${this.integrator==="verlet"?"Velocity Verlet":"Explicit Euler"} · integrating motion`:"Paused · drag a mass or inspect invariants");},{signal});this.querySelector("[data-reset]")?.addEventListener("click",()=>this.load(this.preset),{signal});
      this.querySelector<HTMLSelectElement>("[data-integrator]")?.addEventListener("change",e=>{this.integrator=(e.currentTarget as HTMLSelectElement).value;this.text("[data-integrator-value]",this.integrator==="verlet"?"Verlet":"Euler");this.load(this.preset);},{signal});this.range("[data-dt]",v=>{this.dt=v;this.text("[data-dt-value]",v.toFixed(3));});this.range("[data-speed]",v=>{this.speed=v;this.text("[data-speed-value]",String(v));});this.range("[data-soft]",v=>{this.soft=v;this.text("[data-soft-value]",v.toFixed(3));this.rebase();});
      this.canvas.addEventListener("pointerdown",e=>this.beginDrag(e),{signal});this.canvas.addEventListener("pointermove",e=>this.moveDrag(e),{signal});const release=(e:PointerEvent)=>{if(this.dragging>=0){this.canvas.releasePointerCapture(e.pointerId);this.dragging=-1;this.rebase();}};this.canvas.addEventListener("pointerup",release,{signal});this.canvas.addEventListener("pointercancel",release,{signal});}
    range(q:string,fn:(v:number)=>void){this.querySelector<HTMLInputElement>(q)?.addEventListener("input",e=>fn(Number((e.currentTarget as HTMLInputElement).value)),{signal:this.aborter.signal});}
    load(name:Preset){this.preset=name;const colors=["#78d9ff","#ff8a62","#50c49b","#c98bff"];if(name==="binary"){const w=Math.sqrt(1.6/Math.pow(1.92,3));this.bodies=[this.body(-.72,0,0,-w*.72,1,colors[0]),this.body(1.2,0,0,w*1.2,.6,colors[1])];this.view=4.8;this.selected=1;}else if(name==="eccentric"){this.bodies=[this.body(-.013,0,0,-.008,3,colors[0]),this.body(1.95,0,0,1.02,.02,colors[1])];this.view=5.2;this.selected=1;}else if(name==="figure8"){this.bodies=[this.body(.97000436,-.24308753,.466203685,.43236573,1,colors[0]),this.body(-.97000436,.24308753,.466203685,.43236573,1,colors[1]),this.body(0,0,-.93240737,-.86473146,1,colors[2])];this.view=3.8;this.selected=2;}else{this.bodies=[this.body(0,0,0,-.08,4,colors[0]),this.body(1.25,0,0,1.72,.22,colors[1]),this.body(-3,-.9,1.85,.36,.006,colors[2])];this.view=7.4;this.selected=2;}this.simTime=0;this.tickCount=0;this.history=[];this.rebase();const [title,description]=ORBIT_INFO[name];this.text("[data-title]",title);this.text("[data-description]",description);this.draw();}
    body(x:number,y:number,vx:number,vy:number,m:number,color:string):Body{return{x,y,vx,vy,m,color,trail:[]}}
    accelerations(){const out=this.bodies.map(()=>({x:0,y:0}));for(let i=0;i<this.bodies.length;i++)for(let j=i+1;j<this.bodies.length;j++){const a=this.bodies[i],b=this.bodies[j],dx=b.x-a.x,dy=b.y-a.y,r2=dx*dx+dy*dy+this.soft*this.soft,inv=1/(r2*Math.sqrt(r2));out[i].x+=b.m*dx*inv;out[i].y+=b.m*dy*inv;out[j].x-=a.m*dx*inv;out[j].y-=a.m*dy*inv;}return out;}
    step(){const h=this.dt;if(this.integrator==="euler"){const a=this.accelerations();this.bodies.forEach((b,i)=>{b.x+=b.vx*h;b.y+=b.vy*h;b.vx+=a[i].x*h;b.vy+=a[i].y*h;});}else{let a=this.accelerations();this.bodies.forEach((b,i)=>{b.vx+=a[i].x*h/2;b.vy+=a[i].y*h/2;b.x+=b.vx*h;b.y+=b.vy*h;});a=this.accelerations();this.bodies.forEach((b,i)=>{b.vx+=a[i].x*h/2;b.vy+=a[i].y*h/2;});}this.simTime+=h;this.tickCount++;if(this.tickCount%3===0)this.bodies.forEach(b=>{b.trail.push({x:b.x,y:b.y});if(b.trail.length>900)b.trail.shift();});if(this.tickCount%24===0){const e=this.energy(),l=this.angular();this.history.push({e:Math.abs((e-this.initialEnergy)/(Math.abs(this.initialEnergy)||1)),l:Math.abs((l-this.initialAngular)/(Math.abs(this.initialAngular)||1))});if(this.history.length>180)this.history.shift();}}
    energy(){let e=this.bodies.reduce((s,b)=>s+.5*b.m*(b.vx*b.vx+b.vy*b.vy),0);for(let i=0;i<this.bodies.length;i++)for(let j=i+1;j<this.bodies.length;j++){const a=this.bodies[i],b=this.bodies[j];e-=a.m*b.m/Math.sqrt((a.x-b.x)**2+(a.y-b.y)**2+this.soft*this.soft);}return e;}
    angular(){return this.bodies.reduce((s,b)=>s+b.m*(b.x*b.vy-b.y*b.vx),0)}
    rebase(){this.initialEnergy=this.energy();this.initialAngular=this.angular();this.history=[];this.bodies.forEach(b=>b.trail=[]);this.updateMetrics();}
    orbitElements(){if(this.bodies.length!==2)return null;const a=this.bodies[0],b=this.bodies[1],rx=b.x-a.x,ry=b.y-a.y,vx=b.vx-a.vx,vy=b.vy-a.vy,r=Math.hypot(rx,ry),v2=vx*vx+vy*vy,mu=a.m+b.m,h=rx*vy-ry*vx,eps=v2/2-mu/r,e=Math.sqrt(Math.max(0,1+2*eps*h*h/(mu*mu))),axis=eps<0?-mu/(2*eps):Infinity,period=Number.isFinite(axis)?2*Math.PI*Math.sqrt(axis**3/mu):Infinity;return{e,period};}
    updateMetrics(){const e=this.energy(),l=this.angular(),ed=Math.abs((e-this.initialEnergy)/(Math.abs(this.initialEnergy)||1)),ld=Math.abs((l-this.initialAngular)/(Math.abs(this.initialAngular)||1)),o=this.orbitElements();this.text("[data-energy]",ed.toExponential(2));this.text("[data-angular]",ld.toExponential(2));this.text("[data-orbit]",o?`e = ${o.e.toFixed(3)}`:`t = ${this.simTime.toFixed(2)}`);this.text("[data-orbit-label]",o?"Osculating eccentricity":"Simulation time");this.text("[data-reading-1]",this.integrator==="verlet"?"Velocity Verlet is symplectic: its energy error normally oscillates instead of drifting away.":"Explicit Euler does not preserve orbital geometry; watch its energy error grow.");}
    layout(){const r=this.canvas.getBoundingClientRect();if(!r.width)return;const d=Math.min(devicePixelRatio||1,2);this.width=r.width;this.height=r.height;this.canvas.width=Math.round(r.width*d);this.canvas.height=Math.round(r.height*d);this.ctx.setTransform(d,0,0,d,0,0);this.draw();}
    animate(t:number){if(this.playing&&t-this.last>16){this.last=t;for(let n=0;n<this.speed;n++)this.step();this.updateMetrics();this.draw();}this.frame=requestAnimationFrame(x=>this.animate(x));}
    map(x:number,y:number){const plotH=this.height*.76,scale=Math.min(this.width,plotH)/this.view;return{x:this.width/2+x*scale,y:plotH/2-y*scale,scale,plotH}}
    beginDrag(e:PointerEvent){const r=this.canvas.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top;let best=-1,dist=24;this.bodies.forEach((b,i)=>{const p=this.map(b.x,b.y),d=Math.hypot(p.x-x,p.y-y);if(d<dist){dist=d;best=i;}});if(best>=0){this.dragging=best;this.selected=best;this.canvas.setPointerCapture(e.pointerId);this.moveDrag(e);}}
    moveDrag(e:PointerEvent){if(this.dragging<0)return;const r=this.canvas.getBoundingClientRect(),p=this.map(0,0),b=this.bodies[this.dragging];b.x=(e.clientX-r.left-this.width/2)/p.scale;b.y=(p.plotH/2-(e.clientY-r.top))/p.scale;b.trail=[];this.draw();}
    draw(){if(!this.width)return;const c=this.ctx,s=getComputedStyle(this),paper=s.getPropertyValue("--paper-sunken"),rule=s.getPropertyValue("--rule"),faint=s.getPropertyValue("--ink-faint");c.clearRect(0,0,this.width,this.height);c.fillStyle=paper;c.fillRect(0,0,this.width,this.height);const origin=this.map(0,0),plotH=origin.plotH;c.strokeStyle=rule;c.lineWidth=.7;for(let k=-6;k<=6;k++){const x=this.width/2+k*origin.scale;c.beginPath();c.moveTo(x,0);c.lineTo(x,plotH);c.stroke();const y=plotH/2+k*origin.scale;c.beginPath();c.moveTo(0,y);c.lineTo(this.width,y);c.stroke();}const totalM=this.bodies.reduce((q,b)=>q+b.m,0),cx=this.bodies.reduce((q,b)=>q+b.m*b.x,0)/totalM,cy=this.bodies.reduce((q,b)=>q+b.m*b.y,0)/totalM,com=this.map(cx,cy);c.strokeStyle=this.css("--math-good");c.lineWidth=1;c.beginPath();c.moveTo(com.x-7,com.y);c.lineTo(com.x+7,com.y);c.moveTo(com.x,com.y-7);c.lineTo(com.x,com.y+7);c.stroke();this.bodies.forEach((b,i)=>{c.strokeStyle=b.color;c.globalAlpha=.5;c.lineWidth=1.1;c.beginPath();b.trail.forEach((q,n)=>{const p=this.map(q.x,q.y);n?c.lineTo(p.x,p.y):c.moveTo(p.x,p.y);});c.stroke();c.globalAlpha=1;const p=this.map(b.x,b.y),radius=Math.max(3,Math.min(13,4+Math.sqrt(b.m)*4)),g=c.createRadialGradient(p.x-radius*.25,p.y-radius*.3,1,p.x,p.y,radius);g.addColorStop(0,"#fff");g.addColorStop(.25,b.color);g.addColorStop(1,"#10162e");c.fillStyle=g;c.beginPath();c.arc(p.x,p.y,radius,0,Math.PI*2);c.fill();if(i===this.selected){c.strokeStyle="#fff";c.lineWidth=1;c.beginPath();c.arc(p.x,p.y,radius+5,0,Math.PI*2);c.stroke();const vScale=origin.scale*.38;c.strokeStyle=b.color;c.beginPath();c.moveTo(p.x,p.y);c.lineTo(p.x+b.vx*vScale,p.y-b.vy*vScale);c.stroke();}});c.globalAlpha=1;this.drawChart(plotH,this.height-plotH,faint,rule);}
    drawChart(y:number,h:number,faint:string,rule:string){const c=this.ctx,x=28,w=this.width-56,top=y+18,ch=Math.max(34,h-36);c.strokeStyle=rule;c.strokeRect(x,top,w,ch);c.fillStyle=faint;c.font="8px IBM Plex Mono";c.fillText("relative invariant drift · log₁₀ scale",x+6,top+12);if(this.history.length<2)return;const values=this.history.flatMap(p=>[p.e,p.l]).filter(v=>v>0),lo=Math.min(-12,Math.floor(Math.log10(Math.min(...values,1e-12)))),hi=Math.max(-2,Math.ceil(Math.log10(Math.max(...values,1e-12)))),py=(v:number)=>top+ch-(Math.log10(Math.max(v,1e-14))-lo)/(hi-lo)*ch;for(const [key,color] of [["e",this.css("--math-a")],["l",this.css("--math-b")]] as ["e"|"l",string][]){c.strokeStyle=color;c.lineWidth=1.4;c.beginPath();this.history.forEach((p,n)=>{const qx=x+n/Math.max(1,this.history.length-1)*w,qy=py(p[key]);n?c.lineTo(qx,qy):c.moveTo(qx,qy);});c.stroke();}}
    css(n:string){return getComputedStyle(this).getPropertyValue(n).trim()}text(q:string,v:string){const e=this.querySelector(q);if(e)e.textContent=v}
  }
  if(!customElements.get("orbital-mechanics-laboratory"))customElements.define("orbital-mechanics-laboratory",OrbitalMechanicsLaboratory);
</script>

<style>orbital-mechanics-laboratory{display:block}.math-stage canvas{cursor:grab}.math-stage canvas:active{cursor:grabbing}</style>

<hashing-laboratory>
  <section class="instrument hash-lab" aria-label="Interactive hash-table collision visualizer">
    <div class="instrument-tabs"><button data-mode="chaining">Separate chaining</button><button class="active" data-mode="linear">Linear probing</button><button data-mode="quadratic">Quadratic probing</button><button data-mode="robin">Robin Hood</button></div>
    <div class="instrument-status"><span><strong data-state>Table ready</strong> · <span data-message>Insert a key and follow its probe sequence</span></span><span class="hint">Hash function: key mod 13</span></div>
    <div class="hash-layout">
      <div class="table-stage"><div class="hash-expression"><span>h(<b data-active-key>k</b>)</span><i>=</i><span><b data-hash>k</b> mod 13</span><i>=</i><strong data-home>?</strong></div><div class="slots" data-table></div></div>
      <aside>
        <p class="label label--accent">Collision policy</p><h2 data-name>Linear probing</h2><p data-description>Walk forward one bucket at a time until an empty slot appears.</p>
        <div class="instrument-metrics"><div><span data-load>0%</span><small>Load factor</small></div><div><span data-collisions>0</span><small>Collisions</small></div><div><span data-probe>0</span><small>Longest probe</small></div></div>
        <div class="probe-log"><p class="label">Current probe</p><div data-probe-log><span>—</span></div></div>
      </aside>
    </div>
    <div class="instrument-toolbar"><label class="key-input"><span class="label">Key</span><input data-key type="number" min="0" max="9999" value="72" /></label><button class="instrument-action primary" data-insert>Insert key</button><button class="instrument-action" data-step>Step probe →</button><button class="instrument-action" data-random>Random key</button><button class="instrument-action" data-reset>Reset table</button><label class="instrument-range"><span>Speed <b data-speed-label>4 probe/s</b></span><input data-speed type="range" min="1" max="100" value="40" /></label></div>
  </section>
</hashing-laboratory>

<script>
  type Mode="chaining"|"linear"|"quadratic"|"robin";type Entry={key:number;home:number;distance:number};
  const HASH_INFO:Record<Mode,[string,string]>={chaining:["Separate chaining","Keep a linked collection at every bucket; collisions never move away from their home."],linear:["Linear probing","Walk forward one bucket at a time until an empty slot appears."],quadratic:["Quadratic probing","Increase the jump quadratically to avoid long contiguous clusters."],robin:["Robin Hood hashing","If a newcomer has travelled farther, it steals the slot and the displaced key continues probing."]};
  class HashingLaboratory extends HTMLElement{
    size=13;mode:Mode="linear";chains:number[][]=[];slots:(Entry|null)[]=[];keys=new Set<number>();collisions=0;maxProbe=0;pending:Entry|null=null;probe:number[]=[];probeAt=0;running=false;current=-1;aborter=new AbortController();frame=0;last=0;acc=0;
    connectedCallback(){this.bind();this.reset();this.frame=requestAnimationFrame(t=>this.animate(t));}
    disconnectedCallback(){cancelAnimationFrame(this.frame);this.aborter.abort();}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(b=>b.addEventListener("click",()=>{this.mode=b.dataset.mode as Mode;this.querySelectorAll("[data-mode]").forEach(x=>x.classList.toggle("active",x===b));this.text("[data-name]",HASH_INFO[this.mode][0]);this.text("[data-description]",HASH_INFO[this.mode][1]);this.reset();},{signal}));this.querySelector("[data-insert]")?.addEventListener("click",()=>this.beginInput(),{signal});this.querySelector<HTMLInputElement>("[data-key]")?.addEventListener("keydown",e=>{if(e.key==="Enter")this.beginInput();},{signal});this.querySelector("[data-step]")?.addEventListener("click",()=>{this.running=false;if(!this.pending)this.beginInput(false);this.advance();},{signal});this.querySelector("[data-random]")?.addEventListener("click",()=>{const key=Math.floor(Math.random()*180)+1;const input=this.querySelector<HTMLInputElement>("[data-key]");if(input)input.value=String(key);this.begin(key,true);},{signal});this.querySelector("[data-reset]")?.addEventListener("click",()=>this.reset(),{signal});this.querySelector<HTMLInputElement>("[data-speed]")?.addEventListener("input",()=>this.text("[data-speed-label]",`${this.rate()} probe/s`),{signal});}
    reset(){this.running=false;this.chains=Array.from({length:this.size},()=>[]);this.slots=Array(this.size).fill(null);this.keys.clear();this.collisions=0;this.maxProbe=0;this.pending=null;this.probe=[];this.probeAt=0;this.current=-1;[18,41,22,44,59,32].forEach(k=>this.instant(k));this.state("Table ready","Insert a key and follow its probe sequence");this.render();}
    instant(key:number){if(this.mode==="chaining"){const h=key%this.size;if(this.chains[h].length)this.collisions++;this.chains[h].push(key);this.keys.add(key);this.maxProbe=Math.max(this.maxProbe,this.chains[h].length-1);return;}let entry:Entry={key,home:key%this.size,distance:0};for(let tries=0;tries<this.size;tries++){const index=this.indexFor(entry.home,entry.distance);const at=this.slots[index];if(!at){this.slots[index]=entry;this.keys.add(key);this.maxProbe=Math.max(this.maxProbe,entry.distance);return;}this.collisions++;if(this.mode==="robin"&&at.distance<entry.distance){this.slots[index]=entry;entry=at;}entry.distance++;}}
    beginInput(auto=true){const input=this.querySelector<HTMLInputElement>("[data-key]");if(input)this.begin(Number(input.value),auto);}
    begin(key:number,auto:boolean){if(this.pending){this.state("Insertion active","Finish the current probe first");return;}if(!Number.isFinite(key)||this.keys.has(key)){this.state("Duplicate ignored",`${key} is already stored`);return;}if(this.keys.size>=this.size&&this.mode!=="chaining"){this.state("Table full","Reset before inserting another key");return;}const home=((key%this.size)+this.size)%this.size;this.pending={key,home,distance:0};this.probe=[];this.probeAt=0;this.current=-1;this.text("[data-active-key]",String(key));this.text("[data-hash]",String(key));this.text("[data-home]",String(home));this.running=auto;this.state("Hash computed",`${key} maps to bucket ${home}`);this.render();}
    advance(){if(!this.pending)return;const entry=this.pending,index=this.indexFor(entry.home,entry.distance);this.current=index;this.probe.push(index);const occupied=this.mode==="chaining"?this.chains[index].length>0:!!this.slots[index];if(this.mode==="chaining"){if(occupied)this.collisions++;this.chains[index].push(entry.key);this.keys.add(entry.key);this.maxProbe=Math.max(this.maxProbe,this.chains[index].length-1);this.complete(`Appended ${entry.key} to bucket ${index}`);return;}const at=this.slots[index];if(!at){this.slots[index]=entry;this.keys.add(entry.key);this.maxProbe=Math.max(this.maxProbe,entry.distance);this.complete(`Placed ${entry.key} after ${entry.distance} collision${entry.distance===1?"":"s"}`);return;}this.collisions++;if(this.mode==="robin"&&at.distance<entry.distance){this.slots[index]=entry;this.pending=at;this.pending.distance=at.distance+1;this.state("Robin Hood swap",`${entry.key} stole bucket ${index}; ${at.key} continues`);}else{entry.distance++;this.state("Collision",`Bucket ${index} contains ${at.key}; probing again`);}if(this.pending.distance>=this.size){this.running=false;this.pending=null;this.state("Probe cycle","This probing sequence cannot reach a remaining empty bucket");}this.render();}
    complete(message:string){this.running=false;this.pending=null;this.state("Inserted",message);this.render();}
    indexFor(home:number,distance:number){if(this.mode==="quadratic")return(home+distance*distance)%this.size;return(home+distance)%this.size;}
    animate(t:number){const d=Math.min(50,t-(this.last||t));this.last=t;if(this.running&&this.pending){this.acc+=d;const delay=1000/this.rate();if(this.acc>=delay){this.acc=0;this.advance();}}this.frame=requestAnimationFrame(n=>this.animate(n));}
    rate(){const v=Number(this.querySelector<HTMLInputElement>("[data-speed]")?.value||40);return Math.max(1,Math.round(Math.pow(2,v/24)));}
    render(){const table=this.querySelector("[data-table]");if(!table)return;table.replaceChildren();for(let i=0;i<this.size;i++){const row=document.createElement("div");row.className="slot";if(i===this.current)row.classList.add("current");const index=document.createElement("span");index.textContent=String(i).padStart(2,"0");const bucket=document.createElement("div");if(this.mode==="chaining"){this.chains[i].forEach((key,j)=>{const token=document.createElement("b");token.textContent=String(key);token.title=`chain position ${j}`;bucket.append(token);});}else{const entry=this.slots[i];if(entry){const token=document.createElement("b");token.textContent=String(entry.key);if(entry.distance)token.dataset.distance=`+${entry.distance}`;bucket.append(token);}}row.append(index,bucket);table.append(row);}this.text("[data-load]",`${Math.round(this.keys.size/this.size*100)}%`);this.text("[data-collisions]",String(this.collisions));this.text("[data-probe]",String(this.maxProbe));const log=this.querySelector("[data-probe-log]");if(log){log.replaceChildren();if(!this.probe.length){const s=document.createElement("span");s.textContent="—";log.append(s);}this.probe.forEach((p,i)=>{const b=document.createElement("b");b.textContent=String(p);if(i===this.probe.length-1)b.className="active";log.append(b);if(i<this.probe.length-1)log.append(document.createTextNode("→"));});}}
    state(a:string,b:string){this.text("[data-state]",a);this.text("[data-message]",b);}text(q:string,x:string){const e=this.querySelector(q);if(e)e.textContent=x;}
  }
  if(!customElements.get("hashing-laboratory"))customElements.define("hashing-laboratory",HashingLaboratory);
</script>

<style>
  hashing-laboratory{display:block}.hash-layout{display:grid;grid-template-columns:minmax(29rem,1.25fr) minmax(18rem,.75fr);min-height:35rem}.table-stage{padding:1.4rem;border-right:1px solid var(--glass-border);background:linear-gradient(to right,var(--reseau) 1px,transparent 1px),linear-gradient(to bottom,var(--reseau) 1px,transparent 1px);background-size:24px 24px}.hash-expression{display:flex;align-items:center;justify-content:center;gap:.75rem;min-height:4rem;margin-bottom:1rem;color:var(--ink-soft);font-size:.8rem}.hash-expression i{color:var(--ink-faint);font-style:normal}.hash-expression strong{display:grid;width:2.2rem;height:2.2rem;place-items:center;color:var(--paper);background:var(--ink);border-radius:50%}.slots{display:grid;gap:.3rem}.slot{display:grid;grid-template-columns:2.5rem 1fr;align-items:center;min-height:2rem;overflow:hidden;border:1px solid var(--rule);border-radius:5px;background:var(--glass);transition:border-color 150ms ease,transform 150ms ease}.slot.current{border-color:var(--interact);box-shadow:0 0 14px color-mix(in srgb,var(--interact) 20%,transparent);transform:translateX(4px)}.slot>span{display:grid;align-self:stretch;place-items:center;color:var(--ink-faint);border-right:1px solid var(--rule);font-size:.55rem}.slot>div{display:flex;align-items:center;gap:.35rem;padding:.25rem .45rem}.slot b{position:relative;display:inline-grid;min-width:2rem;height:1.35rem;place-items:center;padding:0 .3rem;color:var(--paper);background:var(--ink-soft);border-radius:4px;font-size:.58rem;font-weight:500}.slot b[data-distance]::after{content:attr(data-distance);position:absolute;top:-5px;right:-5px;display:grid;width:13px;height:13px;place-items:center;color:var(--paper);background:var(--interact);border-radius:50%;font-size:.4rem}aside{padding:1.4rem;background:color-mix(in srgb,var(--paper-sunken) 38%,transparent)}aside h2{margin:.55rem 0 .7rem;font-family:var(--font-display);font-size:2rem;font-weight:400;line-height:1}aside>p:not(.label){min-height:4.2rem;color:var(--ink-soft);font-size:.68rem}.instrument-metrics{grid-template-columns:1fr;margin-top:1.1rem}.probe-log{margin-top:1.3rem;padding-top:1rem;border-top:1px solid var(--rule)}.probe-log>div{display:flex;align-items:center;gap:.35rem;flex-wrap:wrap;margin-top:.7rem;color:var(--ink-faint);font-size:.55rem}.probe-log :global(b),.probe-log :global(span){display:grid;width:1.6rem;height:1.6rem;place-items:center;border:1px solid var(--rule);border-radius:50%;font-weight:500}.probe-log :global(b.active){color:var(--paper);background:var(--interact);border-color:var(--interact)}.key-input{display:flex;align-items:center;gap:.55rem}.key-input input{width:6rem;min-height:2.4rem;padding:.4rem .55rem;color:var(--ink);background:var(--glass);border:1px solid var(--rule);border-radius:7px}@media(max-width:53rem){.hash-layout{grid-template-columns:1fr}.table-stage{border-right:0;border-bottom:1px solid var(--glass-border)}aside .instrument-metrics{grid-template-columns:repeat(3,1fr)}}
</style>

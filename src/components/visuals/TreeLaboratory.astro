<tree-laboratory>
  <section class="instrument tree-lab" aria-label="Interactive balanced tree visualizer">
    <div class="instrument-tabs"><button data-mode="bst">Binary search</button><button class="active" data-mode="avl">AVL tree</button><button data-mode="redblack">Red–black</button><button data-mode="btree">B-tree</button></div>
    <div class="instrument-status"><span><strong data-state>Example built</strong> · <span data-message>Insert another key to mutate the structure</span></span><span class="hint">Duplicate keys are ignored</span></div>
    <div class="tree-layout">
      <div class="tree-canvas"><canvas data-tree aria-label="Tree structure"></canvas></div>
      <aside>
        <p class="label label--accent">Current structure</p><h2 data-name>AVL tree</h2><p data-description>Restores a height difference of at most one using local rotations.</p>
        <div class="instrument-metrics"><div><span data-nodes>0</span><small>Keys</small></div><div><span data-height>0</span><small>Height</small></div><div><span data-changes>0</span><small>Rotations / splits</small></div></div>
        <div class="history"><p class="label">Last insertion</p><ol data-history><li>Waiting for a key</li></ol></div>
      </aside>
    </div>
    <div class="instrument-toolbar"><label class="key-input"><span class="label">Key</span><input data-value type="number" min="0" max="999" value="33" /></label><button class="instrument-action primary" data-insert>Insert key</button><button class="instrument-action" data-next>Insert next preset</button><button class="instrument-action" data-random>Random key</button><button class="instrument-action" data-example>Rebuild example</button><label class="instrument-range"><span>Animation <b data-speed-label>1.0×</b></span><input data-speed type="range" min="1" max="100" value="50" /></label></div>
  </section>
</tree-laboratory>

<script>
  type Mode="bst"|"avl"|"redblack"|"btree"; type Color="red"|"black";
  type Node={key:number;left:Node|null;right:Node|null;parent:Node|null;height:number;color:Color};
  type BNode={keys:number[];children:BNode[];leaf:boolean};
  type VisualNode={key:number;x:number;y:number;color:Color;parent?:number};
  type VisualState={nodes:Map<number,VisualNode>;edges:[number,number][]};
  const TREE_INFO:Record<Mode,[string,string]>={bst:["Binary search tree","Preserves ordered search but performs no repair when the shape becomes unbalanced."],avl:["AVL tree","Restores a height difference of at most one using local rotations."],redblack:["Red–black tree","Uses colour invariants and rotations to keep every root-to-leaf path within a constant factor."],btree:["B-tree · order 4","Stores several keys per node and splits full pages on the descent, as storage indexes do."]};
  class TreeLaboratory extends HTMLElement{
    mode:Mode="avl";root:Node|null=null;broot:BNode={keys:[],children:[],leaf:true};keys=new Set<number>();actions:string[]=[];changes=0;comparisons=0;active=-1;preset=[6,12,24,33,50,59,70,81,3,15,30,57];presetAt=0;
    canvas!:HTMLCanvasElement;ctx!:CanvasRenderingContext2D;width=0;height=0;aborter=new AbortController();resize?:ResizeObserver;theme?:MutationObserver;frame=0;animating=false;animationStart=0;animationDuration=900;animationProgress=0;animationBefore:VisualState={nodes:new Map(),edges:[]};animationAfter:VisualState={nodes:new Map(),edges:[]};animationActions:string[]=[];animationKey=-1;
    connectedCallback(){this.canvas=this.querySelector("[data-tree]") as HTMLCanvasElement;const c=this.canvas.getContext("2d");if(!c)return;this.ctx=c;this.bind();this.resize=new ResizeObserver(()=>this.layout());this.resize.observe(this.canvas);this.theme=new MutationObserver(()=>this.animating?this.drawTransition(this.animationProgress):this.draw());this.theme.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});this.buildExample();this.layout();this.frame=requestAnimationFrame(t=>this.animate(t));}
    disconnectedCallback(){cancelAnimationFrame(this.frame);this.aborter.abort();this.resize?.disconnect();this.theme?.disconnect();}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(b=>b.addEventListener("click",()=>{this.mode=b.dataset.mode as Mode;this.querySelectorAll("[data-mode]").forEach(x=>x.classList.toggle("active",x===b));this.text("[data-name]",TREE_INFO[this.mode][0]);this.text("[data-description]",TREE_INFO[this.mode][1]);this.buildExample();},{signal}));this.querySelector("[data-insert]")?.addEventListener("click",()=>this.insertInput(),{signal});this.querySelector<HTMLInputElement>("[data-value]")?.addEventListener("keydown",e=>{if(e.key==="Enter")this.insertInput();},{signal});this.querySelector("[data-next]")?.addEventListener("click",()=>this.insert(this.preset[this.presetAt++%this.preset.length]),{signal});this.querySelector("[data-random]")?.addEventListener("click",()=>this.insert(Math.floor(Math.random()*96)+2),{signal});this.querySelector("[data-example]")?.addEventListener("click",()=>this.buildExample(),{signal});this.querySelector<HTMLInputElement>("[data-speed]")?.addEventListener("input",()=>this.text("[data-speed-label]",`${this.speed().toFixed(1)}×`),{signal});}
    insertInput(){const input=this.querySelector<HTMLInputElement>("[data-value]");if(input)this.insert(Math.max(0,Math.min(999,Number(input.value))));}
    buildExample(){this.animating=false;this.root=null;this.broot={keys:[],children:[],leaf:true};this.keys.clear();this.changes=0;this.comparisons=0;this.presetAt=0;[42,18,65,9,27,54,73].forEach(v=>this.insert(v,false));this.actions=["Built the seven-key starting tree","Choose a key to continue"];this.active=-1;this.state("Example built","Insert another key to mutate the structure");this.update();this.draw();}
    node(key:number,color:Color="black",parent:Node|null=null):Node{return{key,left:null,right:null,parent,height:1,color};}
    insert(key:number,render=true){if(!Number.isFinite(key)||this.keys.has(key)){if(render)this.state("Duplicate ignored",`${key} is already present`);return;}if(render&&this.animating)this.finishAnimation();const before=render?this.visualState():undefined;this.actions=[];this.active=key;this.keys.add(key);if(this.mode==="btree")this.insertB(key);else if(this.mode==="redblack")this.insertRB(key);else if(this.mode==="avl")this.root=this.insertAVL(this.root,key,null);else this.insertBST(key);if(this.root)this.root.parent=null;if(render){this.update();this.startAnimation(before!,this.visualState(),key);}}
    insertBST(key:number){const n=this.node(key);if(!this.root){this.root=n;this.actions.push("Created the root");return;}let at=this.root;while(true){this.comparisons++;this.actions.push(`Compared ${key} with ${at.key}`);if(key<at.key){if(at.left)at=at.left;else{at.left=n;n.parent=at;break;}}else{if(at.right)at=at.right;else{at.right=n;n.parent=at;break;}}}this.actions.push(`Attached ${key} below ${n.parent!.key}`);}
    h(n:Node|null){return n?.height||0;}fix(n:Node){n.height=1+Math.max(this.h(n.left),this.h(n.right));}
    rotateRight(y:Node){const x=y.left!,t=x.right;x.right=y;y.left=t;if(t)t.parent=y;x.parent=y.parent;y.parent=x;this.fix(y);this.fix(x);this.changes++;this.actions.push(`Right rotation at ${y.key}`);return x;}
    rotateLeft(x:Node){const y=x.right!,t=y.left;y.left=x;x.right=t;if(t)t.parent=x;y.parent=x.parent;x.parent=y;this.fix(x);this.fix(y);this.changes++;this.actions.push(`Left rotation at ${x.key}`);return y;}
    insertAVL(root:Node|null,key:number,parent:Node|null):Node{if(!root){this.actions.push(`Placed ${key} at an empty leaf`);return this.node(key,"black",parent);}this.comparisons++;this.actions.push(`Compared ${key} with ${root.key}`);if(key<root.key)root.left=this.insertAVL(root.left,key,root);else root.right=this.insertAVL(root.right,key,root);this.fix(root);const balance=this.h(root.left)-this.h(root.right);if(balance>1&&key<root.left!.key)return this.rotateRight(root);if(balance<-1&&key>root.right!.key)return this.rotateLeft(root);if(balance>1&&key>root.left!.key){root.left=this.rotateLeft(root.left!);root.left.parent=root;return this.rotateRight(root);}if(balance<-1&&key<root.right!.key){root.right=this.rotateRight(root.right!);root.right.parent=root;return this.rotateLeft(root);}return root;}
    insertRB(key:number){const z=this.node(key,"red");let parent:Node|null=null,at=this.root;while(at){parent=at;this.comparisons++;this.actions.push(`Compared ${key} with ${at.key}`);at=key<at.key?at.left:at.right;}z.parent=parent;if(!parent)this.root=z;else if(key<parent.key)parent.left=z;else parent.right=z;this.actions.push(`Inserted ${key} in red`);this.fixRB(z);}
    leftRB(x:Node){const y=x.right!;x.right=y.left;if(y.left)y.left.parent=x;y.parent=x.parent;if(!x.parent)this.root=y;else if(x===x.parent.left)x.parent.left=y;else x.parent.right=y;y.left=x;x.parent=y;this.changes++;this.actions.push(`Left rotation at ${x.key}`);}
    rightRB(y:Node){const x=y.left!;y.left=x.right;if(x.right)x.right.parent=y;x.parent=y.parent;if(!y.parent)this.root=x;else if(y===y.parent.left)y.parent.left=x;else y.parent.right=x;x.right=y;y.parent=x;this.changes++;this.actions.push(`Right rotation at ${y.key}`);}
    fixRB(z:Node){while(z.parent?.color==="red"){const p=z.parent,g=p.parent!;if(p===g.left){const u=g.right;if(u?.color==="red"){p.color="black";u.color="black";g.color="red";this.actions.push(`Recoloured around ${g.key}`);z=g;}else{if(z===p.right){z=p;this.leftRB(z);}z.parent!.color="black";z.parent!.parent!.color="red";this.rightRB(z.parent!.parent!);}}else{const u=g.left;if(u?.color==="red"){p.color="black";u.color="black";g.color="red";this.actions.push(`Recoloured around ${g.key}`);z=g;}else{if(z===p.left){z=p;this.rightRB(z);}z.parent!.color="black";z.parent!.parent!.color="red";this.leftRB(z.parent!.parent!);}}}if(this.root)this.root.color="black";}
    insertB(key:number){const t=2;if(this.broot.keys.length===2*t-1){const root:BNode={keys:[],children:[this.broot],leaf:false};this.split(root,0);this.broot=root;}this.insertNonFull(this.broot,key);}
    split(parent:BNode,index:number){const t=2,y=parent.children[index],z:BNode={keys:y.keys.slice(t),children:y.leaf?[]:y.children.slice(t),leaf:y.leaf},middle=y.keys[t-1];y.keys=y.keys.slice(0,t-1);if(!y.leaf)y.children=y.children.slice(0,t);parent.keys.splice(index,0,middle);parent.children.splice(index+1,0,z);this.changes++;this.actions.push(`Split a full page; promoted ${middle}`);}
    insertNonFull(node:BNode,key:number){let i=node.keys.length-1;if(node.leaf){while(i>=0&&key<node.keys[i]){this.comparisons++;i--;}node.keys.splice(i+1,0,key);this.actions.push(`Inserted ${key} into leaf page`);return;}while(i>=0&&key<node.keys[i]){this.comparisons++;i--;}i++;if(node.children[i].keys.length===3){this.split(node,i);if(key>node.keys[i])i++;}this.insertNonFull(node.children[i],key);}
    update(){this.text("[data-nodes]",String(this.keys.size));this.text("[data-height]",String(this.mode==="btree"?this.bHeight(this.broot):this.treeHeight(this.root)));this.text("[data-changes]",String(this.changes));const list=this.querySelector("[data-history]");if(list){list.replaceChildren();this.actions.slice(-5).forEach(a=>{const li=document.createElement("li");li.textContent=a;list.append(li);});}}
    treeHeight(n:Node|null):number{return n?1+Math.max(this.treeHeight(n.left),this.treeHeight(n.right)):0;}bHeight(n:BNode):number{return n.leaf?1:1+this.bHeight(n.children[0]);}
    speed(){const value=Number(this.querySelector<HTMLInputElement>("[data-speed]")?.value||50);return .45+value/100*1.15;}
    startAnimation(before:VisualState,after:VisualState,key:number){this.animationBefore=before;this.animationAfter=after;this.animationActions=[...this.actions];this.animationKey=key;this.animationProgress=0;this.animationStart=performance.now();this.animationDuration=Math.min(2600,700+this.animationActions.length*170)/this.speed();if(matchMedia("(prefers-reduced-motion: reduce)").matches){this.finishAnimation();return;}this.animating=true;this.state("Inserting key",this.animationActions[0]||`Placing ${key}`);this.drawTransition(0);}
    finishAnimation(){this.animating=false;this.animationProgress=1;this.state("Key inserted",`${this.animationKey} is now in the ${TREE_INFO[this.mode][0].toLowerCase()}`);this.draw();}
    animate(time:number){if(this.animating){this.animationProgress=Math.min(1,(time-this.animationStart)/this.animationDuration);const index=Math.min(this.animationActions.length-1,Math.floor(this.animationProgress*Math.max(1,this.animationActions.length)));if(index>=0)this.text("[data-message]",this.animationActions[index]);this.drawTransition(this.animationProgress);if(this.animationProgress>=1)this.finishAnimation();}this.frame=requestAnimationFrame(t=>this.animate(t));}
    visualState():VisualState{const nodes=new Map<number,VisualNode>(),edges:[number,number][]=[];if(this.mode==="btree"){const layers:BNode[][]=[];const parents=new Map<BNode,BNode>();const visit=(n:BNode,d:number)=>{(layers[d]??=[]).push(n);n.children.forEach(child=>{parents.set(child,n);visit(child,d+1);});};visit(this.broot,0);const positions=new Map<BNode,{x:number;y:number}>();layers.forEach((layer,d)=>layer.forEach((n,i)=>positions.set(n,{x:(i+1)*this.width/(layer.length+1),y:60+d*Math.min(100,(this.height-110)/Math.max(1,layers.length-1))})));for(const [node,p] of positions){const w=Math.max(45,node.keys.length*31);node.keys.forEach((key,i)=>nodes.set(key,{key,x:p.x-w/2+(i+.5)*w/node.keys.length,y:p.y,color:"black",parent:parents.get(node)?.keys[Math.floor((parents.get(node)?.keys.length||1)/2)]}));const parent=parents.get(node);if(parent&&node.keys.length&&parent.keys.length)edges.push([parent.keys[Math.floor(parent.keys.length/2)],node.keys[Math.floor(node.keys.length/2)]]);}return{nodes,edges};}if(!this.root)return{nodes,edges};const ordered:Node[]=[];const walk=(n:Node|null)=>{if(!n)return;walk(n.left);ordered.push(n);walk(n.right);};walk(this.root);const height=this.treeHeight(this.root);const place=(n:Node|null,depth:number)=>{if(!n)return;const index=ordered.indexOf(n);nodes.set(n.key,{key:n.key,x:35+index*Math.max(1,(this.width-70)/Math.max(1,ordered.length-1)),y:50+depth*Math.min(82,(this.height-100)/Math.max(1,height-1)),color:n.color,parent:n.parent?.key});if(n.left)edges.push([n.key,n.left.key]);if(n.right)edges.push([n.key,n.right.key]);place(n.left,depth+1);place(n.right,depth+1);};place(this.root,0);return{nodes,edges};}
    drawTransition(progress:number){if(!this.ctx||!this.width)return;const c=this.ctx,s=getComputedStyle(this),v=(n:string)=>s.getPropertyValue(n).trim(),raw=Math.max(0,Math.min(1,(progress-.28)/.72)),move=1-Math.pow(1-raw,3);c.clearRect(0,0,this.width,this.height);const focus=this.focusKey(progress);const position=(key:number)=>{const end=this.animationAfter.nodes.get(key),start=this.animationBefore.nodes.get(key);if(!end)return start;let origin=start;if(!origin&&end.parent!==undefined)origin=this.animationBefore.nodes.get(end.parent);origin??={...end,x:end.x,y:Math.max(24,end.y-55)};return{...end,x:origin.x+(end.x-origin.x)*move,y:origin.y+(end.y-origin.y)*move};};for(const [from,to] of this.animationAfter.edges){const a=position(from),b=position(to);if(!a||!b)continue;c.globalAlpha=this.animationBefore.nodes.has(to)?1:Math.max(.12,move);c.strokeStyle=v("--t-edge");c.lineWidth=1;c.beginPath();c.moveTo(a.x,a.y);c.lineTo(b.x,b.y);c.stroke();}for(const [key,end] of this.animationAfter.nodes){const p=position(key)!;const existed=this.animationBefore.nodes.has(key),scale=existed?1:Math.max(.08,move),isFocus=key===focus||key===this.animationKey&&progress>.28;let fill=(progress<.58?this.animationBefore.nodes.get(key)?.color:end.color)==="red"?v("--t-red"):v("--t-node");if(isFocus)fill=v("--t-active");c.globalAlpha=existed?1:Math.max(.1,move);c.beginPath();c.arc(p.x,p.y,17*scale,0,Math.PI*2);c.fillStyle=fill;c.fill();c.strokeStyle=v("--t-outline");c.stroke();if(scale>.45){c.fillStyle=(fill===v("--t-red")||isFocus)?v("--t-on-color"):v("--t-text");c.font="600 10px IBM Plex Mono";c.textAlign="center";c.textBaseline="middle";c.fillText(String(key),p.x,p.y);}}c.globalAlpha=1;c.textAlign="start";}
    focusKey(progress:number){if(!this.animationActions.length)return this.animationKey;const index=Math.min(this.animationActions.length-1,Math.floor(progress*this.animationActions.length)),action=this.animationActions[index];const match=action.match(/(?:with|at|around|below|promoted)\s+(\d+)/);return match?Number(match[1]):this.animationKey;}
    layout(){const r=this.canvas.getBoundingClientRect();if(!r.width)return;const d=Math.min(devicePixelRatio||1,2);this.width=r.width;this.height=r.height;this.canvas.width=r.width*d;this.canvas.height=r.height*d;this.ctx.setTransform(d,0,0,d,0,0);if(this.animating)this.finishAnimation();else this.draw();}
    draw(){if(!this.ctx||!this.width)return;const c=this.ctx,s=getComputedStyle(this),v=(n:string)=>s.getPropertyValue(n).trim();c.clearRect(0,0,this.width,this.height);if(this.mode==="btree"){this.drawB(c,v);return;}if(!this.root)return;const ordered:Node[]=[];const walk=(n:Node|null)=>{if(!n)return;walk(n.left);ordered.push(n);walk(n.right);};walk(this.root);const pos=new Map<Node,{x:number,y:number}>();const place=(n:Node|null,depth:number)=>{if(!n)return;const index=ordered.indexOf(n);pos.set(n,{x:35+index*Math.max(1,(this.width-70)/Math.max(1,ordered.length-1)),y:50+depth*Math.min(82,(this.height-100)/Math.max(1,this.treeHeight(this.root)-1))});place(n.left,depth+1);place(n.right,depth+1);};place(this.root,0);for(const [n,p] of pos)for(const child of [n.left,n.right])if(child){const q=pos.get(child)!;c.strokeStyle=v("--t-edge");c.lineWidth=1;c.beginPath();c.moveTo(p.x,p.y);c.lineTo(q.x,q.y);c.stroke();}for(const [n,p] of pos){let fill=n.color==="red"?v("--t-red"):v("--t-node");if(n.key===this.active)fill=v("--t-active");c.beginPath();c.arc(p.x,p.y,17,0,Math.PI*2);c.fillStyle=fill;c.fill();c.strokeStyle=v("--t-outline");c.stroke();c.fillStyle=n.color==="red"||n.key===this.active?v("--t-on-color"):v("--t-text");c.font="600 10px IBM Plex Mono";c.textAlign="center";c.textBaseline="middle";c.fillText(String(n.key),p.x,p.y);}c.textAlign="start";}
    drawB(c:CanvasRenderingContext2D,v:(n:string)=>string){const layers:BNode[][]=[];const visit=(n:BNode,d:number)=>{(layers[d]??=[]).push(n);n.children.forEach(x=>visit(x,d+1));};visit(this.broot,0);const pos=new Map<BNode,{x:number,y:number}>();layers.forEach((layer,d)=>layer.forEach((n,i)=>pos.set(n,{x:(i+1)*this.width/(layer.length+1),y:60+d*Math.min(100,(this.height-110)/Math.max(1,layers.length-1))})));for(const [n,p] of pos)n.children.forEach(child=>{const q=pos.get(child)!;c.strokeStyle=v("--t-edge");c.beginPath();c.moveTo(p.x,p.y);c.lineTo(q.x,q.y);c.stroke();});for(const [n,p] of pos){const w=Math.max(45,n.keys.length*31);c.fillStyle=n.keys.includes(this.active)?v("--t-active"):v("--t-node");c.strokeStyle=v("--t-outline");c.beginPath();c.roundRect(p.x-w/2,p.y-18,w,36,7);c.fill();c.stroke();n.keys.forEach((key,i)=>{if(i){c.beginPath();c.moveTo(p.x-w/2+i*w/n.keys.length,p.y-18);c.lineTo(p.x-w/2+i*w/n.keys.length,p.y+18);c.stroke();}c.fillStyle=n.keys.includes(this.active)?v("--t-on-color"):v("--t-text");c.font="600 10px IBM Plex Mono";c.textAlign="center";c.textBaseline="middle";c.fillText(String(key),p.x-w/2+(i+.5)*w/n.keys.length,p.y);});}c.textAlign="start";}
    state(a:string,b:string){this.text("[data-state]",a);this.text("[data-message]",b);}text(q:string,x:string){const e=this.querySelector(q);if(e)e.textContent=x;}
  }
  if(!customElements.get("tree-laboratory"))customElements.define("tree-laboratory",TreeLaboratory);
</script>

<style>
  tree-laboratory{--t-node:var(--paper-raised);--t-red:#c8401a;--t-active:#4b3fd6;--t-edge:var(--ink-faint);--t-outline:var(--ink-soft);--t-text:var(--ink);--t-on-color:#fff;display:block}:global(html[data-theme="dark"]) tree-laboratory{--t-node:#18203a;--t-red:#d94f68;--t-active:#4aaed4;--t-edge:#4b587d;--t-outline:#8795bd;--t-text:#edf2ff;--t-on-color:#07101a}.tree-layout{display:grid;grid-template-columns:minmax(31rem,1.4fr) minmax(17rem,.6fr);min-height:35rem}.tree-canvas{padding:1rem;border-right:1px solid var(--glass-border);background:linear-gradient(to right,var(--reseau) 1px,transparent 1px),linear-gradient(to bottom,var(--reseau) 1px,transparent 1px);background-size:24px 24px}canvas{display:block;width:100%;height:100%;min-height:31rem}aside{padding:1.4rem;background:color-mix(in srgb,var(--paper-sunken) 38%,transparent)}aside h2{margin:.55rem 0 .7rem;font-family:var(--font-display);font-size:2rem;font-weight:400;line-height:1}aside>p:not(.label){min-height:4.2rem;color:var(--ink-soft);font-size:.68rem}.instrument-metrics{grid-template-columns:1fr;margin-top:1.1rem}.history{margin-top:1.3rem;padding-top:1rem;border-top:1px solid var(--rule)}.history ol{margin:.6rem 0 0;padding-left:1.2rem;color:var(--ink-soft);font-size:.58rem;line-height:1.6}.key-input{display:flex;align-items:center;gap:.55rem}.key-input input{width:5.5rem;min-height:2.4rem;padding:.4rem .55rem;color:var(--ink);background:var(--glass);border:1px solid var(--rule);border-radius:7px}@media(max-width:55rem){.tree-layout{grid-template-columns:1fr}.tree-canvas{border-right:0;border-bottom:1px solid var(--glass-border)}aside .instrument-metrics{grid-template-columns:repeat(3,1fr)}}@media(max-width:40rem){canvas{min-height:24rem}}
</style>

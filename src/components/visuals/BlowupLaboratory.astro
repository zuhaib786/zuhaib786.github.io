<blowup-laboratory>
  <section class="math-instrument" aria-label="Interactive Navier–Stokes finite-time blowup laboratory">
    <div class="math-bar">
      <div class="math-state"><i></i><span data-state>Self-similar collapse running · τ = 1 − t</span></div>
      <div class="math-actions">
        <div class="math-tabs" aria-label="Stage">
          <button class="active" data-mode="vortex">Vortex</button>
          <button data-mode="collapse">Section</button>
          <button data-mode="spinup">Spin-up</button>
          <button data-mode="pulses">Pulses</button>
          <button data-mode="ledger">Ledger</button>
        </div>
        <button class="math-button" data-frame>Frame · lab</button>
        <button class="math-button" data-pulses>Pulses · on</button>
        <button class="math-button" data-play>Pause</button>
        <button class="math-button" data-reset>Rewind</button>
      </div>
    </div>

    <div class="math-dashboard">
      <div class="math-stage physics-stage">
        <span class="math-stage-label label" data-stage-label>streamlines of the collapsing vortex · drag to orbit · scroll to zoom</span>
        <div class="stage-surface">
          <canvas data-canvas class="veiled" aria-label="Meridional section of the collapsing vortex"></canvas>
          <canvas data-gl aria-label="Three-dimensional streamlines of the collapsing vortex"></canvas>
          <div class="vortex-notes" data-notes>
            <span class="note note--axial">axial stretching</span>
            <span class="note note--spiral">inward spiral</span>
          </div>
        </div>
      </div>

      <aside class="math-readout">
        <p class="label label--accent">Finite-time blowup</p>
        <h2 data-title>A vortex drawn into a thread</h2>
        <p data-description>
          Streamlines of the leading flow: fluid spirals inward, turns at a
          dividing layer near z = 0, and is stretched out along the axis.
        </p>
        <div class="math-formula" data-formula>ℓ_r ≍ τ^½ · ℓ_z ≍ τ^½⁻ʰ · ℓ_r/ℓ_z ≍ τ^h → 0</div>

        <div class="math-metrics">
          <div><strong data-m-tau>1.000</strong><small>τ = 1 − t</small></div>
          <div><strong data-m-lr>2.236</strong><small>Core radius ℓ_r</small></div>
          <div><strong data-m-aspect>1.00</strong><small>ℓ_z / ℓ_r ≍ τ^−h</small></div>
          <div><strong data-m-sup>0.61</strong><small>sup |u| over core</small></div>
          <div><strong data-m-energy>1.00</strong><small>Core kinetic energy</small></div>
          <div><strong data-m-re>0.61</strong><small>Angular Reynolds Re_θ</small></div>
        </div>

        <div class="math-controls">
          <div class="math-control">
            <label><span>Slenderness exponent h</span><b data-v-h>0.0060</b></label>
            <input data-h type="range" min="0" max="0.05" step="0.0005" value="0.006" />
          </div>
          <div class="math-control">
            <label><span>Collapse rate d(−log τ)/dt</span><b data-v-rate>0.34</b></label>
            <input data-rate type="range" min="0.04" max="0.9" step="0.01" value="0.34" />
          </div>
          <div class="math-control">
            <label><span>Viscosity ν</span><b data-v-nu>1.00</b></label>
            <input data-nu type="range" min="0.2" max="2.4" step="0.05" value="1" />
          </div>
        </div>

        <div class="math-legend">
          <span><i></i>swirl u<sub>θ</sub></span>
          <span><i></i>axial jet u<sub>z</sub></span>
          <span><i></i>pulse annulus</span>
        </div>

        <div class="math-trace">
          <p class="label">Reading</p>
          <ol>
            <li data-r1>Radial inflow carries angular momentum r·u_θ toward the axis.</li>
            <li data-r2>The axial jet clears the arriving fluid, so the inflow never chokes.</li>
            <li data-r3>Both core lengths vanish; their ratio diverges.</li>
          </ol>
        </div>
      </aside>
    </div>
  </section>
</blowup-laboratory>

<script>
  // ---------------------------------------------------------------------------
  // A working model of the flow in OpenAI's "Finite time blowup for
  // Navier--Stokes" (September 2026). The scaling exponents, the similarity
  // coordinates, the core geometry and the pulse mechanism are the paper's; the
  // profiles E, U, Psi below are illustrative stand-ins for the ones the paper
  // constructs, chosen so that the leading radial pressure balance
  // d_r p = u_theta^2 / r holds exactly.
  // ---------------------------------------------------------------------------

  import { VortexView } from "../../scripts/blowup/vortex";

  type Mode = "vortex" | "collapse" | "spinup" | "pulses" | "ledger";
  type Frame = "lab" | "similarity";

  const X_CORE = 2.5;      // inner edge of the annulus, X = r^2 / 2q
  const X_ANN = 6.5;       // outer edge of the annulus
  const ETA_CORE = 0.8;    // axial extent of the core in similarity height
  const ETA_W = 0.3;       // width of the dividing layer near z = 0
  const BIAS = 0.1;        // upward bias: u_z does not vanish on z = 0
  const S_MAX = 6.9;       // log-time horizon, tau = e^-s down to 1e-3
  const PULSE_SPAN = 5;    // life of one pulse in log-time
  const LAB_R = 6.2;       // radial extent of the lab-frame window
  const BANDS = 11;        // quantisation of the swirl field into contour bands
  const GAMMA = 2 * Math.PI * 0.45;
  const SWIRL = 2.6;       // circulation normalisation of the azimuthal profile

  const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);
  const smoothstep = (a: number, b: number, x: number) => {
    const t = clamp((x - a) / (b - a || 1), 0, 1);
    return t * t * (3 - 2 * t);
  };

  // Similarity profiles ------------------------------------------------------
  // Poloidal streamfunction  psi = q^D * Psi(X, eta),  Psi = X e^-X phi(eta).
  // phi is odd through the dividing layer with a small upward bias, so the
  // fluid turns axially on opposite sides of it and returns radially further out.
  const phi = (e: number) => {
    const w = Math.max(0, 1 - e * e);
    return Math.tanh(e / ETA_W) * Math.pow(w, 1.5) + BIAS * w * w;
  };
  const phiP = (e: number) => {
    const w = Math.max(0, 1 - e * e);
    const ch = Math.cosh(e / ETA_W);
    return (
      Math.pow(w, 1.5) / (ETA_W * ch * ch) -
      3 * e * Math.tanh(e / ETA_W) * Math.sqrt(w) -
      4 * BIAS * e * w
    );
  };
  // Azimuthal envelope. E = sqrt(2X) e^-X g(eta) keeps E/sqrt(2X) smooth on the
  // axis, so the Cartesian field stays smooth there for every t < 1.
  const gEta = (e: number) => SWIRL * Math.pow(Math.max(0, 1 - e * e), 0.75) * (1 + 0.12 * e);

  type Field = {
    q: number; X: number; eta: number;
    ut: number; uz: number; ur: number; p: number;
  };

  class BlowupLaboratory extends HTMLElement {
    canvas!: HTMLCanvasElement;
    ctx!: CanvasRenderingContext2D;
    width = 0; height = 0;

    mode: Mode = "vortex";
    frame: Frame = "lab";
    playing = true;
    pulses = true;

    s = 0; tau = 1;
    h = 0.006; rate = 0.34; nu = 1;

    // stress target inside the admissible cone, in (T_rtheta, T_rz)
    target = { x: 0.62, y: 0.34 };
    dragging = false;
    hover: { x: number; y: number } | null = null;

    // tracers
    poloidal: Float64Array = new Float64Array(0);   // r, z, age  * N
    disc: Float64Array = new Float64Array(0);       // r, theta, age * M
    readonly NP = 240;
    readonly ND = 420;

    raster?: ImageData;
    rasterCanvas?: HTMLCanvasElement;
    gl?: HTMLCanvasElement;
    vortex?: VortexView;
    surface?: HTMLElement;

    frameId = 0; last = 0;
    resizeObs?: ResizeObserver;
    themeObs?: MutationObserver;
    aborter = new AbortController();

    connectedCallback() {
      this.canvas = this.querySelector("[data-canvas]") as HTMLCanvasElement;
      const c = this.canvas.getContext("2d");
      if (!c) return;
      this.ctx = c;
      this.gl = this.querySelector("[data-gl]") as HTMLCanvasElement;
      this.surface = this.querySelector(".stage-surface") as HTMLElement;
      this.bind();
      this.seed();
      this.resizeObs = new ResizeObserver(() => this.layout());
      this.resizeObs.observe(this.surface || this.canvas);
      this.themeObs = new MutationObserver(() => { this.vortex?.retheme(this.palette()); this.draw(); });
      this.themeObs.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
      this.surfaces();
      this.configure();
      this.layout();
      this.frameId = requestAnimationFrame((t) => this.animate(t));
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.frameId);
      this.aborter.abort();
      this.resizeObs?.disconnect();
      this.themeObs?.disconnect();
      this.vortex?.dispose();
    }

    // --- wiring --------------------------------------------------------------
    bind() {
      const signal = this.aborter.signal;
      this.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((b) =>
        b.addEventListener("click", () => {
          this.mode = b.dataset.mode as Mode;
          this.querySelectorAll("[data-mode]").forEach((x) => x.classList.toggle("active", x === b));
          this.surfaces();
          this.configure();
          this.draw();
        }, { signal }),
      );
      this.querySelector("[data-frame]")?.addEventListener("click", () => {
        this.frame = this.frame === "lab" ? "similarity" : "lab";
        this.text("[data-frame]", `Frame · ${this.frame === "lab" ? "lab" : "similarity"}`);
        this.configure();
        this.metrics();
        this.draw();
      }, { signal });
      this.querySelector("[data-pulses]")?.addEventListener("click", () => {
        this.pulses = !this.pulses;
        this.text("[data-pulses]", `Pulses · ${this.pulses ? "on" : "off"}`);
        this.querySelector("[data-pulses]")?.classList.toggle("active", this.pulses);
        this.configure();
        this.draw();
      }, { signal });
      this.querySelector("[data-play]")?.addEventListener("click", () => {
        this.playing = !this.playing;
        this.text("[data-play]", this.playing ? "Pause" : "Run");
        this.configure();
      }, { signal });
      this.querySelector("[data-reset]")?.addEventListener("click", () => {
        this.s = 0; this.tau = 1; this.seed(); this.draw();
      }, { signal });
      this.range("[data-h]", (v) => { this.h = v; this.text("[data-v-h]", v.toFixed(4)); this.configure(); this.draw(); });
      this.range("[data-rate]", (v) => { this.rate = v; this.text("[data-v-rate]", v.toFixed(2)); });
      this.range("[data-nu]", (v) => { this.nu = v; this.text("[data-v-nu]", v.toFixed(2)); this.draw(); });

      this.canvas.addEventListener("pointerdown", (e) => {
        this.canvas.setPointerCapture(e.pointerId);
        this.dragging = true;
        this.pointer(e);
      }, { signal });
      this.canvas.addEventListener("pointermove", (e) => this.pointer(e), { signal });
      this.canvas.addEventListener("pointerup", () => { this.dragging = false; }, { signal });
      this.canvas.addEventListener("pointerleave", () => { this.dragging = false; this.hover = null; this.draw(); }, { signal });
    }

    range(q: string, fn: (v: number) => void) {
      this.querySelector<HTMLInputElement>(q)?.addEventListener(
        "input",
        (e) => fn(Number((e.currentTarget as HTMLInputElement).value)),
        { signal: this.aborter.signal },
      );
    }

    pointer(e: PointerEvent) {
      const r = this.canvas.getBoundingClientRect();
      const x = e.clientX - r.left, y = e.clientY - r.top;
      this.hover = { x, y };
      if (this.mode === "ledger" && this.dragging) {
        const m = this.margins();
        this.s = clamp((x - m.l) / Math.max(1, m.w), 0, 1) * S_MAX;
        this.tau = Math.exp(-this.s);
        this.seed();
      }
      if (this.mode === "pulses" && this.dragging) this.dragTarget(x, y);
      this.draw();
    }

    // --- flow ----------------------------------------------------------------
    // q solves q - z^2 q^{2h} = tau, uniquely since d/dq = 1 - 2h eta^2 > 0.
    solveQ(z: number, tau: number) {
      const zz = z * z, h = this.h;
      let q = tau + zz;
      if (q <= 0) return 1e-12;
      if (h === 0 || zz < 1e-24) return Math.max(q, 1e-14);
      for (let i = 0; i < 3; i++) {
        const p = Math.exp(2 * h * Math.log(q));
        const F = q - zz * p - tau;
        const dF = 1 - (2 * h * zz * p) / q;
        q -= F / (Math.abs(dF) < 1e-6 ? 1e-6 : dF);
        if (q < 1e-14) q = 1e-14;
      }
      return q;
    }

    field(r: number, z: number, tau = this.tau): Field {
      const h = this.h, A = 0.5 + h, D = 0.5 - h;
      const q = this.solveQ(z, tau);
      const eta = clamp(z / Math.pow(q, D), -0.9995, 0.9995);
      const X = (r * r) / (2 * q);
      const ex = Math.exp(-X);
      const ut = Math.pow(q, -A) * Math.sqrt(2 * X) * ex * gEta(eta);
      const uz = Math.pow(q, D - 1) * (1 - X) * ex * phi(eta);
      const ur = r > 1e-9 ? -(X * ex * phiP(eta)) / r : 0;
      const p = Math.pow(q, -2 * A) * (-0.5 * gEta(eta) * gEta(eta) * Math.exp(-2 * X));
      return { q, X, eta, ut, uz, ur, p };
    }

    // Oseen--Lamb vortex: an exact solution of the radial heat equation for the
    // azimuthal velocity, which is what the paper calls the heat exterior.
    extSwirl(r: number) {
      if (r < 1e-9) return 0;
      const t = 1 - this.tau + 0.3;
      return (GAMMA / (2 * Math.PI * r)) * (1 - Math.exp(-(r * r) / (4 * this.nu * t)));
    }

    swirlAt(r: number, z: number) {
      const f = this.field(r, z);
      const w = smoothstep(X_CORE, X_ANN, f.X);
      return f.ut * (1 - w) + this.extSwirl(r) * w;
    }

    // core geometry --------------------------------------------------------
    lr(tau = this.tau) { return Math.sqrt(2 * tau * X_CORE); }
    lz(tau = this.tau) {
      const q = tau / (1 - ETA_CORE * ETA_CORE);
      return Math.pow(q, 0.5 - this.h) * ETA_CORE;
    }
    supU(tau = this.tau) { return 0.6065 * SWIRL * Math.pow(tau, -0.5 - this.h); }
    coreEnergy(tau = this.tau) { return Math.pow(tau, 0.5 - 3 * this.h); }
    reTheta(tau = this.tau) { return (this.supU(tau) * this.lr(tau)) / this.nu; }
    // scale of the momentum residual the background alone would need
    residualBg(tau = this.tau) { return Math.pow(tau, -1.5 - this.h); }

    // pulse envelope: shear amplifies, then steepening of the radial wavenumber
    // hands the balance to viscosity, so each pulse grows and then decays.
    pulseEnvelope(sigma: number) {
      const S = 1, P0 = 3.2, damp = 0.12 * this.nu;
      const n = 40;
      let acc = 0;
      for (let i = 0; i < n; i++) {
        const u = (S * ((sigma * (i + 0.5)) / n)) ** 2;
        acc += (P0 / (1 + u) - damp * (1 + u)) * (sigma / n);
      }
      return Math.exp(acc - 3.4);
    }
    pulsePeak() {
      const P0 = 3.2, damp = 0.12 * this.nu;
      return Math.sqrt(Math.max(0, Math.sqrt(P0 / damp) - 1));
    }

    seed() {
      this.poloidal = new Float64Array(this.NP * 3);
      for (let i = 0; i < this.NP; i++) this.respawn(i, true);
      this.disc = new Float64Array(this.ND * 3);
      for (let i = 0; i < this.ND; i++) this.respawnDisc(i, true);
    }

    respawn(i: number, spread = false) {
      const X = spread
        ? Math.random() * (X_ANN + 1)
        : X_CORE * 0.7 + Math.random() * (X_ANN + 1 - X_CORE * 0.7);
      const eta = (Math.random() * 2 - 1) * 0.92;
      const q = this.tau / (1 - eta * eta);
      const r = Math.sqrt(2 * q * X);
      const z = Math.pow(q, 0.5 - this.h) * eta;
      this.poloidal[i * 3] = r;
      this.poloidal[i * 3 + 1] = z;
      this.poloidal[i * 3 + 2] = 0;
    }

    respawnDisc(i: number, spread = false) {
      const X = spread ? Math.random() * X_ANN : X_CORE + Math.random() * (X_ANN - X_CORE);
      const eta = 0.25;
      const q = this.tau / (1 - eta * eta);
      this.disc[i * 3] = Math.sqrt(2 * q * X);
      this.disc[i * 3 + 1] = Math.random() * Math.PI * 2;
      this.disc[i * 3 + 2] = 0;
    }

    // --- evolution -----------------------------------------------------------
    step(dt: number) {
      const ds = this.rate * dt;
      this.s += ds;
      if (this.s > S_MAX) { this.s = 0; this.tau = 1; this.seed(); }
      this.tau = Math.exp(-this.s);
      const k = this.tau * ds;   // dt = -d(tau) = tau ds

      if (this.mode === "collapse") {
        for (let i = 0; i < this.NP; i++) {
          const r = this.poloidal[i * 3], z = this.poloidal[i * 3 + 1];
          const f = this.field(r, z);
          const nr = r + k * f.ur, nz = z + k * f.uz;
          this.poloidal[i * 3] = nr; this.poloidal[i * 3 + 1] = nz;
          this.poloidal[i * 3 + 2] += ds;
          const q = this.solveQ(nz, this.tau);
          const X = (nr * nr) / (2 * q);
          if (!Number.isFinite(nr) || X > X_ANN + 3 || Math.abs(nz / Math.pow(q, 0.5 - this.h)) > 0.98 || this.poloidal[i * 3 + 2] > 5.5) {
            this.respawn(i);
          }
        }
      } else if (this.mode === "spinup") {
        for (let i = 0; i < this.ND; i++) {
          const r = this.disc[i * 3];
          const eta = 0.25;
          const q = this.tau / (1 - eta * eta);
          const z = Math.pow(q, 0.5 - this.h) * eta;
          const f = this.field(r, z);
          const w = smoothstep(X_CORE, X_ANN, f.X);
          const ut = f.ut * (1 - w) + this.extSwirl(r) * w;
          this.disc[i * 3] = r + k * f.ur * (1 - w * 0.85);
          this.disc[i * 3 + 1] += r > 1e-9 ? (k * ut) / r : 0;
          this.disc[i * 3 + 2] += ds;
          if (!(this.disc[i * 3] > 1e-8) || (this.disc[i * 3] * this.disc[i * 3]) / (2 * q) > X_ANN + 1.5) this.respawnDisc(i);
        }
      }
    }

    animate(t: number) {
      const dt = Math.min(0.05, (t - this.last) / 1000 || 0.016);
      this.last = t;
      if (this.playing) { this.step(dt); this.metrics(); }
      if (this.mode === "vortex") {
        this.ensureVortex();
        this.vortex?.update(this.tau, 0.5 - this.h, this.frame, this.playing ? this.rate * dt : 0);
        this.vortex?.render();
      } else if (this.playing) this.draw();
      this.frameId = requestAnimationFrame((x) => this.animate(x));
    }

    // --- readout -------------------------------------------------------------
    configure() {
      const admissible = this.h < 0.01;
      const info: Record<Mode, [string, string, string, string]> = {
        vortex: [
          "A vortex drawn into a thread",
          "Streamlines of the leading flow. Orange marks fast angular rotation near the axis, teal the slower outer skirt. Because the flow is self-similar the bundle keeps its shape: in the lab frame it collapses toward the origin, in the similarity frame it only grows more slender.",
          "x = (r cos θ, r sin θ, z)  ·  scale (√τ, τ^(½−h), √τ)",
          "streamlines of the collapsing vortex · drag to orbit · scroll to zoom",
        ],
        collapse: [
          "A core that thins faster than it shortens",
          "Fluid spirals inward, turns at a dividing layer near z = 0 and is thrown out along the axis. Measured in its own shrinking scales the profile never changes shape — switch to the similarity frame and the picture stops moving.",
          "ℓr ≍ √τ  ·  ℓz ≍ τ^(½−h)  ·  ℓr / ℓz → 0",
          "meridional section · swirl u_θ · poloidal streamlines · pulse annulus",
        ],
        spinup: [
          "Inflow spins the core up",
          "With no torque a parcel conserves its angular momentum r·u_θ, so drifting inward makes it turn faster. Viscosity carries angular momentum back out; the axial jet removes the arriving fluid so the inflow never chokes.",
          "Reθ = |uθ| ℓr / ν ≍ τ^(−h) → ∞  ·  Rer = O(1)",
          "axial section · tracers conserving r·u_θ · shrinking core radius",
        ],
        pulses: [
          "Oscillations pay the background's bill",
          "The background alone would need a force that blows up in the annulus. Ring pulses, seeded exponentially small and amplified by the shear, carry momentum fluxes whose divergence cancels it. Drag the target stress: two pulse families can only supply what lies in their cone.",
          "R(u+w, p+π) = R(u,p) + L(w,π) + ∇·(w⊗w)",
          "pulse packet · wavevector steepening under shear · admissible stress cone",
        ],
        ledger: [
          "Unbounded speed, bounded energy",
          "The whole construction exists to make these curves cross-purposes: the supremum of the velocity runs away while the kinetic energy stays bounded, and the force needed to sustain it stays smooth through the singular time. Drag to scrub τ.",
          "sup ‖u(t)‖ L² < ∞   ·   limsup ‖u(t)‖ L∞ = ∞",
          "log–log ledger · drag to scrub τ from 1 down to 10⁻³",
        ],
      };
      const i = info[this.mode];
      this.text("[data-title]", i[0]);
      this.text("[data-description]", i[1]);
      this.text("[data-formula]", i[2]);
      const label = this.querySelector("[data-stage-label]");
      if (label) label.textContent = i[3];
      const state = !this.playing
        ? "Paused · drag inside the stage"
        : !admissible
          ? `h = ${this.h.toFixed(4)} ≥ 1/100 · outside the range the proof allows, shown to exaggerate the anisotropy`
          : !this.pulses
            ? "Pulses off · the background's own force is unbounded as τ → 0"
            : "Self-similar collapse running · τ = 1 − t";
      this.text("[data-state]", state);
    }

    metrics() {
      const t = this.tau;
      this.text("[data-m-tau]", t < 0.001 ? t.toExponential(2) : t.toFixed(4));
      this.text("[data-m-lr]", this.lr().toExponential(2));
      this.text("[data-m-aspect]", (this.lz() / this.lr()).toFixed(4));
      this.text("[data-m-sup]", this.supU().toFixed(2));
      this.text("[data-m-energy]", this.coreEnergy().toFixed(4));
      this.text("[data-m-re]", this.reTheta().toFixed(2));

      const admissible = this.h < 0.01;
      if (this.mode === "vortex") {
        this.text("[data-r1]", `Core radius ${this.lr().toExponential(2)}, height ${this.lz().toExponential(2)} — the bundle is ${(this.lz() / this.lr()).toFixed(3)} as wide as it is tall, and thinning.`);
        this.text("[data-r2]", `Peak speed ${this.supU().toFixed(2)} ≍ τ^(−½−h), while the energy inside the core is ${this.coreEnergy().toFixed(4)} and falling.`);
        this.text("[data-r3]", this.frame === "lab" ? "Lab frame: the dashed ring is the core's radius at τ = 1." : "Similarity frame: distances are measured in ℓ_r and ℓ_z, so only the slenderness changes.");
      } else if (this.mode === "collapse") {
        this.text("[data-r1]", `Core radius ${this.lr().toExponential(2)}, height ${this.lz().toExponential(2)}; both vanish, their ratio τ^h ${admissible ? "drifts" : "runs"} to zero.`);
        this.text("[data-r2]", `Kinetic energy inside the core is ${this.coreEnergy().toFixed(4)} and falling, even though the peak speed is ${this.supU().toFixed(2)}.`);
        this.text("[data-r3]", this.frame === "lab" ? "Faint outlines mark the core at 2τ, 4τ and 8τ — the same shape, larger." : "Axes are X = r²/2q and η: in these coordinates only the ruler changes.");
      } else if (this.mode === "spinup") {
        this.text("[data-r1]", `Angular Reynolds number ${this.reTheta().toFixed(2)} ≍ τ^(−h) → ∞: many turns per radial diffusion time.`);
        this.text("[data-r2]", `Radial Reynolds number stays O(1), so viscosity keeps competing with the inflow at every scale.`);
        this.text("[data-r3]", `Peak swirl ${this.supU().toFixed(2)} at radius ${this.lr().toExponential(2)}.`);
      } else if (this.mode === "pulses") {
        const c = this.coneWeights();
        this.text("[data-r1]", `Pulse amplitude ≍ q^(−½−h/2) = ${Math.pow(t, -0.5 - this.h / 2).toFixed(2)}, wavelength ≍ q^(½+h/2) = ${Math.pow(t, 0.5 + this.h / 2).toExponential(2)}.`);
        this.text("[data-r2]", `Family weights c₁ = ${c.a.toFixed(2)}, c₂ = ${c.b.toFixed(2)} — ${c.ok ? "both non-negative, the stress is admissible." : "negative weight: this stress is outside the cone."}`);
        this.text("[data-r3]", this.pulses ? `Residual force stays bounded; without the pulses it would grow like τ^(−3/2−h) = ${this.residualBg().toExponential(2)}.` : `Pulses off: the background's residual is ${this.residualBg().toExponential(2)} and diverging.`);
      } else {
        this.text("[data-r1]", `sup |u| = ${this.supU().toFixed(2)} and climbing like τ^(−½−h).`);
        this.text("[data-r2]", `Total kinetic energy ${(1 + this.coreEnergy() * 0.35).toFixed(3)} — the core's share is vanishing, so the total settles.`);
        this.text("[data-r3]", this.pulses ? "With the pulses the residual force extends smoothly through t = 1." : "Without them the residual is unbounded and cannot be a smooth force.");
      }
    }

    // --- drawing -------------------------------------------------------------
    layout() {
      const r = (this.surface || this.canvas).getBoundingClientRect();
      if (!r.width) return;
      const d = Math.min(devicePixelRatio || 1, 2);
      this.width = r.width; this.height = r.height;
      this.canvas.width = Math.round(r.width * d);
      this.canvas.height = Math.round(r.height * d);
      this.ctx.setTransform(d, 0, 0, d, 0, 0);
      this.vortex?.resize(r.width, r.height);
      this.draw();
    }

    margins() {
      const l = 52, rr = 18, t = 18, b = 38;
      return { l, t, w: Math.max(10, this.width - l - rr), h: Math.max(10, this.height - t - b) };
    }

    css(n: string) { return getComputedStyle(this).getPropertyValue(n).trim(); }

    palette() {
      return {
        low: this.css("--vortex-low"),
        mid: this.css("--vortex-mid"),
        high: this.css("--vortex-high"),
        ink: this.css("--vortex-ink"),
        ground: this.css("--vortex-ground"),
      };
    }

    surfaces() {
      const three = this.mode === "vortex";
      this.canvas.classList.toggle("veiled", three);
      this.gl?.classList.toggle("veiled", !three);
      this.querySelector("[data-notes]")?.classList.toggle("veiled", !three);
      if (three) this.ensureVortex();
    }

    ensureVortex() {
      if (this.vortex || !this.gl) return;
      this.vortex = new VortexView(this.gl);
      this.vortex.build(
        (r, z) => {
          const f = this.field(r, z, 1);
          return { ur: f.ur, uz: f.uz, ut: f.ut };
        },
        X_CORE,
        X_ANN,
        this.palette(),
      );
      const r = (this.surface || this.canvas).getBoundingClientRect();
      this.vortex.resize(r.width, r.height);
    }

    // Quantised ramp: contour bands read as a plate engraving, and the steps
    // make the collapse legible in a way a smooth gradient does not.
    band(t: number, bg: number[], a: number[], b: number[]) {
      const q = Math.floor(clamp(t, 0, 0.9999) * BANDS) / (BANDS - 1);
      if (q < 0.5) {
        const u = q / 0.5;
        return [bg[0] + (a[0] - bg[0]) * u, bg[1] + (a[1] - bg[1]) * u, bg[2] + (a[2] - bg[2]) * u];
      }
      const u = (q - 0.5) / 0.5;
      return [a[0] + (b[0] - a[0]) * u, a[1] + (b[1] - a[1]) * u, a[2] + (b[2] - a[2]) * u];
    }

    rgb(name: string): [number, number, number] {
      const v = this.css(name);
      const m = v.match(/#([0-9a-f]{6})/i);
      if (m) {
        const n = parseInt(m[1], 16);
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
      }
      const p = v.match(/-?\d+(\.\d+)?/g);
      return p ? [Number(p[0]), Number(p[1]), Number(p[2])] : [128, 128, 128];
    }

    draw() {
      if (!this.width || this.mode === "vortex") return;
      const c = this.ctx;
      c.save();
      c.fillStyle = this.css("--paper-sunken");
      c.fillRect(0, 0, this.width, this.height);
      c.font = "10px 'IBM Plex Mono', ui-monospace, monospace";
      c.textBaseline = "middle";
      if (this.mode === "collapse") this.drawCollapse();
      else if (this.mode === "spinup") this.drawSpinup();
      else if (this.mode === "pulses") this.drawPulses();
      else this.drawLedger();
      c.restore();
    }

    // Screen projection. Both frames read the same physical field; only the map
    // from (r, z) to pixels differs.
    project(r: number, z: number): [number, number] {
      const m = this.margins();
      if (this.frame === "lab") {
        const scale = m.w / LAB_R;
        return [m.l + r * scale, m.t + m.h / 2 - z * scale];
      }
      const q = this.solveQ(z, this.tau);
      const X = (r * r) / (2 * q);
      const eta = clamp(z / Math.pow(q, 0.5 - this.h), -1, 1);
      return [m.l + (X / (X_ANN + 1.5)) * m.w, m.t + m.h / 2 - eta * (m.h / 2.1)];
    }

    unproject(px: number, py: number): [number, number] {
      const m = this.margins();
      if (this.frame === "lab") {
        const scale = m.w / LAB_R;
        return [Math.max(0, (px - m.l) / scale), (m.t + m.h / 2 - py) / scale];
      }
      const X = clamp(((px - m.l) / m.w) * (X_ANN + 1.5), 0, X_ANN + 1.5);
      const eta = clamp((m.t + m.h / 2 - py) / (m.h / 2.1), -0.995, 0.995);
      const q = this.tau / (1 - eta * eta);
      return [Math.sqrt(2 * q * X), Math.pow(q, 0.5 - this.h) * eta];
    }

    drawField() {
      const m = this.margins();
      const RW = 300, RH = Math.max(24, Math.round((RW * m.h) / m.w));
      if (!this.rasterCanvas) {
        this.rasterCanvas = document.createElement("canvas");
      }
      const rc = this.rasterCanvas;
      if (rc.width !== RW || rc.height !== RH) { rc.width = RW; rc.height = RH; }
      const rctx = rc.getContext("2d")!;
      const img = rctx.createImageData(RW, RH);
      const vals = new Float32Array(RW * RH);
      let max = 1e-9;
      for (let j = 0; j < RH; j++) {
        for (let i = 0; i < RW; i++) {
          const px = m.l + ((i + 0.5) / RW) * m.w;
          const py = m.t + ((j + 0.5) / RH) * m.h;
          const [r, z] = this.unproject(px, py);
          const v = Math.abs(this.swirlAt(r, z));
          vals[j * RW + i] = v;
          if (v > max) max = v;
        }
      }
      const bg = this.rgb("--paper-sunken");
      const a = this.rgb("--math-a");
      const b = this.rgb("--math-b");
      const d = img.data;
      for (let k = 0; k < RW * RH; k++) {
        const col = this.band(Math.pow(clamp(vals[k] / max, 0, 1), 0.62), bg, a, b);
        d[k * 4] = col[0]; d[k * 4 + 1] = col[1]; d[k * 4 + 2] = col[2]; d[k * 4 + 3] = 255;
      }
      rctx.putImageData(img, 0, 0);
      const c = this.ctx;
      c.save();
      c.beginPath(); c.rect(m.l, m.t, m.w, m.h); c.clip();
      c.imageSmoothingEnabled = true;
      c.drawImage(rc, m.l, m.t, m.w, m.h);
      c.restore();
      return max;
    }

    // Instantaneous poloidal streamlines, integrated through the physical field.
    drawStreamlines() {
      const c = this.ctx, m = this.margins();
      c.save();
      c.beginPath(); c.rect(m.l, m.t, m.w, m.h); c.clip();
      const seeds: [number, number][] = [];
      for (let k = 0; k < 13; k++) {
        const eta = -0.9 + (k / 12) * 1.8;
        const q = this.tau / (1 - eta * eta);
        seeds.push([Math.sqrt(2 * q * (X_ANN - 0.6)), Math.pow(q, 0.5 - this.h) * eta]);
      }
      const paths: Path2D[] = [];
      for (const [sr, sz] of seeds) {
        let r = sr, z = sz;
        const path = new Path2D();
        let started = false;
        for (let n = 0; n < 420; n++) {
          const f = this.field(r, z);
          const sp = Math.hypot(f.ur, f.uz);
          if (!Number.isFinite(sp) || sp < 1e-12) break;
          const step = (0.012 * Math.sqrt(this.tau)) / sp;
          const mr = r + 0.5 * step * f.ur, mz = z + 0.5 * step * f.uz;
          const g = this.field(Math.max(0, mr), mz);
          r += step * g.ur; z += step * g.uz;
          if (!(r >= 0) || !Number.isFinite(z)) break;
          const q = this.solveQ(z, this.tau);
          if ((r * r) / (2 * q) > X_ANN + 1.4 || Math.abs(z / Math.pow(q, 0.5 - this.h)) > 0.97) break;
          const [px, py] = this.project(r, z);
          if (!started) { path.moveTo(px, py); started = true; } else path.lineTo(px, py);
        }
        if (started) paths.push(path);
      }
      c.lineCap = "round";
      c.strokeStyle = this.css("--paper-raised");
      c.globalAlpha = 0.8; c.lineWidth = 3.4;
      for (const path of paths) c.stroke(path);
      c.strokeStyle = this.css("--ink");
      c.globalAlpha = 0.85; c.lineWidth = 1.3;
      for (const path of paths) c.stroke(path);
      c.restore();
    }

    drawTracers() {
      const c = this.ctx, m = this.margins();
      c.save();
      c.beginPath(); c.rect(m.l, m.t, m.w, m.h); c.clip();
      const hot = this.css("--math-b");
      c.lineCap = "round";
      for (let i = 0; i < this.NP; i++) {
        const r = this.poloidal[i * 3], z = this.poloidal[i * 3 + 1];
        const f = this.field(r, z);
        const [px, py] = this.project(r, z);
        const [qx, qy] = this.project(Math.max(0, r - f.ur * this.tau * 0.9), z - f.uz * this.tau * 0.9);
        const len = Math.hypot(qx - px, qy - py);
        if (len > 1.5) {
          const k = Math.min(1, 16 / len);
          c.strokeStyle = hot;
          c.globalAlpha = 0.55;
          c.lineWidth = 1.6;
          c.beginPath();
          c.moveTo(px, py);
          c.lineTo(px + (qx - px) * k, py + (qy - py) * k);
          c.stroke();
        }
        c.globalAlpha = 1;
        c.fillStyle = hot;
        c.beginPath(); c.arc(px, py, 2.1, 0, Math.PI * 2); c.fill();
      }
      c.restore();
    }

    // Closed boundary of { Xin <= X <= Xout, |eta| <= ETA_CORE } in the (r, z)
    // half-plane: two similarity arcs joined by two constant-eta caps.
    region(tau: number, Xin: number, Xout: number) {
      const pts: [number, number][] = [];
      const N = 46;
      const at = (X: number, eta: number): [number, number] => {
        const q = tau / (1 - eta * eta);
        return [Math.sqrt(2 * q * X), Math.pow(q, 0.5 - this.h) * eta];
      };
      for (let i = 0; i <= N; i++) pts.push(at(Xin, -ETA_CORE + (2 * ETA_CORE * i) / N));
      for (let i = 0; i <= 12; i++) pts.push(at(Xin + ((Xout - Xin) * i) / 12, ETA_CORE));
      for (let i = N; i >= 0; i--) pts.push(at(Xout, -ETA_CORE + (2 * ETA_CORE * i) / N));
      for (let i = 12; i >= 0; i--) pts.push(at(Xin + ((Xout - Xin) * i) / 12, -ETA_CORE));
      return pts;
    }

    coreOutline(tau: number) { return this.region(tau, 0, X_CORE); }

    strokeRegion(pts: [number, number][], style: string, dash: number[], alpha = 1, width = 1.3) {
      const c = this.ctx, m = this.margins();
      c.save();
      c.beginPath(); c.rect(m.l, m.t, m.w, m.h); c.clip();
      c.strokeStyle = style; c.setLineDash(dash); c.globalAlpha = alpha; c.lineWidth = width;
      c.beginPath();
      pts.forEach(([r, z], i) => {
        const [px, py] = this.project(r, z);
        if (i === 0) c.moveTo(px, py); else c.lineTo(px, py);
      });
      c.closePath();
      c.stroke();
      c.restore();
    }

    drawCollapse() {
      const c = this.ctx, m = this.margins();
      const max = this.drawField();

      this.strokeRegion(this.region(this.tau, X_CORE, X_ANN), this.css("--math-good"), [4, 4], 0.9);

      this.drawStreamlines();
      if (this.pulses) this.drawPulseRings();
      this.drawTracers();

      // core outline now, and its own shape at 2τ, 4τ, 8τ
      if (this.frame === "lab") {
        for (const k of [8, 4, 2]) {
          const t = Math.min(1, this.tau * k);
          this.strokeRegion(this.coreOutline(t), this.css("--ink-faint"), [2, 3], 0.3);
        }
      }
      this.strokeRegion(this.coreOutline(this.tau), this.css("--ink"), [], 0.95, 1.8);

      // axis of symmetry
      c.save();
      c.strokeStyle = this.css("--ink-soft"); c.lineWidth = 1; c.setLineDash([5, 4]);
      const [ax] = this.project(0, 0);
      c.beginPath(); c.moveTo(ax, m.t); c.lineTo(ax, m.t + m.h); c.stroke();
      c.restore();

      this.axes(
        this.frame === "lab" ? "r" : "X = r² / 2q",
        this.frame === "lab" ? "z" : "η",
        this.frame === "lab" ? ["0", "3.1", "6.2"] : ["0", "4", "8"],
      );
      this.colourbar(max, "|u_θ|");
      this.regionLabels();
      this.hoverReadout();
    }

    drawPulseRings() {
      const c = this.ctx, m = this.margins();
      c.save();
      c.beginPath(); c.rect(m.l, m.t, m.w, m.h); c.clip();
      c.strokeStyle = this.css("--math-good");
      c.lineWidth = 1.3;
      const lam = Math.pow(this.tau, 0.5 + this.h / 2);
      for (let row = 0; row < 7; row++) {
        const eta = -0.78 + (row / 6) * 1.56;
        const q = this.tau / (1 - eta * eta);
        const sigma = ((this.s * 1.7 + row * 0.9) % PULSE_SPAN);
        const amp = this.pulseEnvelope(sigma);
        const tilt = sigma * 0.85;
        const X0 = X_CORE + 0.5 + (row % 2) * 0.7;
        c.globalAlpha = clamp(amp * 2.6, 0.05, 0.95);
        c.beginPath();
        for (let i = 0; i <= 44; i++) {
          const X = X0 + (i / 44) * 2.6;
          const r = Math.sqrt(2 * q * X);
          const phase = ((r - Math.sqrt(2 * q * X0)) / (lam * (1 + tilt))) * Math.PI * 2 * 0.9;
          const dz = Math.sin(phase) * Math.pow(q, 0.5 - this.h) * 0.075 * clamp(amp * 3, 0.1, 1);
          const z = Math.pow(q, 0.5 - this.h) * eta + dz;
          const [px, py] = this.project(r, z);
          if (i === 0) c.moveTo(px, py); else c.lineTo(px, py);
        }
        c.stroke();
      }
      c.restore();
    }

    regionLabels() {
      const c = this.ctx, m = this.margins();
      c.save();
      c.fillStyle = this.css("--ink-faint");
      c.font = "9px 'IBM Plex Mono', ui-monospace, monospace";
      const put = (r: number, z: number, s: string, color?: string) => {
        const [px, py] = this.project(r, z);
        if (px < m.l - 4 || px > m.l + m.w - 4 || py < m.t || py > m.t + m.h) return;
        const w = c.measureText(s).width;
        const x = Math.min(px + 8, m.l + m.w - w - 12);
        c.fillStyle = this.css("--glass-strong");
        c.fillRect(x - 4, py - 7, w + 8, 14);
        c.fillStyle = color || this.css("--ink-faint");
        c.fillText(s, x, py);
      };
      const q0 = this.tau;
      put(Math.sqrt(2 * q0 * 0.6), 0, "core", this.css("--ink"));
      put(Math.sqrt(2 * q0 * (X_CORE + 1.4)), Math.pow(q0, 0.5 - this.h) * 0.55, "annulus · pulses", this.css("--math-good"));
      put(Math.sqrt(2 * q0 * (X_ANN + 1.0)), -Math.pow(q0, 0.5 - this.h) * 0.55, "heat exterior");
      c.restore();
    }

    drawSpinup() {
      const c = this.ctx, m = this.margins();
      const cx = m.l + m.w / 2, cy = m.t + m.h / 2;
      const R = Math.min(m.w, m.h) / 2 - 12;
      const eta = 0.25;
      const q = this.tau / (1 - eta * eta);
      const z = Math.pow(q, 0.5 - this.h) * eta;
      const rMax = Math.sqrt(2 * q * (X_ANN + 1.5));
      const toPx = (r: number, th: number): [number, number] => {
        const rr = (r / rMax) * R;
        return [cx + rr * Math.cos(th), cy + rr * Math.sin(th)];
      };

      // swirl rings
      c.save();
      const bands = 90;
      let maxV = 1e-9;
      const vs: number[] = [];
      for (let i = 0; i < bands; i++) {
        const r = ((i + 0.5) / bands) * rMax;
        const f = this.field(r, z);
        const w = smoothstep(X_CORE, X_ANN, f.X);
        const v = Math.abs(f.ut * (1 - w) + this.extSwirl(r) * w);
        vs.push(v); if (v > maxV) maxV = v;
      }
      const bg = this.rgb("--paper-sunken"), ca = this.rgb("--math-a"), cb = this.rgb("--math-b");
      for (let i = bands - 1; i >= 0; i--) {
        const col = this.band(Math.pow(clamp(vs[i] / maxV, 0, 1), 0.62), bg, ca, cb);
        c.fillStyle = `rgb(${col[0] | 0},${col[1] | 0},${col[2] | 0})`;
        c.beginPath();
        c.arc(cx, cy, ((i + 1) / bands) * R, 0, Math.PI * 2);
        c.fill();
      }
      c.restore();

      // tracers, drawn as arcs of their own motion
      c.save();
      c.strokeStyle = this.css("--interact");
      c.lineWidth = 1;
      c.globalAlpha = 0.5;
      for (let i = 0; i < this.ND; i++) {
        const r = this.disc[i * 3], th = this.disc[i * 3 + 1];
        const rr = (r / rMax) * R;
        if (!(rr > 0.5) || rr > R) continue;
        c.beginPath();
        c.arc(cx, cy, rr, th - 0.34, th);
        c.stroke();
      }
      c.globalAlpha = 1;
      c.fillStyle = this.css("--math-b");
      for (let i = 0; i < this.ND; i++) {
        const [px, py] = toPx(this.disc[i * 3], this.disc[i * 3 + 1]);
        const rr = Math.hypot(px - cx, py - cy);
        if (rr > R) continue;
        c.beginPath(); c.arc(px, py, 1.5, 0, Math.PI * 2); c.fill();
      }
      c.restore();

      // core radius and annulus circles
      c.save();
      c.setLineDash([4, 4]);
      c.strokeStyle = this.css("--ink");
      c.beginPath(); c.arc(cx, cy, (this.lr() / rMax) * R, 0, Math.PI * 2); c.stroke();
      c.strokeStyle = this.css("--math-good");
      c.beginPath(); c.arc(cx, cy, (Math.sqrt(2 * q * X_ANN) / rMax) * R, 0, Math.PI * 2); c.stroke();
      c.restore();

      // angular momentum profile strip
      const sh = 62, sy = m.t + m.h - sh;
      c.save();
      c.fillStyle = this.css("--glass");
      c.fillRect(m.l, sy, 190, sh);
      c.strokeStyle = this.css("--rule");
      c.strokeRect(m.l, sy, 190, sh);
      c.fillStyle = this.css("--ink-faint");
      c.font = "9px 'IBM Plex Mono', ui-monospace, monospace";
      c.fillText("angular momentum r·u_θ", m.l + 8, sy + 12);
      let lmax = 1e-9;
      const ls: number[] = [];
      for (let i = 0; i < 90; i++) {
        const r = ((i + 0.5) / 90) * rMax;
        const f = this.field(r, z);
        const w = smoothstep(X_CORE, X_ANN, f.X);
        const v = r * (f.ut * (1 - w) + this.extSwirl(r) * w);
        ls.push(v); if (v > lmax) lmax = v;
      }
      c.strokeStyle = this.css("--math-b");
      c.lineWidth = 1.4;
      c.beginPath();
      ls.forEach((v, i) => {
        const px = m.l + 8 + (i / 89) * 174;
        const py = sy + sh - 10 - (v / lmax) * (sh - 26);
        if (i === 0) c.moveTo(px, py); else c.lineTo(px, py);
      });
      c.stroke();
      c.restore();

      c.save();
      c.fillStyle = this.css("--ink-faint");
      c.font = "9px 'IBM Plex Mono', ui-monospace, monospace";
      c.fillText(`section at η = 0.25 · core radius ℓ_r = ${this.lr().toExponential(2)}`, m.l, m.t + 6);
      c.fillText(`Re_θ = ${this.reTheta().toFixed(2)}`, m.l + m.w - 90, m.t + 6);
      c.restore();
    }

    // stress cone -------------------------------------------------------------
    coneDirs() {
      return { v1: [Math.cos(0.13), Math.sin(0.13)], v2: [Math.cos(1.24), Math.sin(1.24)] };
    }
    coneWeights() {
      const { v1, v2 } = this.coneDirs();
      const det = v1[0] * v2[1] - v1[1] * v2[0];
      const a = (this.target.x * v2[1] - this.target.y * v2[0]) / det;
      const b = (v1[0] * this.target.y - v1[1] * this.target.x) / det;
      return { a, b, ok: a >= 0 && b >= 0 };
    }
    conePanel() {
      const m = this.margins();
      const w = Math.min(300, m.w * 0.4);
      return { x: m.l + m.w - w, y: m.t, w, h: Math.min(w * 1.15, m.h * 0.66) };
    }
    dragTarget(px: number, py: number) {
      const p = this.conePanel();
      const s = Math.min(p.w, p.h) * 0.6;
      this.target.x = clamp((px - (p.x + 26)) / s, -0.4, 1.2);
      this.target.y = clamp(((p.y + p.h - 30) - py) / s, -0.4, 1.2);
    }

    drawPulses() {
      const c = this.ctx, m = this.margins();
      const p = this.conePanel();
      const leftW = p.x - m.l - 18;
      const packH = m.h * 0.6;

      // --- pulse packet in the annulus, in (X, eta)
      const sigma = (this.s * 1.7) % PULSE_SPAN;
      const amp = this.pulseEnvelope(sigma);
      const tilt = sigma * 0.85;
      const RW = 150, RH = Math.max(20, Math.round((RW * packH) / leftW));
      const rc = document.createElement("canvas");
      rc.width = RW; rc.height = RH;
      const rctx = rc.getContext("2d")!;
      const img = rctx.createImageData(RW, RH);
      const d = img.data;
      const bg = this.rgb("--paper-sunken"), ca = this.rgb("--math-a"), cb = this.rgb("--math-b");
      const kr = 7.5 * (1 + tilt), kz = 7.5;
      for (let j = 0; j < RH; j++) {
        for (let i = 0; i < RW; i++) {
          const X = X_CORE + (i / RW) * (X_ANN - X_CORE);
          const eta = 0.85 - (j / RH) * 1.7;
          const env =
            Math.exp(-(((X - (X_CORE + X_ANN) / 2) / 1.15) ** 2)) *
            Math.exp(-((eta / 0.5) ** 2));
          const val = this.pulses ? env * (0.45 + 1.05 * Math.pow(clamp(amp / 0.66, 0, 1), 0.6)) * Math.cos(kr * X + kz * eta + this.s * 6) : 0;
          const t = clamp((val + 1) / 2, 0, 1);
          let col: number[];
          if (t < 0.5) { const u = 1 - t / 0.5; col = [bg[0] + (ca[0] - bg[0]) * u, bg[1] + (ca[1] - bg[1]) * u, bg[2] + (ca[2] - bg[2]) * u]; }
          else { const u = (t - 0.5) / 0.5; col = [bg[0] + (cb[0] - bg[0]) * u, bg[1] + (cb[1] - bg[1]) * u, bg[2] + (cb[2] - bg[2]) * u]; }
          const k = (j * RW + i) * 4;
          d[k] = col[0]; d[k + 1] = col[1]; d[k + 2] = col[2]; d[k + 3] = 255;
        }
      }
      rctx.putImageData(img, 0, 0);
      c.drawImage(rc, m.l, m.t, leftW, packH);
      c.save();
      c.strokeStyle = this.css("--math-good");
      c.setLineDash([4, 4]);
      c.globalAlpha = 0.8;
      c.beginPath();
      c.ellipse(m.l + leftW * 0.5, m.t + packH * 0.5, leftW * 0.29, packH * 0.31, 0, 0, Math.PI * 2);
      c.stroke();
      c.restore();
      c.strokeStyle = this.css("--rule");
      c.strokeRect(m.l, m.t, leftW, packH);

      // wavevector and the transverse velocity direction
      const ox = m.l + leftW * 0.5, oy = m.t + packH * 0.5;
      const ang = Math.atan2(kz, kr);
      const L = 46;
      c.save();
      c.strokeStyle = this.css("--ink"); c.lineWidth = 1.6;
      c.beginPath(); c.moveTo(ox, oy); c.lineTo(ox + L * Math.cos(ang), oy - L * Math.sin(ang)); c.stroke();
      c.strokeStyle = this.css("--math-good");
      c.beginPath(); c.moveTo(ox, oy); c.lineTo(ox - L * 0.8 * Math.sin(ang), oy - L * 0.8 * Math.cos(ang)); c.stroke();
      c.fillStyle = this.css("--ink");
      c.font = "9px 'IBM Plex Mono', ui-monospace, monospace";
      c.fillText("ξ", ox + L * Math.cos(ang) + 4, oy - L * Math.sin(ang));
      c.fillStyle = this.css("--math-good");
      c.fillText("a ⟂ ξ", ox - L * 0.8 * Math.sin(ang) - 26, oy - L * 0.8 * Math.cos(ang) - 8);
      c.fillStyle = this.css("--ink-faint");
      c.fillText(`w = a cos(ξ·x + φ)  ·  |ξ_r| grows with the shear`, m.l + 8, m.t + 12);
      c.restore();

      // --- envelope: growth then viscous decay
      const ey = m.t + packH + 16, eh = m.h - packH - 16;
      c.save();
      c.strokeStyle = this.css("--rule");
      c.strokeRect(m.l, ey, leftW, eh);
      c.fillStyle = this.css("--ink-faint");
      c.font = "9px 'IBM Plex Mono', ui-monospace, monospace";
      c.fillText("pulse envelope A(σ) · seeded exponentially small", m.l + 8, ey + 12);
      let emax = 1e-9;
      const es: number[] = [];
      for (let i = 0; i <= 120; i++) { const v = this.pulseEnvelope((i / 120) * PULSE_SPAN); es.push(v); if (v > emax) emax = v; }
      c.strokeStyle = this.css("--math-good"); c.lineWidth = 1.6;
      c.beginPath();
      es.forEach((v, i) => {
        const px = m.l + 8 + (i / 120) * (leftW - 16);
        const py = ey + eh - 12 - (v / emax) * (eh - 30);
        if (i === 0) c.moveTo(px, py); else c.lineTo(px, py);
      });
      c.stroke();
      const cxp = m.l + 8 + (sigma / PULSE_SPAN) * (leftW - 16);
      c.strokeStyle = this.css("--interact"); c.setLineDash([3, 3]);
      c.beginPath(); c.moveTo(cxp, ey + 16); c.lineTo(cxp, ey + eh - 8); c.stroke();
      c.setLineDash([]);
      const peak = m.l + 8 + (this.pulsePeak() / PULSE_SPAN) * (leftW - 16);
      c.fillStyle = this.css("--ink-faint");
      c.fillText("amplification", m.l + 12, ey + eh - 20);
      if (peak < m.l + leftW - 70) c.fillText("damping wins", peak + 6, ey + eh - 20);
      c.restore();

      // --- admissible stress cone
      c.save();
      c.fillStyle = this.css("--glass");
      c.fillRect(p.x, p.y, p.w, p.h);
      c.strokeStyle = this.css("--rule");
      c.strokeRect(p.x, p.y, p.w, p.h);
      c.beginPath(); c.rect(p.x, p.y, p.w, p.h); c.clip();
      const s = Math.min(p.w, p.h) * 0.6;
      const O = [p.x + 26, p.y + p.h - 30];
      const map = (a: number, b: number): [number, number] => [O[0] + a * s, O[1] - b * s];
      const { v1, v2 } = this.coneDirs();
      c.globalAlpha = 0.22;
      c.fillStyle = this.css("--math-good");
      c.beginPath();
      c.moveTo(O[0], O[1]);
      c.lineTo(...map(v1[0] * 1.02, v1[1] * 1.02));
      c.lineTo(...map(v2[0] * 1.02, v2[1] * 1.02));
      c.closePath(); c.fill();
      c.globalAlpha = 1;
      c.strokeStyle = this.css("--ink-soft"); c.lineWidth = 1;
      c.beginPath(); c.moveTo(O[0], O[1]); c.lineTo(O[0] + s * 1.1, O[1]); c.stroke();
      c.beginPath(); c.moveTo(O[0], O[1]); c.lineTo(O[0], O[1] - s * 1.1); c.stroke();
      c.strokeStyle = this.css("--math-good"); c.lineWidth = 1.5;
      for (const v of [v1, v2]) { c.beginPath(); c.moveTo(O[0], O[1]); c.lineTo(...map(v[0] * 1.02, v[1] * 1.02)); c.stroke(); }
      const w = this.coneWeights();
      const [tx, ty] = map(this.target.x, this.target.y);
      c.strokeStyle = w.ok ? this.css("--math-b") : this.css("--math-bad");
      c.lineWidth = 1.6;
      c.beginPath(); c.moveTo(O[0], O[1]); c.lineTo(tx, ty); c.stroke();
      c.fillStyle = w.ok ? this.css("--math-b") : this.css("--math-bad");
      c.beginPath(); c.arc(tx, ty, 6, 0, Math.PI * 2); c.fill();
      c.fillStyle = this.css("--ink-faint");
      c.font = "9px 'IBM Plex Mono', ui-monospace, monospace";
      c.fillText("admissible stress cone", p.x + 10, p.y + 14);
      c.fillText("T_rθ", O[0] + s * 1.1 - 26, O[1] + 12);
      c.fillText("T_rz", O[0] + 6, O[1] - s * 1.1 + 6);
      c.fillStyle = w.ok ? this.css("--math-good") : this.css("--math-bad");
      c.fillText(`c₁ = ${w.a.toFixed(2)}   c₂ = ${w.b.toFixed(2)}`, p.x + 10, p.y + p.h - 12);
      c.fillStyle = this.css("--ink-faint");
      c.fillText("drag the marker", p.x + 10, p.y + 26);
      c.restore();

      // residual meter
      const ry = p.y + p.h + 16;
      if (ry + 60 < m.t + m.h) {
        c.save();
        c.fillStyle = this.css("--glass");
        c.fillRect(p.x, ry, p.w, m.t + m.h - ry);
        c.strokeStyle = this.css("--rule");
        c.strokeRect(p.x, ry, p.w, m.t + m.h - ry);
        c.fillStyle = this.css("--ink-faint");
        c.font = "9px 'IBM Plex Mono', ui-monospace, monospace";
        c.fillText("residual force ‖R‖ as τ → 0", p.x + 10, ry + 16);
        const full = p.w - 24;
        const frac = clamp(Math.log10(this.residualBg()) / 5, 0.02, 1);
        c.fillStyle = this.css("--ink-faint");
        c.fillText("background alone", p.x + 12, ry + 36);
        c.fillStyle = this.css("--math-bad");
        c.fillRect(p.x + 12, ry + 44, Math.max(4, full * frac), 14);
        c.fillStyle = this.css("--ink");
        c.fillText(`${this.residualBg().toExponential(1)}  ↗`, p.x + 20 + Math.max(4, full * frac), ry + 51);
        c.fillStyle = this.css("--ink-faint");
        c.fillText(this.pulses ? "with the pulse stress" : "pulses switched off", p.x + 12, ry + 78);
        c.fillStyle = this.pulses ? this.css("--math-good") : this.css("--rule-strong");
        c.fillRect(p.x + 12, ry + 86, full * 0.14, 14);
        c.fillStyle = this.css("--ink-faint");
        c.fillText(this.pulses ? "bounded through t = 1" : "unbounded", p.x + 20 + full * 0.14, ry + 93);
        c.fillText("the pulses' averaged momentum flux", p.x + 12, ry + 118);
        c.fillText("cancels the divergent part.", p.x + 12, ry + 132);
        c.restore();
      }
    }

    drawLedger() {
      const c = this.ctx, m = this.margins();
      const yMin = -2.6, yMax = 4.6;
      const px = (s: number) => m.l + (s / S_MAX) * m.w;
      const py = (v: number) => m.t + m.h - ((clamp(Math.log10(Math.max(v, 1e-9)), yMin, yMax) - yMin) / (yMax - yMin)) * m.h;

      // decade grid
      c.save();
      c.strokeStyle = this.css("--rule");
      c.fillStyle = this.css("--ink-faint");
      c.font = "9px 'IBM Plex Mono', ui-monospace, monospace";
      for (let e = Math.ceil(yMin); e <= yMax; e++) {
        const y = py(Math.pow(10, e));
        c.globalAlpha = e === 0 ? 0.9 : 0.4;
        c.beginPath(); c.moveTo(m.l, y); c.lineTo(m.l + m.w, y); c.stroke();
        c.globalAlpha = 1;
        c.fillText(`10${e < 0 ? "⁻" : ""}${"⁰¹²³⁴⁵⁶⁷⁸⁹"[Math.abs(e)]}`, 8, y);
      }
      for (let e = 0; e <= 3; e++) {
        const x = px(e * Math.LN10);
        c.globalAlpha = 0.4;
        c.beginPath(); c.moveTo(x, m.t); c.lineTo(x, m.t + m.h); c.stroke();
        c.globalAlpha = 1;
        const lbl = e === 0 ? "τ = 1" : `10⁻${"⁰¹²³"[e]}`;
        c.fillText(lbl, Math.min(x + 4, m.l + m.w - c.measureText(lbl).width), m.t + m.h + 14);
      }
      c.restore();

      const trace = (fn: (t: number) => number, style: string, dash: number[], label: string, ly: number) => {
        c.save();
        c.strokeStyle = style; c.lineWidth = 1.8; c.setLineDash(dash);
        c.beginPath();
        for (let i = 0; i <= 200; i++) {
          const s = (i / 200) * S_MAX;
          const x = px(s), y = py(fn(Math.exp(-s)));
          if (i === 0) c.moveTo(x, y); else c.lineTo(x, y);
        }
        c.stroke();
        c.setLineDash([]);
        c.fillStyle = style;
        c.fillText(label, m.l + m.w - c.measureText(label).width - 6, ly);
        c.restore();
      };

      const end = Math.exp(-S_MAX);
      trace((t) => this.residualBg(t), this.css("--math-bad"), [5, 4], "‖R‖ background alone  ↗ ∞", py(this.residualBg(end)) + 14);
      trace(() => 0.62, this.css("--math-good"), [], this.pulses ? "‖R‖ with pulses  bounded" : "‖R‖ with pulses (off)", py(0.62) + 14);
      trace((t) => this.supU(t), this.css("--math-b"), [], "sup |u|  ↗ ∞", py(this.supU(end)) - 10);
      trace((t) => 1 + 0.35 * this.coreEnergy(t), this.css("--math-a"), [], "‖u‖ L²  bounded", py(1.02) - 12);
      trace((t) => this.coreEnergy(t), this.css("--ink-soft"), [2, 3], "core energy  ↘ 0", py(this.coreEnergy(end)) + 14);

      // scrub cursor
      c.save();
      const cx = px(this.s);
      c.strokeStyle = this.css("--interact"); c.lineWidth = 1.4;
      c.beginPath(); c.moveTo(cx, m.t); c.lineTo(cx, m.t + m.h); c.stroke();
      c.fillStyle = this.css("--interact");
      for (const v of [this.supU(), 1 + 0.35 * this.coreEnergy(), this.coreEnergy()]) {
        c.beginPath(); c.arc(cx, py(v), 3.2, 0, Math.PI * 2); c.fill();
      }
      c.font = "10px 'IBM Plex Mono', ui-monospace, monospace";
      const tag = `τ = ${this.tau < 0.001 ? this.tau.toExponential(1) : this.tau.toFixed(3)}`;
      c.fillStyle = this.css("--glass-strong");
      c.fillRect(Math.min(cx + 6, m.l + m.w - 86), m.t + 6, 80, 18);
      c.fillStyle = this.css("--ink");
      c.fillText(tag, Math.min(cx + 12, m.l + m.w - 80), m.t + 15);
      c.restore();
    }

    axes(xl: string, yl: string, ticks: string[]) {
      const c = this.ctx, m = this.margins();
      c.save();
      c.strokeStyle = this.css("--rule-strong");
      c.strokeRect(m.l, m.t, m.w, m.h);
      c.fillStyle = this.css("--ink-faint");
      c.font = "9px 'IBM Plex Mono', ui-monospace, monospace";
      ticks.forEach((t, i) => {
        const x = m.l + (i / (ticks.length - 1)) * m.w;
        c.fillText(t, i === ticks.length - 1 ? x - 20 : x + 3, m.t + m.h + 13);
      });
      c.fillText(xl, m.l + m.w / 2 - 20, m.t + m.h + 27);
      c.save();
      c.translate(14, m.t + m.h / 2);
      c.rotate(-Math.PI / 2);
      c.fillText(yl, -10, 0);
      c.restore();
      c.restore();
    }

    colourbar(max: number, label: string) {
      const c = this.ctx, m = this.margins();
      const w = 132, h = 11, x = m.l + m.w - w - 10, y = m.t + m.h - 26;
      const grad = c.createLinearGradient(x, 0, x + w, 0);
      grad.addColorStop(0, this.css("--paper-sunken"));
      grad.addColorStop(0.5, this.css("--math-a"));
      grad.addColorStop(1, this.css("--math-b"));
      c.save();
      c.fillStyle = grad;
      c.fillRect(x, y, w, h);
      c.strokeStyle = this.css("--rule-strong");
      c.strokeRect(x, y, w, h);
      c.fillStyle = this.css("--ink-faint");
      c.font = "9px 'IBM Plex Mono', ui-monospace, monospace";
      c.fillText("0", x - 8, y + h / 2);
      c.fillText(`${label} ≤ ${max.toFixed(2)}`, x, y - 8);
      c.restore();
    }

    hoverReadout() {
      if (!this.hover) return;
      const c = this.ctx, m = this.margins();
      const { x, y } = this.hover;
      if (x < m.l || x > m.l + m.w || y < m.t || y > m.t + m.h) return;
      const [r, z] = this.unproject(x, y);
      const f = this.field(r, z);
      const w = smoothstep(X_CORE, X_ANN, f.X);
      const ut = f.ut * (1 - w) + this.extSwirl(r) * w;
      const lines = [
        `r ${r.toExponential(2)}   z ${z.toExponential(2)}`,
        `X ${f.X.toFixed(2)}   η ${f.eta.toFixed(3)}`,
        `u_θ ${ut.toFixed(3)}   u_z ${f.uz.toFixed(3)}`,
        `u_r ${f.ur.toFixed(3)}   p ${f.p.toFixed(3)}`,
      ];
      const bw = 152, bh = 14 * lines.length + 10;
      const bx = Math.min(x + 12, m.l + m.w - bw - 4);
      const by = Math.min(y + 12, m.t + m.h - bh - 4);
      c.save();
      c.fillStyle = this.css("--glass-strong");
      c.fillRect(bx, by, bw, bh);
      c.strokeStyle = this.css("--rule-strong");
      c.strokeRect(bx, by, bw, bh);
      c.fillStyle = this.css("--ink");
      c.font = "9px 'IBM Plex Mono', ui-monospace, monospace";
      lines.forEach((l, i) => c.fillText(l, bx + 8, by + 12 + i * 14));
      c.restore();
    }

    text(q: string, v: string) {
      const e = this.querySelector(q);
      if (e) e.textContent = v;
    }
  }

  if (!customElements.get("blowup-laboratory")) customElements.define("blowup-laboratory", BlowupLaboratory);
</script>

<style>
  blowup-laboratory {
    display: block;
    --vortex-low: #2f9ab4;
    --vortex-mid: #4d63dc;
    --vortex-high: #e07b2a;
    --vortex-ink: #98a2c2;
    --vortex-ground: #171d30;
  }

  html[data-theme="dark"] blowup-laboratory {
    --vortex-low: #3fd0c4;
    --vortex-mid: #6f95ff;
    --vortex-high: #ff9a4d;
    --vortex-ink: #8b95b5;
    --vortex-ground: #10151f;
  }

  blowup-laboratory .stage-surface {
    position: relative;
    min-height: 35.5rem;
    height: 100%;
    overflow: hidden;
  }

  blowup-laboratory .stage-surface canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    cursor: crosshair;
    transition: opacity 220ms var(--ease-out);
  }

  blowup-laboratory [data-gl] { cursor: grab; }
  blowup-laboratory [data-gl]:active { cursor: grabbing; }

  blowup-laboratory .veiled { opacity: 0; pointer-events: none; }

  blowup-laboratory .vortex-notes {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity 220ms var(--ease-out);
  }

  blowup-laboratory .note {
    position: absolute;
    color: #dfe4f5;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  blowup-laboratory .note::after {
    content: "";
    position: absolute;
    background: rgba(223, 228, 245, 0.4);
  }

  blowup-laboratory .note--axial { top: 8%; right: 7%; }
  blowup-laboratory .note--axial::after { top: 1.5rem; right: 1.6rem; width: 4.5rem; height: 1px; transform: rotate(24deg); }
  blowup-laboratory .note--spiral { top: 30%; left: 7%; }
  blowup-laboratory .note--spiral::after { top: 1.4rem; left: 1.2rem; width: 1px; height: 4.5rem; transform: rotate(-28deg); transform-origin: top; }

  blowup-laboratory .math-button.active { color: var(--interact); border-color: var(--interact); }

  @media (max-width: 44rem) {
    blowup-laboratory .stage-surface { min-height: 27.5rem; }
    blowup-laboratory .note { font-size: 0.55rem; }
  }
</style>

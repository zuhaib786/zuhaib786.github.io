<monte-carlo-laboratory>
  <section class="math-instrument" aria-label="Interactive Monte Carlo laboratory">
    <div class="math-bar"><div class="math-state"><i></i><span data-state>Sampling a geometric estimator</span></div><div class="math-actions"><div class="math-tabs" aria-label="Monte Carlo experiment"><button class="active" data-mode="pi">Geometric π</button><button data-mode="integral">Integration</button><button data-mode="importance">Rare event</button><button data-mode="walk">Random walk</button></div><button class="math-button" data-run>Pause</button><button class="math-button" data-step>One batch</button><button class="math-button" data-reset>Reset</button></div></div>
    <div class="math-dashboard">
      <div class="math-stage"><span class="math-stage-label label" data-stage-label>uniform points · circle membership</span><canvas data-canvas aria-label="Monte Carlo samples and convergence"></canvas></div>
      <aside class="math-readout"><p class="label label--accent">Monte Carlo methods</p><h2 data-title>Area becomes probability</h2><p data-description>A uniform point in the square lands inside the unit circle with probability π/4. Counting membership turns geometry into an estimator.</p><div class="math-formula" data-formula>π̂ₙ = 4 Ninside / N</div>
        <div class="math-metrics"><div><strong data-estimate>—</strong><small>Estimate</small></div><div><strong data-error>—</strong><small>Absolute error</small></div><div><strong data-se>—</strong><small>Standard error</small></div></div>
        <div class="math-controls"><div class="math-control"><label><span>Batch size</span><b data-batch-value>120</b></label><input data-batch type="range" min="10" max="600" step="10" value="120" /></div><div class="math-control"><label><span data-parameter-label>Circle radius</span><b data-parameter-value>1.00</b></label><input data-parameter type="range" min="0.2" max="4" step="0.05" value="1" /></div><div class="math-control"><label><span>Deterministic seed</span><b data-seed-value>1729</b></label><input data-seed type="range" min="1" max="9999" step="1" value="1729" /></div></div>
        <div class="math-legend"><span><i></i>accepted / weighted</span><span><i></i>rejected / rare region</span><span><i></i>running estimate</span></div><div class="math-trace"><p class="label">Error law</p><ol><li data-reading-1>Each sample contributes either 0 or 4.</li><li data-reading-2>The estimator is unbiased for π.</li><li data-reading-3>Standard error shrinks proportionally to 1/√N.</li></ol></div>
      </aside>
    </div>
  </section>
</monte-carlo-laboratory>

<script>
  type Mode="pi"|"integral"|"importance"|"walk";type Sample={x:number;y:number;v:number;ok:boolean;path?:number[]};
  const INFO:Record<Mode,[string,string,string,string]>={
    pi:["Area becomes probability","A uniform point in the square lands inside a circle with probability equal to its area divided by four. Counting membership turns geometry into an estimator.","Âₙ = 4 Ninside / N","uniform points · circle membership"],
    integral:["An integral is an expectation","Uniform samples replace a continuum by an empirical mean. The estimator is noisy, but its uncertainty is measurable.","Îₙ = (b−a) · (1/N) Σ f(Xᵢ)","sample mean · f(x) = exp(−αx²)"],
    importance:["Sample where the answer lives","A Gaussian tail is almost never visited by naive sampling. A shifted proposal visits it deliberately and likelihood weights remove the bias.","P(X>τ) = E_q[𝟙{X>τ} φ(X)/q(X)]","importance samples · target and proposal densities"],
    walk:["Paths vote on a boundary value","A symmetric random walk stops at either boundary. The fraction that reaches the upper boundary estimates the exact hitting probability i/L.","Pᵢ(hit L before 0) = i / L","gambler's ruin · sampled paths"],
  };
  class MonteCarloLaboratory extends HTMLElement{
    canvas!:HTMLCanvasElement;ctx!:CanvasRenderingContext2D;width=0;height=0;mode:Mode="pi";batch=120;parameter=1;seed=1729;rngState=1729;count=0;mean=0;m2=0;samples:Sample[]=[];history:{n:number;y:number}[]=[];running=true;frame=0;last=0;resize?:ResizeObserver;theme?:MutationObserver;aborter=new AbortController();
    connectedCallback(){this.canvas=this.querySelector("[data-canvas]") as HTMLCanvasElement;const c=this.canvas.getContext("2d");if(!c)return;this.ctx=c;this.bind();this.resize=new ResizeObserver(()=>this.layout());this.resize.observe(this.canvas);this.theme=new MutationObserver(()=>this.draw());this.theme.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});this.configure();this.reset();this.layout();this.frame=requestAnimationFrame(t=>this.animate(t));}
    disconnectedCallback(){cancelAnimationFrame(this.frame);this.aborter.abort();this.resize?.disconnect();this.theme?.disconnect();}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(b=>b.addEventListener("click",()=>{this.mode=b.dataset.mode as Mode;this.querySelectorAll("[data-mode]").forEach(x=>x.classList.toggle("active",x===b));this.configure();this.reset();},{signal}));this.querySelector("[data-run]")?.addEventListener("click",()=>{this.running=!this.running;const b=this.querySelector<HTMLButtonElement>("[data-run]");if(b)b.textContent=this.running?"Pause":"Run";this.text("[data-state]",this.running?"Sampling continuously":"Paused · inspect the estimator");},{signal});this.querySelector("[data-step]")?.addEventListener("click",()=>{this.running=false;const b=this.querySelector<HTMLButtonElement>("[data-run]");if(b)b.textContent="Run";this.step();},{signal});this.querySelector("[data-reset]")?.addEventListener("click",()=>this.reset(),{signal});
      this.querySelector<HTMLInputElement>("[data-batch]")?.addEventListener("input",e=>{this.batch=Number((e.currentTarget as HTMLInputElement).value);this.text("[data-batch-value]",String(this.batch));},{signal});this.querySelector<HTMLInputElement>("[data-parameter]")?.addEventListener("input",e=>{this.parameter=Number((e.currentTarget as HTMLInputElement).value);this.text("[data-parameter-value]",this.parameter.toFixed(this.mode==="walk"?0:2));this.reset();},{signal});this.querySelector<HTMLInputElement>("[data-seed]")?.addEventListener("input",e=>{this.seed=Number((e.currentTarget as HTMLInputElement).value);this.text("[data-seed-value]",String(this.seed));this.reset();},{signal});}
    defaults(){if(this.mode==="pi")return{value:1,min:.2,max:1,step:.05,label:"Circle radius"};if(this.mode==="integral")return{value:1.2,min:.2,max:4,step:.05,label:"Shape α"};if(this.mode==="importance")return{value:3.5,min:2,max:5,step:.05,label:"Tail threshold τ"};return{value:7,min:1,max:19,step:1,label:"Start i · boundary L=20"};}
    configure(){const i=INFO[this.mode],d=this.defaults();this.parameter=d.value;this.text("[data-title]",i[0]);this.text("[data-description]",i[1]);this.text("[data-formula]",i[2]);this.text("[data-stage-label]",i[3]);this.text("[data-parameter-label]",d.label);this.text("[data-parameter-value]",d.value.toFixed(this.mode==="walk"?0:2));const input=this.querySelector<HTMLInputElement>("[data-parameter]");if(input){input.min=String(d.min);input.max=String(d.max);input.step=String(d.step);input.value=String(d.value);}if(this.mode==="pi"){this.text("[data-reading-1]","Each sample contributes either 0 or 4.");this.text("[data-reading-2]","The estimator is unbiased for the circle area πr².");}else if(this.mode==="integral"){this.text("[data-reading-1]","The sample mean is an unbiased integral estimator.");this.text("[data-reading-2]","Smoothness does not improve the N⁻¹ᐟ² Monte Carlo rate by itself.");}else if(this.mode==="importance"){this.text("[data-reading-1]","Samples come from q = Normal(τ, 1), near the rare event.");this.text("[data-reading-2]","Likelihood weights φ/q repair the changed distribution.");}else{this.text("[data-reading-1]","Every path terminates at either 0 or 20.");this.text("[data-reading-2]","The exact hitting probability is i/20 by harmonicity.");}this.text("[data-reading-3]","Standard error shrinks proportionally to 1/√N.");}
    reset(){this.rngState=this.seed>>>0||1;this.count=0;this.mean=0;this.m2=0;this.samples=[];this.history=[];this.text("[data-estimate]","—");this.text("[data-error]","—");this.text("[data-se]","—");this.draw();}
    random(){let x=this.rngState;x^=x<<13;x^=x>>>17;x^=x<<5;this.rngState=x>>>0;return this.rngState/4294967296;}
    normal(){const u=Math.max(1e-12,this.random()),v=this.random();return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v);}
    add(value:number,sample:Sample){this.count++;const delta=value-this.mean;this.mean+=delta/this.count;this.m2+=delta*(value-this.mean);this.samples.push(sample);if(this.samples.length>6500)this.samples.splice(0,this.samples.length-6500);}
    step(){const amount=this.mode==="walk"?Math.max(5,Math.floor(this.batch/8)):this.batch;for(let n=0;n<amount;n++){if(this.mode==="pi")this.samplePi();else if(this.mode==="integral")this.sampleIntegral();else if(this.mode==="importance")this.sampleImportance();else this.sampleWalk();}this.history.push({n:this.count,y:this.mean});if(this.history.length>180)this.history.shift();this.update();this.draw();}
    samplePi(){const x=this.random()*2-1,y=this.random()*2-1,ok=x*x+y*y<=this.parameter*this.parameter,v=ok?4:0;this.add(v,{x,y,v,ok});}
    sampleIntegral(){const x=this.random()*4-2,y=Math.exp(-this.parameter*x*x),v=4*y;this.add(v,{x,y,v,ok:true});}
    sampleImportance(){const tau=this.parameter,x=tau+this.normal(),ok=x>tau,weight=Math.exp(-x*x/2+(x-tau)*(x-tau)/2),v=ok?weight:0;this.add(v,{x,y:weight,v,ok});}
    sampleWalk(){const L=20,start=Math.round(this.parameter),path=[start];let x=start;for(let k=0;k<600&&x>0&&x<L;k++){x+=this.random()<.5?-1:1;path.push(x);}const ok=x===L,v=ok?1:0;this.add(v,{x:start,y:x,v,ok,path});}
    target(){if(this.mode==="pi")return Math.PI*this.parameter*this.parameter;if(this.mode==="integral")return Math.sqrt(Math.PI/this.parameter)*this.erf(2*Math.sqrt(this.parameter));if(this.mode==="importance")return .5*(1-this.erf(this.parameter/Math.SQRT2));return Math.round(this.parameter)/20;}
    erf(x:number){const sign=x<0?-1:1,a=Math.abs(x),t=1/(1+.3275911*a),y=1-(((((1.061405429*t-1.453152027)*t)+1.421413741)*t-.284496736)*t+.254829592)*t*Math.exp(-a*a);return sign*y;}
    update(){const variance=this.count>1?this.m2/(this.count-1):0,se=Math.sqrt(variance/Math.max(1,this.count)),target=this.target();this.text("[data-estimate]",this.mean.toPrecision(6));this.text("[data-error]",Math.abs(this.mean-target).toExponential(2));this.text("[data-se]",se.toExponential(2));this.text("[data-state]",`${this.count.toLocaleString()} samples · target ${target.toPrecision(6)}`);}
    animate(time:number){if(this.running&&time-this.last>90){this.last=time;this.step();}this.frame=requestAnimationFrame(t=>this.animate(t));}
    layout(){const r=this.canvas.getBoundingClientRect();if(!r.width)return;const d=Math.min(devicePixelRatio||1,2);this.width=r.width;this.height=r.height;this.canvas.width=Math.round(r.width*d);this.canvas.height=Math.round(r.height*d);this.ctx.setTransform(d,0,0,d,0,0);this.draw();}
    draw(){if(!this.width)return;const c=this.ctx,s=getComputedStyle(this);c.clearRect(0,0,this.width,this.height);c.fillStyle=s.getPropertyValue("--paper-sunken");c.fillRect(0,0,this.width,this.height);if(this.mode==="pi")this.drawPi();else if(this.mode==="integral")this.drawIntegral();else if(this.mode==="importance")this.drawImportance();else this.drawWalk();this.drawConvergence();}
    plotRect(){return{x:28,y:42,w:this.width-56,h:this.height*.63};}
    drawPi(){const c=this.ctx,r=this.plotRect(),size=Math.min(r.w,r.h),x=r.x+(r.w-size)/2,y=r.y;c.strokeStyle=this.css("--ink-soft");c.strokeRect(x,y,size,size);c.strokeStyle=this.css("--math-a");c.lineWidth=1.5;c.beginPath();c.arc(x+size/2,y+size/2,size/2*this.parameter,0,Math.PI*2);c.stroke();for(const p of this.samples){c.fillStyle=p.ok?this.css("--math-a"):this.css("--math-b");c.globalAlpha=.5;c.fillRect(x+(p.x+1)/2*size,y+(1-p.y)/2*size,1.4,1.4);}c.globalAlpha=1;}
    drawIntegral(){const c=this.ctx,r=this.plotRect(),toX=(x:number)=>r.x+(x+2)/4*r.w,toY=(y:number)=>r.y+r.h-y*r.h;c.strokeStyle=this.css("--rule");c.strokeRect(r.x,r.y,r.w,r.h);c.fillStyle=this.css("--math-a");c.globalAlpha=.25;for(const p of this.samples.slice(-1800)){const x=toX(p.x),y=toY(p.y);c.fillRect(x,y,1.5,r.y+r.h-y);}c.globalAlpha=1;c.strokeStyle=this.css("--math-a");c.lineWidth=2;c.beginPath();for(let n=0;n<=240;n++){const x=-2+n/60,y=Math.exp(-this.parameter*x*x),p={x:toX(x),y:toY(y)};n?c.lineTo(p.x,p.y):c.moveTo(p.x,p.y);}c.stroke();}
    drawImportance(){const c=this.ctx,r=this.plotRect(),xmin=-1,xmax=this.parameter+4,toX=(x:number)=>r.x+(x-xmin)/(xmax-xmin)*r.w,toY=(y:number)=>r.y+r.h-y/.45*r.h;c.strokeStyle=this.css("--rule");c.strokeRect(r.x,r.y,r.w,r.h);const density=(x:number,m:number)=>Math.exp(-(x-m)*(x-m)/2)/Math.sqrt(2*Math.PI);for(const [m,color] of [[0,this.css("--math-b")],[this.parameter,this.css("--math-a")]] as [number,string][]){c.strokeStyle=color;c.lineWidth=1.8;c.beginPath();for(let n=0;n<=220;n++){const x=xmin+n/220*(xmax-xmin),p={x:toX(x),y:toY(density(x,m))};n?c.lineTo(p.x,p.y):c.moveTo(p.x,p.y);}c.stroke();}const tx=toX(this.parameter);c.strokeStyle=this.css("--math-good");c.setLineDash([5,4]);c.beginPath();c.moveTo(tx,r.y);c.lineTo(tx,r.y+r.h);c.stroke();c.setLineDash([]);for(const p of this.samples.slice(-1500)){c.fillStyle=p.ok?this.css("--math-good"):this.css("--math-a");c.globalAlpha=.25+Math.min(.65,p.y);c.fillRect(toX(p.x),r.y+r.h-3,1.5,-8-Math.min(30,p.y*40));}c.globalAlpha=1;}
    drawWalk(){const c=this.ctx,r=this.plotRect(),paths=this.samples.slice(-80);c.strokeStyle=this.css("--rule");c.strokeRect(r.x,r.y,r.w,r.h);paths.forEach(p=>{const path=p.path||[],max=Math.max(1,path.length-1);c.strokeStyle=p.ok?this.css("--math-a"):this.css("--math-b");c.globalAlpha=.22;c.beginPath();path.forEach((x,n)=>{const px=r.x+n/max*r.w,py=r.y+r.h-x/20*r.h;n?c.lineTo(px,py):c.moveTo(px,py);});c.stroke();});c.globalAlpha=1;const y=r.y+r.h-this.parameter/20*r.h;c.strokeStyle=this.css("--math-good");c.beginPath();c.moveTo(r.x,y);c.lineTo(r.x+r.w,y);c.stroke();}
    drawConvergence(){const c=this.ctx,x=28,y=this.height*.75,w=this.width-56,h=this.height*.19;c.strokeStyle=this.css("--rule");c.strokeRect(x,y,w,h);if(this.history.length<2)return;const target=this.target(),se=this.count>1?Math.sqrt((this.m2/(this.count-1))/this.count):1,span=Math.max(se*5,Math.abs(this.mean-target)*1.5,Math.abs(target)*.015,1e-8),min=target-span,max=target+span;c.strokeStyle=this.css("--math-b");c.setLineDash([4,4]);const ty=y+h-(target-min)/(max-min)*h;c.beginPath();c.moveTo(x,ty);c.lineTo(x+w,ty);c.stroke();c.setLineDash([]);c.strokeStyle=this.css("--math-good");c.lineWidth=1.6;c.beginPath();this.history.forEach((p,n)=>{const px=x+n/Math.max(1,this.history.length-1)*w,py=y+h-(p.y-min)/(max-min)*h;n?c.lineTo(px,py):c.moveTo(px,py);});c.stroke();c.fillStyle=this.css("--ink-faint");c.font="8px IBM Plex Mono";c.fillText("running estimate",x+5,y+12);}
    css(n:string){return getComputedStyle(this).getPropertyValue(n).trim()}text(q:string,s:string){const e=this.querySelector(q);if(e)e.textContent=s}
  }
  if(!customElements.get("monte-carlo-laboratory"))customElements.define("monte-carlo-laboratory",MonteCarloLaboratory);
</script>

<style>
  monte-carlo-laboratory{display:block}.math-stage canvas{cursor:default}
</style>

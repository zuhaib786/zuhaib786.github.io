<dft-laboratory>
  <section class="math-instrument" aria-label="Interactive discrete Fourier transform laboratory">
    <div class="math-bar"><div class="math-state"><i></i><span data-state>Decomposing a signal into pure frequencies</span></div><div class="math-actions"><div class="math-tabs" aria-label="Waveform"><button class="active" data-mode="chord">Chord</button><button data-mode="square">Square</button><button data-mode="saw">Sawtooth</button><button data-mode="noisy">Noisy tone</button></div><div class="math-tabs" aria-label="Window"><button data-win="rect">Rect</button><button class="active" data-win="hamming">Hamming</button><button data-win="blackman">Blackman</button></div></div></div>
    <div class="math-dashboard">
      <div class="math-stage"><span class="math-stage-label label" data-stage-label>signal + reconstruction above · magnitude spectrum below</span><canvas data-canvas aria-label="Signal, reconstruction, and DFT magnitude spectrum"></canvas></div>
      <aside class="math-readout"><p class="label label--accent">Spectral analysis</p><h2 data-title>A prism made of arithmetic</h2><p data-description>The DFT re-expresses N samples as N sinusoids. Keep only the strongest few and you still recognise the waveform — evidence that spectra compress structure. Windows taper the edges so sharp cuts stop smearing energy across every bin.</p><div class="math-formula">Xₖ = Σₙ xₙ·e^(−2πikn∕N)</div>
        <div class="math-metrics"><div><strong data-metric-1>128</strong><small data-metric-1-label>Samples N</small></div><div><strong data-metric-2>—</strong><small data-metric-2-label>Bins kept</small></div><div><strong data-metric-3>—</strong><small data-metric-3-label>Windowed RMS error</small></div></div>
        <div class="math-controls"><div class="math-control"><label><span>Block size N</span><b data-n-value>128</b></label><input data-n type="range" min="64" max="256" step="32" value="128" /></div><div class="math-control"><label><span>Spectrum kept</span><b data-keep-value>8%</b></label><input data-keep type="range" min="2" max="100" step="1" value="8" /></div></div>
        <div class="math-legend"><span><i></i>windowed block</span><span><i></i>reconstruction</span><span><i></i>|Xₖ| kept</span></div><div class="math-trace"><p class="label">Qualitative reading</p><ol><li data-reading-1>Rectangular windows leak when a tone falls between bins.</li><li data-reading-2>Hamming and Blackman trade resolution for lower sidelobes.</li><li data-reading-3>Keeping the strongest bins preserves concentrated spectral energy.</li></ol></div>
      </aside>
    </div>
  </section>
</dft-laboratory>

<script>
  type Mode="chord"|"square"|"saw"|"noisy";type Win="rect"|"hamming"|"blackman";
  const mulberry=(seed:number)=>()=>{seed|=0;seed=seed+0x6d2b79f5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};
  class DftLaboratory extends HTMLElement{
    canvas!:HTMLCanvasElement;ctx!:CanvasRenderingContext2D;width=0;height=0;mode:Mode="chord";win:Win="hamming";N=128;keep=8;resize?:ResizeObserver;theme?:MutationObserver;aborter=new AbortController();
    connectedCallback(){this.canvas=this.querySelector("[data-canvas]") as HTMLCanvasElement;const c=this.canvas.getContext("2d");if(!c)return;this.ctx=c;this.bind();this.resize=new ResizeObserver(()=>this.layout());this.resize.observe(this.canvas);this.theme=new MutationObserver(()=>this.draw());this.theme.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});this.layout();}
    disconnectedCallback(){this.aborter.abort();this.resize?.disconnect();this.theme?.disconnect();}
    bind(){const signal=this.aborter.signal;
      this.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(b=>b.addEventListener("click",()=>{this.mode=b.dataset.mode as Mode;this.querySelectorAll("[data-mode]").forEach(x=>x.classList.toggle("active",x===b));this.draw();},{signal}));
      this.querySelectorAll<HTMLButtonElement>("[data-win]").forEach(b=>b.addEventListener("click",()=>{this.win=b.dataset.win as Win;this.querySelectorAll("[data-win]").forEach(x=>x.classList.toggle("active",x===b));this.draw();},{signal}));
      const range=(q:string,f:(n:number)=>void)=>this.querySelector<HTMLInputElement>(q)?.addEventListener("input",e=>{f(Number((e.currentTarget as HTMLInputElement).value));this.draw();},{signal});
      range("[data-n]",v=>{this.N=v;this.text("[data-n-value]",String(v));});
      range("[data-keep]",v=>{this.keep=v;this.text("[data-keep-value]",v+"%");});}
    signal(){const N=this.N,out=new Array(N),r=mulberry(42);
      for(let n=0;n<N;n++){const t=n/N;
        if(this.mode==="chord")out[n]=Math.sin(2*Math.PI*3*t)+.5*Math.sin(2*Math.PI*7.35*t)+.28*Math.sin(2*Math.PI*13.1*t);
        else if(this.mode==="square")out[n]=Math.sign(Math.sin(2*Math.PI*3*t));
        else if(this.mode==="saw")out[n]=2*((3*t)%1)-1;
        else out[n]=Math.sin(2*Math.PI*5*t)+.45*(r()*2-1);}
      return out;}
    windowAt(n:number){const N=this.N;if(this.win==="rect")return 1;if(this.win==="hamming")return .54-.46*Math.cos(2*Math.PI*n/(N-1));return .42-.5*Math.cos(2*Math.PI*n/(N-1))+.08*Math.cos(4*Math.PI*n/(N-1));}
    analyse(){const N=this.N,x=this.signal(),half=N>>1;
      const xw=x.map((v,n)=>v*this.windowAt(n)),re=new Float64Array(half+1),im=new Float64Array(half+1);
      for(let k=0;k<=half;k++){let sr=0,si=0;for(let n=0;n<N;n++){const a=-2*Math.PI*k*n/N;xw[n]&&(sr+=xw[n]*Math.cos(a),si+=xw[n]*Math.sin(a));}re[k]=sr;im[k]=si;}
      const mag=Array.from({length:half+1},(_,k)=>Math.hypot(re[k],im[k])*(k===0||k===half?1:2)/N);
      const order=mag.map((m,k)=>[m,k] as [number,number]).sort((a,b)=>b[0]-a[0]);
      const keepCount=Math.max(1,Math.round(order.length*this.keep/100));
      const kept=new Set(order.slice(0,keepCount).map(([,k])=>k));
      const rec=new Array(N).fill(re[0]/N);
      for(let n=0;n<N;n++)for(const k of kept){if(!k)continue;const a=2*Math.PI*k*n/N,c=(k===half?1:2)/N;rec[n]+=c*(re[k]*Math.cos(a)-im[k]*Math.sin(a));}
      let se=0,s0=0;for(let n=0;n<N;n++){se+=(xw[n]-rec[n])**2;s0+=xw[n]**2;}
      return{x:xw,rec,mag,kept,err:s0>1e-12?Math.sqrt(se/s0):0};}
    layout(){const rect=this.canvas.getBoundingClientRect();if(!rect.width)return;const d=Math.min(devicePixelRatio||1,2);this.width=rect.width;this.height=rect.height;this.canvas.width=Math.round(rect.width*d);this.canvas.height=Math.round(rect.height*d);this.ctx.setTransform(d,0,0,d,0,0);this.draw();}
    css(v:string){return getComputedStyle(this).getPropertyValue(v);}
    draw(){if(!this.width)return;const c=this.ctx,w=this.width,h=this.height;c.clearRect(0,0,w,h);c.fillStyle=this.css("--paper-sunken");c.fillRect(0,0,w,h);
      const pad=w*.05,tw=w-pad*2,{x,rec,mag,kept,err}=this.analyse(),N=this.N;
      const mid=h*.24,amp=h*.15;
      c.strokeStyle=this.css("--rule");c.beginPath();c.moveTo(pad,mid);c.lineTo(w-pad,mid);c.stroke();
      c.strokeStyle=this.css("--ink-faint");c.lineWidth=1;c.beginPath();
      x.forEach((v,n)=>{const px=pad+n/(N-1)*tw,py=mid-v*amp;n?c.lineTo(px,py):c.moveTo(px,py);});c.stroke();
      c.strokeStyle=this.css("--math-b");c.lineWidth=1.8;c.beginPath();
      rec.forEach((v,n)=>{const px=pad+n/(N-1)*tw,py=mid-Math.max(-1.6,Math.min(1.6,v))*amp;n?c.lineTo(px,py):c.moveTo(px,py);});c.stroke();
      c.strokeStyle=this.css("--rule");c.setLineDash([3,4]);c.lineWidth=1;c.beginPath();
      for(let n=0;n<N;n+=2){const px=pad+n/(N-1)*tw,py=mid-this.windowAt(n)*amp*.9;n?c.lineTo(px,py):c.moveTo(px,py);}c.stroke();c.setLineDash([]);
      c.fillStyle=this.css("--ink-faint");c.font="8px IBM Plex Mono";c.fillText("window taper",w-pad-70,mid-amp*.9);
      const sy=h*.52,sh=h*.34,maxMag=Math.max(...mag,.001),bins=mag.length;
      c.strokeStyle=this.css("--rule");c.beginPath();c.moveTo(pad,sy+sh);c.lineTo(w-pad,sy+sh);c.stroke();
      const bw=tw/bins;
      mag.forEach((m,k)=>{const bh=m/maxMag*sh*.94;c.fillStyle=kept.has(k)?this.css("--math-a"):this.css("--rule");c.fillRect(pad+k*bw,sy+sh-bh,Math.max(1,bw-1.2),bh);});
      c.fillStyle=this.css("--ink-faint");c.font="8px IBM Plex Mono";
      c.fillText("bin 0 (DC)",pad,sy+sh+12);c.fillText(`bin ${bins-1}`,w-pad-40,sy+sh+12);
      this.text("[data-metric-1]",String(N));this.text("[data-metric-2]",`${kept.size}/${bins}`);this.text("[data-metric-3]",(err*100).toFixed(1)+"%");}
    text(q:string,s:string){const e=this.querySelector(q);if(e)e.textContent=s}
  }
  if(!customElements.get("dft-laboratory"))customElements.define("dft-laboratory",DftLaboratory);
</script>

<style>
  dft-laboratory{display:block}.math-stage canvas{cursor:pointer}
</style>

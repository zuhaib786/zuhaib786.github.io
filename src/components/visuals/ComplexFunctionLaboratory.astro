<complex-function-laboratory>
  <section class="math-instrument" aria-label="Interactive complex function atlas">
    <div class="math-bar">
      <div class="math-state"><i></i><span data-state>Drag z through the coloured domain</span></div>
      <div class="math-actions"><div class="math-tabs" aria-label="Complex function"><button class="active" data-mode="square">z²</button><button data-mode="reciprocal">1/z</button><button data-mode="exp">exp z</button><button data-mode="sin">sin z</button><button data-mode="mobius">Möbius</button></div><button class="math-button" data-reset>Reset point</button></div>
    </div>
    <div class="math-dashboard">
      <div class="math-stage"><span class="math-stage-label label">argument → hue · modulus → contour</span><canvas data-canvas aria-label="Domain colouring and mapped complex grid"></canvas></div>
      <aside class="math-readout">
        <p class="label label--accent">Complex function atlas</p><h2 data-title>Angles double at the origin</h2><p data-description>Every nonzero point is mapped by squaring its modulus and doubling its argument. The warped image grid makes the two-to-one covering visible.</p>
        <div class="math-formula" data-formula>f(z) = z²</div>
        <div class="math-metrics"><div><strong data-z>0.65 + 0.40i</strong><small>Input z</small></div><div><strong data-w>0.26 + 0.52i</strong><small>Image f(z)</small></div><div><strong data-derivative>1.526</strong><small>|f′(z)|</small></div></div>
        <div class="math-controls">
          <div class="math-control"><label><span>Domain span</span><b data-span-value>4.0</b></label><input data-span type="range" min="2" max="8" step="0.25" value="4" /></div>
          <div class="math-control"><label><span>Grid density</span><b data-grid-value>9</b></label><input data-grid type="range" min="5" max="17" step="2" value="9" /></div>
          <div class="math-control" data-parameter-control hidden><label><span>Möbius parameter a</span><b data-parameter-value>0.45</b></label><input data-parameter type="range" min="-0.85" max="0.85" step="0.01" value="0.45" /></div>
        </div>
        <div class="math-legend"><span><i></i>positive real direction</span><span><i></i>negative / singular behaviour</span><span><i></i>selected z and f(z)</span></div>
        <div class="math-trace"><p class="label">Local geometry</p><ol><li data-analytic>Analytic away from the critical point z = 0.</li><li data-local>Locally scales lengths by |f′(z)|.</li><li data-angle>Angles are preserved wherever f′(z) ≠ 0.</li></ol></div>
      </aside>
    </div>
  </section>
</complex-function-laboratory>

<script>
  type Mode="square"|"reciprocal"|"exp"|"sin"|"mobius";type C={r:number;i:number};
  const INFO:Record<Mode,[string,string,string,string]>={
    square:["Angles double at the origin","Every nonzero point is mapped by squaring its modulus and doubling its argument. The warped image grid makes the two-to-one covering visible.","f(z) = z²","Analytic everywhere; critical at z = 0."],
    reciprocal:["The plane turns inside out","Reciprocal inversion sends circles and lines to circles and lines, swaps zero with infinity, and reverses radial scale.","f(z) = 1 / z","A simple pole at z = 0; analytic elsewhere."],
    exp:["Strips wrap around zero","The exponential turns horizontal translation into radial scaling and vertical translation into rotation. One strip of height 2π covers the punctured plane.","f(z) = eᶻ","Entire, periodic by 2πi, and never equal to zero."],
    sin:["Oscillation leaves the real line","Complex sine combines rotation and exponential growth. Its zeros stay on the real axis while magnitude grows rapidly in imaginary directions.","f(z) = sin z","Entire; critical where cos z = 0."],
    mobius:["Circles remain circles","A fractional linear transformation moves the unit disk while preserving generalized circles and every oriented angle.","f(z) = (z − a) / (1 − az)","Analytic away from its single pole; conformal wherever finite."],
  };
  class ComplexFunctionLaboratory extends HTMLElement{
    canvas!:HTMLCanvasElement;ctx!:CanvasRenderingContext2D;width=0;height=0;mode:Mode="square";span=4;density=9;a=.45;z:C={r:.65,i:.4};dragging=false;resize?:ResizeObserver;theme?:MutationObserver;aborter=new AbortController();pending=0;
    connectedCallback(){this.canvas=this.querySelector("[data-canvas]") as HTMLCanvasElement;const c=this.canvas.getContext("2d");if(!c)return;this.ctx=c;this.bind();this.resize=new ResizeObserver(()=>this.layout());this.resize.observe(this.canvas);this.theme=new MutationObserver(()=>this.schedule());this.theme.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});this.configure();this.layout();}
    disconnectedCallback(){this.aborter.abort();this.resize?.disconnect();this.theme?.disconnect();cancelAnimationFrame(this.pending);}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(b=>b.addEventListener("click",()=>{this.mode=b.dataset.mode as Mode;this.querySelectorAll("[data-mode]").forEach(x=>x.classList.toggle("active",x===b));this.configure();this.schedule();},{signal}));this.querySelector("[data-reset]")?.addEventListener("click",()=>{this.z={r:.65,i:.4};this.span=4;this.setInput("[data-span]",4);this.text("[data-span-value]","4.0");this.schedule();},{signal});
      const range=(q:string,f:(n:number)=>void)=>this.querySelector<HTMLInputElement>(q)?.addEventListener("input",e=>{f(Number((e.currentTarget as HTMLInputElement).value));this.schedule();},{signal});range("[data-span]",v=>{this.span=v;this.text("[data-span-value]",v.toFixed(1));});range("[data-grid]",v=>{this.density=v;this.text("[data-grid-value]",String(v));});range("[data-parameter]",v=>{this.a=v;this.text("[data-parameter-value]",v.toFixed(2));});
      this.canvas.addEventListener("pointerdown",e=>{if(this.select(e)){this.dragging=true;this.canvas.setPointerCapture(e.pointerId);}},{signal});this.canvas.addEventListener("pointermove",e=>{if(this.dragging)this.select(e);},{signal});const up=(e:PointerEvent)=>{this.dragging=false;if(this.canvas.hasPointerCapture(e.pointerId))this.canvas.releasePointerCapture(e.pointerId);};this.canvas.addEventListener("pointerup",up,{signal});this.canvas.addEventListener("pointercancel",up,{signal});}
    configure(){const i=INFO[this.mode];this.text("[data-title]",i[0]);this.text("[data-description]",i[1]);this.text("[data-formula]",i[2]);this.text("[data-analytic]",i[3]);const p=this.querySelector<HTMLElement>("[data-parameter-control]");if(p)p.hidden=this.mode!=="mobius";}
    select(e:PointerEvent){const r=this.canvas.getBoundingClientRect(),gap=10,pw=(this.width-gap)/2,x=e.clientX-r.left,y=e.clientY-r.top;if(x>pw)return false;this.z={r:(x/pw-.5)*this.span,i:(.5-y/this.height)*this.span*this.height/pw};this.schedule();return true;}
    schedule(){cancelAnimationFrame(this.pending);this.pending=requestAnimationFrame(()=>this.render());}
    layout(){const r=this.canvas.getBoundingClientRect();if(!r.width)return;const d=Math.min(devicePixelRatio||1,2);this.width=r.width;this.height=r.height;this.canvas.width=Math.round(r.width*d);this.canvas.height=Math.round(r.height*d);this.ctx.setTransform(d,0,0,d,0,0);this.schedule();}
    render(){const c=this.ctx,w=this.width,h=this.height,gap=10,pw=(w-gap)/2;c.clearRect(0,0,w,h);this.domainRaster(0,0,pw,h);c.fillStyle=getComputedStyle(this).getPropertyValue("--paper-sunken");c.fillRect(pw+gap,0,pw,h);this.drawAxes(pw+gap,pw,h);this.drawMappedGrid(pw+gap,pw,h);this.drawSelection(0,pw,h);this.updateReadout();const tagY=h-38;this.tag(c,pw-78,tagY,"z-PLANE");this.tag(c,pw+gap+8,tagY,"w = f(z)");}
    domainRaster(x:number,y:number,w:number,h:number){const rw=Math.max(120,Math.floor(w*.7)),rh=Math.max(120,Math.floor(h*.7)),off=document.createElement("canvas");off.width=rw;off.height=rh;const oc=off.getContext("2d")!,im=oc.createImageData(rw,rh),d=im.data,dark=document.documentElement.dataset.theme==="dark";for(let py=0;py<rh;py++)for(let px=0;px<rw;px++){const z={r:(px/(rw-1)-.5)*this.span,i:(.5-py/(rh-1))*this.span*h/w},v=this.f(z),arg=(Math.atan2(v.i,v.r)+Math.PI)/(2*Math.PI),log=Math.log(Math.hypot(v.r,v.i)+1e-8),ring=.72+.18*Math.cos(log*2*Math.PI),rgb=this.hsv(arg*360,dark ? .72 : .68,(dark ? .82 : .72)*ring),k=(py*rw+px)*4;d[k]=rgb[0];d[k+1]=rgb[1];d[k+2]=rgb[2];d[k+3]=255;}oc.putImageData(im,0,0);this.ctx.drawImage(off,x,y,w,h);}
    imageSpan(){if(this.mode==="exp"||this.mode==="sin")return 8;if(this.mode==="reciprocal")return 5;return Math.max(3.2,this.span*1.15);}
    imagePoint(v:C,offset:number,w:number,h:number){const s=this.imageSpan();return{x:offset+w/2+v.r/s*w,y:h/2-v.i/s*w};}
    drawAxes(offset:number,w:number,h:number){const c=this.ctx,p0=this.imagePoint({r:0,i:0},offset,w,h);c.strokeStyle=getComputedStyle(this).getPropertyValue("--rule-strong");c.lineWidth=1;c.beginPath();c.moveTo(offset,p0.y);c.lineTo(offset+w,p0.y);c.moveTo(p0.x,0);c.lineTo(p0.x,h);c.stroke();}
    drawMappedGrid(offset:number,w:number,h:number){const c=this.ctx,n=this.density,min=-this.span/2,max=this.span/2,steps=100;for(let family=0;family<2;family++){c.strokeStyle=family?"rgba(200,64,26,.52)":"rgba(75,63,214,.52)";if(document.documentElement.dataset.theme==="dark")c.strokeStyle=family?"rgba(255,139,89,.6)":"rgba(111,214,255,.55)";c.lineWidth=.75;for(let k=0;k<n;k++){const fixed=min+k/(n-1)*(max-min);c.beginPath();let prior:any=null;for(let j=0;j<=steps;j++){const vary=min+j/steps*(max-min),z=family?{r:vary,i:fixed}:{r:fixed,i:vary},v=this.f(z),p=this.imagePoint(v,offset,w,h),finite=Number.isFinite(p.x)&&Number.isFinite(p.y),near=prior&&Math.hypot(p.x-prior.x,p.y-prior.y)<w*.22;if(!finite||p.x<offset-w||p.x>offset+2*w||p.y<-h||p.y>2*h){prior=null;continue;}if(prior&&near)c.lineTo(p.x,p.y);else c.moveTo(p.x,p.y);prior=p;}c.stroke();}}}
    drawSelection(offset:number,w:number,h:number){const c=this.ctx,x=offset+w/2+this.z.r/this.span*w,y=h/2-this.z.i/this.span*w,out=this.imagePoint(this.f(this.z),w+10,w,h);c.strokeStyle="#fff";c.lineWidth=1.5;for(const p of [{x,y},out]){c.beginPath();c.arc(p.x,p.y,7,0,2*Math.PI);c.stroke();c.beginPath();c.moveTo(p.x-10,p.y);c.lineTo(p.x+10,p.y);c.moveTo(p.x,p.y-10);c.lineTo(p.x,p.y+10);c.stroke();}}
    tag(c:CanvasRenderingContext2D,x:number,y:number,s:string){c.fillStyle="rgba(7,12,28,.78)";c.beginPath();c.roundRect(x,y,70,22,4);c.fill();c.fillStyle="#fff";c.font="600 8px IBM Plex Mono";c.fillText(s,x+8,y+14);}
    updateReadout(){const w=this.f(this.z),der=this.df(this.z),mag=this.abs(der);this.text("[data-z]",this.complex(this.z));this.text("[data-w]",this.complex(w));this.text("[data-derivative]",Number.isFinite(mag)?mag.toFixed(3):"∞");this.text("[data-local]",`Locally scales lengths by ${Number.isFinite(mag)?mag.toFixed(3):"an unbounded factor"}.`);this.text("[data-angle]",mag<1e-6?"The derivative vanishes here, so local angle preservation breaks.":"Angles are preserved at this point because f′(z) ≠ 0.");}
    f(z:C):C{if(this.mode==="square")return this.mul(z,z);if(this.mode==="reciprocal")return this.div({r:1,i:0},z);if(this.mode==="exp"){const e=Math.exp(z.r);return{r:e*Math.cos(z.i),i:e*Math.sin(z.i)}}if(this.mode==="sin")return{r:Math.sin(z.r)*Math.cosh(z.i),i:Math.cos(z.r)*Math.sinh(z.i)};return this.div({r:z.r-this.a,i:z.i},{r:1-this.a*z.r,i:-this.a*z.i});}
    df(z:C):C{if(this.mode==="square")return{r:2*z.r,i:2*z.i};if(this.mode==="reciprocal"){const q=this.div({r:-1,i:0},this.mul(z,z));return q;}if(this.mode==="exp")return this.f(z);if(this.mode==="sin")return{r:Math.cos(z.r)*Math.cosh(z.i),i:-Math.sin(z.r)*Math.sinh(z.i)};return this.div({r:1-this.a*this.a,i:0},this.mul({r:1-this.a*z.r,i:-this.a*z.i},{r:1-this.a*z.r,i:-this.a*z.i}));}
    mul(a:C,b:C):C{return{r:a.r*b.r-a.i*b.i,i:a.r*b.i+a.i*b.r}}div(a:C,b:C):C{const d=b.r*b.r+b.i*b.i;return d<1e-14?{r:Infinity,i:Infinity}:{r:(a.r*b.r+a.i*b.i)/d,i:(a.i*b.r-a.r*b.i)/d}}abs(z:C){return Math.hypot(z.r,z.i)}complex(z:C){if(!Number.isFinite(z.r)||!Number.isFinite(z.i))return"∞";return`${z.r.toFixed(2)} ${z.i<0?"−":"+"} ${Math.abs(z.i).toFixed(2)}i`}hsv(h:number,s:number,v:number):[number,number,number]{const q=v*s,x=q*(1-Math.abs(h/60%2-1)),m=v-q;let a=[0,0,0];if(h<60)a=[q,x,0];else if(h<120)a=[x,q,0];else if(h<180)a=[0,q,x];else if(h<240)a=[0,x,q];else if(h<300)a=[x,0,q];else a=[q,0,x];return a.map(n=>Math.round((n+m)*255)) as [number,number,number]}text(q:string,s:string){const e=this.querySelector(q);if(e)e.textContent=s}setInput(q:string,n:number){const e=this.querySelector<HTMLInputElement>(q);if(e)e.value=String(n)}
  }
  if(!customElements.get("complex-function-laboratory"))customElements.define("complex-function-laboratory",ComplexFunctionLaboratory);
</script>

<style>
  complex-function-laboratory{display:block}.math-stage{display:grid;grid-template-rows:auto minmax(0,1fr)}.math-stage-label{position:static;display:flex;min-height:2.5rem;align-items:center;padding:.65rem .9rem;overflow:hidden;border-bottom:1px solid var(--glass-border);background:color-mix(in srgb,var(--glass) 72%,transparent);text-overflow:ellipsis;white-space:nowrap}.math-stage canvas{height:100%;min-height:35.5rem;cursor:crosshair}.math-readout [hidden]{display:none}@media(max-width:44rem){.math-stage canvas{min-height:27.5rem}}
</style>

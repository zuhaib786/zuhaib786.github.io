<hamiltonian-laboratory>
  <section class="math-instrument" aria-label="Interactive Hamiltonian mechanics laboratory">
    <div class="math-bar"><div class="math-state"><i></i><span data-state>Hamiltonian flow · nearby trajectories</span></div><div class="math-actions"><div class="math-tabs" aria-label="Hamiltonian system"><button class="active" data-mode="pendulum">Pendulum</button><button data-mode="double">Double pendulum</button><button data-mode="henon">Hénon–Heiles</button></div><button class="math-button" data-play>Pause</button><button class="math-button" data-reset>Reset</button></div></div>
    <div class="math-dashboard">
      <div class="math-stage physics-stage"><span class="math-stage-label label">configuration · phase portrait · invariant drift · Poincaré section</span><canvas data-canvas aria-label="Hamiltonian motion, phase space, and chaos diagnostics"></canvas></div>
      <aside class="math-readout"><p class="label label--accent">Hamiltonian mechanics</p><h2 data-title>Energy foliates phase space</h2><p data-description>The pendulum moves on level sets of its Hamiltonian. Below the separatrix it librates; above it rotates.</p><div class="math-formula" data-formula>q̇ = ∂H/∂p · ṗ = −∂H/∂q</div>
        <div class="math-metrics"><div><strong data-h>0.0000</strong><small>Hamiltonian H</small></div><div><strong data-drift>0.00e+0</strong><small>Relative energy drift</small></div><div><strong data-lyapunov>0.000</strong><small>Finite-time λ</small></div></div>
        <div class="math-controls"><div class="math-control"><label><span>Integrator</span><b data-integrator-value>RK4</b></label><select data-integrator><option value="rk4">Runge–Kutta 4</option><option value="euler">Explicit Euler</option></select></div><div class="math-control"><label><span>Time step Δt</span><b data-dt-value>0.012</b></label><input data-dt type="range" min="0.003" max="0.035" step="0.001" value="0.012" /></div><div class="math-control"><label><span>Initial energy / amplitude</span><b data-level-value>0.55</b></label><input data-level type="range" min="0.05" max="0.95" step="0.01" value="0.55" /></div><div class="math-control"><label><span>log₁₀ initial separation</span><b data-delta-value>−5</b></label><input data-delta type="range" min="-7" max="-2" step="1" value="-5" /></div></div>
        <div class="math-legend"><span><i></i>reference trajectory</span><span><i></i>nearby trajectory</span><span><i></i>section crossings</span></div><div class="math-trace"><p class="label">Phase-space reading</p><ol><li data-reading-1>Closed curves are periodic librations; open curves are rotations.</li><li data-reading-2>Hamiltonian flow preserves phase-space area.</li><li data-reading-3>Click the phase portrait to choose a new state.</li></ol></div>
      </aside>
    </div>
  </section>
</hamiltonian-laboratory>

<script>
  type Mode="pendulum"|"double"|"henon";type State=number[];
  const HAM_INFO:Record<Mode,[string,string,string,string]>={pendulum:["Energy foliates phase space","The pendulum moves on level sets of its Hamiltonian. Below the separatrix it librates; above it rotates.","H(θ,p) = ½p² + 1 − cos θ","Closed curves are librations; open curves are rotations."],double:["One hinge opens a route to chaos","Two coupled angles exchange energy. A nearby double pendulum begins almost identically and then loses phase agreement.","H = T(θ₁,θ₂,p₁,p₂) + V(θ₁,θ₂)","Projection hides dimensions, but separation reveals sensitivity."],henon:["Invariant curves fracture into islands","The Hénon–Heiles potential is integrable at low energy and increasingly chaotic near its escape threshold H = 1/6.","H = ½(pₓ²+pᵧ²+x²+y²) + x²y − y³/3","A Poincaré section converts a four-dimensional flow into points."]};
  class HamiltonianLaboratory extends HTMLElement{
    canvas!:HTMLCanvasElement;ctx!:CanvasRenderingContext2D;width=0;height=0;mode:Mode="pendulum";state:State=[];shadow:State=[];integrator="rk4";dt=.012;level=.55;logDelta=-5;playing=true;frame=0;last=0;time=0;initialH=0;phasePath:{q:number;p:number}[]=[];shadowPath:{q:number;p:number}[]=[];driftHistory:number[]=[];section:{q:number;p:number}[]=[];prevSection=0;resize?:ResizeObserver;theme?:MutationObserver;aborter=new AbortController();
    connectedCallback(){this.canvas=this.querySelector("[data-canvas]") as HTMLCanvasElement;const c=this.canvas.getContext("2d");if(!c)return;this.ctx=c;this.bind();this.resize=new ResizeObserver(()=>this.layout());this.resize.observe(this.canvas);this.theme=new MutationObserver(()=>this.draw());this.theme.observe(document.documentElement,{attributes:true,attributeFilter:["data-theme"]});this.reset();this.layout();this.frame=requestAnimationFrame(t=>this.animate(t));}
    disconnectedCallback(){cancelAnimationFrame(this.frame);this.aborter.abort();this.resize?.disconnect();this.theme?.disconnect();}
    bind(){const signal=this.aborter.signal;this.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach(b=>b.addEventListener("click",()=>{this.mode=b.dataset.mode as Mode;this.querySelectorAll("[data-mode]").forEach(x=>x.classList.toggle("active",x===b));this.configure();this.reset();},{signal}));this.querySelector("[data-play]")?.addEventListener("click",()=>{this.playing=!this.playing;const b=this.querySelector<HTMLButtonElement>("[data-play]");if(b)b.textContent=this.playing?"Pause":"Run";this.text("[data-state]",this.playing?"Hamiltonian flow · nearby trajectories":"Paused · choose a phase-space point");},{signal});this.querySelector("[data-reset]")?.addEventListener("click",()=>this.reset(),{signal});this.querySelector<HTMLSelectElement>("[data-integrator]")?.addEventListener("change",e=>{this.integrator=(e.currentTarget as HTMLSelectElement).value;this.text("[data-integrator-value]",this.integrator==="rk4"?"RK4":"Euler");this.reset();},{signal});this.range("[data-dt]",v=>{this.dt=v;this.text("[data-dt-value]",v.toFixed(3));this.reset();});this.range("[data-level]",v=>{this.level=v;this.text("[data-level-value]",v.toFixed(2));this.reset();});this.range("[data-delta]",v=>{this.logDelta=v;this.text("[data-delta-value]",`${v<0?"−":""}${Math.abs(v)}`);this.reset();});this.canvas.addEventListener("pointerdown",e=>this.choosePhase(e),{signal});}
    range(q:string,fn:(v:number)=>void){this.querySelector<HTMLInputElement>(q)?.addEventListener("input",e=>fn(Number((e.currentTarget as HTMLInputElement).value)),{signal:this.aborter.signal});}
    configure(){const i=HAM_INFO[this.mode];this.text("[data-title]",i[0]);this.text("[data-description]",i[1]);this.text("[data-formula]",i[2]);this.text("[data-reading-1]",i[3]);this.text("[data-reading-2]",this.mode==="henon"?"Regular motion draws invariant curves; chaotic motion fills areas.":"Hamiltonian flow preserves phase-space area even when trajectories stretch.");}
    reset(){if(this.mode==="pendulum")this.state=[.35+2.7*this.level,0];else if(this.mode==="double")this.state=[.55+1.7*this.level,-.35,0,0];else{const target=.035+.125*this.level,x=.02,y=.08,px=.12,u=.5*(x*x+y*y)+x*x*y-y*y*y/3,py=Math.sqrt(Math.max(.001,2*(target-u)-px*px));this.state=[x,y,px,py];}const d=10**this.logDelta;this.shadow=[...this.state];this.shadow[0]+=d;this.time=0;this.phasePath=[];this.shadowPath=[];this.driftHistory=[];this.section=[];this.prevSection=this.sectionCoordinate(this.state);this.initialH=this.energy(this.state);this.record();this.updateMetrics();this.draw();}
    deriv(s:State):State{if(this.mode==="pendulum")return[s[1],-Math.sin(s[0])];if(this.mode==="henon"){const [x,y,px,py]=s;return[px,py,-x-2*x*y,-y-x*x+y*y];}const [a,b,w1,w2]=s,d=b-a,sd=Math.sin(d),cd=Math.cos(d),den=2-cd*cd,a1=(w1*w1*sd*cd+Math.sin(b)*cd+w2*w2*sd-2*Math.sin(a))/den,a2=(-w2*w2*sd*cd+2*(Math.sin(a)*cd-w1*w1*sd-Math.sin(b)))/den;return[w1,w2,a1,a2];}
    advance(s:State){const h=this.dt;if(this.integrator==="euler"){const k=this.deriv(s);return s.map((x,i)=>x+h*k[i]);}const k1=this.deriv(s),k2=this.deriv(s.map((x,i)=>x+h*k1[i]/2)),k3=this.deriv(s.map((x,i)=>x+h*k2[i]/2)),k4=this.deriv(s.map((x,i)=>x+h*k3[i]));return s.map((x,i)=>x+h*(k1[i]+2*k2[i]+2*k3[i]+k4[i])/6);}
    step(){const prior=this.sectionCoordinate(this.state);this.state=this.advance(this.state);this.shadow=this.advance(this.shadow);this.time+=this.dt;const now=this.sectionCoordinate(this.state);if(prior<0&&now>=0){const p=this.phasePoint(this.state);this.section.push(p);if(this.section.length>700)this.section.shift();}if(this.phasePath.length%3===0||this.phasePath.length<2)this.record();else if(Math.floor(this.time/this.dt)%3===0)this.record();if(Math.floor(this.time/this.dt)%18===0){const drift=Math.abs((this.energy(this.state)-this.initialH)/(Math.abs(this.initialH)||1));this.driftHistory.push(drift);if(this.driftHistory.length>180)this.driftHistory.shift();}}
    record(){this.phasePath.push(this.phasePoint(this.state));this.shadowPath.push(this.phasePoint(this.shadow));if(this.phasePath.length>1100)this.phasePath.shift();if(this.shadowPath.length>1100)this.shadowPath.shift();}
    phasePoint(s:State){return this.mode==="pendulum"?{q:this.wrap(s[0]),p:s[1]}:this.mode==="double"?{q:this.wrap(s[0]),p:s[2]}:{q:s[0],p:s[2]}}
    sectionCoordinate(s:State){return this.mode==="pendulum"?Math.sin(s[0]):this.mode==="double"?Math.sin(s[1]):s[1]}
    energy(s:State){if(this.mode==="pendulum")return.5*s[1]*s[1]+1-Math.cos(s[0]);if(this.mode==="henon"){const[x,y,px,py]=s;return.5*(px*px+py*py+x*x+y*y)+x*x*y-y*y*y/3;}const[a,b,w1,w2]=s;return w1*w1+.5*w2*w2+w1*w2*Math.cos(a-b)-2*Math.cos(a)-Math.cos(b)+3;}
    separation(){let sum=0;for(let i=0;i<this.state.length;i++){let d=this.shadow[i]-this.state[i];if((this.mode==="pendulum"||this.mode==="double")&&i<2)d=this.wrap(d);sum+=d*d;}return Math.sqrt(sum)}
    updateMetrics(){const h=this.energy(this.state),drift=Math.abs((h-this.initialH)/(Math.abs(this.initialH)||1)),delta0=10**this.logDelta,sep=this.separation(),lambda=this.time>.05?Math.log(Math.max(sep,1e-14)/delta0)/this.time:0;this.text("[data-h]",h.toFixed(5));this.text("[data-drift]",drift.toExponential(2));this.text("[data-lyapunov]",lambda.toFixed(3));this.text("[data-reading-3]",`${this.section.length} section crossings recorded · click phase space to reset.`);}
    choosePhase(e:PointerEvent){const r=this.canvas.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top,top=this.height*.72,split=this.width*.43;if(x<split||y>top)return;const bounds=this.bounds(),q=bounds.q0+(x-split)/(this.width-split)*(bounds.q1-bounds.q0),p=bounds.p1-y/top*(bounds.p1-bounds.p0);if(this.mode==="pendulum")this.state=[q,p];else if(this.mode==="double")this.state=[q,this.state[1],p,this.state[3]];else this.state=[q,this.state[1],p,this.state[3]];const d=10**this.logDelta;this.shadow=[...this.state];this.shadow[0]+=d;this.initialH=this.energy(this.state);this.time=0;this.phasePath=[];this.shadowPath=[];this.section=[];this.driftHistory=[];this.record();this.draw();}
    bounds(){return this.mode==="henon"?{q0:-.55,q1:.55,p0:-.55,p1:.55}:{q0:-Math.PI,q1:Math.PI,p0:-3.2,p1:3.2}}
    wrap(x:number){return((x+Math.PI)%(2*Math.PI)+2*Math.PI)%(2*Math.PI)-Math.PI}
    animate(t:number){if(this.playing&&t-this.last>16){this.last=t;for(let k=0;k<4;k++)this.step();this.updateMetrics();this.draw();}this.frame=requestAnimationFrame(x=>this.animate(x));}
    layout(){const r=this.canvas.getBoundingClientRect();if(!r.width)return;const d=Math.min(devicePixelRatio||1,2);this.width=r.width;this.height=r.height;this.canvas.width=Math.round(r.width*d);this.canvas.height=Math.round(r.height*d);this.ctx.setTransform(d,0,0,d,0,0);this.draw();}
    draw(){if(!this.width)return;const c=this.ctx;c.fillStyle=this.css("--paper-sunken");c.fillRect(0,0,this.width,this.height);const top=this.height*.72,split=this.width*.43;c.strokeStyle=this.css("--rule");c.beginPath();c.moveTo(split,0);c.lineTo(split,top);c.moveTo(0,top);c.lineTo(this.width,top);c.stroke();this.drawConfiguration(0,0,split,top);this.drawPhase(split,0,this.width-split,top);this.drawDiagnostics(0,top,this.width,this.height-top);}
    drawConfiguration(x:number,y:number,w:number,h:number){const c=this.ctx;if(this.mode==="pendulum"||this.mode==="double"){const scale=Math.min(w,h)*.27,ox=x+w/2,oy=y+h*.35,a=this.state[0],p1={x:ox+Math.sin(a)*scale,y:oy+Math.cos(a)*scale};c.strokeStyle=this.css("--ink-soft");c.lineWidth=2;c.beginPath();c.moveTo(ox,oy);c.lineTo(p1.x,p1.y);if(this.mode==="double"){const b=this.state[1],p2={x:p1.x+Math.sin(b)*scale,y:p1.y+Math.cos(b)*scale};c.lineTo(p2.x,p2.y);c.stroke();this.mass(p2.x,p2.y,this.css("--math-b"),8);}else c.stroke();this.mass(p1.x,p1.y,this.css("--math-a"),9);const sa=this.shadow[0],sp1={x:ox+Math.sin(sa)*scale,y:oy+Math.cos(sa)*scale};c.strokeStyle=this.css("--math-b");c.globalAlpha=.55;c.beginPath();c.moveTo(ox,oy);c.lineTo(sp1.x,sp1.y);c.stroke();c.globalAlpha=1;c.fillStyle=this.css("--ink");c.beginPath();c.arc(ox,oy,4,0,Math.PI*2);c.fill();}else{const to=(qx:number,qy:number)=>({x:x+w/2+qx*w*.72,y:y+h/2-qy*w*.72});for(let iy=0;iy<20;iy++){c.strokeStyle=`rgba(120,140,190,${.08+iy*.008})`;c.beginPath();const radius=.04+iy*.027;for(let n=0;n<=100;n++){const a=n/100*Math.PI*2,q=to(radius*Math.cos(a),radius*Math.sin(a));n?c.lineTo(q.x,q.y):c.moveTo(q.x,q.y);}c.stroke();}const p=to(this.state[0],this.state[1]),s=to(this.shadow[0],this.shadow[1]);this.mass(p.x,p.y,this.css("--math-a"),7);this.mass(s.x,s.y,this.css("--math-b"),4);}}
    mass(x:number,y:number,color:string,r:number){const c=this.ctx;c.fillStyle=color;c.shadowColor=color;c.shadowBlur=12;c.beginPath();c.arc(x,y,r,0,Math.PI*2);c.fill();c.shadowBlur=0;}
    drawPhase(x:number,y:number,w:number,h:number){const c=this.ctx,b=this.bounds(),to=(p:{q:number;p:number})=>({x:x+(p.q-b.q0)/(b.q1-b.q0)*w,y:y+h-(p.p-b.p0)/(b.p1-b.p0)*h});c.strokeStyle=this.css("--rule");for(let k=1;k<6;k++){c.beginPath();c.moveTo(x+k*w/6,y);c.lineTo(x+k*w/6,y+h);c.moveTo(x,y+k*h/6);c.lineTo(x+w,y+k*h/6);c.stroke();}for(const [path,color,alpha] of [[this.phasePath,this.css("--math-a"),.9],[this.shadowPath,this.css("--math-b"),.55]] as [{q:number;p:number}[],string,number][]){c.strokeStyle=color;c.globalAlpha=alpha;c.lineWidth=1.2;c.beginPath();path.forEach((p,n)=>{const q=to(p);n?c.lineTo(q.x,q.y):c.moveTo(q.x,q.y);});c.stroke();}c.globalAlpha=1;const p=to(this.phasePoint(this.state));this.mass(p.x,p.y,this.css("--math-good"),4);}
    drawDiagnostics(x:number,y:number,w:number,h:number){const c=this.ctx,pad=22,leftW=w*.48,top=y+15,ch=h-30;c.strokeStyle=this.css("--rule");c.strokeRect(pad,top,leftW-pad*1.5,ch);c.strokeRect(leftW+pad*.5,top,w-leftW-pad*1.5,ch);if(this.driftHistory.length>1){const max=Math.max(...this.driftHistory,1e-10),min=1e-12;c.strokeStyle=this.css("--math-a");c.beginPath();this.driftHistory.forEach((v,n)=>{const px=pad+n/(this.driftHistory.length-1)*(leftW-pad*1.5),py=top+ch-(Math.log10(Math.max(v,min))-Math.log10(min))/(Math.log10(max)-Math.log10(min)||1)*ch;n?c.lineTo(px,py):c.moveTo(px,py);});c.stroke();}const b=this.bounds();c.fillStyle=this.css("--math-good");this.section.forEach(p=>{const px=leftW+pad*.5+(p.q-b.q0)/(b.q1-b.q0)*(w-leftW-pad*1.5),py=top+ch-(p.p-b.p0)/(b.p1-b.p0)*ch;c.fillRect(px,py,1.6,1.6);});c.fillStyle=this.css("--ink-faint");c.font="8px IBM Plex Mono";c.fillText("energy drift",pad+5,top+11);c.fillText("Poincaré crossings",leftW+pad*.5+5,top+11);}
    css(n:string){return getComputedStyle(this).getPropertyValue(n).trim()}text(q:string,v:string){const e=this.querySelector(q);if(e)e.textContent=v}
  }
  if(!customElements.get("hamiltonian-laboratory"))customElements.define("hamiltonian-laboratory",HamiltonianLaboratory);
</script>

<style>hamiltonian-laboratory{display:block}.math-stage canvas{cursor:crosshair}</style>

---
interface Props {
  href: string;
  number: string;
  title: string;
  description?: string;
  date: Date;
  eyebrow?: string;
}

const { href, title, description, date, eyebrow } = Astro.props;

const formatted = date.toLocaleDateString("en-GB", {
  day: "2-digit",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
---

<article class="entry">
  <a href={href} class="entry-line">
    <span class="entry-title">
      {eyebrow && <small>{eyebrow}</small>}
      {title}
    </span>
    <time datetime={date.toISOString()}>{formatted}</time>
  </a>
  {description && <p>{description}</p>}
</article>

<style>
  .entry {
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .entry-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    color: inherit;
    text-decoration: none;
  }

  .entry-title {
    flex: 0 1 auto;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .entry-title small {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  time {
    flex: 0 0 auto;
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .entry p {
    max-width: 66ch;
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    line-height: 1.75;
  }

  .entry:hover .entry-title,
  .entry:focus-within .entry-title {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .entry-line {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    time {
      grid-column: 1;
    }

    .entry p {
      margin-left: 0;
    }
  }
</style>

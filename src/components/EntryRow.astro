---
interface Props {
  href: string;
  number: string;
  title: string;
  description?: string;
  date: Date;
  eyebrow?: string;
}

const { href, number, title, description, date, eyebrow } = Astro.props;

const formatted = date.toLocaleDateString("en-GB", {
  day: "2-digit",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
---

<article class="entry">
  <a href={href} class="entry-line">
    <span class="entry-number">{number}</span>
    <span class="entry-title">
      {eyebrow && <small>{eyebrow}</small>}
      {title}
    </span>
    <span class="entry-leader" aria-hidden="true"></span>
    <time datetime={date.toISOString()}>{formatted}</time>
  </a>
  {description && <p>{description}</p>}
</article>

<style>
  .entry {
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .entry-line {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    color: inherit;
    text-decoration: none;
  }

  .entry-number {
    flex: 0 0 2rem;
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 0.82rem;
    font-variant-numeric: oldstyle-nums tabular-nums;
  }

  .entry-title {
    flex: 0 1 auto;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.14rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .entry-title small {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .entry-leader {
    flex: 1 1 auto;
    min-width: 1.25rem;
    border-bottom: 1px dotted var(--rule-strong);
    transform: translateY(-0.24em);
  }

  time {
    flex: 0 0 auto;
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .entry p {
    max-width: 66ch;
    margin: 0.35rem 0 0 2.6rem;
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .entry:hover .entry-title,
  .entry:focus-within .entry-title {
    color: var(--accent);
  }

  .entry:hover .entry-leader,
  .entry:focus-within .entry-leader {
    border-bottom-color: var(--accent);
  }

  @media (max-width: 560px) {
    .entry-line {
      display: grid;
      grid-template-columns: 2rem 1fr;
    }

    .entry-leader {
      display: none;
    }

    time {
      grid-column: 2;
    }

    .entry p {
      margin-left: 2.6rem;
    }
  }
</style>

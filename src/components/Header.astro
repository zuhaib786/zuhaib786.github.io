---
const nav = [
  { href: "/blog", label: "Writing" },
  { href: "/series", label: "Series" },
  { href: "/notes", label: "Notes" },
  { href: "/visuals", label: "Visuals" },
  { href: "/projects", label: "Projects" },
  { href: "/resume", label: "Résumé" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const visualPrefixes = [
  "/earthquakes",
  "/algorithms",
  "/systems",
  "/distributed",
  "/databases",
  "/runtime",
  "/networking",
  "/ml",
  "/gpu",
  "/reliability",
  "/mathematics",
  "/physics",
];
const isActive = (href: string) =>
  path.startsWith(href) ||
  (href === "/visuals" &&
    visualPrefixes.some((prefix) => path.startsWith(prefix)));
---

<header class="site-header">
  <a href="/" class="wordmark" aria-label="Zuhaib Ul Zamann — home">
    <span class="mark" aria-hidden="true">Z<sup>2</sup></span>
    <span class="name">Zuhaib Ul Zamann</span>
  </a>

  <nav aria-label="Primary navigation">
    {
      nav.map((item) => (
        <a
          href={item.href}
          class:list={["nav-link", { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <button
    id="theme-toggle"
    class="theme-toggle"
    type="button"
    aria-label="Toggle color theme"
    aria-pressed="false"
  >
    <span aria-hidden="true">◐</span>
  </button>
</header>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    if (!target.closest?.("#theme-toggle")) return;

    const next =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 4.25rem;
    padding: 0 clamp(1rem, 4vw, 4rem);
    border-bottom: 1px solid color-mix(in srgb, var(--rule), transparent 20%);
    background: color-mix(in srgb, var(--paper), transparent 5%);
    backdrop-filter: blur(16px);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    width: max-content;
    color: var(--ink);
    text-decoration: none;
  }

  .mark {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--accent-2);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-style: italic;
    line-height: 1;
    transition: transform 180ms var(--ease-out);
  }

  .mark sup {
    margin-left: 0.03em;
    font-size: 0.52em;
    font-style: normal;
    vertical-align: 0.55em;
  }

  .wordmark:hover .mark {
    transform: rotate(-6deg);
  }

  .name {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    white-space: nowrap;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.8rem, 2vw, 1.75rem);
  }

  .nav-link {
    position: relative;
    color: var(--ink-soft);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--accent);
  }

  .nav-link.active::after {
    position: absolute;
    right: 0;
    bottom: -0.55rem;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
  }

  .theme-toggle {
    justify-self: end;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .site-header {
      grid-template-columns: 1fr auto;
      gap: 0.65rem;
      padding-block: 0.65rem;
    }

    nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: 0.25rem;
      scrollbar-width: none;
    }

    nav::-webkit-scrollbar {
      display: none;
    }

    .nav-link {
      flex: 0 0 auto;
    }

    .nav-link.active::after {
      bottom: -0.25rem;
    }
  }

  @media (max-width: 420px) {
    .name {
      font-size: 0.9rem;
    }
  }
</style>

---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import EntryRow from "../../../components/EntryRow.astro";
import ContentArtwork from "../../../components/ContentArtwork.astro";
import { visibleSeries } from "../../../data/series";

export async function getStaticPaths() {
  return visibleSeries.map((s) => ({
    params: { series: s.slug },
    props: { meta: s },
  }));
}

const { meta } = Astro.props;

const posts = (
  await getCollection(
    "series",
    ({ id, data }) => id.split("/")[0] === meta.slug && !data.draft,
  )
).sort((a, b) => a.data.order - b.data.order);

const postSlug = (id: string) => id.split("/").slice(1).join("/");

// A series with `sections` keeps posts in subfolders; each folder becomes a
// titled group. Posts at the series root (or in an unlisted folder) come first.
const folderOf = (id: string) => {
  const parts = id.split("/");
  return parts.length > 2 ? parts[1] : "";
};
const groups = meta.sections
  ? [
      {
        title: "",
        posts: posts.filter(
          (p) => !meta.sections!.some((s) => s.folder === folderOf(p.id)),
        ),
      },
      ...meta.sections.map((s) => ({
        title: s.title,
        posts: posts.filter((p) => folderOf(p.id) === s.folder),
      })),
    ].filter((g) => g.posts.length > 0)
  : [{ title: "", posts }];
---

<Base
  title={`${meta.title} — Zuhaib Ul Zamann`}
  description={meta.description}
>
  <section class="listing">
    <header>
      <div class="introduction">
        <a href="/series" class="back label">← Series</a>
        <h1>{meta.title}</h1>
        <p class="standfirst">{meta.description}</p>
      </div>
      <div class="series-cover"><ContentArtwork kind={meta.cover} /></div>
    </header>

    {
      posts.length === 0 && (
        <p class="empty">No posts in this series yet — check back soon.</p>
      )
    }

    {
      groups.map((group) => (
        <>
          {group.title && <h2 class="section-title label">{group.title}</h2>}
          {group.posts.map((post) => (
            <EntryRow
              href={`/series/${meta.slug}/${postSlug(post.id)}`}
              number={String(post.data.order).padStart(2, "0")}
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
            />
          ))}
        </>
      ))
    }
  </section>
</Base>

<style>
  .listing {
    padding-top: 2.5rem;
  }

  .back {
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  .back:hover {
    color: var(--accent);
  }

  header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 2rem;
    border-bottom: 2px solid var(--rule-heavy);
    padding-bottom: 1.5rem;
  }

  .series-cover { overflow: hidden; border: 1px solid var(--rule); border-radius: 12px; }

  @media (max-width: 45rem) {
    header { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin: 0 0 0.75rem;
  }

  .standfirst {
    max-width: 38rem;
    color: var(--ink-soft);
  }

  .section-title {
    margin: 2.5rem 0 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
    font-weight: 400;
  }

  .empty {
    margin-top: 2.5rem;
    color: var(--ink-soft);
    font-style: italic;
  }
</style>

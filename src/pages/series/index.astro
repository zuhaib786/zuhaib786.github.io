---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { visibleSeries } from "../../data/series";

const posts = await getCollection("series", ({ data }) => !data.draft);

function postCount(slug: string) {
  return posts.filter((p) => p.id.split("/")[0] === slug).length;
}
---

<Base
  title="Series — Zuhaib Ul Zamann"
  description="Multi-part learning series — focused folders of posts on a single topic."
>
  <section class="listing" data-reveal>
    <header>
      <p class="label label--accent">Section 02</p>
      <h1>Series</h1>
      <p class="standfirst">
        Focused, multi-part folders of posts where I work through a single
        topic from the ground up.
      </p>
    </header>

    <div class="grid">
      {
        visibleSeries.map((s) => (
          <a href={`/series/${s.slug}`} class="card">
            <span class="card-meta label label--accent">
              {postCount(s.slug)}{" "}
              {postCount(s.slug) === 1 ? "post" : "posts"}
            </span>
            <span class="card-title">{s.title}</span>
            <span class="card-blurb">{s.description}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .listing {
    padding-top: 2.5rem;
  }

  header {
    border-bottom: 2px solid var(--rule-heavy);
    padding-bottom: 1.5rem;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin: 0.75rem 0;
  }

  .standfirst {
    max-width: 38rem;
    color: var(--ink-soft);
  }

  .grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0.875rem;
  }

  .card {
    position: relative;
    overflow: hidden;
    background: var(--glass);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    box-shadow: inset 0 1px 0 var(--glass-highlight);
    padding: 1.5rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition:
      background 150ms ease,
      border-color 150ms ease,
      transform 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out);
  }

  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 40%,
      var(--sheen) 50%,
      transparent 60%
    );
    transform: translateX(-130%);
    pointer-events: none;
  }

  .card:hover {
    background: var(--glass-strong);
    border-color: color-mix(in srgb, var(--interact) 50%, var(--glass-border));
    transform: translateY(-3px);
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      var(--hover-glow);
    z-index: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card:hover::after {
      transition: transform 650ms ease;
      transform: translateX(130%);
    }
  }

  .card-meta {
    font-size: 0.6875rem;
  }

  .card-title {
    font-weight: 700;
    font-size: 1.0625rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .card:hover .card-title {
    color: var(--interact);
  }

  .card-blurb {
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
</style>

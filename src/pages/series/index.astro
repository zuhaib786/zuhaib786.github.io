---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ContentCard from "../../components/ContentCard.astro";
import { visibleSeries } from "../../data/series";

const posts = await getCollection("series", ({ data }) => !data.draft);

function postCount(slug: string) {
  return posts.filter((p) => p.id.split("/")[0] === slug).length;
}
---

<Base
  title="Series — Zuhaib Ul Zamann"
  description="Multi-part learning series — focused folders of posts on a single topic."
>
  <section class="listing" data-reveal>
    <header>
      <p class="label label--accent">Section 02</p>
      <h1>Series</h1>
      <p class="standfirst">
        Focused, multi-part folders of posts where I work through a single
        topic from the ground up.
      </p>
    </header>

    <div class="grid">
      {
        visibleSeries.map((s) => (
          <ContentCard
            href={`/series/${s.slug}`}
            title={s.title}
            description={s.description}
            cover={s.cover}
            label={`Series · ${postCount(s.slug)} ${postCount(s.slug) === 1 ? "post" : "posts"}`}
            action="Explore series"
          />
        ))
      }
    </div>
  </section>
</Base>

<style>
  .listing {
    padding-top: 2.5rem;
  }

  header {
    border-bottom: 2px solid var(--rule-heavy);
    padding-bottom: 1.5rem;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin: 0.75rem 0;
  }

  .standfirst {
    max-width: 38rem;
    color: var(--ink-soft);
  }

  .grid {
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
  }

</style>

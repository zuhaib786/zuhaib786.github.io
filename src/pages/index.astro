---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import EntryRow from "../components/EntryRow.astro";
import { getSeriesMeta, postIsVisible } from "../data/series";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const recent = [...posts].reverse().slice(0, 4);

const seriesPosts = (
  await getCollection("series", ({ id, data }) =>
    postIsVisible(id, data.draft),
  )
).sort(
  (a, b) =>
    a.data.date.valueOf() - b.data.date.valueOf() ||
    a.data.order - b.data.order,
);
const recentSeries = [...seriesPosts].reverse().slice(0, 4);
const seriesPostPath = (id: string) => {
  const parts = id.split("/");
  return `/series/${parts[0]}/${parts.slice(1).join("/")}`;
};

const sections = [
  {
    number: "01",
    title: "Writing",
    href: "/blog",
    blurb: "Long-form technical articles on systems, performance and ML.",
  },
  {
    number: "02",
    title: "Series",
    href: "/series",
    blurb: "Multi-part learning series, like working through Zig from scratch.",
  },
  {
    number: "03",
    title: "Notes",
    href: "/notes",
    blurb: "Working notes and chapter summaries from books I'm studying.",
  },
  {
    number: "04",
    title: "Visuals",
    href: "/visuals",
    blurb: "Interactive explanations, simulations and data experiments.",
  },
  {
    number: "05",
    title: "Projects",
    href: "/projects",
    blurb: "Selected personal and academic projects.",
  },
  {
    number: "06",
    title: "Résumé",
    href: "/resume",
    blurb: "Education, experience and technical skills.",
  },
];
---

<Base title="Zuhaib Ul Zamann — Software Engineer">
  <section class="hero">
    <p class="label label--accent">
      ML Engineering · Distributed Systems · Agentic AI
    </p>
    <h1>Zuhaib <span class="family">Ul Zamann</span></h1>
    <p class="role label">Software Engineer II, AI/ML · Uber</p>
    <p class="intro">
      I build agentic AI systems and the infrastructure that keeps them
      reliable and cheap to run. I recently joined Uber as a Software Engineer
      II on AI/ML. Previously at Sprinklr I shipped production copilots for
      marketing and social suites, built cost telemetry across 1,000+
      microservices that saved $100K+/month, and designed resiliency systems
      that lifted platform uptime from 95% to 99.999%.
    </p>
  </section>

  <section class="contents" data-reveal>
    <h2 class="label">Contents</h2>
    <div class="grid">
      {
        sections.map((s, i) => (
          <a href={s.href} class="card" style={`--i: ${i}`}>
            <span class="card-number">{s.number}</span>
            <span class="card-title">{s.title}</span>
            <span class="card-blurb">{s.blurb}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="recent" data-reveal>
    <div class="recent-head">
      <h2 class="label">Recent Writing</h2>
      <a href="/blog" class="label all">All articles →</a>
    </div>
    {
      recent.map((post) => (
        <EntryRow
          href={`/blog/${post.id}`}
          number={String(posts.indexOf(post) + 1).padStart(2, "0")}
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
        />
      ))
    }
  </section>

  {
    recentSeries.length > 0 && (
      <section class="recent" data-reveal>
        <div class="recent-head">
          <h2 class="label">Recent Series</h2>
          <a href="/series" class="label all">
            All series →
          </a>
        </div>
        {recentSeries.map((post) => (
          <EntryRow
            href={seriesPostPath(post.id)}
            number={String(seriesPosts.indexOf(post) + 1).padStart(2, "0")}
            eyebrow={getSeriesMeta(post.id.split("/")[0])?.title}
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
          />
        ))}
      </section>
    )
  }
</Base>

<style>
  .hero {
    position: relative;
    padding: 4.5rem 0 3.5rem;
    border-bottom: 2px solid var(--rule-heavy);
  }

  /* soft two-hue glow behind the name — ambient, theme-aware */
  .hero::before {
    content: "";
    position: absolute;
    top: 1rem;
    left: -8rem;
    width: 34rem;
    height: 18rem;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--accent) 11%, transparent),
      transparent
    );
    filter: blur(32px);
    pointer-events: none;
  }

  .hero::after {
    content: "";
    position: absolute;
    top: 0;
    right: -6rem;
    width: 28rem;
    height: 16rem;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--accent-2) 9%, transparent),
      transparent
    );
    filter: blur(36px);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero > * {
      opacity: 0;
      animation: rise 700ms var(--ease-out) forwards;
    }

    .hero > *:nth-child(1) { animation-delay: 60ms; }
    .hero > *:nth-child(2) { animation-delay: 160ms; }
    .hero > *:nth-child(3) { animation-delay: 260ms; }
    .hero > *:nth-child(4) { animation-delay: 360ms; }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* the engraved plate title — the one place the display face appears
     at size, set against the mono everything else is measured in */
  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 10vw, 6rem);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: -0.015em;
    margin: 1.5rem 0 1.25rem;
    text-wrap: balance;
  }

  .family {
    font-style: italic;
    color: var(--ink-soft);
  }

  .role {
    margin-bottom: 2rem;
  }

  .intro {
    max-width: 38rem;
    color: var(--ink-soft);
  }

  .contents {
    padding: 2.5rem 0;
  }

  .contents > .label {
    margin-bottom: 1.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.875rem;
  }

  @media (max-width: 48rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    position: relative;
    overflow: hidden;
    background: var(--glass);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    box-shadow: inset 0 1px 0 var(--glass-highlight);
    padding: 1.5rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition:
      background 150ms ease,
      border-color 150ms ease,
      transform 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out);
  }

  /* glass sheen that sweeps across on hover */
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 40%,
      var(--sheen) 50%,
      transparent 60%
    );
    transform: translateX(-130%);
    pointer-events: none;
  }

  .card:hover {
    background: var(--glass-strong);
    border-color: color-mix(in srgb, var(--interact) 50%, var(--glass-border));
    transform: translateY(-3px);
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      var(--hover-glow);
    z-index: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card:hover::after {
      transition: transform 650ms ease;
      transform: translateX(130%);
    }
  }

  /* staggered card entrance once the section reveals */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .contents[data-reveal] .card {
      opacity: 0;
    }

    /* `backwards` fill so the finished animation stops overriding
       transform — otherwise the hover lift would never fire */
    :global(html.js) .contents[data-reveal].is-visible .card {
      opacity: 1;
      animation: rise 550ms var(--ease-out) backwards;
      animation-delay: calc(var(--i) * 70ms + 150ms);
    }
  }

  .card-number {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .card-title {
    font-weight: 700;
    font-size: 1.0625rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .card:hover .card-title {
    color: var(--interact);
  }

  .card-blurb {
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .recent {
    padding: 1.5rem 0 0;
  }

  .recent-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 2px solid var(--rule-heavy);
    padding-bottom: 0.75rem;
  }

  .all {
    text-decoration: none;
  }

  .all:hover {
    color: var(--interact);
  }
</style>

---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import EntryRow from "../components/EntryRow.astro";
import { getSeriesMeta, postIsVisible } from "../data/series";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const recent = [...posts].reverse().slice(0, 4);

const seriesPosts = (
  await getCollection("series", ({ id, data }) =>
    postIsVisible(id, data.draft),
  )
).sort(
  (a, b) =>
    a.data.date.valueOf() - b.data.date.valueOf() ||
    a.data.order - b.data.order,
);
const recentSeries = [...seriesPosts].reverse().slice(0, 4);
const seriesPostPath = (id: string) => {
  const parts = id.split("/");
  return `/series/${parts[0]}/${parts.slice(1).join("/")}`;
};

const sections = [
  {
    number: "I",
    title: "Writing",
    href: "/blog",
    blurb: "Long-form work on systems, performance, and ML infrastructure.",
  },
  {
    number: "II",
    title: "Series",
    href: "/series",
    blurb: "Structured, multi-part technical learning projects.",
  },
  {
    number: "III",
    title: "Notes",
    href: "/notes",
    blurb: "Compact reference notes from active study.",
  },
  {
    number: "IV",
    title: "Visuals",
    href: "/visuals",
    blurb: "Interactive explanations, simulations, and experiments.",
  },
  {
    number: "V",
    title: "Projects",
    href: "/projects",
    blurb: "Selected engineering and academic work.",
  },
  {
    number: "VI",
    title: "Résumé",
    href: "/resume",
    blurb: "Experience, education, and technical background.",
  },
];
---

<Base title="Zuhaib Ul Zamann — Software Engineer">
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-copy">
      <p class="eyebrow">ML Engineering · Distributed Systems · Agentic AI</p>
      <h1>Zuhaib <em>Ul Zamann</em></h1>
      <p class="role">Software Engineer II, AI/ML · Uber</p>
    </div>
    <p class="intro">
      I build agentic AI systems and the infrastructure that keeps them
      reliable and economical to run. At Uber, I work on AI/ML engineering.
      Previously at Sprinklr, I shipped production copilots, built cost
      telemetry across 1,000+ microservices, and designed platform resiliency
      systems.
    </p>
  </section>

  <section class="contents" data-reveal>
    <header class="section-head">
      <p>Contents</p>
      <h2>Browse the work</h2>
    </header>
    <ol class="contents-list">
      {
        sections.map((section) => (
          <li>
            <a href={section.href}>
              <span class="section-number">{section.number}</span>
              <span>
                <strong>{section.title}</strong>
                <small>{section.blurb}</small>
              </span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="recent" data-reveal>
    <header class="section-head section-head--row">
      <div>
        <p>Latest entries</p>
        <h2>Recent writing</h2>
      </div>
      <a href="/blog">All articles →</a>
    </header>
    {
      recent.map((post) => (
        <EntryRow
          href={`/blog/${post.id}`}
          number={String(posts.indexOf(post) + 1).padStart(2, "0")}
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
        />
      ))
    }
  </section>

  {
    recentSeries.length > 0 && (
      <section class="recent" data-reveal>
        <header class="section-head section-head--row">
          <div>
            <p>In sequence</p>
            <h2>Recent series</h2>
          </div>
          <a href="/series">All series →</a>
        </header>
        {recentSeries.map((post) => (
          <EntryRow
            href={seriesPostPath(post.id)}
            number={String(seriesPosts.indexOf(post) + 1).padStart(2, "0")}
            eyebrow={getSeriesMeta(post.id.split("/")[0])?.title}
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
          />
        ))}
      </section>
    )
  }
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.65fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: end;
    min-height: 34rem;
    margin-inline: calc(-1 * var(--folio-pad));
    padding: clamp(4rem, 10vw, 7rem) var(--folio-pad);
    overflow: hidden;
    background: #102b3a;
    color: #fffdf7;
  }

  .hero-grid {
    position: absolute;
    z-index: -2;
    inset: 0;
    opacity: 0.08;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.7) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.7) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to right, black, transparent 82%);
  }

  .hero::after {
    position: absolute;
    right: -4rem;
    bottom: -7rem;
    z-index: -1;
    color: rgba(244, 201, 93, 0.08);
    font-family: var(--font-display);
    font-size: 26rem;
    font-style: italic;
    line-height: 1;
    content: "Z²";
  }

  .eyebrow,
  .role {
    color: #f07a62;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 48rem;
    margin: 1.2rem 0 1.4rem;
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 9vw, 7.6rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.82;
  }

  h1 em {
    color: #f4c95d;
    font-weight: 400;
  }

  .intro {
    position: relative;
    max-width: 34rem;
    color: rgba(255, 253, 247, 0.72);
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.65;
  }

  .contents,
  .recent {
    padding-top: clamp(3rem, 7vw, 5.5rem);
  }

  .section-head {
    margin-bottom: 1.8rem;
    text-align: center;
  }

  .section-head p {
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 0.76rem;
    font-variant-caps: all-small-caps;
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .section-head h2 {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1;
  }

  .section-head--row {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--ink);
    text-align: left;
  }

  .section-head--row a {
    color: var(--ink-soft);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .contents-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  .contents-list li {
    border-bottom: 1px solid var(--rule);
  }

  .contents-list li:nth-child(odd) {
    border-right: 1px solid var(--rule);
  }

  .contents-list a {
    display: grid;
    grid-template-columns: 2.2rem 1fr auto;
    gap: 0.85rem;
    align-items: baseline;
    min-height: 8rem;
    padding: 1.4rem;
    text-decoration: none;
  }

  .section-number {
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 0.82rem;
  }

  .contents-list strong {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.25rem;
  }

  .contents-list small {
    display: block;
    margin-top: 0.35rem;
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .arrow {
    color: var(--rule-strong);
  }

  .contents-list a:hover {
    background: color-mix(in srgb, var(--paper-sunken) 52%, transparent);
  }

  .contents-list a:hover strong,
  .contents-list a:hover .arrow {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 2rem;
    }

    .hero::after {
      font-size: 16rem;
    }

    .contents-list {
      grid-template-columns: 1fr;
    }

    .contents-list li:nth-child(odd) {
      border-right: 0;
    }
  }
</style>

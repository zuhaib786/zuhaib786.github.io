---
import Base from "../../layouts/Base.astro";

const instruments = [
  { n:"001", href:"/signals/sampling", title:"Sampling & aliasing", field:"Digitisation", kind:"sampling", formula:"fₛ > 2·f_max", description:"Sample continuous tones too slowly and watch impostor frequencies fold back into the band." },
  { n:"002", href:"/signals/dft-spectrum", title:"DFT spectrum", field:"Spectral analysis", kind:"spectrum", formula:"Xₖ = Σ xₙe^{−2πikn/N}", description:"Decompose waveforms into pure frequencies, then keep only the strongest bins and hear the structure survive." },
  { n:"003", href:"/signals/convolution", title:"Convolution", field:"Filtering", kind:"convolution", formula:"y[n] = Σ x[k]h[n−k]", description:"Flip, slide, multiply, add — one animated stencil behind smoothing, echo, and edge detection." },
];
---

<Base title="Signals — Visuals by Zuhaib Ul Zamann" description="Interactive signal processing laboratories for sampling, spectra, windows, and convolution.">
  <section class="collection-head"><a href="/visuals" class="label back">← Visual laboratory</a><div class="head-grid"><div><p class="label label--accent">Collection 05 · Signal processing</p><h1>Waves,<br/><em>taken apart.</em></h1></div><div class="introduction"><p>Every recording is a bridge between the continuous world and discrete samples. These instruments make the crossing visible: what sampling keeps, what spectra hide, and how one sliding stencil builds every filter.</p><span class="label">{String(instruments.length).padStart(2,"0")} interactive instruments</span></div></div></section>
  <section class="math-grid" aria-label="Signal visualizations">
    {instruments.map((item,index)=><a href={item.href} class="math-card" data-reveal style={`--delay:${index*70}ms`}><div class={`preview preview--${item.kind}`}><span class="number">SIG / {item.n}</span>{item.kind==="sampling"?<svg class="sampling-glyph" viewBox="0 0 260 96" aria-hidden="true"><path d="M4 48 C18 8 32 88 46 48 S74 8 88 48 S116 88 130 48 S158 8 172 48 S200 88 214 48 S242 8 256 48"/><g>{[18,46,74,102,130,158,186,214,242].map((x,i)=><><line x1={x} y1="82" x2={x} y2={48+Math.sin(i*1.65)*28}/><circle cx={x} cy={48+Math.sin(i*1.65)*28} r="3"/></>)}</g></svg>:item.kind==="spectrum"?<div class="spectrum-glyph" aria-hidden="true">{[18,38,92,27,63,34,78,22,49,16,31,12].map((height,i)=><i style={`--h:${height}%;--i:${i}`}></i>)}</div>:<div class="convolution-glyph" aria-hidden="true"><span class="pulse pulse--one"></span><span class="pulse pulse--two"></span><span class="kernel"><i></i><i></i><i></i><i></i><i></i></span></div>}<code>{item.formula}</code></div><div class="copy"><div><span class="label label--accent">{item.field}</span><span class="label">Interactive</span></div><h2>{item.title}</h2><p>{item.description}</p><span class="open">Open instrument →</span></div></a>)}
  </section>
</Base>

<style>
  .collection-head{padding:3rem 0 3.5rem;border-bottom:2px solid var(--rule-heavy)}.back{display:inline-block;margin-bottom:2.5rem;color:var(--ink-faint);text-decoration:none}.head-grid{display:grid;grid-template-columns:minmax(22rem,1.1fr) minmax(18rem,.65fr);align-items:end;gap:3rem}h1{margin-top:.8rem;font-family:var(--font-display);font-size:clamp(3.5rem,9vw,7.5rem);font-weight:400;letter-spacing:-.025em;line-height:.83}h1 em{color:var(--ink-soft);font-weight:400}.introduction p{margin-bottom:1.5rem;color:var(--ink-soft);font-size:.875rem}.introduction .label{color:var(--ink-faint)}.math-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;padding:2rem 0 1rem}.math-card{display:flex;min-width:0;flex-direction:column;overflow:hidden;color:inherit;text-decoration:none;background:var(--glass);border:1px solid var(--glass-border);border-radius:14px;box-shadow:inset 0 1px 0 var(--glass-highlight);transition:transform 220ms var(--ease-out),border-color 180ms ease,box-shadow 220ms ease}.math-card:hover{color:inherit;transform:translateY(-4px);border-color:color-mix(in srgb,var(--interact) 50%,var(--glass-border));box-shadow:inset 0 1px 0 var(--glass-highlight),var(--hover-glow)}.preview{position:relative;display:grid;height:11rem;place-items:center;overflow:hidden;border-bottom:1px solid var(--glass-border);background:linear-gradient(to right,var(--reseau) 1px,transparent 1px),linear-gradient(to bottom,var(--reseau) 1px,transparent 1px),color-mix(in srgb,var(--paper-sunken) 58%,transparent);background-size:24px 24px}.number{position:absolute;top:.7rem;left:.8rem;z-index:3;color:var(--ink-faint);font-size:.52rem;letter-spacing:.12em}.preview code{position:absolute;right:.7rem;bottom:.65rem;z-index:2;padding:.45rem .55rem;color:var(--interact);background:color-mix(in srgb,var(--code-wash) 88%,transparent);border:1px solid color-mix(in srgb,var(--interact) 45%,var(--rule));border-radius:6px;font:500 .58rem/1 var(--font-mono);backdrop-filter:blur(8px)}.sampling-glyph{width:84%;overflow:visible}.sampling-glyph path{fill:none;stroke:var(--ink-faint);stroke-width:1.3}.sampling-glyph line{stroke:var(--interact);stroke-width:1;opacity:.45}.sampling-glyph circle{fill:var(--interact)}.spectrum-glyph{display:flex;width:78%;height:6rem;align-items:flex-end;gap:clamp(3px,1vw,8px);padding-bottom:.65rem;border-bottom:1px solid var(--rule)}.spectrum-glyph i{width:100%;height:var(--h);background:var(--interact);border-radius:2px 2px 0 0}.spectrum-glyph i:nth-child(3n){background:var(--accent-2)}.convolution-glyph{position:relative;width:78%;height:5.8rem;border-bottom:1px solid var(--rule)}.pulse{position:absolute;bottom:0;width:2px;background:var(--ink-faint)}.pulse--one{left:17%;height:68%}.pulse--two{left:72%;height:42%}.kernel{position:absolute;right:23%;bottom:0;display:flex;align-items:flex-end;gap:3px;transform:translateX(50%)}.kernel i{width:10px;background:var(--interact);border-radius:2px 2px 0 0}.kernel i:nth-child(1),.kernel i:nth-child(5){height:13px}.kernel i:nth-child(2),.kernel i:nth-child(4){height:30px}.kernel i:nth-child(3){height:48px}.copy{display:flex;flex:1;flex-direction:column;gap:.35rem;padding:1.15rem 1.15rem 1.25rem}.copy>div{display:flex;justify-content:space-between;gap:.5rem}.copy h2{margin:.45rem 0 .3rem;font-family:var(--font-display);font-size:1.55rem;font-weight:400;line-height:1}.copy p{color:var(--ink-soft);font-size:.72rem}.open{margin-top:auto;padding-top:1rem;color:var(--interact);font-size:.6rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase}@media(max-width:58rem){.math-grid{grid-template-columns:1fr 1fr}}@media(max-width:44rem){.math-grid{grid-template-columns:1fr}}
</style>

---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ContentCard from "../../components/ContentCard.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const newestFirst = [...posts].reverse();
---

<Base
  title="Writing — Zuhaib Ul Zamann"
  description="Long-form technical articles on systems, performance and machine learning infrastructure."
>
  <section class="listing" data-reveal>
    <header>
      <p class="label label--accent">Section 01</p>
      <h1>Writing</h1>
      <p class="standfirst">
        Long-form technical articles on systems, performance and machine
        learning infrastructure.
      </p>
    </header>

    <div class="cards">
      {
        newestFirst.map((post) => (
          <ContentCard
            href={`/blog/${post.id}`}
            title={post.data.title}
            description={post.data.description}
            cover={post.data.cover}
            label={`Article ${String(posts.indexOf(post) + 1).padStart(2, "0")} · ${post.data.date.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric", timeZone: "UTC" })}`}
            action="Read article"
          />
        ))
      }
    </div>
  </section>
</Base>

<style>
  .cards { display: grid; gap: 1rem; margin-top: 2rem; }

  .listing {
    padding-top: 2.5rem;
  }

  header {
    border-bottom: 2px solid var(--rule-heavy);
    padding-bottom: 1.5rem;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin: 0.75rem 0;
  }

  .standfirst {
    max-width: 38rem;
    color: var(--ink-soft);
  }
</style>

---
import Base from "../../layouts/Base.astro";

const instruments = [
  { n:"001", href:"/mathematics/fractal-dynamics", title:"Fractal dynamics", field:"Complex dynamics", formula:"zₙ₊₁ = zₙᵖ + c", description:"Link parameter space, Julia sets, Newton basins, and iterated contractions." },
  { n:"002", href:"/mathematics/measure-in-motion", title:"Measure in Motion", field:"Geometry", formula:"V = A · 2πd̄", description:"Generate solids through centroid motion and verify Pappus with independent slices." },
  { n:"003", href:"/mathematics/complex-functions", title:"Complex functions", field:"Complex analysis", formula:"arg f(z) ↦ hue", description:"Read zeros, poles, argument, modulus, and conformal distortion directly from colour." },
  { n:"004", href:"/mathematics/dynamical-systems", title:"Dynamical systems", field:"Differential equations", formula:"ẋ = F(x; μ)", description:"Seed phase portraits, inspect nullclines, and move from cycles to bifurcations." },
  { n:"005", href:"/mathematics/linear-transformations", title:"Linear transformations", field:"Linear algebra", formula:"A = UΣVᵀ", description:"Turn matrices, eigenstructure, singular values, and projection into geometry." },
  { n:"006", href:"/mathematics/monte-carlo", title:"Monte Carlo", field:"Probability", formula:"σ(μ̂) ∝ N⁻¹ᐟ²", description:"Estimate geometry, integrals, rare events, and hitting probabilities from samples." },
];
---

<Base title="Mathematics — Visuals by Zuhaib Ul Zamann" description="Interactive laboratories for complex analysis, geometry, dynamical systems, linear algebra, and probability.">
  <section class="collection-head"><a href="/visuals" class="label back">← Visual laboratory</a><div class="head-grid"><div><p class="label label--accent">Collection 03 · Mathematical instruments</p><h1>Structure,<br/><em>made visible.</em></h1></div><div class="introduction"><p>A formula compresses a relationship; an instrument lets you perturb it. These laboratories make iteration, invariance, convergence, and geometry respond directly to touch.</p><span class="label">{String(instruments.length).padStart(2,"0")} interactive instruments</span></div></div></section>
  <section class="math-grid" aria-label="Mathematics visualizations">
    {instruments.map((item,index)=><a href={item.href} class="math-card" data-reveal style={`--delay:${index*70}ms`}><div class="preview"><span class="number">MAT / {item.n}</span><div class="orbit"><i></i><i></i><i></i></div><code>{item.formula}</code></div><div class="copy"><div><span class="label label--accent">{item.field}</span><span class="label">Interactive</span></div><h2>{item.title}</h2><p>{item.description}</p><span class="open">Open instrument →</span></div></a>)}
  </section>
</Base>

<style>
  .collection-head{padding:3rem 0 3.5rem;border-bottom:2px solid var(--rule-heavy)}.back{display:inline-block;margin-bottom:2.5rem;color:var(--ink-faint);text-decoration:none}.head-grid{display:grid;grid-template-columns:minmax(22rem,1.1fr) minmax(18rem,.65fr);align-items:end;gap:3rem}h1{margin-top:.8rem;font-family:var(--font-display);font-size:clamp(3.5rem,9vw,7.5rem);font-weight:400;letter-spacing:-.025em;line-height:.83}h1 em{color:var(--ink-soft);font-weight:400}.introduction p{margin-bottom:1.5rem;color:var(--ink-soft);font-size:.875rem}.introduction .label{color:var(--ink-faint)}.math-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;padding:2rem 0 1rem}.math-card{display:flex;min-width:0;flex-direction:column;overflow:hidden;color:inherit;text-decoration:none;background:var(--glass);border:1px solid var(--glass-border);border-radius:14px;box-shadow:inset 0 1px 0 var(--glass-highlight);transition:transform 220ms var(--ease-out),border-color 180ms ease,box-shadow 220ms ease}.math-card:hover{color:inherit;transform:translateY(-4px);border-color:color-mix(in srgb,var(--interact) 50%,var(--glass-border));box-shadow:inset 0 1px 0 var(--glass-highlight),var(--hover-glow)}.preview{position:relative;display:grid;height:11rem;place-items:center;overflow:hidden;border-bottom:1px solid var(--glass-border);background:linear-gradient(to right,var(--reseau) 1px,transparent 1px),linear-gradient(to bottom,var(--reseau) 1px,transparent 1px),color-mix(in srgb,var(--paper-sunken) 58%,transparent);background-size:24px 24px}.number{position:absolute;top:.7rem;left:.8rem;color:var(--ink-faint);font-size:.52rem;letter-spacing:.12em}.preview code{z-index:2;padding:.62rem .75rem;color:var(--interact);background:var(--code-wash);border:1px solid color-mix(in srgb,var(--interact) 55%,var(--rule));border-radius:7px;font:500 .68rem/1 var(--font-mono);box-shadow:0 0 25px color-mix(in srgb,var(--interact) 12%,transparent)}.orbit{position:absolute;width:8rem;height:8rem;border:1px solid color-mix(in srgb,var(--interact) 28%,transparent);border-radius:50%;animation:turn 12s linear infinite}.orbit::before,.orbit::after{content:"";position:absolute;inset:18%;border:1px solid color-mix(in srgb,var(--accent-2) 26%,transparent);border-radius:50%;transform:rotate(63deg) scaleY(.42)}.orbit::after{inset:34%;transform:rotate(-28deg) scaleX(.55)}.orbit i{position:absolute;width:5px;height:5px;background:var(--interact);border-radius:50%;box-shadow:0 0 9px var(--interact)}.orbit i:first-child{top:-3px;left:50%}.orbit i:nth-child(2){right:9px;bottom:17px;background:var(--accent-2)}.orbit i:nth-child(3){left:18px;bottom:3px;width:3px;height:3px}@keyframes turn{to{transform:rotate(360deg)}}.copy{display:flex;flex:1;flex-direction:column;padding:1.2rem}.copy>div{display:flex;justify-content:space-between;gap:1rem}.copy h2{margin:.65rem 0 .7rem;font-family:var(--font-display);font-size:2rem;font-weight:400;line-height:1}.copy p{min-height:3.5rem;color:var(--ink-soft);font-size:.68rem}.open{margin-top:auto;padding-top:1rem;color:var(--interact);font-size:.55rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase}@media(prefers-reduced-motion:reduce){.orbit{animation:none}}@media(max-width:56rem){.math-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:40rem){.head-grid{grid-template-columns:1fr;gap:2rem}.math-grid{grid-template-columns:1fr}}
</style>

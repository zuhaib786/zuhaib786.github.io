---
import Base from "../../layouts/Base.astro";

const instruments = [
  { n:"001", href:"/physics/orbital-mechanics", title:"Orbital mechanics", field:"Celestial mechanics", formula:"r̈ᵢ = Σ Gmⱼrᵢⱼ/|rᵢⱼ|³", description:"Perturb N-body systems while energy, angular momentum, orbital elements, and integration error remain visible." },
  { n:"002", href:"/physics/fields-and-potentials", title:"Fields & potentials", field:"Electromagnetism", formula:"E = −∇V", description:"Place charges, read potential contours and field lines, and measure flux through a draggable Gaussian surface." },
  { n:"003", href:"/physics/wave-laboratory", title:"Wave laboratory", field:"Continuum mechanics", formula:"uₜₜ = c²∇²u", description:"Paint initial data into strings and membranes, alter boundaries, and resolve the motion into normal modes." },
  { n:"004", href:"/physics/hamiltonian-chaos", title:"Hamiltonian chaos", field:"Analytical mechanics", formula:"q̇ = ∂H/∂p · ṗ = −∂H/∂q", description:"Put motion, phase space, energy surfaces, Poincaré sections, and Lyapunov separation on one instrument." },
  { n:"005", href:"/physics/quantum-dynamics", title:"Quantum dynamics", field:"Quantum mechanics", formula:"i∂ₜψ = Ĥψ", description:"Launch complex wave packets through barriers and wells while probability, phase, current, and norm evolve." },
  { n:"006", href:"/physics/ising-model", title:"Ising model", field:"Statistical mechanics", formula:"H = −J Σ⟨ij⟩ sᵢsⱼ", description:"Drive a spin lattice through its critical region and watch domains, energy, magnetization, and susceptibility respond." },
];
---

<Base title="Physics — Visuals by Zuhaib Ul Zamann" description="Interactive computational physics laboratories for mechanics, fields, waves, quantum dynamics, and statistical mechanics.">
  <section class="collection-head"><a href="/visuals" class="label back">← Visual laboratory</a><div class="head-grid"><div><p class="label label--accent">Collection 04 · Computational physics</p><h1>Laws in motion,<br/><em>error included.</em></h1></div><div class="introduction"><p>A physical model earns trust by showing more than motion. These instruments expose state, representation, invariants, and the numerical method carrying time forward.</p><span class="label">{String(instruments.length).padStart(2,"0")} interactive instruments</span></div></div></section>
  <section class="physics-grid" aria-label="Physics visualizations">
    {instruments.map((item,index)=><a href={item.href} class="physics-card" data-reveal style={`--delay:${index*70}ms`}><div class="preview"><span class="number">PHY / {item.n}</span><div class="field"><i></i><i></i><i></i><i></i></div><code>{item.formula}</code></div><div class="copy"><div><span class="label label--accent">{item.field}</span><span class="label">Interactive</span></div><h2>{item.title}</h2><p>{item.description}</p><span class="open">Open instrument →</span></div></a>)}
  </section>
</Base>

<style>
  .collection-head{padding:3rem 0 3.5rem;border-bottom:2px solid var(--rule-heavy)}.back{display:inline-block;margin-bottom:2.5rem;color:var(--ink-faint);text-decoration:none}.head-grid{display:grid;grid-template-columns:minmax(22rem,1.1fr) minmax(18rem,.65fr);align-items:end;gap:3rem}h1{margin-top:.8rem;font-family:var(--font-display);font-size:clamp(3.5rem,9vw,7.5rem);font-weight:400;letter-spacing:-.025em;line-height:.83}h1 em{color:var(--ink-soft);font-weight:400}.introduction p{margin-bottom:1.5rem;color:var(--ink-soft);font-size:.875rem}.introduction .label{color:var(--ink-faint)}.physics-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;padding:2rem 0 1rem}.physics-card{display:flex;min-width:0;flex-direction:column;overflow:hidden;color:inherit;text-decoration:none;background:var(--glass);border:1px solid var(--glass-border);border-radius:14px;box-shadow:inset 0 1px 0 var(--glass-highlight);transition:transform 220ms var(--ease-out),border-color 180ms ease,box-shadow 220ms ease}.physics-card:hover{color:inherit;transform:translateY(-4px);border-color:color-mix(in srgb,var(--interact) 50%,var(--glass-border));box-shadow:inset 0 1px 0 var(--glass-highlight),var(--hover-glow)}.preview{position:relative;display:grid;height:11rem;place-items:center;overflow:hidden;border-bottom:1px solid var(--glass-border);background:linear-gradient(to right,var(--reseau) 1px,transparent 1px),linear-gradient(to bottom,var(--reseau) 1px,transparent 1px),color-mix(in srgb,var(--paper-sunken) 58%,transparent);background-size:24px 24px}.number{position:absolute;top:.7rem;left:.8rem;color:var(--ink-faint);font-size:.52rem;letter-spacing:.12em}.preview code{z-index:2;max-width:88%;padding:.62rem .75rem;overflow:hidden;color:var(--interact);background:var(--code-wash);border:1px solid color-mix(in srgb,var(--interact) 55%,var(--rule));border-radius:7px;font:500 .64rem/1 var(--font-mono);text-overflow:ellipsis;white-space:nowrap;box-shadow:0 0 25px color-mix(in srgb,var(--interact) 12%,transparent)}.field{position:absolute;inset:1.9rem;opacity:.6}.field::before,.field::after{content:"";position:absolute;inset:8% 18%;border:1px solid color-mix(in srgb,var(--interact) 38%,transparent);border-radius:50%;transform:rotate(-18deg)}.field::after{inset:28% 5%;border-color:color-mix(in srgb,var(--accent-2) 38%,transparent);transform:rotate(28deg)}.field i{position:absolute;width:4px;height:4px;background:var(--interact);border-radius:50%;box-shadow:0 0 9px var(--interact)}.field i:first-child{top:12%;left:23%}.field i:nth-child(2){right:17%;top:35%;background:var(--accent-2)}.field i:nth-child(3){left:31%;bottom:8%;background:var(--accent-2)}.field i:nth-child(4){right:29%;bottom:20%}.copy{display:flex;flex:1;flex-direction:column;padding:1.2rem}.copy>div{display:flex;justify-content:space-between;gap:1rem}.copy h2{margin:.65rem 0 .7rem;font-family:var(--font-display);font-size:2rem;font-weight:400;line-height:1}.copy p{min-height:3.5rem;color:var(--ink-soft);font-size:.68rem}.open{margin-top:auto;padding-top:1rem;color:var(--interact);font-size:.55rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase}@media(max-width:56rem){.physics-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:40rem){.head-grid{grid-template-columns:1fr;gap:2rem}.physics-grid{grid-template-columns:1fr}}
</style>

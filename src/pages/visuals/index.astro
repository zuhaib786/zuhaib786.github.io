---
import Base from "../../layouts/Base.astro";

const experiments = [
  {
    number: "001",
    href: "/earthquakes",
    title: "Earthquakes",
    kicker: "Live data · Canvas · Geospatial",
    description:
      "A draggable observatory for the past month of global seismic activity, fed by the USGS.",
    kind: "globe",
  },
  {
    number: "002",
    href: "/algorithms",
    title: "Algorithms",
    kicker: "Growing collection · Computer science",
    description:
      "Executable explanations of classic algorithms, beginning with five ways to sort an array.",
    kind: "sorting",
  },
  {
    number: "003",
    href: "/systems",
    title: "Systems",
    kicker: "Fault injection · State machines · Simulation",
    description:
      "Twelve executable models of storage, consensus, runtimes, networking, parallelism, and reliability.",
    kind: "systems",
  },
];
---

<Base
  title="Visuals — Zuhaib Ul Zamann"
  description="Interactive visual explanations, simulations, and data experiments by Zuhaib Ul Zamann."
>
  <section class="visuals-head">
    <p class="label label--accent">Section 04 · Visual laboratory</p>
    <h1>Things that move<br /><em>when you touch them.</em></h1>
    <p class="standfirst">
      Small, interactive explanations for ideas that deserve more than a
      static diagram. Built for the browser, with no account, install, or
      instruction manual required.
    </p>
  </section>

  <section class="experiments" aria-label="Interactive experiments">
    {
      experiments.map((experiment, index) => (
        <a
          href={experiment.href}
          class="experiment"
          data-reveal
          style={`--delay: ${index * 90}ms`}
        >
          <div class={`preview preview--${experiment.kind}`} aria-hidden="true">
            {experiment.kind === "globe" ? (
              <div class="mini-globe">
                <span class="orbit orbit-a" />
                <span class="orbit orbit-b" />
                <span class="quake quake-a" />
                <span class="quake quake-b" />
                <span class="quake quake-c" />
                <span class="quake quake-d" />
              </div>
            ) : experiment.kind === "sorting" ? (
              <div class="mini-bars">
                {[42, 76, 28, 91, 55, 69, 35, 84, 48, 62, 23, 73].map(
                  (height, i) => (
                    <span style={`--h:${height}%; --i:${i}`} />
                  ),
                )}
              </div>
            ) : (
              <div class="mini-system">
                <span>WAL</span><i></i><span>MEM</span><i></i><span>SST</span>
                <b>packet / state / time</b>
              </div>
            )}
            <span class="preview-index">EXP / {experiment.number}</span>
          </div>
          <div class="experiment-copy">
            <p class="label">{experiment.kicker}</p>
            <h2>{experiment.title}</h2>
            <p>{experiment.description}</p>
            <span class="launch">Launch experiment <b aria-hidden="true">↗</b></span>
          </div>
        </a>
      ))
    }
  </section>
</Base>

<style>
  .visuals-head {
    padding: 4.5rem 0 3.5rem;
    border-bottom: 2px solid var(--rule-heavy);
  }

  h1 {
    max-width: 52rem;
    margin: 1.25rem 0 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6.75rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 0.88;
  }

  h1 em {
    color: var(--ink-soft);
    font-weight: 400;
  }

  .standfirst {
    max-width: 43rem;
    color: var(--ink-soft);
    font-size: clamp(0.9rem, 1.8vw, 1.05rem);
  }

  .experiments {
    display: grid;
    gap: 1rem;
    padding: 2rem 0 1rem;
  }

  .experiment {
    display: grid;
    grid-template-columns: minmax(17rem, 1.1fr) minmax(18rem, 0.9fr);
    min-height: 23rem;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    box-shadow: inset 0 1px 0 var(--glass-highlight);
    transition:
      transform 260ms var(--ease-out),
      border-color 180ms ease,
      box-shadow 260ms ease;
  }

  .experiment:hover {
    color: inherit;
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--interact) 48%, var(--glass-border));
    box-shadow: inset 0 1px 0 var(--glass-highlight), var(--hover-glow);
  }

  .preview {
    position: relative;
    display: grid;
    min-height: 23rem;
    place-items: center;
    overflow: hidden;
    border-right: 1px solid var(--glass-border);
    background:
      linear-gradient(to right, var(--reseau) 1px, transparent 1px),
      linear-gradient(to bottom, var(--reseau) 1px, transparent 1px),
      color-mix(in srgb, var(--paper-sunken) 78%, transparent);
    background-size: 24px 24px;
  }

  .preview::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, transparent 25%, var(--paper-sunken) 110%);
    pointer-events: none;
  }

  .preview-index {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 1;
    color: var(--ink-faint);
    font-size: 0.625rem;
    letter-spacing: 0.15em;
  }

  .experiment-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4rem);
  }

  .experiment-copy h2 {
    margin: 0.65rem 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 5vw, 4.2rem);
    font-weight: 400;
    line-height: 0.95;
  }

  .experiment-copy > p:not(.label) {
    color: var(--ink-soft);
    font-size: 0.875rem;
  }

  .launch {
    margin-top: 2.5rem;
    color: var(--interact);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .launch b {
    display: inline-block;
    margin-left: 0.35rem;
    transition: transform 220ms var(--ease-out);
  }

  .experiment:hover .launch b {
    transform: translate(4px, -4px);
  }

  .mini-globe {
    position: relative;
    width: min(69%, 18rem);
    aspect-ratio: 1;
    border: 1px solid var(--ink-soft);
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 30%, var(--glass-highlight), transparent 32%),
      color-mix(in srgb, var(--accent-soft) 45%, transparent);
    box-shadow: 0 0 60px color-mix(in srgb, var(--accent-2) 18%, transparent);
  }

  .mini-globe::before,
  .mini-globe::after,
  .orbit {
    content: "";
    position: absolute;
    inset: 14% 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
  }

  .mini-globe::after {
    inset: 0 27%;
  }

  .orbit-a { transform: rotate(36deg); }
  .orbit-b { transform: rotate(-36deg); }

  .quake {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--interact);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--interact) 18%, transparent), 0 0 16px var(--interact);
    animation: ping 2.6s ease-in-out infinite;
  }

  .quake-a { top: 28%; left: 67%; }
  .quake-b { top: 61%; left: 24%; animation-delay: -0.8s; }
  .quake-c { top: 72%; left: 58%; animation-delay: -1.7s; }
  .quake-d { top: 42%; left: 82%; animation-delay: -2.2s; }

  @keyframes ping {
    50% { transform: scale(1.55); opacity: 0.6; }
  }

  .mini-bars {
    display: flex;
    align-items: flex-end;
    gap: clamp(3px, 0.8vw, 8px);
    width: 78%;
    height: 60%;
    border-bottom: 1px solid var(--ink-soft);
  }

  .mini-bars span {
    flex: 1;
    height: var(--h);
    min-width: 3px;
    background: linear-gradient(to top, var(--accent-2), var(--interact));
    border-radius: 3px 3px 0 0;
    transform-origin: bottom;
    animation: bars 2.8s var(--ease-out) infinite alternate;
    animation-delay: calc(var(--i) * -80ms);
  }

  .mini-system { position:relative;z-index:1;display:flex;align-items:center;gap:.45rem;color:var(--ink-soft); }
  .mini-system span { display:grid;width:3.5rem;height:3.5rem;place-items:center;background:var(--glass);border:1px solid var(--ink-soft);border-radius:50%;font-size:.58rem; }
  .mini-system i { width:2.4rem;height:1px;background:linear-gradient(90deg,var(--rule),var(--interact)); }
  .mini-system b { position:absolute;top:4.8rem;left:50%;width:14rem;transform:translateX(-50%);color:var(--interact);font-size:.5rem;font-weight:500;letter-spacing:.1em;text-align:center;text-transform:uppercase; }

  @keyframes bars {
    35% { transform: scaleY(0.82); opacity: 0.65; }
    70% { transform: scaleY(1); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .quake,
    .mini-bars span { animation: none; }
  }

  @media (max-width: 45rem) {
    .visuals-head { padding: 3rem 0 2.5rem; }

    .experiment { grid-template-columns: 1fr; }

    .preview {
      min-height: 18rem;
      border-right: 0;
      border-bottom: 1px solid var(--glass-border);
    }

    .experiment-copy { padding: 2rem; }
  }
</style>

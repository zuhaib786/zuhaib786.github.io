---
import Base from "../../layouts/Base.astro";

const experiments = [
  {
    number: "009",
    href: "/biology",
    title: "Biology Atlas",
    kicker: "3D anatomy · Cutaways · Selectable structures",
    description:
      "An open animal cell and real reference anatomy. Hover to identify a structure, click to isolate it, and turn it over while you read.",
    kind: "biology",
  },
  {
    number: "001",
    href: "/earthquakes",
    title: "Earthquakes",
    kicker: "Live data · Canvas · Geospatial",
    description:
      "A draggable observatory for the past month of global seismic activity, fed by the USGS.",
    kind: "globe",
  },
  {
    number: "002",
    href: "/algorithms",
    title: "Algorithms",
    kicker: "Growing collection · Computer science",
    description:
      "Executable explanations of classic algorithms, from sorting and search to zero-knowledge proofs and cellular automata.",
    kind: "sorting",
  },
  {
    number: "003",
    href: "/systems",
    title: "Systems",
    kicker: "Fault injection · State machines · Simulation",
    description:
      "Fifteen executable models of storage, consensus, runtimes, networking, parallelism, learning, and reliability.",
    kind: "systems",
  },
  {
    number: "004",
    href: "/sky",
    title: "The Night Sky",
    kicker: "Celestial mechanics · Star catalog · Live clock",
    description:
      "A planetarium in the browser: two thousand real stars, the planets computed from their orbits, and the sky over your head right now.",
    kind: "sky",
  },
  {
    number: "005",
    href: "/mathematics",
    title: "Mathematics",
    kicker: "Eight instruments · Analysis · Geometry · Probability",
    description:
      "Complex dynamics, Pappus, domain colouring, phase portraits, linear maps, Monte Carlo estimation, Fourier epicycles, and the road to chaos — all manipulable.",
    kind: "measure",
  },
  {
    number: "006",
    href: "/physics",
    title: "Physics",
    kicker: "Six instruments · Dynamics · Fields · Matter",
    description:
      "Orbits, fields, waves, Hamiltonian chaos, quantum packets, and phase transitions — with invariants and numerical error exposed.",
    kind: "physics",
  },
  {
    number: "007",
    href: "/signals",
    title: "Signals",
    kicker: "Three instruments · Sampling · Spectra · Filtering",
    description:
      "Sample continuous waves into digital land, decompose them into pure frequencies, and build every filter from one sliding stencil.",
    kind: "signal",
  },
  {
    number: "008",
    href: "/cryptography",
    title: "Cryptography",
    kicker: "Three instruments · Ciphers · Public keys · Hashes",
    description:
      "Break classical ciphers with their own statistics, walk RSA's modular ladders, and measure whether a hash truly mixes.",
    kind: "cipher",
  },
];
---

<Base
  title="Visuals — Zuhaib Ul Zamann"
  description="Interactive visual explanations, simulations, and data experiments by Zuhaib Ul Zamann."
>
  <section class="visuals-head">
    <p class="label label--accent">Section 04 · Visual laboratory</p>
    <h1>Things that move<br /><em>when you touch them.</em></h1>
    <p class="standfirst">
      Small, interactive explanations for ideas that deserve more than a
      static diagram. Built for the browser, with no account, install, or
      instruction manual required.
    </p>
  </section>

  <section class="experiments" aria-label="Interactive experiments">
    {
      experiments.map((experiment, index) => (
        <a
          href={experiment.href}
          class="experiment"
          data-reveal
          style={`--delay: ${index * 90}ms`}
        >
          <div class={`preview preview--${experiment.kind}`} aria-hidden="true">
            {experiment.kind === "biology" ? (
              <svg viewBox="0 0 260 180" width="260" aria-hidden="true">
                <ellipse cx="130" cy="94" rx="99" ry="59" fill="#c9d2ba" stroke="#94ab91" stroke-width="2" />
                <path d="M31 94a99 59 0 0 0 198 0" fill="none" stroke="#e1e4cb" stroke-width="7" />
                <ellipse cx="111" cy="82" rx="35" ry="29" fill="#ad91c7" stroke="#8e72ae" stroke-width="2" />
                <circle cx="114" cy="86" r="12" fill="#7d6197" />
                <g fill="none" stroke="#6e8cb6" stroke-width="4"><path d="M68 64q-27 35 11 59"/><path d="M59 58q-31 39 12 72"/><path d="M48 61q-30 39 13 71"/></g>
                <g transform="translate(177 105) rotate(-25)"><ellipse rx="29" ry="13" fill="#dc9b61"/><path d="M-18-7v14m9-18v22m9-23v24m9-21v18m9-13v10" stroke="#f2d19e" stroke-width="3"/></g>
                <g fill="none" stroke="#c6a05c" stroke-width="4"><path d="M163 59q17-9 32 0m-33 7q18-9 33 0m-30 7q15-9 29 0"/></g>
                <circle cx="125" cy="122" r="10" fill="#be8299" />
              </svg>
            ) : experiment.kind === "globe" ? (
              <div class="mini-globe">
                <span class="orbit orbit-a" />
                <span class="orbit orbit-b" />
                <span class="quake quake-a" />
                <span class="quake quake-b" />
                <span class="quake quake-c" />
                <span class="quake quake-d" />
              </div>
            ) : experiment.kind === "sorting" ? (
              <div class="mini-bars">
                {[42, 76, 28, 91, 55, 69, 35, 84, 48, 62, 23, 73].map(
                  (height, i) => (
                    <span style={`--h:${height}%; --i:${i}`} />
                  ),
                )}
              </div>
            ) : experiment.kind === "systems" ? (
              <div class="mini-system">
                <span>WAL</span><i></i><span>MEM</span><i></i><span>SST</span>
                <b>packet / state / time</b>
              </div>
            ) : experiment.kind === "measure" ? (
              <div class="mini-measure">
                <svg viewBox="0 0 200 130" aria-hidden="true">
                  <line class="axis" x1="70" y1="8" x2="70" y2="122" />
                  <path class="profile" d="M70,97 A32,32 0 0 1 70,33 Z" />
                  <ellipse class="ring" cx="70" cy="65" rx="42" ry="13" />
                  <ellipse class="ghost" cx="70" cy="65" rx="21" ry="6.5" />
                  <circle class="centroid" cx="84" cy="65" r="3" />
                </svg>
              </div>
            ) : experiment.kind === "physics" ? (
              <div class="mini-physics">
                <svg viewBox="0 0 220 140" aria-hidden="true">
                  <ellipse class="trajectory" cx="110" cy="70" rx="82" ry="34" />
                  <ellipse class="trajectory trajectory--second" cx="110" cy="70" rx="55" ry="22" />
                  <circle class="mass mass--primary" cx="110" cy="70" r="9" />
                  <circle class="mass mass--orbiter" cx="192" cy="70" r="4" />
                  <path class="wave" d="M18,112 C34,92 48,132 64,112 S94,92 110,112 S140,132 156,112 S186,92 202,112" />
                </svg>
              </div>
            ) : experiment.kind === "signal" ? (
              <div class="mini-signal">
                <svg viewBox="0 0 220 120" aria-hidden="true">
                  <line class="axis" x1="8" y1="60" x2="212" y2="60" />
                  <path class="carrier" d="M8,60 C18,24 28,96 38,60 S58,24 68,60 S88,96 108,60 S128,24 148,60 S168,96 188,60 S208,24 218,60" />
                  {[[8,60],[24,35],[40,45],[56,75],[72,85],[88,60],[104,35],[120,45],[136,75],[152,85],[168,60],[184,35],[200,45]].map(([cx,cy],i)=>(
                    <circle class="dot" cx={cx} cy={cy} r="3" style={`--i:${i}`} />
                  ))}
                </svg>
              </div>
            ) : experiment.kind === "cipher" ? (
              <div class="mini-cipher">
                <p><span>attack at dawn</span><b aria-hidden="true">⇒</b><em>xzqwl dg yrhu</em></p>
                <div class="mini-bars">
                  {[62,38,80,24,55,70,30,66,42,74,28,58].map((height, i) => (
                    <span style={`--h:${height}%; --i:${i}`} />
                  ))}
                </div>
              </div>
            ) : (
              <div class="mini-sky">
                <svg viewBox="0 0 200 130" aria-hidden="true">
                  <path class="figure" d="M28,96 L52,74 L74,82 L96,58 L124,66 L146,38 L170,46" />
                  <path class="figure" d="M96,58 L108,34 L146,38" />
                  <circle class="s1" cx="28" cy="96" r="2.6" />
                  <circle class="s2" cx="52" cy="74" r="2" />
                  <circle class="s1" cx="74" cy="82" r="1.6" />
                  <circle class="s3" cx="96" cy="58" r="2.8" />
                  <circle class="s2" cx="124" cy="66" r="1.7" />
                  <circle class="s1" cx="146" cy="38" r="2.4" />
                  <circle class="s2" cx="170" cy="46" r="1.8" />
                  <circle class="s3" cx="108" cy="34" r="1.5" />
                  <circle class="planet" cx="58" cy="112" r="3" />
                </svg>
                <i class="mini-horizon"></i>
              </div>
            )}
            <span class="preview-index">EXP / {experiment.number}</span>
          </div>
          <div class="experiment-copy">
            <p class="label">{experiment.kicker}</p>
            <h2>{experiment.title}</h2>
            <p>{experiment.description}</p>
            <span class="launch">Launch experiment <b aria-hidden="true">↗</b></span>
          </div>
        </a>
      ))
    }
  </section>
</Base>

<style>
  .visuals-head {
    padding: 4.5rem 0 3.5rem;
    border-bottom: 2px solid var(--rule-heavy);
  }

  h1 {
    max-width: 52rem;
    margin: 1.25rem 0 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6.75rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 0.88;
  }

  h1 em {
    color: var(--ink-soft);
    font-weight: 400;
  }

  .standfirst {
    max-width: 43rem;
    color: var(--ink-soft);
    font-size: clamp(0.9rem, 1.8vw, 1.05rem);
  }

  .experiments {
    display: grid;
    gap: 1rem;
    padding: 2rem 0 1rem;
  }

  .experiment {
    display: grid;
    grid-template-columns: minmax(17rem, 1.1fr) minmax(18rem, 0.9fr);
    min-height: 23rem;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    box-shadow: inset 0 1px 0 var(--glass-highlight);
    transition:
      transform 260ms var(--ease-out),
      border-color 180ms ease,
      box-shadow 260ms ease;
  }

  .experiment:hover {
    color: inherit;
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--interact) 48%, var(--glass-border));
    box-shadow: inset 0 1px 0 var(--glass-highlight), var(--hover-glow);
  }

  .preview {
    position: relative;
    display: grid;
    min-height: 23rem;
    place-items: center;
    overflow: hidden;
    border-right: 1px solid var(--glass-border);
    background:
      linear-gradient(to right, var(--reseau) 1px, transparent 1px),
      linear-gradient(to bottom, var(--reseau) 1px, transparent 1px),
      color-mix(in srgb, var(--paper-sunken) 78%, transparent);
    background-size: 24px 24px;
  }

  .preview::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, transparent 25%, var(--paper-sunken) 110%);
    pointer-events: none;
  }

  .preview-index {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 1;
    color: var(--ink-faint);
    font-size: 0.625rem;
    letter-spacing: 0.15em;
  }

  .experiment-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4rem);
  }

  .experiment-copy h2 {
    margin: 0.65rem 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 5vw, 4.2rem);
    font-weight: 400;
    line-height: 0.95;
  }

  .experiment-copy > p:not(.label) {
    color: var(--ink-soft);
    font-size: 0.875rem;
  }

  .launch {
    margin-top: 2.5rem;
    color: var(--interact);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .launch b {
    display: inline-block;
    margin-left: 0.35rem;
    transition: transform 220ms var(--ease-out);
  }

  .experiment:hover .launch b {
    transform: translate(4px, -4px);
  }

  .mini-globe {
    position: relative;
    width: min(69%, 18rem);
    aspect-ratio: 1;
    border: 1px solid var(--ink-soft);
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 30%, var(--glass-highlight), transparent 32%),
      color-mix(in srgb, var(--accent-soft) 45%, transparent);
    box-shadow: 0 0 60px color-mix(in srgb, var(--accent-2) 18%, transparent);
  }

  .mini-globe::before,
  .mini-globe::after,
  .orbit {
    content: "";
    position: absolute;
    inset: 14% 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
  }

  .mini-globe::after {
    inset: 0 27%;
  }

  .orbit-a { transform: rotate(36deg); }
  .orbit-b { transform: rotate(-36deg); }

  .quake {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--interact);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--interact) 18%, transparent), 0 0 16px var(--interact);
    animation: ping 2.6s ease-in-out infinite;
  }

  .quake-a { top: 28%; left: 67%; }
  .quake-b { top: 61%; left: 24%; animation-delay: -0.8s; }
  .quake-c { top: 72%; left: 58%; animation-delay: -1.7s; }
  .quake-d { top: 42%; left: 82%; animation-delay: -2.2s; }

  @keyframes ping {
    50% { transform: scale(1.55); opacity: 0.6; }
  }

  .mini-bars {
    display: flex;
    align-items: flex-end;
    gap: clamp(3px, 0.8vw, 8px);
    width: 78%;
    height: 60%;
    border-bottom: 1px solid var(--ink-soft);
  }

  .mini-bars span {
    flex: 1;
    height: var(--h);
    min-width: 3px;
    background: linear-gradient(to top, var(--accent-2), var(--interact));
    border-radius: 3px 3px 0 0;
    transform-origin: bottom;
    animation: bars 2.8s var(--ease-out) infinite alternate;
    animation-delay: calc(var(--i) * -80ms);
  }

  .mini-system { position:relative;z-index:1;display:flex;align-items:center;gap:.45rem;color:var(--ink-soft); }
  .mini-system span { display:grid;width:3.5rem;height:3.5rem;place-items:center;background:var(--glass);border:1px solid var(--ink-soft);border-radius:50%;font-size:.58rem; }
  .mini-system i { width:2.4rem;height:1px;background:linear-gradient(90deg,var(--rule),var(--interact)); }
  .mini-system b { position:absolute;top:4.8rem;left:50%;width:14rem;transform:translateX(-50%);color:var(--interact);font-size:.5rem;font-weight:500;letter-spacing:.1em;text-align:center;text-transform:uppercase; }

  @keyframes bars {
    35% { transform: scaleY(0.82); opacity: 0.65; }
    70% { transform: scaleY(1); opacity: 1; }
  }

  .mini-sky {
    position: relative;
    z-index: 1;
    width: min(72%, 15rem);
  }

  .mini-sky svg { display: block; width: 100%; }

  .mini-sky .figure {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1;
  }

  .mini-sky circle { fill: var(--ink-soft); }
  .mini-sky .s1 { animation: twinkle 3.2s ease-in-out infinite; }
  .mini-sky .s2 { animation: twinkle 3.2s ease-in-out infinite; animation-delay: -1.1s; }
  .mini-sky .s3 { fill: var(--interact); animation: twinkle 3.2s ease-in-out infinite; animation-delay: -2.2s; }

  .mini-sky .planet {
    fill: var(--interact);
    filter: drop-shadow(0 0 6px var(--interact));
  }

  .mini-horizon {
    display: block;
    height: 1px;
    margin-top: 0.4rem;
    background: linear-gradient(90deg, transparent, var(--ink-soft), transparent);
  }

  @keyframes twinkle {
    50% { opacity: 0.35; }
  }

  .mini-measure {
    position: relative;
    z-index: 1;
    width: min(64%, 13rem);
  }

  .mini-measure svg { display: block; width: 100%; }

  .mini-measure .axis {
    stroke: var(--interact);
    stroke-width: 1.4;
    stroke-dasharray: 5 4;
  }

  .mini-measure .profile {
    fill: color-mix(in srgb, var(--accent-2) 14%, transparent);
    stroke: var(--ink-soft);
    stroke-width: 1.4;
  }

  .mini-measure .ring,
  .mini-measure .ghost {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1;
  }

  .mini-measure .ring {
    stroke: var(--ink-soft);
    stroke-dasharray: 3 4;
  }

  .mini-measure .centroid {
    fill: var(--interact);
    filter: drop-shadow(0 0 6px var(--interact));
    offset-path: path("M 112 65 A 42 13 0 1 1 28 65 A 42 13 0 1 1 112 65 Z");
    animation: revolve 6s linear infinite;
  }

  .mini-physics { position:relative;z-index:1;width:min(76%,17rem); }
  .mini-physics svg { display:block;width:100%;overflow:visible; }
  .mini-physics .trajectory { fill:none;stroke:var(--rule-strong);stroke-width:1.2;transform-origin:110px 70px;transform:rotate(-14deg); }
  .mini-physics .trajectory--second { stroke:var(--rule);stroke-dasharray:4 5;transform:rotate(28deg); }
  .mini-physics .mass { fill:var(--interact);filter:drop-shadow(0 0 7px var(--interact)); }
  .mini-physics .mass--orbiter { offset-path:path("M 28 70 A 82 34 0 1 0 192 70 A 82 34 0 1 0 28 70");animation:revolve 7s linear infinite; }
  .mini-physics .wave { fill:none;stroke:var(--accent-2);stroke-width:1.5;stroke-linecap:round; }

  @keyframes revolve {
    to { offset-distance: 100%; }
  }

  .mini-signal { position: relative; z-index: 1; width: min(76%, 17rem); }
  .mini-signal svg { display: block; width: 100%; }
  .mini-signal .axis { stroke: var(--rule); stroke-width: 1; }
  .mini-signal .carrier { fill: none; stroke: var(--rule-strong); stroke-width: 1.4; }
  .mini-signal .dot {
    fill: var(--interact);
    filter: drop-shadow(0 0 5px var(--interact));
    animation: twinkle 2.4s ease-in-out infinite;
    animation-delay: calc(var(--i) * -160ms);
  }

  .mini-cipher { display: flex; flex-direction: column; gap: 1.1rem; z-index: 1; width: min(70%, 15rem); }
  .mini-cipher .mini-bars { height: 4.5rem; }
  .mini-cipher p {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-soft);
  }
  .mini-cipher em { color: var(--interact); font-style: normal; letter-spacing: 0.06em; }

  @media (prefers-reduced-motion: reduce) {
    .quake,
    .mini-bars span,
    .mini-sky circle,
    .mini-measure .centroid,
    .mini-physics .mass--orbiter,
    .mini-signal .dot { animation: none; }
  }

  @media (max-width: 45rem) {
    .visuals-head { padding: 3rem 0 2.5rem; }

    .experiment { grid-template-columns: 1fr; }

    .preview {
      min-height: 18rem;
      border-right: 0;
      border-bottom: 1px solid var(--glass-border);
    }

    .experiment-copy { padding: 2rem; }
  }
</style>

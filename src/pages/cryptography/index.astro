---
import Base from "../../layouts/Base.astro";

const instruments = [
  { n:"001", href:"/cryptography/classical-ciphers", title:"Classical ciphers", field:"Cryptanalysis", kind:"wheel", formula:"cᵢ = (pᵢ + kᵢ) mod 26", description:"Break Caesar by brute force, expose Vigenère's repeated-key periodicity, and see why XOR demands a fresh keystream." },
  { n:"002", href:"/cryptography/rsa", title:"RSA", field:"Public-key cryptography", kind:"ladder", formula:"c = mᵉ mod n", description:"Pick toy primes, derive the private exponent, and follow square-and-multiply through encryption and back." },
  { n:"003", href:"/cryptography/hash-avalanche", title:"Hash avalanche", field:"Digests", kind:"bits", formula:"d ∼ Binomial(32, ½)", description:"Flip a single input bit and measure how far the disturbance travels through the mixing rounds." },
];
---

<Base title="Cryptography — Visuals by Zuhaib Ul Zamann" description="Interactive cryptography laboratories for classical ciphers, public-key RSA, and hash avalanche.">
  <section class="collection-head"><a href="/visuals" class="label back">← Visual laboratory</a><div class="head-grid"><div><p class="label label--accent">Collection 06 · Cryptography</p><h1>Secrets,<br/><em>under test.</em></h1></div><div class="introduction"><p>A cipher earns trust only under attack. These laboratories break the classics with their own statistics, walk the modular arithmetic behind public keys, and measure whether a hash really mixes.</p><span class="label">{String(instruments.length).padStart(2,"0")} interactive instruments</span></div></div></section>
  <section class="math-grid" aria-label="Cryptography visualizations">
    {instruments.map((item,index)=><a href={item.href} class="math-card" data-reveal style={`--delay:${index*70}ms`}><div class={`preview preview--${item.kind}`}><span class="number">CRY / {item.n}</span>{item.kind==="wheel"?<div class="cipher-wheel" aria-hidden="true"><span>ABCDEFGHIJKLMNOPQRSTUVWXYZ</span><span>HIJKLMNOPQRSTUVWXYZABCDEFG</span></div>:item.kind==="ladder"?<div class="rsa-ladder" aria-hidden="true"><span>m</span><i>□</i><span>m²</span><i>□</i><span>m⁴</span><i>□</i><strong>c</strong></div>:<div class="bit-grid" aria-hidden="true">{Array.from({length:32},(_,i)=><i class:list={{diff:[2,5,9,14,18,23,24,30].includes(i)}}></i>)}</div>}<code>{item.formula}</code></div><div class="copy"><div><span class="label label--accent">{item.field}</span><span class="label">Interactive</span></div><h2>{item.title}</h2><p>{item.description}</p><span class="open">Open instrument →</span></div></a>)}
  </section>
</Base>

<style>
  .collection-head{padding:3rem 0 3.5rem;border-bottom:2px solid var(--rule-heavy)}.back{display:inline-block;margin-bottom:2.5rem;color:var(--ink-faint);text-decoration:none}.head-grid{display:grid;grid-template-columns:minmax(22rem,1.1fr) minmax(18rem,.65fr);align-items:end;gap:3rem}h1{margin-top:.8rem;font-family:var(--font-display);font-size:clamp(3.5rem,9vw,7.5rem);font-weight:400;letter-spacing:-.025em;line-height:.83}h1 em{color:var(--ink-soft);font-weight:400}.introduction p{margin-bottom:1.5rem;color:var(--ink-soft);font-size:.875rem}.introduction .label{color:var(--ink-faint)}.math-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;padding:2rem 0 1rem}.math-card{display:flex;min-width:0;flex-direction:column;overflow:hidden;color:inherit;text-decoration:none;background:var(--glass);border:1px solid var(--glass-border);border-radius:14px;box-shadow:inset 0 1px 0 var(--glass-highlight);transition:transform 220ms var(--ease-out),border-color 180ms ease,box-shadow 220ms ease}.math-card:hover{color:inherit;transform:translateY(-4px);border-color:color-mix(in srgb,var(--interact) 50%,var(--glass-border));box-shadow:inset 0 1px 0 var(--glass-highlight),var(--hover-glow)}.preview{position:relative;display:grid;height:11rem;place-items:center;overflow:hidden;border-bottom:1px solid var(--glass-border);background:linear-gradient(to right,var(--reseau) 1px,transparent 1px),linear-gradient(to bottom,var(--reseau) 1px,transparent 1px),color-mix(in srgb,var(--paper-sunken) 58%,transparent);background-size:24px 24px}.number{position:absolute;top:.7rem;left:.8rem;z-index:3;color:var(--ink-faint);font-size:.52rem;letter-spacing:.12em}.preview code{position:absolute;right:.7rem;bottom:.65rem;z-index:2;padding:.45rem .55rem;color:var(--interact);background:color-mix(in srgb,var(--code-wash) 88%,transparent);border:1px solid color-mix(in srgb,var(--interact) 45%,var(--rule));border-radius:6px;font:500 .58rem/1 var(--font-mono);backdrop-filter:blur(8px)}.cipher-wheel{display:grid;width:78%;gap:.55rem;overflow:hidden;font:600 .62rem/1 var(--font-mono);letter-spacing:.16em;white-space:nowrap}.cipher-wheel span{padding:.48rem .6rem;border:1px solid var(--rule);border-radius:999px;color:var(--ink-faint);background:var(--glass)}.cipher-wheel span+span{margin-left:1.2rem;color:var(--interact);border-color:color-mix(in srgb,var(--interact) 45%,var(--rule))}.rsa-ladder{display:flex;width:80%;align-items:center;justify-content:center;color:var(--ink-soft);font:600 .65rem/1 var(--font-mono)}.rsa-ladder i{flex:1;height:1px;margin:.2rem;background:var(--rule);font-size:0}.rsa-ladder span,.rsa-ladder strong{display:grid;width:2.1rem;height:2.1rem;place-items:center;border:1px solid var(--rule);border-radius:50%;background:var(--glass)}.rsa-ladder strong{color:var(--paper);background:var(--interact);border-color:var(--interact)}.bit-grid{display:grid;width:72%;grid-template-columns:repeat(8,1fr);gap:5px}.bit-grid i{aspect-ratio:1;background:var(--rule);border-radius:2px}.bit-grid i:nth-child(3n){background:var(--ink-faint)}.bit-grid i.diff{background:var(--interact);box-shadow:0 0 9px color-mix(in srgb,var(--interact) 40%,transparent)}.copy{display:flex;flex:1;flex-direction:column;gap:.35rem;padding:1.15rem 1.15rem 1.25rem}.copy>div{display:flex;justify-content:space-between;gap:.5rem}.copy h2{margin:.45rem 0 .3rem;font-family:var(--font-display);font-size:1.55rem;font-weight:400;line-height:1}.copy p{color:var(--ink-soft);font-size:.72rem}.open{margin-top:auto;padding-top:1rem;color:var(--interact);font-size:.6rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase}@media(max-width:58rem){.math-grid{grid-template-columns:1fr 1fr}}@media(max-width:44rem){.math-grid{grid-template-columns:1fr}}
</style>

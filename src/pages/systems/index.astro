---
import Base from "../../layouts/Base.astro";

const labs = [
  { n:"011", href:"/systems/storage-engine", title:"Storage engine", group:"Storage", glyph:"WAL → MEM → SST", blurb:"Write, flush, compact, crash, and recover an LSM-style engine." },
  { n:"012", href:"/distributed/raft", title:"Raft", group:"Distributed", glyph:"N₁ ⇄ N₂ ⇄ N₃", blurb:"Partition a cluster and watch elections and log replication." },
  { n:"013", href:"/systems/concurrency", title:"Concurrency", group:"Scheduling", glyph:"T₁ ━╳━ T₂", blurb:"Choose schedules that expose races, blocking, and deadlock." },
  { n:"014", href:"/systems/cache", title:"Cache hierarchy", group:"Performance", glyph:"L1 ↔ L2 ↔ RAM", blurb:"Turn access patterns into hits, misses, and false sharing." },
  { n:"015", href:"/databases/transactions", title:"Transactions", group:"Databases", glyph:"T₁ ⟂ T₂ · MVCC", blurb:"Interleave operations under three isolation strategies." },
  { n:"016", href:"/runtime/compiler", title:"Compiler & VM", group:"Languages", glyph:"src → AST → VM", blurb:"Step source through tokens, syntax, bytecode, and execution." },
  { n:"017", href:"/runtime/memory", title:"Memory allocator", group:"Runtime", glyph:"▮ ▯ ▮▮ ▯ ▮", blurb:"Allocate and free blocks under three placement policies." },
  { n:"018", href:"/networking/tcp", title:"TCP congestion", group:"Networking", glyph:"SEQ ── ACK ↩", blurb:"Drop packets and watch windows, ACKs, and retransmission." },
  { n:"019", href:"/systems/event-loop", title:"Event loop", group:"Async I/O", glyph:"call → poll → queue", blurb:"Mix timers, I/O, CPU work, and microtasks on one loop." },
  { n:"020", href:"/ml/backpropagation", title:"Backpropagation", group:"Machine learning", glyph:"x → h → ŷ ← ∇", blurb:"Follow activations forward and gradients backward." },
  { n:"021", href:"/gpu/compute", title:"GPU compute", group:"Parallelism", glyph:"WG₀ WG₁ WG₂ WG₃", blurb:"Dispatch workgroups and expose divergence and access shape." },
  { n:"022", href:"/reliability/retry-storm", title:"Retry storm", group:"Reliability", glyph:"503 ↻ ↻ ↻", blurb:"Overload a service and compare three resilience policies." },
];
---

<Base title="Systems — Visuals by Zuhaib Ul Zamann" description="Interactive simulations of storage, distributed systems, runtimes, networking, and machine learning.">
  <section class="collection-head"><a href="/visuals" class="label back">← Visual laboratory</a><div class="head-grid"><div><p class="label label--accent">Collection 02 · Executable systems</p><h1>Machines in<br/><em>motion.</em></h1></div><div class="introduction"><p>Systems fail between the boxes in a static architecture diagram. These simulations expose time: queues forming, messages crossing, state becoming durable, and recovery repairing what interruption left behind.</p><span class="label">{String(labs.length).padStart(2,"0")} fault-injectable instruments</span></div></div></section>
  <section class="lab-grid" aria-label="Systems visualizations">{labs.map(lab=><a href={lab.href} class="lab-card" data-reveal><div class="preview"><span class="number">SYS / {lab.n}</span><code>{lab.glyph}</code><i></i></div><div class="copy"><div><span class="label label--accent">{lab.group}</span><span class="label">Interactive</span></div><h2>{lab.title}</h2><p>{lab.blurb}</p><span class="open">Open simulator →</span></div></a>)}</section>
</Base>

<style>
  .collection-head{padding:3rem 0 3.5rem;border-bottom:2px solid var(--rule-heavy)}.back{display:inline-block;margin-bottom:2.5rem;color:var(--ink-faint);text-decoration:none}.head-grid{display:grid;grid-template-columns:minmax(22rem,1.1fr) minmax(18rem,.65fr);align-items:end;gap:3rem}h1{margin-top:.8rem;font-family:var(--font-display);font-size:clamp(3.5rem,9vw,7.5rem);font-weight:400;letter-spacing:-.025em;line-height:.83}h1 em{color:var(--ink-soft);font-weight:400}.introduction p{margin-bottom:1.5rem;color:var(--ink-soft);font-size:.875rem}.introduction .label{color:var(--ink-faint)}.lab-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;padding:2rem 0 1rem}.lab-card{display:flex;min-width:0;flex-direction:column;overflow:hidden;color:inherit;text-decoration:none;background:var(--glass);border:1px solid var(--glass-border);border-radius:14px;box-shadow:inset 0 1px 0 var(--glass-highlight);transition:transform 220ms var(--ease-out),border-color 180ms ease,box-shadow 220ms ease}.lab-card:hover{color:inherit;transform:translateY(-4px);border-color:color-mix(in srgb,var(--interact) 50%,var(--glass-border));box-shadow:inset 0 1px 0 var(--glass-highlight),var(--hover-glow)}.preview{position:relative;display:grid;height:10rem;place-items:center;overflow:hidden;border-bottom:1px solid var(--glass-border);background:linear-gradient(to right,var(--reseau) 1px,transparent 1px),linear-gradient(to bottom,var(--reseau) 1px,transparent 1px),color-mix(in srgb,var(--paper-sunken) 58%,transparent);background-size:24px 24px}.preview .number{position:absolute;top:.7rem;left:.8rem;color:var(--ink-faint);font-size:.52rem;letter-spacing:.12em}.preview code{z-index:1;padding:.65rem .8rem;color:var(--interact);background:var(--code-wash);border:1px solid var(--interact);border-radius:7px;font:500 clamp(.55rem,1.2vw,.72rem)/1 var(--font-mono);box-shadow:0 0 24px color-mix(in srgb,var(--interact) 12%,transparent)}.preview i{position:absolute;width:70%;height:1px;background:linear-gradient(90deg,transparent,var(--interact),transparent);animation:scan 3.5s ease-in-out infinite alternate}@keyframes scan{from{transform:translateY(-2.5rem)}to{transform:translateY(2.5rem)}}.copy{display:flex;flex:1;flex-direction:column;padding:1.2rem}.copy>div{display:flex;justify-content:space-between;gap:1rem}.copy h2{margin:.65rem 0 .7rem;font-family:var(--font-display);font-size:2rem;font-weight:400;line-height:1}.copy p{min-height:3.5rem;color:var(--ink-soft);font-size:.68rem}.open{margin-top:auto;padding-top:1rem;color:var(--interact);font-size:.55rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase}@media(prefers-reduced-motion:reduce){.preview i{animation:none}}@media(max-width:56rem){.lab-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:40rem){.head-grid{grid-template-columns:1fr;gap:2rem}.lab-grid{grid-template-columns:1fr}}
</style>

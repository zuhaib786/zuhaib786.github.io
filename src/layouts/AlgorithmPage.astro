---
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  number: string;
  eyebrow: string;
  heading: string;
  accent?: string;
  lede: string;
  noteTitle: string;
  note: string;
}

const {
  title,
  description,
  number,
  eyebrow,
  heading,
  accent,
  lede,
  noteTitle,
  note,
} = Astro.props;
---

<Base title={`${title} — Visuals by Zuhaib Ul Zamann`} description={description}>
  <section class="experiment-head">
    <div>
      <a href="/algorithms" class="label back">← Algorithms</a>
      <p class="label label--accent">Experiment {number} · {eyebrow}</p>
      <h1>{heading}{accent && <> <em>{accent}</em></>}</h1>
    </div>
    <p class="lede">{lede}</p>
  </section>

  <slot />

  <footer class="experiment-note">
    <span class="label">{noteTitle}</span>
    <p>{note}</p>
  </footer>
</Base>

<style>
  .experiment-head {
    display: grid;
    grid-template-columns: 1fr minmax(19rem, 0.68fr);
    align-items: end;
    gap: 3rem;
    padding: 3rem 0 2rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.6rem;
    color: var(--ink-faint);
    text-decoration: none;
  }

  h1 {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(3.3rem, 8.5vw, 6.8rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 0.85;
  }

  h1 em { color: var(--ink-soft); font-weight: 400; }

  .lede {
    max-width: 31rem;
    padding-bottom: 0.2rem;
    color: var(--ink-soft);
    font-size: 0.875rem;
  }

  .experiment-note {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-faint);
    font-size: 0.6875rem;
  }

  .experiment-note p { max-width: 48rem; }

  @media (max-width: 44rem) {
    .experiment-head { grid-template-columns: 1fr; gap: 1.5rem; }
    .experiment-note { grid-template-columns: 1fr; }
  }
</style>

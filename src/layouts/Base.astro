---
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "../styles/global.css";
import "../styles/instruments.css";
import "../styles/math-instruments.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description =
    "Zuhaib Ul Zamann — software engineer. Writing on systems, performance, and machine learning infrastructure.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#102b3a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (() => {
        const apply = () => {
          let theme;
          try {
            theme = localStorage.getItem("theme");
          } catch {}
          theme ??= window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
          document.documentElement.dataset.theme = theme;
          document.documentElement.classList.add("js");
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main class="site-main">
      <slot />
    </main>
    <Footer />

    <script>
      const reveal = () => {
        const elements = document.querySelectorAll(
          "[data-reveal]:not(.is-visible)",
        );
        if (!("IntersectionObserver" in window)) {
          elements.forEach((element) => element.classList.add("is-visible"));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.08, rootMargin: "0px 0px -5% 0px" },
        );
        elements.forEach((element) => observer.observe(element));
      };

      reveal();
      document.addEventListener("astro:page-load", reveal);
    </script>
  </body>
</html>

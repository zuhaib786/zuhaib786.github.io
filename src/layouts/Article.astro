---
import "katex/dist/katex.min.css";
import Base from "./Base.astro";

interface Props {
  kind: string;
  number: string;
  title: string;
  description?: string;
  date: Date;
  tags?: string[];
  backHref: string;
  backLabel: string;
}

const {
  kind,
  number,
  title,
  description,
  date,
  tags = [],
  backHref,
  backLabel,
} = Astro.props;

const formatted = date.toLocaleDateString("en-GB", {
  day: "2-digit",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
---

<Base title={`${title} — Zuhaib Ul Zamann`} description={description}>
  <article class="article-folio">
    <nav class="folio-running" aria-label="Breadcrumb">
      <span>{kind} {number}</span>
      <a href="/">Zuhaib Ul Zamann</a>
      <a href={backHref}>{backLabel}</a>
    </nav>

    <header class="folio-head">
      <p class="folio-kicker">{kind} № {number} · {formatted}</p>
      <h1>{title}</h1>
      <div class="folio-ornament" aria-hidden="true">
        <span></span>✦<span></span>
      </div>
      {description && <p class="folio-argument">{description}</p>}
      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Topics">
            {tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .article-folio {
    padding-top: 1.25rem;
  }

  .folio-running a {
    text-decoration: none;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 1.35rem;
    list-style: none;
  }

  .tags li {
    padding: 0.16rem 0.48rem;
    border: 1px solid var(--rule);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
